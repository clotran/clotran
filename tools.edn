;; The tools an installed clotran can start by itself, each pinned to a
;; commit, fetched into the cache by clotran-deps on first use (PLAN step
;; 36): `clotran nrepl` runs clotran-nrepl, `clotran lsp` runs clotran-ide,
;; whose formatter is cljfmt on clotran. A release carries each beside
;; lib/clotran at its commit (scripts/dist-bundle), so it needs no git or
;; network for them; a checkout beside clotran, or
;; CLOTRAN_NREPL / CLOTRAN_IDE / CLOTRAN_CLJFMT, is used instead when there
;; is one. No project names them.
{clotran/clotran-nrepl {:git/url "https://github.com/clotran/clotran-nrepl.git"
                        :git/sha "1fbe8dbfe83d09bb8f20baf2f4b50c3e2a538558"}
 clotran/clotran-ide {:git/url "https://github.com/clotran/clotran-ide.git"
                      :git/sha "a87df973d53504e76643f37fbf94b3e8be5ac00b"}
 clotran/cljfmt {:git/url "https://github.com/clotran/cljfmt.git"
                 :git/sha "40a9b02b87d7cb1ef63cdcbbb85581f1f89b207b"}}
