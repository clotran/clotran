;; Cases scripts/fuzz found clotran getting wrong, kept so they stay
;; fixed: each runs through clj and clotran's flat, tree and compiled
;; modes (make test, check-fuzz). Add a shrunk form here with each fix.
[
 ;; compiled, (int x) boxed as a long: the class differs from the
 ;; interpreted int (scripts/fuzz-num)
 (class (int 9.75))
 (let [r (int -3)] [r (class r)])
 ;; (empty m) of a map past eight entries answered nil, so into built a
 ;; list of its entries (scripts/fuzz-spec)
 (into (empty (zipmap (range 10) (range 10))) {:a 1})
 (map? (empty (zipmap (range 10) (range 10))))
 ;; a function's class is named as clj names it, which spec reads back
 (.getName (class int?))
 ;; two literals whose product overflows: the compiled form was a
 ;; constant gfortran folded, and refused the whole library over
 (* 19 4611686018427387904)
 (+ 9223372036854775807 1)
 (- -9223372036854775807 1)
 (* 3 4)
 ;; ONE literal is enough: (inc Long/MAX_VALUE) compiled to huge + 1, a
 ;; constant gfortran refused even under its guard -- literals now go
 ;; into a variable first; doubles likewise
 (inc 9223372036854775807)
 (dec -9223372036854775808)
 (- -9223372036854775808)
 (* -1 -9223372036854775808)
 (quot -9223372036854775808 -1)
 (- 0 -9223372036854775808)
 (abs -9223372036854775808)
 (unchecked-inc 9223372036854775807)
 (unchecked-multiply 19 4611686018427387904)
 (* 1.5 4611686018427387904)
 (inc' 9223372036854775807)
 (* 1.0e308 10.0)
 (+ 1.7976931348623157e308 1.7976931348623157e308)
 (inc 1.0e308)
 ;; scripts/fuzz --fns: assoc on what is not associative throws, as
 ;; RT.assoc's cast does -- it answered nil and assoc-in lost the key
 (assoc 5 :c 12)
 (assoc-in {:d 7 :b -5} [:b :c] 12)
 ;; subvec checks its range, as RT.subvec does
 (subvec [] 5)
 (subvec [6 3 9 -1] 5)
 (subvec [1 2] 1 0)
 (subvec [1 2] -1 1)
 (subvec [1 2 3] 1 3)
 ;; two constants that are = but not the same kind keep their own slots
 (into '(9) '[9])
 ;; the empty string is found at the end (both hosts' lastIndexOf)
 (clojure.string/last-index-of "abc" "")
 (clojure.string/last-index-of "a" "")
 (clojure.string/last-index-of "abc" "" 1)
 (clojure.string/last-index-of "" "")
 [(quote (1 2)) (quote [1 2]) (quote 1N) 1 (quote "a") (quote a)]
 ;; dissoc on an array map keeps the order (PersistentArrayMap.without);
 ;; dissoc! on a transient one moves the last entry into the hole
 ;; (TransientArrayMap.doWithout)
 (pr-str (dissoc {:c 1 :b 2 :a 3 :d 4} :b))
 (pr-str (dissoc (array-map :c 1 :b 2 :a 3 :d 4) :c :a))
 (pr-str (keys (dissoc {:x 1 :y 2 :z 3} :x)))
 (pr-str (persistent! (dissoc! (transient {:c 1 :b 2 :a 3 :d 4}) :b)))
 (pr-str (persistent! (dissoc! (transient {:c 1 :b 2 :a 3 :d 4 :e 5}) :c :a)))
 ;; a Ratio of any size (DEVIATIONS 26, closed): the denominator had
 ;; been 32-bit and the numerator unchecked; rationalize was missing
 (/ 1 3000000000) (/ 1 2147483648) (/ 3 5000000007) (* 1/3 1/5000000000) (+ 1/9223372036854775807 1/2)
 (/ -9223372036854775808 5) (+ 9223372036854775807 1/2) (* 4611686018427387904/3 2) (denominator (/ 1 3000000000))
 99999999999999999999/7 4/2 (* 99999999999999999999/7 7) (class (* 99999999999999999999/7 7))
 (< 1/3000000000 1/2999999999) (= (/ 2 6000000000) 1/3000000000) (zero? (- 1/3000000000 1/3000000000))
 (quot 99999999999999999999/7 3) (rem 99999999999999999999/7 3) (abs -99999999999999999999/7) (inc 99999999999999999999/7)
 (range 1/2 3 1/2) (/ 99999999999999999999N 7) (sort [1/3000000000 -1/2 99999999999999999999/7 0])
 (bigint 99999999999999999999/7) (/ 99999999999999999999/7 99999999999999999999/7)
 (rationalize 0.5) (rationalize 1.0) (rationalize 0.1) (rationalize 1.0e300) (rationalize 1.234e-20) (rationalize 1.5M) (rationalize 3)
 ;; an empty subject splits to [""] and an empty target is replaced
 ;; between every character, as both hosts do; (/ MIN 1) is a BigInt
 ;; (LongOps.divide)
 (clojure.string/split "" #",") (clojure.string/split-lines "") (clojure.string/split ",a,," #",")
 (clojure.string/replace "xnynz" "" "ab") (clojure.string/replace "" "" "-") (clojure.string/replace "héé" "" "|")
 (/ -9223372036854775808 1) (/ -9223372036854775808 -1) (/ 4 -9223372036854775808)
 ;; conj onto a map of what is not seqable throws (RT.seq), it answered {}
 (conj {} 4) (into {} [4]) (conj (sorted-map) 4) (conj {} nil) (conj {:a 1} (quote ([:b 2])))
 ;; a NaN constant, alone or in a collection: compiled mode looked its pool
 ;; slot up by value, NaN equals nothing, and the Fortran did not build
 (let [r (- -447.145M ##NaN)] [r (class r)]) (str [1 ##NaN]) (- 1 ##NaN) (count #{##NaN 1})
 ;; an arg literal's number has no leading 0 (argPat's [1-9][0-9]*): %0363
 ;; read as a 243-argument fn (scripts/fuzz-read)
 (read-string "#(%0363)") (read-string "#(%0)") (read-string "#(%010)") (count (second (read-string "#(%10)")))
 ;; min and max as Numbers' boxed overload: a NaN on either side wins,
 ;; a tie answers the second argument (scripts/fuzz-fn: -0.0 for 0.0)
 (let [f (fn [a b] [(min a b) (max a b)])] [(f 1.0 ##NaN) (f ##NaN 1.0) (f -0.0 0.0) (f 0.0 -0.0) (f 1 1.0) (f 1.0 1)])
 (let [f (fn [& xs] (apply min xs))] [(f 2 1 ##NaN 0) (f 3 -0.0 0.0) (f 0.0 1 -0.0)])
 ;; conj onto a map of a seq holding nil: clj's host reads the nil's key
 ;; and throws NullPointerException, not a cast error (scripts/fuzz-macro)
 (conj {} (quote (nil))) (into {} [(quote (nil))]) ((fn [{:keys [a]}] a) (quote ({:a 1} {:b 2} (nil))))
 ;; keys and vals of what is not seqable throw, as RT.seq does; they
 ;; answered nil (scripts/fuzz-macro: clojure.set/join on a string)
 (keys 1) (vals 1) (keys \a) (clojure.set/join "-" [1 2])
 ;; <= and >= were not-greater and not-less, true against a NaN; and a
 ;; double in a string or a range error was its printed ##-Inf, not
 ;; -Infinity (scripts/fuzz-num, seed 3948490669)
 (let [r (>= 123456789012345678901234567890N ##NaN)] [r (class r)])
 (let [r (int ##-Inf)] [r (class r)])
 (mapv (fn [f] [(f 5 ##NaN) (f ##NaN 1/2) (f 1.5M ##NaN) (f 2 2.0)]) [< <= > >= ==])
 [(str ##-Inf) (str ##Inf) (str ##NaN) (str [##NaN])]
 ;; a character escape with a non-ASCII digit named its first byte, and
 ;; \u measured its length in bytes (scripts/fuzz-read, seed 2362644560)
 (read-string "\\oλ1") (read-string "\\o1λ") (read-string "\\uλ12a")
 (read-string "\\u12λa") (read-string "\\u12λ") (read-string "\\oλ")
]
