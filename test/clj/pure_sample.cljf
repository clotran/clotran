(ns pure-sample
  "Functions scripts/pure-check lowers to pure Fortran and runs against
  the interpreter. The cases are in scripts/pure-check.")

(defn total [a]
  (let [n (alength a)]
    (loop [i 0 s 0.0] (if (< i n) (recur (inc i) (+ s (aget a i))) s))))

(defn mean [a] (/ (total a) (alength a)))

(defn sum-to [n] (loop [i 0 acc 0] (if (< i n) (recur (inc i) (+ acc i)) acc)))

(defn fact [n] (loop [i 1 acc 1] (if (<= i n) (recur (inc i) (* acc i)) acc)))

(defn hyp [x y] (Math/sqrt (+ (* x x) (* y y))))

(defn clamp [x lo hi] (max lo (min hi x)))

(defn sign-of [x] (cond (pos? x) 1 (neg? x) -1 :else 0))

(defn ratio [a b] (quot a b))

(defn floor-mod [a b] (mod a b))

(defn trunc-rem [a b] (rem a b))

(defn nth-or [a i] (aget a i))

(defn to-long [x] (long x))

(defn scale! [a k]
  (let [n (alength a)]
    (loop [i 0] (if (< i n) (do (aset a i (* k (aget a i))) (recur (inc i))) n))))

(defn dist2 [a b]
  (let [n (alength a)]
    (loop [i 0 s 0.0]
      (if (< i n)
        (let [d (- (aget a i) (aget b i))] (recur (inc i) (+ s (* d d))))
        s))))

(defn sum-squares [xs] (reduce + 0.0 (map #(* % %) xs)))

(defn sum-longs [xs] (reduce + xs))

(defn count-big [xs] (count (filter #(> % 10) xs)))

(defn sum-odd-squares [n] (reduce + 0 (map #(* % %) (filter odd? (range n)))))

(defn all-positive? [xs] (every? pos? xs))

(defn scaled-sum [xs k] (reduce + 0.0 (map (fn [x] (* k x)) xs)))

(defn countdown-sum [n] (reduce + 0 (range n 0 -2)))

(defn max-of [xs] (reduce max xs))

(defn show [a] (println "mean:" (mean a)))

(defn label [n] (str "n=" n "!"))

(defn first-three [^String s] (subs s 0 3))

(defn tail-of [^String s] (subs s 1))

(defn has-fe? [^String s] (clojure.string/includes? s "fe"))

(defn same-text? [^String a ^String b] (= a b))

(defn describe-num [x] (println "x is" x (if (pos? x) "positive" "not positive")))

(defn countdown [n] (loop [i n] (when (pos? i) (println i) (recur (dec i)))))

(defn quoted [] (str "say \"hi\"\nbye"))

(defn squares-of [xs] (amap xs i ret (* (aget xs i) (aget xs i))))

(defn zeros [n] (double-array n))

(defn ramp [n] (let [a (long-array n)] (loop [i 0] (if (< i n) (do (aset a i (* i i)) (recur (inc i))) a))))

(defn scaled-copy [xs k] (let [c (aclone xs)] (dotimes [i (alength c)] (aset c i (* k (aget c i)))) c))

(defn alias-write [xs] (let [b xs] (aset b 0 99.0) (aget xs 0)))

(defn- sq [x] (* x x))

(defn circle-area [^double r] (* 3.0 (sq r)))

(defn overrun [n] (let [a (double-array 2)] (loop [i 0] (if (< i n) (do (aset a i 1.0) (recur (inc i))) a))))

(defrecord Particle [x y vx vy])

(defn speed [p] (Math/sqrt (+ (* (:vx p) (:vx p)) (* (:vy p) (:vy p)))))

(defn step [p dt] (->Particle (+ (:x p) (* dt (:vx p))) (+ (:y p) (* dt (:vy p))) (:vx p) (:vy p)))

(defn kinetic [p ^double m] (* 0.5 m (+ (* (:vx p) (:vx p)) (* (:vy p) (:vy p)))))

(defrecord Tally [^long n ^double total])

(defn bump [t x] (->Tally (inc (:n t)) (+ (:total t) x)))

(defn bad-tally [] (->Tally 1.0 2.0))

;; several arities: one generic name, a version per arity and types
(defn lerp
  ([a b] (lerp a b 0.5))
  ([a b ^double t] (+ a (* t (- b a)))))

(defn add-down
  ([n] (add-down n 0))
  ([n acc] (if (zero? n) acc (recur (dec n) (+ acc n)))))
