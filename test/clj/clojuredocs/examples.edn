ins something like:\n;;   (ns example)\n;;   (def ^{:t1 \"secret metadata\"\n;;          :doc \"here's some useful info\"}\n;;     foo 1))\n\n(binding [*compiler-options* {:elide-meta [:doc :t1]}]\n  (compile 'example))\n\n;; AOT-compiles \"example.clj\" removing \":doc\" and \":t1\" values from\n;; the constant pool of the generated class.", :tags #{}} {:var "*data-readers*", :source :example, :n 0, :code "(import '[java.net URL])\n\n;; Teaching Clojure how to read URL objects from a string\n\n(binding [*data-readers* {'url #(URL. %)}] \n  (read-string \"#url \\\"file:/etc/hosts\\\"\"))\n\n;; #object[java.net.URL 0x64a8c844 \"file:/etc/hosts\"]", :tags #{:interop}} {:var "*default-data-reader-fn*", :source :example, :n 0, :code "#object[clojure.lang.Namespace 0x23bff419 \"user\"]\n(set! *default-data-reader-fn* tagged-literal)\n#object[clojure.lang.Namespace 0x23bff419 \"user\"]\n[(:tag *1) (:form *1)]", :tags #{}} {:var "*e", :source :example, :n 0, :code "(ns-refers)\n*e", :tags #{:portable}} {:var "*err*", :source :example, :n 0, :code "(binding [*out* *err*]\n        (prn \"prn can be used\")\n        (println \"println can also be used\"))", :tags #{}} {:var "*file*", :source :example, :n 0, :code ";; Given a file named \"example.clj\" is available in the current folder\n;; with content:\n\n(ns example)\n(when *compile-files* (println \"Compiling:\" *file*))\n\n;; If we start a REPL adding \".\" as part of the classpath,\n;; then we can see the following:\n\n(binding [*compile-path* \".\"]\n  (compile 'example))\n;; Compiling: example.clj\n;; example", :tags #{}} {:var "*ns*", :source :example, :n 0, :code "*ns*", :tags #{:portable}} {:var "*ns*", :source :example, :n 1, :code "(ns foo.bar)\n*ns*", :tags #{:portable}} {:var "*ns*", :source :example, :n 2, :code "(ns my.namespace)\n*ns*\n(defn swap-ns! [ns-name] (in-ns ns-name))\n(swap-ns! 'other.ns)", :tags #{:portable}} {:var "*out*", :source :example, :n 0, :code ";; One approach to silence printing\n\n(def noop-writer\n  ;; *out* needs to be bound to a java.io.writer, so proxy a writer\n  ;; https://docs.oracle.com/javase/7/docs/api/java/io/Writer.html\n  (proxy [java.io.Writer] []\n    (close [] nil)\n    (flush [] nil)\n    (write\n      ;; ... which politely ignores any calls.\n      ([cbuf] nil)\n      ([cbuf off len] nil))))\n\n;; Now if we bind *out* to the no-op writer println won't do anything\n(do\n  (println \"Hello?\")\n  (binding [*out* noop-writer]\n    ;; (.write noop-writer) will be used to print this, so nothing will happen.\n    (println \"world\")))\nnil", :tags #{:portable}} {:var "*print-dup*", :source :example, :n 0, :code "(deserialize \"config.clj\")", :tags #{:portable}} {:var "*print-length*", :source :example, :n 0, :code "(iterate inc 0)\n(set! *print-length* 10)\n(iterate inc 0)", :tags #{:portable}} {:var "*print-level*", :source :example, :n 0, :code "*print-level*\n[1 [2 [3]]]\n(set! *print-level* 2)\n[1 [2 [3]]]", :tags #{:portable}} {:var "*print-meta*", :source :example, :n 0, :code "(binding [*print-meta* true] \n         (pr (var defmacro)) )", :tags #{:portable}} {:var "*print-meta*", :source :example, :n 1, :code "(binding [*print-meta* true]\n         (-> \"{:a ^{:b :c} {}}\"\n            clojure.edn/read-string\n            clojure.pprint/pprint))", :tags #{:interop}} {:var "*print-namespace-maps*", :source :example, :n 0, :code ";; In a REPL:\n\n(prn {:num/val 1 :num/name \"one\"})\n;; #:num{:val 1, :name \"one\"}\n\n(binding [*print-namespace-maps* false] \n  (prn {:num/val 1 :num/name \"one\"}))\n;; {:num/val 1, :num/name \"one\"}", :tags #{:portable}} {:var "*print-namespace-maps*", :source :note, :n 0, :code "; don't use namespaced maps by default in the REPL\n(defmethod print-method clojure.lang.IPersistentMap [m, ^java.io.Writer w]\n  (#'clojure.core/print-meta m w)\n  (#'clojure.core/print-map m #'clojure.core/pr-on w))", :tags #{:interop}} {:var "*print-readably*", :source :example, :n 0, :code ";; Showing how *print-readably* is used internally to escape/unescape control\n;; characters:\n\n(binding [*print-readably* false]\n  (pr \"a\\nb\\nc\"))\n;; a\n;; b\n;; cnil\n\n;; Only use to change behaviour of code you don't control.\n;; Otherwise, it's equivalent to `print`:\n(print \"a\\nb\\nc\")\n;; a\n;; b\n;; cnil", :tags #{:portable}} {:var "*read-eval*", :source :example, :n 0, :code ";;just from the doc\n\n(binding [*read-eval* false] (read-string \"#=(eval (def x 3))\"))\n  [Thrown class java.lang.RuntimeException]\n\n;;remove the anonymous function:\n\n(binding [*read-eval* false] (read-string \"(def x 3)\"))\n\n;;which is evaluable\n\n(eval (binding [*read-eval* false] (read-string \"(def x 3)\")))\n\nx", :tags #{:interop}} {:var "*read-eval*", :source :note, :n 0, :code "(read-string \"#=(+ 1 (+ 2 3))\")", :tags #{}} {:var "*read-eval*", :source :note, :n 1, :code "(+ '1 '(+ 2 3))", :tags #{}} {:var "*read-eval*", :source :note, :n 2, :code "(read-string \"#=(eval (+ 1 (+ 2 3)))\")", :tags #{}} {:var "*read-eval*", :source :note, :n 3, :code "(def x 1)\n#=(eval (+ 1 x))", :tags #{:interop}} {:var "*source-path*", :source :example, :n 0, :code ";; Contains the name (not the full path, for that see \n;; https://clojuredocs.org/clojure.core/*file*) \n;; of the compilation unit that is currently being compiled.\n;; Given a file named \"examples/example.clj\" is available in the \"examples\" \n;; folder starting at \".\":\n\n(ns examples.example)\n(when *compile-files* \n  (println \"Compiling:\" *source-path*))\n\n;; If we start a REPL adding \".\" as part of the classpath,\n;; we can see the following:\n\n(binding [*compile-path* \".\"]\n  (compile 'examples.example))\n;; Compiling: example.clj\n;; examples.example", :tags #{}} {:var "*unchecked-math*", :source :example, :n 0, :code "(unchecked-add Long/MAX_VALUE 1)\n(+ Long/MAX_VALUE 1)\n(set! *unchecked-math* true)\n(+ Long/MAX_VALUE 1)", :tags #{:interop}} {:var "*use-context-classloader*", :source :example, :n 0, :code ";; *use-context-classloader* is always bound to true regarldess of any \n;; outer binding setting and thus ignored.\n;; The initial idea was to have a way to tell Clojure to ignore\n;; the context classloader (supposedly set by external libs or frameworks)\n;; in some pretty specific OSGi scenarios. Original context can be found at:\n;; https://groups.google.com/g/clojure/c/aXsFBdowdsA/m/1Ez894XuT30J and\n;; additional use cases https://clojure.atlassian.net/browse/CLJ-2593\n\n(import '[clojure.lang DynamicClassLoader])\n(def custom-classloader (DynamicClassLoader.))\n(.setContextClassLoader (Thread/currentThread) custom-classloader)\n\n(identical?\n  (.. (fn []) getClass getClassLoader getParent)\n  custom-classloader)\n;; true\n\n;; This should return false and use some other class loader\n(binding [*use-context-classloader* false]\n  (identical?\n    (.. (fn []) getClass getClassLoader getParent)\n    custom-classloader))\n;; true\n\n;; WARNING: If the examples above don't seem to return the expected results, \n;; be aware that tools like Leiningen[https://leiningen.org/] or\n;; nRepl[https://github.com/nrepl/nrepl] alter the context class loader. \n;; Please use a vanilla REPL like \n;; clojure.deps[https://clojure.org/guides/getting_started] instead.", :tags #{:interop}} {:var "*use-context-classloader*", :source :example, :n 1, :code ";; The above example has one minor caveat to be aware of for those who need \n;; to work with classloaders. *use-context-classloader* is not technically\n;; ignored, because RT/baseLoader will use it. But it's usually overridden \n;; by RT/makeClassLoader, which pushes a binding that sets it to true every \n;; time it's called. And RT/makeClassLoader is called every time eval or \n;; compile1 is called and in some versions of load(), so it happens a lot.", :tags #{}} {:var "*warn-on-reflection*", :source :example, :n 0, :code "(def i 23)\n(def s \"123\")\n(set! *warn-on-reflection* true)\n(.toString i)\n(.toString s)\n(.toString ^String s)\n(set! *warn-on-reflection* false)\n(.toString i)\n(.toString s)", :tags #{:interop}} {:var "*warn-on-reflection*", :source :example, :n 1, :code "(set! *warn-on-reflection* true)  ;; turn on *warn-on-reflection*\n(def s \"abc\")                     ;; define s\n(.toString s)                     ;; => \"abc\"; WARN: type of s is unknown\n(.toString ^String s)             ;; => \"abc\"; no warn given the type hint\n(let [s \"abc\"] (.toString s))     ;; => \"abc\"; no warn since Clojure can infer\n                                  ;;           type for the local binding\n(set! *warn-on-reflection* false) ;; turn off *warn-on-reflection*", :tags #{:interop}} {:var "*warn-on-reflection*", :source :example, :n 2, :code ";; Important to note *warn-on-reflection* take its effect at compile time,\n;; so binding the option won't work... even with a set! inside.\n;;   - binding creates a new env to evaluate subsequent statements\n;;   - yet, compiler still lives in the current env, so it won't see the value\n\n(binding [*warn-on-reflection* true]\n  (set! *warn-on-reflection* true)\n  (def s \"abc\")\n  (.toString s))                          ;; => \"abc\", no warning\n(println *warn-on-reflection*)            ;; => false", :tags #{:interop}} {:var "+", :source :example, :n 0, :code "(+)\n\n(+ 1)\n\n(+ -10)\n\n(+ 1 2)\n\n(+ 1 2 3)\n\n(+ 1/2 1/2)\n\n(apply + (range 10000000000000 10000000001000))\n;; ArithmeticException: integer overflow", :tags #{:portable}} {:var "+'", :source :example, :n 0, :code "(+')\n\n(+' 1)\n\n(+' -10)\n\n(+' 1 2)\n\n(+' 1 2 3)\n\n(apply + (range 10000000000000 10000000001000))\n;; ArithmeticException: integer overflow\n\n(apply +' (range 10000000000000 10000000001000))", :tags #{}} {:var "+'", :source :example, :n 1, :code "(class 1)\n\n(+ 1 Long/MAX_VALUE)\n;;        Numbers.java:1388 clojure.lang.Numbers.throwIntOverflow\n;;        Numbers.java:1687 clojure.lang.Numbers.add\n\n(+' 1 Long/MAX_VALUE)\n\n(class (+' 1 Long/MAX_VALUE))", :tags 