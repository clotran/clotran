;; A case is an expression; {:undefined expr}, a result the standard leaves to the processor (an
;; implementation refuses it: fortran.ops throws, the pure tier fails or does not lower it);
;; {:processor expr}, one the processor decides but compiled Fortran may answer with the
;; processor's value (fortran.ops refuses it, the pure tier is not checked); {:interpreted expr},
;; a defined one the pure tier may decline to lower.
;; Cases for the Fortran-types oracle (test/ftypes/oracle.clj). Each is an
;; expression: a literal [kind x] (a real's x is its TEXT), or (op args...).
;; scripts/ftypes-check runs them through the oracle on clj and through
;; gfortran and flang, and compares. Cases whose answer the standard leaves
;; to the processor are expected to be :undefined and are not compared.
[
 ;; integer arithmetic, one kind
 (+ [:int4 7] [:int4 5])
 (- [:int4 7] [:int4 12])
 (* [:int4 -6] [:int4 7])
 (/ [:int4 7] [:int4 2])
 (/ [:int4 -7] [:int4 2])
 (/ [:int4 7] [:int4 -2])
 (/ [:int4 -7] [:int4 -2])
 (/ [:int8 9000000000] [:int8 7])
 (+ [:int1 100] [:int1 27])
 (+ [:int2 30000] [:int2 2767])
 ;; mixed integer kinds: the larger
 (+ [:int1 100] [:int4 100000])
 (* [:int4 100000] [:int8 100000])
 (/ [:int2 -9] [:int8 4])
 ;; mixed integer and real: the real's kind, whatever the integer's
 (+ [:int4 1] [:real8 "0.5"])
 (+ [:int8 1] [:real4 "0.5"])
 (/ [:int4 1] [:real4 "3.0"])
 (/ [:int4 1] [:real8 "3.0"])
 (* [:int1 3] [:real4 "1.1"])
 ;; real kinds
 (+ [:real4 "0.1"] [:real4 "0.2"])
 (+ [:real8 "0.1"] [:real8 "0.2"])
 (+ [:real4 "0.1"] [:real8 "0.2"])
 (* [:real4 "1.1"] [:real4 "1.1"])
 (/ [:real8 "1.0"] [:real8 "3.0"])
 (/ [:real4 "1.0"] [:real4 "3.0"])
 (- [:real4 "16777216"] [:real4 "1.0"])
 (+ [:real4 "16777216"] [:real4 "1.0"])
 (+ [:real4 "1.0e30"] [:real4 "1.0e30"])
 (* [:real8 "1.0e200"] [:real8 "1.0e-200"])
 (- [:real8 "5.0"])
 (- [:int4 5])
 ;; powers
 (** [:int4 2] [:int4 10])
 (** [:int4 -3] [:int4 3])
 (** [:int8 2] [:int4 62])
 (** [:int4 2] [:int4 -1])
 (** [:int4 1] [:int4 -5])
 (** [:int4 -1] [:int4 -5])
 (** [:real8 "1.5"] [:int4 2])
 (** [:real4 "1.1"] [:int4 2])
 ;; conversions: the Fortran gotchas
 (int [:real8 "2.9"])
 (int [:real8 "-2.9"])
 (int [:real4 "1.0e9"])
 (int [:real8 "3.0e9"] :int8)
 (nint [:real8 "2.5"])
 (nint [:real8 "-2.5"])
 (nint [:real8 "0.49999999999999994"])
 (nint [:real4 "1.5"])
 (nint [:real8 "2.5"] :int8)
 (floor [:real8 "-2.5"])
 (floor [:real8 "2.5"])
 (ceiling [:real8 "-2.5"])
 (ceiling [:real8 "2.5"])
 (real [:int4 7])
 (real [:int4 16777217])
 (real [:int8 9007199254740993])
 (real [:int8 9007199254740993] :real8)
 (real [:int4 16777217] :real8)
 (dble [:int4 7])
 (dble [:real4 "0.1"])
 (real [:real8 "0.1"])
 (real [:real8 "0.1"] :real8)
 {:undefined (int [:int8 123456789] :int1)}
 (int [:int4 100] :int1)
 (int [:int1 -5] :int8)
 ;; integer mod and modulo (they differ for negatives)
 (mod [:int4 7] [:int4 3])
 (mod [:int4 -7] [:int4 3])
 (mod [:int4 7] [:int4 -3])
 (mod [:int4 -7] [:int4 -3])
 (modulo [:int4 7] [:int4 3])
 (modulo [:int4 -7] [:int4 3])
 (modulo [:int4 7] [:int4 -3])
 (modulo [:int4 -7] [:int4 -3])
 (mod [:real8 "5.5"] [:real8 "2.0"])
 (mod [:real8 "-5.5"] [:real8 "2.0"])
 (modulo [:real8 "-5.5"] [:real8 "2.0"])
 (modulo [:real8 "5.5"] [:real8 "-2.0"])
 (mod [:real4 "10.5"] [:real4 "3.0"])
 (mod [:real8 "1.0e300"] [:real8 "7.0"])
 (mod [:real8 "123456789.123456"] [:real8 "0.001"])
 (modulo [:real8 "-1.0e300"] [:real8 "7.0"])
 ;; the rest of the intrinsics
 (abs [:int4 -9])
 (abs [:real4 "-2.5"])
 (sign [:int4 5] [:int4 -1])
 (sign [:real8 "-3.5"] [:real8 "2.0"])
 (max [:int4 3] [:int4 9] [:int4 4])
 (min [:real8 "2.5"] [:real8 "-1.5"])
 (sqrt [:real8 "2.0"])
 (sqrt [:real4 "2.0"])
 (sqrt [:real8 "144.0"])
 ;; the numeric model
 (huge [:int1 0])
 (huge [:int2 0])
 (huge [:int4 0])
 (huge [:int8 0])
 (huge [:real4 "1.0"])
 (huge [:real8 "1.0"])
 (tiny [:real4 "1.0"])
 (tiny [:real8 "1.0"])
 (epsilon [:real4 "1.0"])
 (epsilon [:real8 "1.0"])
 (kind [:int1 0])
 (kind [:int8 0])
 (kind [:real4 "1.0"])
 (kind [:real8 "1.0"])
 (digits [:int4 0])
 (digits [:int8 0])
 (digits [:real4 "1.0"])
 (digits [:real8 "1.0"])
 ;; nested
 (+ (* [:int4 3] [:int4 4]) (/ [:int4 10] [:int4 4]))
 (real (/ [:int4 1] [:int4 2]))
 (/ (real [:int4 1]) (real [:int4 2]))
 (int (* [:real8 "2.5"] [:real8 "4.0"]))
 ;; the processor's to decide: {:undefined expr} says the oracle must answer
 ;; undefined (and so must an implementation: clotran throws). Any other
 ;; case must answer a value, or the check fails.
 {:undefined (+ [:int4 2147483647] [:int4 1])}
 {:undefined (* [:int8 4611686018427387904] [:int8 2])}
 {:undefined (- [:int1 -128] [:int1 1])}
 {:undefined (abs [:int1 -128])}
 {:undefined (/ [:int4 1] [:int4 0])}
 {:undefined (mod [:int4 1] [:int4 0])}
 {:undefined (int [:real8 "1.0e30"])}
 {:undefined (int [:int8 300] :int1)}
 ;; a real to an integer power: defined where every partial power is exact, else the processor's
 (** [:real8 "2.0"] [:int4 3])
 (** [:real8 "1.5"] [:int4 3])
 (** [:real8 "0.5"] [:int4 10])
 (** [:real8 "2.0"] [:int4 -3])
 (** [:real8 "10.0"] [:int4 22])
 (** [:real4 "1.5"] [:int8 4])
 (** [:real8 "-2.0"] [:int4 5])
 (** [:real8 "7.0"] [:int4 0])
 {:processor (** [:real8 "10.0"] [:int4 23])}
 {:processor (** [:real4 "1.1"] [:int4 3])}
 {:processor (** [:real8 "3.0"] [:int4 -1])}
 {:undefined (** [:real8 "0.0"] [:int4 -2])}
 {:undefined (** [:real8 "2.0"] [:real8 "0.5"])}
 ;; IEEE: overflow is infinity, x/0 infinity, 0/0 NaN, in both real kinds
 (+ [:real4 "3.0e38"] [:real4 "3.0e38"])
 (* [:real8 "1.0e200"] [:real8 "1.0e200"])
 (/ [:real8 "1.0"] [:real8 "0.0"])
 (/ [:real4 "-1.0"] [:real4 "0.0"])
 (/ [:real8 "0.0"] [:real8 "0.0"])
 (- [:real4 "3.0e38"] [:real4 "-3.0e38"])
 (real [:real8 "1.0e39"])
 (real [:real8 "-1.0e39"])
 (real [:real8 "3.4028235677973366e38"])
 (real [:real8 "3.4028235677973362e38"])
 {:undefined (int (/ [:real8 "0.0"] [:real8 "0.0"]))}
 {:undefined (int (/ [:real8 "1.0"] [:real8 "0.0"]))}
 {:undefined (nint (* [:real8 "1.0e200"] [:real8 "1.0e200"]))}
 ;; a real(4) literal is rounded once, from its text: just above the midpoint of 1 and 1+2**-23
 ;; the text is nearer the upper one, which rounding through a real(8) would lose
 (+ [:real4 "1.000000059604644775390626"] [:real4 "0.0"])
 (+ [:real4 "1.000000059604644775390624"] [:real4 "0.0"])
 (+ [:real4 "16777217.0000001"] [:real4 "0.0"])
 {:undefined (** [:int4 0] [:int4 -2])}
 {:undefined (sqrt [:real8 "-1.0"])}
 ;; complex (the standard leaves inexact complex * and all / to the processor: FCVS FM828-831)
 (+ [:complex8 ["1.5" "2.5"]] [:complex8 ["0.5" "-1.0"]])
 (- [:complex8 ["1.5" "2.5"]] [:complex8 ["0.5" "-1.0"]])
 (* [:complex8 ["1" "2"]] [:complex8 ["3" "4"]])
 (* [:complex4 ["1.5" "2.0"]] [:complex4 ["2.0" "-0.5"]])
 (- [:complex8 ["1.5" "-2.5"]])
 (+ [:complex4 ["1.5" "2.5"]] [:real8 "1.0"])
 (+ [:int4 1] [:complex4 ["1.5" "2.5"]])
 (+ [:complex4 ["1.5" "2.5"]] [:complex8 ["0.25" "0.5"]])
 (* [:real4 "2.0"] [:complex8 ["1.5" "2.5"]])
 (cmplx [:real8 "1.5"] [:real8 "2.5"])
 (cmplx [:real8 "1.5"] [:real8 "2.5"] :complex8)
 (cmplx [:int4 3] [:int4 4] :complex8)
 (cmplx [:real8 "0.1"] [:real8 "0.2"])
 (conjg [:complex4 ["1.5" "2.5"]])
 (aimag [:complex4 ["1.5" "2.5"]])
 (aimag [:complex8 ["1.5" "2.5"]])
 (real [:complex4 ["1.5" "2.5"]])
 (real [:complex8 ["1.5" "2.5"]] :real4)
 (dble [:complex4 ["0.1" "2.5"]])
 ;; defined (hypot exact), answered by fortran.ops; the pure tier declines ABS of a complex
 {:interpreted (abs [:complex8 ["3" "4"]])}
 {:interpreted (abs [:complex4 ["5" "12"]])}
 (kind [:complex4 ["1" "1"]])
 (kind [:complex8 ["1" "1"]])
 (+ [:complex4 ["0.1" "0.2"]] [:real8 "1.0"])
 (+ [:complex4 ["0.1" "0.2"]] [:complex8 ["0.1" "0.2"]])
 (real [:complex8 ["0.1" "0.2"]])
 (aimag [:complex8 ["0.1" "0.2"]])
 (- [:complex4 ["0.1" "0.2"]] [:real8 "0.1"])
 {:undefined (/ [:complex8 ["1" "2"]] [:complex8 ["3" "4"]])}
 {:processor (* [:complex8 ["0.1" "0.2"]] [:complex8 ["0.3" "0.4"]])}
 {:undefined (abs [:complex8 ["1" "1"]])}

