;; Cases for the Fortran-types oracle (test/ftypes/oracle.clj). Each is an
;; expression: a literal [kind x] (a real's x is its TEXT), or (op args...).
;; scripts/ftypes-check runs them through the oracle on clj and through
;; gfortran and flang, and compares. Cases whose answer the standard leaves
;; to the processor are expected to be :undefined and are not compared.
[
 ;; integer arithmetic, one kind
 (+ [:int32 7] [:int32 5])
 (- [:int32 7] [:int32 12])
 (* [:int32 -6] [:int32 7])
 (/ [:int32 7] [:int32 2])
 (/ [:int32 -7] [:int32 2])
 (/ [:int32 7] [:int32 -2])
 (/ [:int32 -7] [:int32 -2])
 (/ [:int64 9000000000] [:int64 7])
 (+ [:int8 100] [:int8 27])
 (+ [:int16 30000] [:int16 2767])
 ;; mixed integer kinds: the larger
 (+ [:int8 100] [:int32 100000])
 (* [:int32 100000] [:int64 100000])
 (/ [:int16 -9] [:int64 4])
 ;; mixed integer and real: the real's kind, whatever the integer's
 (+ [:int32 1] [:real64 "0.5"])
 (+ [:int64 1] [:real32 "0.5"])
 (/ [:int32 1] [:real32 "3.0"])
 (/ [:int32 1] [:real64 "3.0"])
 (* [:int8 3] [:real32 "1.1"])
 ;; real kinds
 (+ [:real32 "0.1"] [:real32 "0.2"])
 (+ [:real64 "0.1"] [:real64 "0.2"])
 (+ [:real32 "0.1"] [:real64 "0.2"])
 (* [:real32 "1.1"] [:real32 "1.1"])
 (/ [:real64 "1.0"] [:real64 "3.0"])
 (/ [:real32 "1.0"] [:real32 "3.0"])
 (- [:real32 "16777216"] [:real32 "1.0"])
 (+ [:real32 "16777216"] [:real32 "1.0"])
 (+ [:real32 "1.0e30"] [:real32 "1.0e30"])
 (* [:real64 "1.0e200"] [:real64 "1.0e-200"])
 (- [:real64 "5.0"])
 (- [:int32 5])
 ;; powers
 (** [:int32 2] [:int32 10])
 (** [:int32 -3] [:int32 3])
 (** [:int64 2] [:int32 62])
 (** [:int32 2] [:int32 -1])
 (** [:int32 1] [:int32 -5])
 (** [:int32 -1] [:int32 -5])
 (** [:real64 "1.5"] [:int32 2])
 (** [:real32 "1.1"] [:int32 2])
 ;; conversions: the Fortran gotchas
 (int [:real64 "2.9"])
 (int [:real64 "-2.9"])
 (int [:real32 "1.0e9"])
 (int [:real64 "3.0e9"] :int64)
 (nint [:real64 "2.5"])
 (nint [:real64 "-2.5"])
 (nint [:real64 "0.49999999999999994"])
 (nint [:real32 "1.5"])
 (nint [:real64 "2.5"] :int64)
 (floor [:real64 "-2.5"])
 (floor [:real64 "2.5"])
 (ceiling [:real64 "-2.5"])
 (ceiling [:real64 "2.5"])
 (real [:int32 7])
 (real [:int32 16777217])
 (real [:int64 9007199254740993])
 (real [:int64 9007199254740993] :real64)
 (real [:int32 16777217] :real64)
 (dble [:int32 7])
 (dble [:real32 "0.1"])
 (real [:real64 "0.1"])
 (real [:real64 "0.1"] :real64)
 {:undefined (int [:int64 123456789] :int8)}
 (int [:int32 100] :int8)
 (int [:int8 -5] :int64)
 ;; integer mod and modulo (they differ for negatives)
 (mod [:int32 7] [:int32 3])
 (mod [:int32 -7] [:int32 3])
 (mod [:int32 7] [:int32 -3])
 (mod [:int32 -7] [:int32 -3])
 (modulo [:int32 7] [:int32 3])
 (modulo [:int32 -7] [:int32 3])
 (modulo [:int32 7] [:int32 -3])
 (modulo [:int32 -7] [:int32 -3])
 (mod [:real64 "5.5"] [:real64 "2.0"])
 (mod [:real64 "-5.5"] [:real64 "2.0"])
 (modulo [:real64 "-5.5"] [:real64 "2.0"])
 (modulo [:real64 "5.5"] [:real64 "-2.0"])
 (mod [:real32 "10.5"] [:real32 "3.0"])
 ;; the rest of the intrinsics
 (abs [:int32 -9])
 (abs [:real32 "-2.5"])
 (sign [:int32 5] [:int32 -1])
 (sign [:real64 "-3.5"] [:real64 "2.0"])
 (max [:int32 3] [:int32 9] [:int32 4])
 (min [:real64 "2.5"] [:real64 "-1.5"])
 (sqrt [:real64 "2.0"])
 (sqrt [:real32 "2.0"])
 (sqrt [:real64 "144.0"])
 ;; the numeric model
 (huge [:int8 0])
 (huge [:int16 0])
 (huge [:int32 0])
 (huge [:int64 0])
 (huge [:real32 "1.0"])
 (huge [:real64 "1.0"])
 (tiny [:real32 "1.0"])
 (tiny [:real64 "1.0"])
 (epsilon [:real32 "1.0"])
 (epsilon [:real64 "1.0"])
 (kind [:int8 0])
 (kind [:int64 0])
 (kind [:real32 "1.0"])
 (kind [:real64 "1.0"])
 (digits [:int32 0])
 (digits [:int64 0])
 (digits [:real32 "1.0"])
 (digits [:real64 "1.0"])
 ;; nested
 (+ (* [:int32 3] [:int32 4]) (/ [:int32 10] [:int32 4]))
 (real (/ [:int32 1] [:int32 2]))
 (/ (real [:int32 1]) (real [:int32 2]))
 (int (* [:real64 "2.5"] [:real64 "4.0"]))
 ;; the processor's to decide: {:undefined expr} says the oracle must answer
 ;; undefined (and so must an implementation: clotran throws). Any other
 ;; case must answer a value, or the check fails.
 {:undefined (+ [:int32 2147483647] [:int32 1])}
 {:undefined (* [:int64 4611686018427387904] [:int64 2])}
 {:undefined (- [:int8 -128] [:int8 1])}
 {:undefined (abs [:int8 -128])}
 {:undefined (/ [:int32 1] [:int32 0])}
 {:undefined (mod [:int32 1] [:int32 0])}
 {:undefined (int [:real64 "1.0e30"])}
 {:undefined (int [:int64 300] :int8)}
 {:undefined (** [:real64 "2.0"] [:int32 3])}
 {:undefined (** [:int32 0] [:int32 -2])}
 {:undefined (sqrt [:real64 "-1.0"])}
]
