(ns blas
  "The reference BLAS (netlib, vendored unmodified in src/f/blas) as a
  clotran package: packages/blas/libblas behind the door
  (src/f/DynLoad.f90), its shims and manifest generated from the F77
  sources by clotran bind. blas.raw/dgemm is DGEMM as netlib declares it,
  thirteen positional arguments, its matrices assumed-size (A(LDA,*)):
  their sizes are DGEMM's to trust, not the declaration's to check. This
  namespace is the API, and checks the shapes before the call.")

(defn- shape-of [x] (when (and (some? x) (some? (.getComponentType (class x))) (= "real8" (fortran/array-kind x))) (fortran/array-shape x)))

(defn- got [x]
  (if-let [sh (and (some? x) (some? (.getComponentType (class x))) (fortran/array-shape x))]
    (let [k (fortran/array-kind x)] (str (if (re-find #"^[aeiou]" k) "an " "a ") k " array of " (clojure.string/join " by " sh)))
    (cond (nil? x) "nil" (map? x) "a map" (vector? x) "a vector" :else (pr-str x))))

(defn- refuse [msg] (throw (clotran.host.illegal_argument_exception. (str "dgemm: " msg))))

(defn dgemm
  "C = A x B for two real8 rank-2 arrays, a m by k and b k by n; a new
  real8 array, m by n. Refuses shapes that do not agree before DGEMM
  runs, as the routine itself would not."
  [a b]
  (let [[m k :as sa] (shape-of a)
        [k2 n :as sb] (shape-of b)]
    (when-not (= 2 (count sa))
      (refuse (str "a is a real8 array of m by k -- pass one, as (fortran/make-array \"real8\" m k) makes; got " (got a))))
    (when-not (and (= 2 (count sb)) (= k k2))
      (refuse (str "b is a real8 array of k by n, k = " k " (a's columns) -- pass a real8 array of " k
                   " by n, as (fortran/make-array \"real8\" " k " n) makes; got " (got b))))
    (let [c (fortran/make-array "real8" m n)]
      (blas.raw/dgemm "N" "N" m n k 1.0 a m b k 0.0 c m)
      c)))
