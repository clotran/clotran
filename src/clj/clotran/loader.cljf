(ns clotran.loader
  "Installs a compiled namespace over the one its source just defined.

  Clojure's RT.load prefers a class file sitting beside the source when
  the class is newer; clotran's compiled artifact is a shared library
  sitting beside the source, `foo.cljf` and `foo.dylib` (or `.so`), and
  `load` calls `install` here when there is one. The source is still
  loaded first -- its macros, its defs that are not functions, and the
  functions the compiler declined all come from it -- and the library
  then replaces the functions it compiled.

  THE POOL IS REBUILT, not read, by the host's own walk (Eval.f90,
  compiled_pool), which the compiler also takes its pool from. A procedure's constants -- Vars,
  collections, the functions analysis folded into call heads, whole
  subtrees handed to the interpreter -- are live objects, and no file
  can hold them. Analysis is deterministic, so analysing the same form
  in the same namespace hands back the same pool in the same order.
  Two checks make \"the same\" true rather than hoped for:

  - the manifest carries a hash of the source, and a library built
    from other text is not installed;
  - each function carries a FINGERPRINT of its analysed tree, and a
    tree that analyses differently now -- a macro in another namespace
    changed, a Var went away -- is not installed either.

  A library that fails either check is reported and left alone; the
  interpreted definitions stand. Loading this namespace is cheap on
  purpose: it is the part of the compiler every run needs, and only
  that part."
  (:require [clojure.string :as str]))

;;; ---- one function, analysed ---------------------------------------

(defn fn-form
  "The (fn ...) a top-level defn defines, with a single arity written
  as Clojure writes fn: `(fn [x] body)`, its hints where they were. A
  defn whose value is not a fn form answers nil."
  [defn-form]
  (let [[_ _ f] (macroexpand defn-form)]
    (when (and (seq? f) (= 'fn (symbol (name (first f)))))
      (let [arities (rest f)]
        (if (and (= 1 (count arities)) (seq? (first arities)) (vector? (ffirst arities)))
          (list* 'fn (first arities))
          f)))))

(defn print-form
  "A form as text that reads back with its hints: *print-meta* keeps
  ^long and ^doubles, which the compiler reads."
  [form]
  (binding [*print-meta* true] (pr-str form)))

(defn- entries
  "The host's pool as the compiler keys it: [kind value] pairs, one per
  entry the generated code reads (Eval.f90, compiled_pool)."
  [pool]
  (mapv (fn [[k v]] {:kind k :value v}) pool))

(defn analyse
  "The analysed (fn ...) `form`, in the current namespace, as the
  compiler needs it: {:tmpl the fn's template, or nil when the form is
  not a fn; :pool; :fingerprint}. The pool and the fingerprint come from
  the host, which is also where `pool-of` below gets them, so the two
  cannot disagree."
  [form]
  (let [top (clotran-ast form)
        fnode (:p1 top)]
    {:tmpl (when (= :fn (:op fnode)) (:p1 fnode))
     :pool (entries (:pool top))
     :fingerprint (:fingerprint top)}))

(defn pool-of
  "The pool and fingerprint of `form` without exporting its tree: what
  installing needs, at a small part of clotran-ast's cost."
  [form]
  (let [r (clotran-ast-pool form)]
    {:pool (entries (:pool r)) :fingerprint (:fingerprint r)}))

;;; ---- installing ------------------------------------------------------

(def abi
  "The version of the runtime entries generated code calls (ClotranABI).
  A library built against another is refused rather than loaded: its
  calls would pass arguments where the entries no longer expect them.
  Bump it with any change to those entries' arguments."
  2)

(defn defined-in?
  "Whether Var `v` was last defined by the file `src`, by its :file
  metadata. The two may be spelled differently -- relative at one
  load, absolute at another -- so the shorter must end the longer."
  [v src]
  (let [f (:file (meta v))]
    (boolean (and (string? f) (or (str/ends-with? src f) (str/ends-with? f src))))))

(defn- install-extends
  "The compiled fns of a file's protocol extensions -- each defined by the
  library under a hidden name in clotran.extends -- into their protocols'
  method maps, where the source's extends put the interpreted ones.
  `extend` REPLACES a type's whole map, so each type's is taken as it
  stands and only the compiled methods are swapped in; a method the
  source no longer extends for that type is left alone."
  [ns extends]
  (binding [*ns* (the-ns (symbol ns))]
    (doseq [[[proto-form type-form] xs] (group-by (juxt :proto :type) extends)]
      (let [proto-var (resolve (read-string proto-form))
            t (eval (read-string type-form))
            impls (get-in @proto-var [:impls t])
            compiled (into {} (for [x xs
                                    :let [f @(find-var (symbol "clotran.extends" (:name x)))]
                                    :when (contains? impls (:method x))]
                                [(:method x) f]))]
        (when (seq compiled)
          (extend t @proto-var (merge impls compiled)))))))

(defn install
  "Install the compiled library `lib` built from the source file `src`.
  True when it is installed; nil, with a note saying why, when it is
  not."
  [lib src]
  (let [{:keys [ns source-hash fns extends] :as manifest} (clotran-library-manifest lib)
        note (fn [why] (println (str "note: not using " lib ": " why)) nil)
        all (into (vec fns) extends)]
    (cond
      (not= abi (:abi manifest))
      (note (str "it was built for another clotran (runtime ABI " (:abi manifest 1) ", this is " abi "); recompile it"))
      (not= source-hash (hash (clotran-slurp src)))
      (note (str src " has changed since it was compiled; recompile it"))
      :else
      (let [built (binding [*ns* (the-ns (symbol ns))]
                    (mapv #(pool-of (read-string (:form %))) all))
            stale (keep (fn [[f b]] (when (not= (:fingerprint f) (:fingerprint b)) (:name f)))
                        (map vector all built))]
        (if (seq stale)
          (note (str "these analyse differently now: " (str/join ", " stale) "; recompile it"))
          ;; A Var some other file defined since -- a later load
          ;; redefining a core function -- keeps what that file gave it:
          ;; the library installs every function, and those are put back.
          (let [vars (map #(ns-resolve (symbol ns) (symbol (:name %))) fns)
                keep (into {} (for [v vars :when (not (defined-in? v src))] [v @v]))]
            (clotran-load-compiled lib (clotran-pool-register (vec (mapcat #(map :value (:pool %)) built))))
            (doseq [[v old] keep] (alter-var-root v (constantly old)))
            (install-extends ns extends)
            true))))))

;;; ---- compiling what is loaded: a cache, and background builds ------
;;
;; With CLOTRAN_AUTOCOMPILE=1 (the ./clotran launcher sets it) every
;; file that loads is also compiled, in a separate process, into a cache;
;; the next load of the same text installs the library, and so does the
;; running session when the build finishes (poll, at each REPL prompt
;; and each load). Editing a file makes its library stale -- the source
;; hash is in the name -- so a namespace being worked on is loaded
;; interpreted, compiled in the background, and picked up when the
;; build is done, without a restart. CLOTRAN_AUTOCOMPILE=use installs
;; from the cache but starts nothing (the compiling process itself);
;; unset, nothing here runs.
;;
;; A library is named by the source's hash and a nonce, never reused:
;; a process cannot load a second library from a path it has loaded,
;; and a library it refused was still opened to read its manifest. A
;; pointer file, KEY-HASH.ptr, names the current one ("none": nothing
;; in the file compiles).

(defonce ^:private builds (atom {}))   ; src -> {:state :lib :hash :log}

(defn- mode [] (clotran.host.system/getenv "CLOTRAN_AUTOCOMPILE"))

(defn- cache-dir []
  (or (clotran.host.system/getenv "CLOTRAN_CACHE") (str (clotran.host.system/getenv "HOME") "/.cache/clotran")))

(def ^:private ext
  (delay (if (zero? (clotran-sh "[ \"$(uname -s)\" = Darwin ]")) "dylib" "so")))

(defn- q
  "`s` quoted for /bin/sh."
  [s]
  (str "'" (str/replace s "'" "'\\''") "'"))

(defn- key-of [src] (str/replace src #"[^A-Za-z0-9._-]" "_"))

(defn- hash-of
  "What names a file's cached library: its text, and the runtime ABI, so a
  clotran with other entries builds its own."
  [src]
  (str/replace (str (hash [abi (clotran-slurp src)])) "-" "m"))

(defn- ptr-path [src h] (str (cache-dir) "/" (key-of src) "-" h ".ptr"))

(defn- current
  "The cached library for this text of `src`: its path, :none, or nil."
  [src h]
  (let [p (ptr-path src h)]
    (when (clotran-file-exists? p)
      (let [t (str/trim (clotran-slurp p))]
        (cond (= t "none") :none
              (clotran-file-exists? t) t)))))

(defn- start!
  "A build of `src` as it is now, in the background unless `wait?`; the
  file's old libraries are removed when it succeeds."
  [src h & [wait?]]
  (let [dir (cache-dir)
        k (key-of src)
        lib (str dir "/" k "-" h "-" (clotran.host.system/nanoTime) "." @ext)
        log (str dir "/" k "-" h ".log")
        ptr (ptr-path src h)
        cmd (str "mkdir -p " (q dir) " && "
                 "CLOTRAN_AUTOCOMPILE=use " (q (str (clotran.host.system/getProperty "clotran.home") "/clotran"))
                 " compile " (q src) " " (q lib) " > " (q log) " 2>&1; "
                 "if [ -f " (q lib) " ]; then "
                 "printf %s " (q lib) " > " (q (str ptr ".part")) " && mv -f " (q (str ptr ".part")) " " (q ptr) "; "
                 "for f in " (q dir) "/" (q k) "-*; do "
                 "[ \"$f\" = " (q lib) " ] || [ \"$f\" = " (q ptr) " ] || [ \"$f\" = " (q log) " ] || rm -f \"$f\"; done; "
                 "elif grep -q 'no Fortran was written' " (q log) "; then printf none > " (q ptr) "; fi; "
                 ": > " (q (str lib ".done")))]
    (swap! builds assoc src {:state :compiling :lib lib :hash h :log log})
    (clotran-sh cmd (boolean wait?))
    lib))

(defn- one-name
  "The file's one absolute name: src/a.cljf, ./src/a.cljf and the
  absolute path are one build, not three."
  [src]
  (or (clotran-real-path src) src))

(defn auto
  "After `src` loads with no library beside it: install the cached
  library for this text, or start building one."
  [src]
  (when (#{"1" "use"} (mode))
    (let [src (one-name src)
          h (hash-of src)
          lib (current src h)]
      (cond
        (= :none lib) nil
        (string? lib) (when (install lib src) (swap! builds assoc src {:state :installed :lib lib :hash h}))
        (not= "1" (mode)) nil
        (and (= :compiling (:state (@builds src))) (= h (:hash (@builds src)))) nil
        :else (do (start! src h) nil)))))

(defn- say
  "A note about a background build, printed only with
  CLOTRAN_AUTOCOMPILE_VERBOSE=1: a build finishing or failing changes nothing
  a program must act on -- it runs interpreted until then, or for good -- and
  a note appearing mid-REPL, for a library it never asked about, is noise."
  [msg]
  (when (= "1" (clotran.host.system/getenv "CLOTRAN_AUTOCOMPILE_VERBOSE")) (println msg)))

(defn poll
  "Builds that have finished since the last look: installed if the source
  is still the text they were built from, rebuilt if it is not."
  []
  (doseq [[src {:keys [state lib log] h :hash}] @builds
          :when (and (= :compiling state) (clotran-file-exists? (str lib ".done")))]
    (clotran-sh (str "rm -f " (q (str lib ".done"))))
    (cond
      (not (clotran-file-exists? lib))
      (if (= :none (current src h))
        (swap! builds assoc-in [src :state] :none)
        (do (swap! builds assoc-in [src :state] :failed)
            (say (str "note: " src " did not compile; see " log))))
      (not= h (hash-of src))
      (start! src (hash-of src))   ; edited while it built
      (install lib src)
      (do (swap! builds assoc-in [src :state] :installed)
          (say (str "note: " src " is compiled now")))
      :else (swap! builds assoc-in [src :state] :refused))))

(defn compile-now
  "Build `src` now and install it, waiting for it -- for a benchmark, or
  after a library was refused."
  [src]
  (let [src (one-name src)
        h (hash-of src)
        {:keys [state lib] bh :hash} (@builds src)]
    ;; a build of this very text already running -- the one a load started
    ;; -- is waited for: a second build shares its file names, and each
    ;; one's cleanup deleted the other's library
    (if (and (= :compiling state) (= h bh))
      (loop [n 0]
        (when (and (< n 3000) (not (clotran-file-exists? (str lib ".done"))))
          (clotran.host.thread/sleep 100)
          (recur (inc n))))
      (start! src h true)))
  (poll)
  (:state (@builds (one-name src))))

(defn compile-status
  "Each file this session loaded or built: :compiling, :installed,
  :none (nothing in it compiles), :failed, :refused."
  []
  (poll)
  (into (sorted-map) (map (fn [[src b]] [src (:state b)]) @builds)))
