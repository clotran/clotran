(ns clotran.bind
  "The shims and manifest for a package, from a library's own signatures
  (PLAN.md steps 9 and 36, src/f/DynLoad.f90): `clotran bind`.

    clotran bind --package NAME --out FILE.f90 SRC.f90 [SRC2.f90 ...]
    clotran bind [DIR]        the package DIR/package.edn declares, built
                              into the cache; prints its library's path

  Reads free-form Fortran modules, and F77 fixed form: every subroutine
  and function whose dummy arguments are declared with a type the door
  carries -- real(8) or double precision, integer or integer(4),
  integer(8), logical, character -- as scalars, explicit-shape,
  assumed-shape or assumed-size arrays. For each it writes a bind(C) shim
  taking argc C pointers (a scalar by pointer to its C type, an array by
  pointer then one int4 per extent, a string null-terminated) and
  unpacking them to the routine's positional arguments, plus one
  clotran_manifest function answering the EDN that names them all, each
  with the file and line it is declared at (an editor's go-to-definition
  reads them through the Var's metadata, clotran.package). An intent the
  source does not declare is taken as :inout, which is safe and costs a
  key in the answer map -- except for an ARRAY the body provably never
  writes (`never-written?`), which is :in: the door's alias check (PLAN
  step 27) refuses an array that may be written and is bound twice, and
  BLAS's dgemm(a, a) must not be refused because F77 has no intent
  statement.

  What it does not bind, it lists in a comment at the top of the output
  rather than guessing: derived types, optional, pointer and allocatable
  dummies, procedure arguments, kinds it does not carry. `routines` is the
  parser on its own -- every routine a file declares, bound or not, with
  its position -- for the index and the language server (step 36), so the
  editor's view of a routine and the shim that calls it come from one
  parse.

  A package.edn is the static declaration of a package:

    {:name \"mylib\" :sources [\"mylib.f90\"]}

  Everything derived from the sources -- the shims, the manifest, the
  library -- is one build output in the cache (clotran.cache), keyed by
  the sources' hash, so a position can never disagree with the code: edit
  the Fortran and the next load builds again. (fortran/load-package DIR)
  on such a directory builds it when it must."
  (:require [clojure.string :as str]
            [clotran.cache :as cache]
            [clotran.loader :as loader]
            [clotran.profile :as profile]))

;; bumped when the shims or the manifest change shape: a library built by
;; an older generator is built again
(def generator-version 2)

;; the C kind each type crosses as (DynLoad's pointers point at these);
;; int8 is c_int64_t, not c_long, which is 4 bytes on Windows
(def ^:private kinds {"real8" "real(c_double)" "int4" "integer(c_int)" "int8" "integer(c_int64_t)" "logical" "logical(c_bool)"})

;; A scalar logical crosses as one C byte, logical(c_bool), but a
;; routine declares its own kind -- default logical is 4 bytes -- so the
;; shim copies through a temporary of the DECLARED kind, back again
;; unless the intent is in. Passing the byte straight on was a type
;; mismatch the compiler refused (test/f/samplelib echo_kinds).
(defn- copied-logical? [a] (and (= "logical" (:type a)) (zero? (:rank a))))

(defn fixed-form? [path] (boolean (re-find #"(?i)\.(f|for|f77)$" path)))

(defn- fixed-to-free
  "Fixed-form source as [line text] statements: a C, c, * or ! in column 1
  is a comment, a non-blank column 6 continues the line above, columns
  7-72 carry the statement. A statement keeps the line it starts on."
  [src]
  (let [ls (->> (map-indexed (fn [i l] [(inc i) l]) (str/split-lines src))
                (remove (fn [[_ l]] (re-find #"^[Cc*!]" l)))
                (remove (fn [[_ l]] (str/blank? l)))
                (map (fn [[n l]] (let [l (if (> (count l) 72) (subs l 0 72) l)
                                       cont (and (>= (count l) 6) (not (str/blank? (subs l 5 6))))
                                       body (if (>= (count l) 7) (subs l 6) "")]
                                   [n cont body]))))]
    (loop [ls ls acc []]
      (if (empty? ls) acc
        (let [[n cont body] (first ls)]
          (if (and cont (seq acc))
            (recur (rest ls) (conj (pop acc) (update (peek acc) 1 str body)))
            (recur (rest ls) (conj acc [n body]))))))))

(defn- statements
  "The source as [line text] statements: comments off, continuation lines
  joined, lower-cased, each with the line it starts on."
  [src path]
  (let [lines (if (and path (fixed-form? path))
                (fixed-to-free src)
                (map-indexed (fn [i l] [(inc i) (str/replace l #"!.*$" "")]) (str/split-lines src)))
        joined (loop [ls lines acc [] cur nil]
                 (if (empty? ls)
                   (if cur (conj acc cur) acc)
                   (let [[n l] (first ls)
                         l (str/trimr l)
                         l (str/replace l #"^\s*&" "")]
                     (if (str/ends-with? l "&")
                       (recur (rest ls) acc [(or (first cur) n) (str (second cur) (subs l 0 (dec (count l))))])
                       (recur (rest ls) (conj acc [(or (first cur) n) (str (second cur) l)]) nil)))))]
    (mapv (fn [[n l]] [n (str/lower-case (str/trim l))]) joined)))

(defn- split-args [s] (when-not (str/blank? s) (map str/trim (str/split s #","))))

;; "real(8), intent(in) :: a(n), b" -> [{:type "real8" :intent "in"} ["a(n)" "b"]]
(def ^:private f77-type #"^(double\s*precision|real\*8|real\*4|real|integer\*8|integer\*4|integer\*2|integer|logical|character\*\(\*\)|character\*\d+|character)\s+([a-z_].*)$")

(defn- parse-decl [l]
  (when-let [[_ spec names] (or (re-matches #"^(.*?)\s*::\s*(.*)$" l)
                                (when-not (re-find #"::|\bfunction\b|\bsubroutine\b|^(external|intrinsic|parameter|data|save|common|implicit|dimension)\b" l)
                                  (when-let [[_ ty names] (re-matches f77-type l)] [nil ty names])))]
    (let [spec (str/replace spec #"\s+" "")
          type (cond (re-find #"^(real\(8\)|real\(kind=8\)|doubleprecision|real\*8|real\(c_double\)|real\(dp\))" spec) "real8"
                     (re-find #"^(integer\(8\)|integer\(kind=8\)|integer\*8|integer\(c_long\))" spec) "int8"
                     (re-find #"^(integer\(4\)|integer\(kind=4\)|integer\*4|integer\(c_int\)|integer)(?![(\w*])" spec) "int4"
                     (re-find #"^logical" spec) "logical"
                     (re-find #"^character" spec) "string"
                     :else nil)
          intent (second (re-find #"intent\((in|out|inout)\)" spec))
          unbindable (cond (re-find #"^type\(" spec) "derived type"
                           (re-find #",optional" spec) "optional"
                           (re-find #",pointer" spec) "pointer"
                           (re-find #",allocatable" spec) "allocatable"
                           (re-find #"^procedure" spec) "procedure argument"
                           (nil? type) (str "kind " spec)
                           :else nil)
          dim (second (re-find #"dimension\(([^)]*)\)" spec))
          ;; split names on commas outside parentheses
          names (loop [cs (seq names) depth 0 cur "" out []]
                  (if (empty? cs) (map str/trim (remove str/blank? (conj out cur)))
                    (let [c (first cs)]
                      (cond (= c \() (recur (rest cs) (inc depth) (str cur c) out)
                            (= c \)) (recur (rest cs) (dec depth) (str cur c) out)
                            (and (= c \,) (zero? depth)) (recur (rest cs) depth "" (conj out cur))
                            :else (recur (rest cs) depth (str cur c) out)))))]
      [{:type type :intent intent :unbindable unbindable :dim dim :ftype (first (str/split spec #","))} names])))

(defn- rank-of [name-with-dims dim]
  (let [d (or (second (re-find #"\(([^)]*)\)" name-with-dims)) dim)]
    (if d (inc (count (re-seq #"," d))) 0)))

(defn- bare-name [n] (str/replace n #"\(.*$" ""))

;; Calls that read their arguments and write none of them: Fortran's
;; intrinsics, and the statements that look like calls.
(def ^:private reads-only
  #{"if" "while" "abs" "dabs" "max" "min" "dmax1" "dmin1" "sqrt" "dsqrt" "dble" "real" "int"
    "nint" "mod" "sign" "dsign" "exp" "dexp" "log" "dlog" "sin" "cos" "tan" "atan" "atan2"
    "size" "len" "len_trim" "lbound" "ubound" "sum" "product" "maxval" "minval" "dot_product"})

(defn- enclosing-call
  "The name before the parenthesis that encloses position i of l, or nil
  at the top level."
  [l i]
  (loop [j (dec i) depth 0]
    (cond (neg? j) nil
          (= \) (.charAt l j)) (recur (dec j) (inc depth))
          (= \( (.charAt l j)) (if (zero? depth)
                                  (second (re-find #"(\w+)\s*$" (subs l 0 j)))
                                  (recur (dec j) (dec depth)))
          :else (recur (dec j) depth))))

(defn- never-written?
  "True only when the routine's executable lines cannot write array p:
  every use is subscripted, none is assigned, read, passed in a CALL, or
  passed to anything but an intrinsic or another array of this routine.
  Conservative: what it cannot prove read-only it calls written."
  [p lines arrays]
  (let [word (re-pattern (str "\\b" p "\\b"))]
    (every?
     (fn [l]
       (or (not (re-find word l))
           (and (not (re-find #"^(\d+\s+)?(call|read)\b" l))
                (not (re-find (re-pattern (str "(^|[^\\w%])" p "\\s*(\\([^=]*\\))?\\s*=(?!=)")) l))
                (let [m (re-matcher word l)]
                  (loop []
                    (if-not (.find m) true
                      (let [i (.start m) after (subs l (.end m))
                            enc (enclosing-call l i)]
                        (and (re-find #"^\s*\(" after)
                             (or (nil? enc) (contains? reads-only enc) (contains? arrays enc))
                             (recur)))))))))
     lines)))

(defn routines
  "The routines a Fortran source declares, bound or not:
  [{:module m :name n :kind :subroutine|:function :file path :line l
    :args [{:name :type :intent :rank ...}] :rspec r} ...], each at the
  line its declaration starts on. The parser the shims, the index and the
  language server share."
  [src path]
  (let [ls (statements src path)
        text (fn [i] (second (ls i)))
        module (some #(second (re-matches #"^module\s+(\w+)$" (second %))) ls)]
    (loop [i 0 out []]
      (if (>= i (count ls)) out
        (let [l (text i)
              m (or (when-let [[_ n a] (re-matches #"^(?:recursive\s+|pure\s+|elemental\s+)*subroutine\s+(\w+)\s*\(([^)]*)\)\s*$" l)] {:kind :subroutine :name n :params (split-args a)})
                    (when-let [[_ t n a r] (re-matches #"^(?:(.*?)\s+)?function\s+(\w+)\s*\(([^)]*)\)\s*(?:result\s*\((\w+)\))?\s*$" l)]
                      (when-not (re-find #"^end" l) {:kind :function :name n :params (split-args a) :result (or r n) :rtype-spec t})))]
          (if-not m (recur (inc i) out)
            ;; the body up to end subroutine/function: collect declarations of the dummies
            (let [end (loop [j (inc i)] (if (or (>= j (count ls)) (re-matches (re-pattern (str "^end\\s*(" (name (:kind m)) ")?\\s*(" (:name m) ")?\\s*$")) (text j))) j (recur (inc j))))
                  body-lines (map second (subvec ls (inc i) (min end (count ls))))
                  decls (keep parse-decl body-lines)
                  wanted (set (map str/lower-case (concat (:params m) (when (= :function (:kind m)) [(:result m)]))))
                  info (reduce (fn [acc [spec names]]
                                 (reduce (fn [acc n] (let [b (bare-name n)] (if (contains? wanted b) (assoc acc b (assoc spec :rank (rank-of n (:dim spec)) :dims (or (second (re-find #"\(([^)]*)\)" n)) (:dim spec)))) acc))) acc names))
                               {} decls)
                  rspec (when (= :function (:kind m))
                          (or (get info (:result m))
                              (when-let [[spec _] (and (:rtype-spec m) (parse-decl (str (:rtype-spec m) " :: " (:result m))))] (assoc spec :rank 0))))
                  args (mapv (fn [p] (merge {:name p :rank 0} (get info p {:unbindable "undeclared"}))) (:params m))
                  body (remove parse-decl body-lines)
                  arrays (set (map :name (filter #(pos? (:rank %)) args)))
                  args (mapv (fn [a] (if (and (nil? (:intent a)) (pos? (:rank a)) (never-written? (:name a) body arrays))
                                       (assoc a :intent "in") a))
                             args)]
              (recur end (conj out (assoc m :module module :file path :line (first (ls i)) :args args :rspec rspec))))))))))

(defn bindable? [r]
  (and (every? #(and (nil? (:unbindable %)) (:type %)) (:args r))
       (or (= :subroutine (:kind r)) (and (:rspec r) (nil? (:unbindable (:rspec r))) (not= "string" (:type (:rspec r))) (zero? (:rank (:rspec r)))))
       (not-any? #(and (= "string" (:type %)) (pos? (:rank %))) (:args r))
       (not-any? #(and (= "string" (:type %)) (= "out" (:intent %))) (:args r))))

(defn edn-name "A Fortran name as clotran spells it: scale_by is scale-by." [n] (str/replace n "_" "-"))

(defn- ftype-decl [a]
  (let [ft (case (:type a) "real8" "double precision" "int4" "integer" "int8" "integer(8)" "logical" "logical" "string" "character(len=*)")]
    (str "       " ft " :: " (:name a) (when (pos? (:rank a)) (str "(" (or (:dims a) (str/join "," (repeat (:rank a) "*"))) ")")))))

(defn- interface-of [r]
  ;; scalars first, so an array's dims may name them
  (let [[scalars arrays] ((juxt filter remove) #(zero? (:rank %)) (:args r))
        head (if (= :function (:kind r))
               (str "     function " (:name r) "(" (str/join ", " (map :name (:args r))) ")" (when (not= (:result r) (:name r)) (str " result(" (:result r) ")")) "\n")
               (str "     subroutine " (:name r) "(" (str/join ", " (map :name (:args r))) ")\n"))]
    (str head
         (str/join "\n" (map ftype-decl (concat scalars arrays))) "\n"
         (when (= :function (:kind r)) (str (ftype-decl (assoc (:rspec r) :name (:result r) :rank 0)) "\n"))
         "     end " (name (:kind r)) " " (:name r) "\n")))

(defn manifest
  "The EDN a package's clotran_manifest answers: its name, and each bound
  routine with its shim's symbol, arguments, result, and where it is
  declared."
  [pkg rs]
  (str "{:package \"" pkg ".raw\" :routines ["
       (str/join " "
         (for [r rs]
           (str "{:name \"" (edn-name (:name r)) "\" :symbol \"" pkg "_" (:name r) "_shim\" :args ["
                (str/join " " (for [a (:args r)] (str "{:name \"" (edn-name (:name a)) "\" :type :" (:type a) " :intent :" (or (:intent a) (if (= "string" (:type a)) "in" "inout")) " :rank " (:rank a) "}")))
                "]" (when (:rspec r) (str " :returns :" (:type (:rspec r))))
                (when (:module r) (str " :module \"" (:module r) "\""))
                (when (:file r) (str " :file " (pr-str (:file r)) " :line " (:line r)))
                "}")))
       "]}"))

(defn- fortran-string-lines [s]
  ;; the EDN as a Fortran character parameter, in pieces a free-form line can hold
  (let [pieces (map #(apply str %) (partition-all 90 s))]
    (str/join " // &\n       " (map #(str "'" (str/replace % "'" "''") "'") pieces))))

(defn- shim [pkg r]
  (let [args (:args r)
        ;; argv slots: a scalar one, an array one plus its rank, then the result
        slots (loop [as args k 1 out []] (if (empty? as) out (let [a (first as)] (recur (rest as) (+ k 1 (:rank a)) (conj out (assoc a :slot k))))))
        rslot (inc (reduce + (count args) (map :rank args)))
        decl (fn [a] (cond
                       (= "string" (:type a)) nil
                       (copied-logical? a) (str "    logical(c_bool), pointer :: " (:name a) "_c\n    " (:ftype a) " :: " (:name a))
                       :else (str "    " (kinds (:type a)) ", pointer :: " (:name a) (when (pos? (:rank a)) (str "(" (str/join "," (repeat (:rank a) ":")) ")")))))
        ext-decl (fn [a] (when (pos? (:rank a)) (str "    integer(c_int), pointer :: " (str/join ", " (for [d (range (:rank a))] (str "n" (:name a) "_" (inc d)))))))
        unpack (fn [a] (if (= "string" (:type a))
                         (str "    call cstr(argv(" (:slot a) "), s_" (:name a) ")")
                         (if (zero? (:rank a))
                           (if (copied-logical? a)
                             (str "    call c_f_pointer(argv(" (:slot a) "), " (:name a) "_c)\n    " (:name a) " = " (:name a) "_c")
                             (str "    call c_f_pointer(argv(" (:slot a) "), " (:name a) ")"))
                           (str (str/join "\n" (for [d (range (:rank a))] (str "    call c_f_pointer(argv(" (+ (:slot a) 1 d) "), n" (:name a) "_" (inc d) ")")))
                                "\n    call c_f_pointer(argv(" (:slot a) "), " (:name a) ", [" (str/join ", " (for [d (range (:rank a))] (str "n" (:name a) "_" (inc d)))) "])"))))
        call-args (str/join ", " (for [a args] (if (= "string" (:type a)) (str "s_" (:name a)) (:name a))))
        strings (filter #(= "string" (:type %)) args)]
    (str "  subroutine " pkg "_" (:name r) "_shim(argc, argv) bind(C, name=\"" pkg "_" (:name r) "_shim\")\n"
         "    integer(c_int), value :: argc\n    type(c_ptr), dimension(*) :: argv\n"
         (str/join "\n" (remove nil? (concat (map decl args) (map ext-decl args))))
         (when (seq strings) (str "\n    character(len=:), allocatable :: " (str/join ", " (map #(str "s_" (:name %)) strings))))
         (when (:rspec r) (str "\n    " (kinds (:type (:rspec r))) ", pointer :: result_"))
         "\n" (str/join "\n" (map unpack slots))
         (if (:rspec r)
           (str "\n    call c_f_pointer(argv(" rslot "), result_)\n    result_ = " (:name r) "(" call-args ")")
           (str "\n    call " (:name r) "(" call-args ")"))
         (str/join (for [a args :when (and (copied-logical? a) (not= "in" (:intent a)))]
                     (str "\n    " (:name a) "_c = " (:name a))))
         "\n  end subroutine " pkg "_" (:name r) "_shim\n")))

(defn generate
  "The Fortran of a package's binding: the manifest and one shim per bound
  routine of rs, the routines of srcs (named in the header)."
  [pkg rs srcs]
  (let [ok (filter bindable? rs)
        skipped (remove bindable? rs)
        modules (distinct (keep :module ok))]
    (str "! GENERATED by clotran bind for package " pkg " from " (str/join ", " srcs) ".\n"
         "! The manifest and one shim per routine (src/f/DynLoad.f90). Do not edit;\n! regenerate.\n"
         (when (seq skipped) (str "! Not bound: " (str/join "; " (for [r skipped] (str (:name r) " (" (str/join ", " (distinct (keep (fn [a] (or (:unbindable a) (when (and (= "string" (:type a)) (pos? (:rank a))) "character array"))) (conj (vec (:args r)) (:rspec r))))) ")"))) "\n"))
         "module " pkg "_pkg\n  use iso_c_binding\n"
         (str/join "\n" (for [m modules] (str "  use " m ", only: " (str/join ", " (map :name (filter #(= m (:module %)) ok))))))
         "\n  implicit none\n"
         (let [ext (remove :module ok)]
           (when (seq ext)
             (str "  ! routines outside any module, as F77 writes them: their interfaces, from their declarations\n  interface\n"
                  (str/join "\n" (map interface-of ext))
                  "  end interface\n")))
         "  character(kind=c_char, len=*), parameter :: manifest = &\n       " (fortran-string-lines (manifest pkg ok)) " // c_null_char\n"
         "  ! filled at the first call, not initialised: flang will not fold transfer of a long string\n  character(kind=c_char), allocatable, target, save :: manifest_buf(:)\n"
         "contains\n"
         "  function clotran_manifest() bind(C, name=\"clotran_manifest\") result(p)\n    type(c_ptr) :: p\n    integer :: i\n    if (.not. allocated(manifest_buf)) then\n       allocate(manifest_buf(len(manifest)))\n       do i = 1, len(manifest)\n          manifest_buf(i) = manifest(i:i)\n       end do\n    end if\n    p = c_loc(manifest_buf)\n  end function clotran_manifest\n\n"
         "  ! a null-terminated string as Fortran text\n  ! a subroutine: gfortran keeps a function's deferred result length in a\n  ! static shared by every thread (scripts/no-static-slen)\n  subroutine cstr(p, s)\n    type(c_ptr), intent(in) :: p\n    character(len=:), allocatable, intent(out) :: s\n    character(kind=c_char), pointer :: c(:)\n    integer :: n\n    call c_f_pointer(p, c, [huge(0)])\n    n = 0\n    do while (c(n + 1) /= c_null_char)\n       n = n + 1\n    end do\n    allocate(character(len=n) :: s)\n    do n = 1, len(s)\n       s(n:n) = c(n)\n    end do\n  end subroutine cstr\n\n"
         (str/join "\n" (map #(shim pkg %) ok))
         "end module " pkg "_pkg\n")))

(defn- read-routines [srcs] (vec (mapcat (fn [f] (routines (clotran-slurp f) f)) srcs)))

(defn write-binding
  "`clotran bind --package NAME --out FILE.f90 SRC...`: FILE.f90 written."
  [pkg out srcs]
  (clotran-spit out (generate pkg (read-routines srcs) srcs))
  (println "wrote" out "for" pkg "from" (str/join ", " srcs)))

;; ---- a package declared by package.edn, built into the cache -------------

(def ^:private windows? (str/starts-with? (str (clotran.host.system/getProperty "os.name")) "Windows"))
(def ^:private ext
  (delay (let [os (str (clotran.host.system/getProperty "os.name"))]
           (cond (str/starts-with? os "Mac") "dylib" (str/starts-with? os "Windows") "dll" :else "so"))))
(def ^:private sep (clotran.host.system/getProperty "path.separator"))
(defn- getenv [k] (let [v (clotran.host.system/getenv k)] (when-not (str/blank? v) v)))
(defn- absolute? [p] (boolean (re-find #"^(/|[A-Za-z]:[/\\])" p)))
(defn- absolute [p] (if (absolute? p) p (str (clotran.host.system/getProperty "user.dir") "/" p)))

(defn- on-path?
  "The name a command has where PATH finds it, or nil."
  [cmd]
  (some (fn [d] (some #(when (= :file (clotran-file-kind %)) %)
                      (if windows? [(str d "/" cmd ".exe") (str d "/" cmd)] [(str d "/" cmd)])))
        (str/split (or (getenv "PATH") "") (re-pattern (str "\\" sep)))))

(defn fortran-compiler
  "FC if set; else gfortran on PATH; else the compiler this clotran was
  built with, by absolute path (build/fc) -- a PATH without Homebrew's
  directory, as an Emacs started from the Dock has, finds no gfortran."
  []
  (or (getenv "FC")
      (when (on-path? "gfortran") "gfortran")
      (let [f (str (clotran.host.system/getProperty "clotran.home") "/build/fc")]
        (when (clotran-file-exists? f)
          (let [fc (str/trim (clotran-slurp f))] (when (clotran-file-exists? fc) fc))))
      "gfortran"))

(defn- fail [msg data] (throw (ex-info (str "clotran bind: " msg) data)))

(defn read-package
  "DIR/package.edn, checked: {:name \"mylib\" :sources [\"mylib.f90\" ...]},
  the name a Fortran name (it prefixes the shims' module), every source a
  file under DIR."
  [dir]
  (let [f (str dir "/package.edn")
        _ (when-not (clotran-file-exists? f) (fail (str "no package.edn in " dir) {:dir dir}))
        m (try (read-string (clotran-slurp f))
               (catch clotran.host.exception e (fail (str f ": " (ex-message e)) {:file f})))]
    (when-not (map? m) (fail (str f ": a package.edn is a map") {:file f}))
    (when-not (and (string? (:name m)) (re-matches #"[A-Za-z][A-Za-z0-9_]*" (:name m)))
      (fail (str f ": :name must be a Fortran name, letters, digits and _") {:file f}))
    (when-not (and (vector? (:sources m)) (seq (:sources m)) (every? string? (:sources m)))
      (fail (str f ": :sources must be a vector of Fortran files") {:file f}))
    (doseq [s (:sources m) :when (not (clotran-file-exists? (str dir "/" s)))]
      (fail (str f ": source " s " is not there") {:file f :source s}))
    m))

(defn build
  "The package DIR/package.edn declares, built into the cache unless the
  same sources were built before: its library's path. The shims
  (NAME_bind.f90), the manifest as EDN (manifest.edn) and the library sit
  together in one directory named by the sources' hash, so none of them
  can be stale against the others; the manifest's :file names each source
  relative to DIR."
  [dir & {:keys [force?]}]
  (let [{:keys [name sources]} (read-package dir)
        dir (absolute dir)
        srcs (mapv #(str dir "/" %) sources)
        texts (mapv clotran-slurp srcs)
        h (str/replace (str (hash [generator-version loader/abi (profile/profile) sources texts])) "-" "m")
        out (str (cache/build-dir loader/abi) "/pkg/" name "-" h)
        lib (str out "/lib" name "." @ext)]
    (when (or force? (not (clotran-file-exists? lib)))
      (clotran-mkdirs out)
      (let [rs (vec (mapcat (fn [s rel] (routines (clotran-slurp s) rel)) srcs sources))
            shims (str out "/" name "_bind.f90")
            fc (fortran-compiler)
            log (str out "/build.log")]
        (clotran-spit shims (generate name rs sources))
        (clotran-spit (str out "/manifest.edn") (manifest name (filter bindable? rs)))
        (when-not (zero? (clotran-run (vec (concat [fc] (profile/compile-flags fc) ["-shared" "-fPIC" "-J" out]
                                                   ["-o" (str lib ".part")] srcs [shims]))
                                      out log nil true))
          (fail (str name " did not build (" fc "):\n" (clotran-slurp log)) {:dir dir :log log}))
        (clotran-rename (str lib ".part") lib)))
    lib))

(defn main
  "The `clotran bind` command: true when it did its work, :usage otherwise."
  [args]
  (let [opt (fn [k] (second (drop-while #(not= % k) args)))
        pkg (opt "--package") out (opt "--out")
        force? (some #{"--force"} args)
        rest-args (remove #{"--force"} args)]
    (cond
      (and pkg out)
      (let [srcs (->> rest-args (partition-all 2 1) (remove (fn [[a _]] (str/starts-with? a "--"))) (map first) (remove #(contains? #{pkg out} %)) (filter #(re-find #"(?i)\.(f90|f95|f03|f08|f|for|f77)$" %)))]
        (if (seq srcs) (do (write-binding pkg out srcs) true) :usage))
      (and (<= (count rest-args) 1) (not-any? #(str/starts-with? % "--") rest-args))
      (do (println (build (or (first rest-args) ".") :force? force?)) true)
      :else :usage)))
