(ns clotran.purefort
  "Tier A to pure Fortran (PLAN.md step 13): a namespace's tier-A
  functions as one ordinary Fortran module, with no clotran runtime --
  no collector, no frames, no constant pool. Any Fortran program can
  `use` it.

  TYPES. Pure Fortran needs a static type for every argument. A hinted
  parameter has one; otherwise its uses propose candidates -- an array
  for aget/aset/alength, a number otherwise -- and one version is
  emitted per combination, double and long, under one GENERIC name, so
  Fortran picks by argument type at compile time. A version that does
  not type (the division of two longs is a Ratio in Clojure) is left
  out, and says why.

  SEMANTICS are Clojure's, checked against the interpreter by
  scripts/pure-check. What Clojure throws, a pure program cannot catch:
  long overflow, a zero divisor, an index out of bounds and a cast
  out of range stop the program with Clojure's own message, as an
  uncaught exception ends a Clojure program."
  (:require [clojure.string :as str]
            [clotran.loader :as loader]
            [clotran.tiers :as tiers]))

;;; ---- the support module ----------------------------------------------

(defn- kinds-support
  "The checked procedures fortran.ops's kinds need, as support-text writes the
  others: P \"\" (nothing that can fail is pure), E `, err` in a library, ED its
  declaration, fail a failure's statements. A result the standard leaves to the
  processor -- an integer out of its kind's range, a zero divisor, a power of
  zero, a square root of a negative -- fails, as fortran.ops throws."
  [P E ED fail lib?]
  (let [chk (if lib? "          if (err%code /= 0) return\n" "")]
    (str
     (str/join
      (for [[n iso lo hi] [[1 "int8" "-128" "127"] [2 "int16" "-32768" "32767"] [4 "int32" "-2147483648" "2147483647"]]]
        (str "  " P "function cl_fit" n "(a" E ") result(r)\n"
             "    integer(int64), intent(in) :: a\n" ED
             "    integer(" iso ") :: r\n"
             "    if (a < " lo "_int64 .or. a > " hi "_int64) then\n"
             "       " (fail (str "'undefined by the standard: integer overflow (integer(" n "))'") 1) "\n"
             "    end if\n"
             "    r = int(a, " iso ")\n"
             "  end function cl_fit" n "\n")))
     "  " P "function cl_fsqrt(x" E ") result(r)\n"
     "    real(real64), intent(in) :: x\n" ED
     "    real(real64) :: r\n"
     "    if (x < 0.0_real64) then\n"
     "       " (fail "'undefined by the standard: SQRT of a negative real'" 1) "\n"
     "    end if\n"
     "    r = sqrt(x)\n"
     "  end function cl_fsqrt\n"
     (str/join
      (for [f ["mod" "modulo"]]
        (str "  " P "function cl_f" f "(a, p" E ") result(r)\n"
             "    real(real64), intent(in) :: a, p\n" ED
             "    real(real64) :: r\n"
             "    if (p == 0.0_real64) then\n"
             "       " (fail "'undefined by the standard: MOD or MODULO with a zero second argument'" 1) "\n"
             "    end if\n"
             "    r = " f "(a, p)\n"
             "  end function cl_f" f "\n")))
     ;; a ** b for integers, exactly: by squaring, checked; the squaring of the base is skipped
     ;; after the last bit, so a power that fits is not refused for a square that does not
     "  " P "function cl_ipow(a, b" E ") result(r)\n"
     "    integer(int64), intent(in) :: a, b\n" ED
     "    integer(int64) :: r, base, e\n"
     "    r = 1_int64\n"
     "    if (b < 0_int64) then\n"
     "       if (a == -1_int64) then\n"
     "          if (mod(b, 2_int64) /= 0_int64) r = -1_int64\n"
     "       else if (a == 0_int64) then\n"
     "          " (fail "'undefined by the standard: 0 raised to a negative integer power'" 1) "\n"
     "       else if (a /= 1_int64) then\n"
     "          r = 0_int64\n"
     "       end if\n"
     "       return\n"
     "    end if\n"
     "    base = a\n"
     "    e = b\n"
     "    do while (e > 0_int64)\n"
     "       if (mod(e, 2_int64) == 1_int64) then\n"
     "          r = cl_mul(r, base" E ")\n" chk
     "       end if\n"
     "       e = e / 2_int64\n"
     "       if (e > 0_int64) then\n"
     "          base = cl_mul(base, base" E ")\n" chk
     "       end if\n"
     "    end do\n"
     "  end function cl_ipow\n")))

(defn- support-text
  "The few checked operations every pure module shares, plain Fortran,
  as module `mod`. STANDALONE (lib? false): a failure is Clojure's
  exception as the program's end, error stop with its message. Nothing
  that can fail is pure, there or in a library: Fortran lets a compiler
  skip a pure function whose value is not needed, and gfortran does, so
  an unused argument that would throw did not (fuzz-build-pure,
  2026-10-18) -- Clojure evaluates every argument; each
  compiler prefixes the message its own way (gfortran ERROR STOP, flang
  Fortran ERROR STOP:). IN A LIBRARY (lib? true, PLAN step 13): nothing
  is pure, every procedure that can fail takes a trailing `err`, a
  cl_err, and a failure is recorded in it -- code and message -- which
  the generated code checks after every such call and returns on; the
  dispatcher (clotran.compiler) raises it as Clojure's exception once
  it holds the mutators again. The pure code calls nothing of the
  runtime, so it runs with the mutators released, as a foreign routine
  does, and never holds up another thread's collection."
  [lib? mod]
  (let [P ""
        E (if lib? ", err" "")
        ED (if lib? "    type(cl_err), intent(inout) :: err\n" "")
        fail (fn [msg code] (if lib?
                              (str "call cl_fail(" msg ", " code ", err)\n       return")
                              (str "call cl_fail(" msg ")")))]
    (str "module " mod "\n"
         "  use iso_fortran_env, only: int8, int16, int32, int64, real32, real64\n"
         "  implicit none
  integer, parameter :: k16 = selected_int_kind(38)
"
         (when lib?
           "  ! A failure, carried back to the dispatcher, which raises it in the
  ! running clotran (clotran_fail, with the class by code: 1 arithmetic,
  ! 2 array index out of bounds, 3 illegal argument, 4 negative array
  ! size, 5 arity, 6 string index out of bounds). Nothing here touches
  ! the runtime, so the pure code runs with the mutators released.
  type :: cl_err
     integer :: code = 0
     character(len=200) :: msg = ''
     integer :: n = 0
     ! a double in the message, written by the runtime as clj writes it
     ! (DEVIATIONS 50 is the standalone road's): the message is the text
     ! before it
     logical :: has_x = .false.
     real(real64) :: x = 0.0_real64
  end type cl_err
")
         "contains\n"
         (if lib?
           "  pure subroutine cl_fail(msg, code, err)
    character(len=*), intent(in) :: msg
    integer, intent(in) :: code
    type(cl_err), intent(inout) :: err
    err%code = code
    err%msg = msg
    err%n = min(len(msg), len(err%msg))
  end subroutine cl_fail
"
           "  subroutine cl_fail(msg)
    character(len=*), intent(in) :: msg
    error stop msg
  end subroutine cl_fail
")
         "  ! Clojure's long arithmetic throws on overflow (Numbers.add, multiply)
  " P "function cl_add(a, b" E ") result(r)
    integer(int64), intent(in) :: a, b
" ED "    integer(int64) :: r
    if ((b > 0 .and. a > huge(a) - b) .or. (b < 0 .and. a < -huge(a) - 1_int64 - b)) then
       " (fail "'long overflow'" 1) "
    end if
    r = a + b
  end function cl_add
  " P "function cl_sub(a, b" E ") result(r)
    integer(int64), intent(in) :: a, b
" ED "    integer(int64) :: r
    if ((b < 0 .and. a > huge(a) + b) .or. (b > 0 .and. a < -huge(a) - 1_int64 + b)) then
       " (fail "'long overflow'" 1) "
    end if
    r = a - b
  end function cl_sub
  " P "function cl_mul(a, b" E ") result(r)
    integer(int64), intent(in) :: a, b
" ED "    integer(int64) :: r
    integer(k16) :: p
    p = int(a, k16) * int(b, k16)
    if (p > int(huge(a), k16) .or. p < -int(huge(a), k16) - 1) then
       " (fail "'long overflow'" 1) "
    end if
    r = int(p, int64)
  end function cl_mul
  " P "function cl_neg(a" E ") result(r)
    integer(int64), intent(in) :: a
" ED "    integer(int64) :: r
    if (a == -huge(a) - 1_int64) then
       " (fail "'long overflow'" 1) "
    end if
    r = -a
  end function cl_neg
  ! Math.abs: the least long is its own absolute value (it wraps), which
  ! Fortran's abs of that constant refuses to compile
  pure function cl_abs(a) result(r)
    integer(int64), intent(in) :: a
    integer(int64) :: r
    if (a == -huge(a) - 1_int64) then
       r = a
    else
       r = abs(a)
    end if
  end function cl_abs
  ! Math.min and Math.max, which clj's min and max are: a NaN either
  ! side answers NaN, and -0.0 is less than 0.0 -- Fortran's min and
  ! max may answer the other argument for a NaN, and either zero
  pure function cl_dmin(a, b) result(r)
    real(real64), intent(in) :: a, b
    real(real64) :: r
    if (a /= a) then
       r = a
    else if (b /= b) then
       r = b
    else if (a == b) then
       r = merge(a, b, sign(1.0_real64, a) < 0.0_real64)
    else
       r = min(a, b)
    end if
  end function cl_dmin
  pure function cl_dmax(a, b) result(r)
    real(real64), intent(in) :: a, b
    real(real64) :: r
    if (a /= a) then
       r = a
    else if (b /= b) then
       r = b
    else if (a == b) then
       r = merge(a, b, sign(1.0_real64, a) > 0.0_real64)
    else
       r = max(a, b)
    end if
  end function cl_dmax
  " P "function cl_quot(a, b" E ") result(r)
    integer(int64), intent(in) :: a, b
" ED "    integer(int64) :: r
    if (b == 0) then
       " (fail "'Divide by zero'" 1) "
    end if
    if (a == -huge(a) - 1_int64 .and. b == -1_int64) then
       r = a
    else
       r = a / b
    end if
  end function cl_quot
  " P "function cl_rem(a, b" E ") result(r)
    integer(int64), intent(in) :: a, b
" ED "    integer(int64) :: r
    if (b == 0) then
       " (fail "'Divide by zero'" 1) "
    end if
    if (b == -1_int64) then
       r = 0
    else
       r = mod(a, b)
    end if
  end function cl_rem
  ! clojure.core/mod: the remainder takes the divisor's sign
  " P "function cl_mod(a, b" E ") result(r)
    integer(int64), intent(in) :: a, b
" ED "    integer(int64) :: r
    r = cl_rem(a, b" E ")
" (when lib? "    if (err%code /= 0) return\n") "    if (r /= 0 .and. ((r < 0) .neqv. (b < 0))) r = r + b
  end function cl_mod
  ! RT.longCast of a double: in range, truncated toward zero
  " P "function cl_long_of(x" E ") result(r)
    real(real64), intent(in) :: x
" ED "    integer(int64) :: r
" (when-not lib? "    character(len=32) :: buf\n") "    ! 2^63 itself is in range: RT's comparison promotes Long.MAX_VALUE to
    ! it, and the host's cast then saturates (the interpreter's long_of_double)
    if (x < -9.223372036854775808d18 .or. x > 9.223372036854775808d18) then
" (if lib?
    "       ! the runtime writes the double, as clj does
       err%has_x = .true.
       err%x = x
       call cl_fail('Value out of range for long: ', 3, err)
       return"
    (str "       ! Fortran's own ES form, the same text from every compiler; clj
       ! writes 1.0E30 (DEVIATIONS 50)
       write(buf, '(es24.16e3)') x
       " (fail "'Value out of range for long: ' // trim(adjustl(buf))" 3))) "
    end if
    if (x /= x) then
       r = 0_int64   ! (long ##NaN) is 0: the cast, not a range error
    else if (x >= 9.223372036854775808d18) then
       r = huge(r)
    else
       r = int(x, int64)
    end if
  end function cl_long_of
" (kinds-support P E ED fail lib?) "  " P "subroutine cl_bounds(i, n" E ")
    integer(int64), intent(in) :: i, n
" ED "    character(len=24) :: bi, bn
    if (i < 0 .or. i >= n) then
       write(bi, '(i0)') i
       write(bn, '(i0)') n
       " (fail "'Index ' // trim(bi) // ' out of bounds for length ' // trim(bn)" 2) "
    end if
  end subroutine cl_bounds
  ! (double-array n), (long-array n): zeros; a negative size is clj's
  ! NegativeArraySizeException, whose message is the size
  " P "function cl_dzeros(n" E ") result(r)
    integer(int64), intent(in) :: n
" ED "    real(real64), allocatable :: r(:)
    character(len=24) :: b
    if (n < 0) then
       write(b, '(i0)') n
       " (when lib? "allocate(r(0))\n       ") (fail "trim(b)" 4) "
    end if
    allocate(r(n))
    r = 0.0_real64
  end function cl_dzeros
  " P "function cl_lzeros(n" E ") result(r)
    integer(int64), intent(in) :: n
" ED "    integer(int64), allocatable :: r(:)
    character(len=24) :: b
    if (n < 0) then
       write(b, '(i0)') n
       " (when lib? "allocate(r(0))\n       ") (fail "trim(b)" 4) "
    end if
    allocate(r(n))
    r = 0_int64
  end function cl_lzeros
  ! ---- strings: UTF-8 bytes, counted and cut by CHARACTER, as clotran
  ! counts them (DEVIATIONS 41). A continuation byte is 10xxxxxx.
  pure function cl_nchars(s) result(n)
    character(len=*), intent(in) :: s
    integer(int64) :: n
    integer :: i
    n = 0
    do i = 1, len(s)
       if (iand(ichar(s(i:i)), 192) /= 128) n = n + 1
    end do
  end function cl_nchars
  ! the byte where character c (0-based) starts; len(s)+1 past the end
  pure function cl_charpos(s, c) result(p)
    character(len=*), intent(in) :: s
    integer(int64), intent(in) :: c
    integer :: p
    integer(int64) :: seen
    seen = -1
    do p = 1, len(s)
       if (iand(ichar(s(p:p)), 192) /= 128) then
          seen = seen + 1
          if (seen == c) return
       end if
    end do
    p = len(s) + 1
  end function cl_charpos
  ! (subs s a b): String.substring's bounds check, then the characters
  " P "function cl_subs(s, a, b" E ") result(r)
    character(len=*), intent(in) :: s
    integer(int64), intent(in) :: a, b
" ED "    character(len=:), allocatable :: r
    character(len=24) :: ba, bb, bn
    integer(int64) :: n
    n = cl_nchars(s)
    if (a < 0 .or. b > n .or. a > b) then
       write(ba, '(i0)') a; write(bb, '(i0)') b; write(bn, '(i0)') n
       " (fail "'Range [' // trim(ba) // ', ' // trim(bb) // ') out of bounds for length ' // trim(bn)" 6) "
    end if
    r = s(cl_charpos(s, a):cl_charpos(s, b) - 1)
  end function cl_subs
  ! numbers and booleans as text, Fortran's way (DEVIATIONS 50)
  pure function cl_lstr(x) result(r)
    integer(int64), intent(in) :: x
    character(len=:), allocatable :: r
    character(len=24) :: b
    write(b, '(i0)') x
    r = trim(b)
  end function cl_lstr
  pure function cl_dstr(x) result(r)
    real(real64), intent(in) :: x
    character(len=:), allocatable :: r
    character(len=32) :: b
    write(b, '(es24.16e3)') x
    r = trim(adjustl(b))
  end function cl_dstr
  pure function cl_bstr(x) result(r)
    logical, intent(in) :: x
    character(len=:), allocatable :: r
    character(len=1) :: b
    write(b, '(l1)') x
    r = b
  end function cl_bstr
end module " mod "
")))

;; what a library's generated code asks of the running clotran: the
;; error flag threaded through every procedure that can fail
(def ^:dynamic *library* false)
(declare decline)

;; the support procedures that can fail, and so take `err` in a library
(def ^:private fallible
  #{"cl_add" "cl_sub" "cl_mul" "cl_neg" "cl_quot" "cl_rem" "cl_mod" "cl_long_of"
    "cl_bounds" "cl_dzeros" "cl_lzeros" "cl_subs"
    "cl_fit1" "cl_fit2" "cl_fit4" "cl_ipow" "cl_fsqrt" "cl_fmod" "cl_fmodulo"})

(defn- ident-char? [c] (boolean (re-matches #"[A-Za-z0-9_]" (str c))))

(defn- matching-paren
  "The index of the ) closing the ( at i, quoted text skipped."
  [s i]
  (loop [j (inc i) depth 1 q false]
    (let [c (nth s j)]
      (cond q (recur (inc j) depth (not= c \'))
            (= c \') (recur (inc j) depth true)
            (= c \() (recur (inc j) (inc depth) false)
            (= c \)) (if (= depth 1) j (recur (inc j) (dec depth) false))
            :else (recur (inc j) depth false)))))

(defn- err-calls
  "`line` with `, err` as the last argument of every call of a name in
  `names` -- nested calls too, quoted text left alone -- and whether
  there was one."
  [line names]
  (let [n (count line)]
    (loop [i 0 start 0 out "" any false]
      (cond
        (>= i n) [(str out (subs line start)) any]
        (= (nth line i) \') (let [j (or (str/index-of line "'" (inc i)) (dec n))]
                              (recur (inc j) start out any))
        (and (ident-char? (nth line i)) (or (zero? i) (not (ident-char? (nth line (dec i))))))
        (let [j (loop [j i] (if (and (< j n) (ident-char? (nth line j))) (recur (inc j)) j))
              nm (subs line i j)]
          (if (and (< j n) (= (nth line j) \() (contains? names nm))
            (let [k (matching-paren line j)
                  [inner _] (err-calls (subs line (inc j) k) names)]
              (recur (inc k) (inc k)
                     (str out (subs line start i) nm "(" inner (if (str/blank? inner) "err" ", err") ")")
                     true))
            (recur j start out any)))
        :else (recur (inc i) start out any)))))

(defn- can-fail?
  "Whether Fortran lines call something that can raise Clojure's
  exception: a checked helper, cl_fail, or any of this file's own
  functions (`own`, their generic names) -- conservatively, since one
  may. Only code that cannot fail is Fortran-pure or do concurrent: a
  compiler may skip a pure reference whose value is unused, and an
  error Clojure raises must not be skipped (fuzz-build-pure,
  2026-10-18); code that cannot fail loses nothing by being skipped."
  [lines own]
  (let [names (into (conj fallible "cl_fail") own)]
    (boolean (some #(second (err-calls % names)) lines))))

(defn- with-err
  "A library procedure's body: each statement that calls something
  that can fail passes `err` and is followed by the check. A failed
  call inside a condition would branch on a garbage value, so a
  checked operation in an if or a do while declines the version."
  [lines names]
  (vec (mapcat (fn [l]
                 (let [[l2 any] (err-calls l names)]
                   (if any
                     (do (when (re-find #"^\s*(else\s*)?(if|do while) \(" l)
                           (decline "a checked operation inside a condition (library mode)"))
                         [l2 (str (re-find #"^\s*" l) "if (err%code /= 0) return")])
                     [l])))
               lines)))

;;; ---- types -----------------------------------------------------------

(defn- record-type? [t] (and (keyword? t) (= "record" (namespace t))))

;; A Fortran name: letters, digits and _, starting with a letter -- so -main
;; and *limit* take an fn prefix (fn_main, fn__limit_)
(defn- fort-ident* [s]
  (let [t (str/lower-case (str/replace (str s) #"[^A-Za-z0-9]" "_"))]
    (if (re-find #"^[a-z]" t) t (str "fn" (when-not (str/starts-with? t "_") "_") t))))

(defn- type-name
  "A record's Fortran derived type: name_t, since Fortran is
  case-insensitive and a function particle would collide with a record
  Particle."
  [t]
  (str (fort-ident* (name t)) "_t"))

(defn- fort-type [t]
  (if (record-type? t)
    (str "type(" (type-name t) ")")
    ({:long "integer(int64)" :double "real(real64)" :bool "logical"
      :int1 "integer(int8)" :int2 "integer(int16)" :int4 "integer(int32)" :real4 "real(real32)"
      :doubles "real(real64)" :longs "integer(int64)"
      :ints "integer(int32)" :floats "real(real32)" :shorts "integer(int16)" :bytes "integer(int8)"
      :complex4 "complex(real32)" :complex8 "complex(real64)"
      :string "character(len=:), allocatable"} t)))

(defn- suffix [t]
  (if (record-type? t)
    (str "r" (fort-ident* (name t)))
    ({:long "l" :double "d" :doubles "vd" :longs "vl" :string "s"
      :int1 "i1" :int2 "i2" :int4 "i4" :real4 "f4" :complex4 "c4" :complex8 "c8" :ints "vi4" :floats "vf4" :shorts "vi2" :bytes "vi1"} t)))

(defn records-of
  "The records a file defines: {Name {:type :record/Name :factory ns/->Name
  :fields [[field type] ...]}}. A field's type is its hint -- ^long,
  ^double -- or a double: the scientific default, and the check at every
  construction keeps it honest."
  [forms ns-name]
  (into {} (for [f forms :when (and (seq? f) (= 'defrecord (first f)))
                 :let [nm (second f) fields (nth f 2)]]
             [(str nm) {:type (keyword "record" (str nm))
                        :factory (symbol (str ns-name) (str "->" nm))
                        :fields (mapv (fn [fl] [(keyword (name fl))
                                               (case (:tag (meta fl)) (long int8) :long (double real8) :double :double)])
                                      fields)}])))

(defn- num? [t] (#{:long :double} t))

;; Fortran's kinds in the pure tier (James, 2026-11-21: clotran's types are Fortran's).
;; :long is integer(8) and :double real(8), as always; :int1 :int2 :int4 :real4 are
;; the other kinds fortran.ops (src/clj/fortran/ops.cljf) has. A value of one of
;; them is made by a fortran.ops constructor or operation and lowered by
;; fortran-call; clojure.core's operations on them are not lowered (Clojure's
;; rule widens them; say what you mean with fortran.ops).
(def ^:private fkinds
  {:int1 {:int? true :bits 8 :n 1 :iso "int8"} :int2 {:int? true :bits 16 :n 2 :iso "int16"}
   :int4 {:int? true :bits 32 :n 4 :iso "int32"} :long {:int? true :bits 64 :n 8 :iso "int64"}
   :real4 {:bits 32 :n 4 :iso "real32"} :double {:bits 64 :n 8 :iso "real64"}
   ;; complex(4) and complex(8): :part is the real kind of a part, :iso the Fortran kind they share
   :complex4 {:cplx true :bits 64 :n 4 :iso "real32" :part :real4}
   :complex8 {:cplx true :bits 128 :n 8 :iso "real64" :part :double}})
(defn- k? [t] (contains? fkinds t))
(defn- kint? [t] (boolean (:int? (fkinds t))))
(defn- kcplx? [t] (boolean (:cplx (fkinds t))))
(defn- kreal? [t] (and (k? t) (not (kint? t)) (not (kcplx? t))))
(defn- kiso [t] (:iso (fkinds t)))
(defn- kwords [t] (str (cond (kint? t) "integer" (kcplx? t) "complex" :else "real") "(" (:n (fkinds t)) ")"))

;; arrays of those kinds, as clj's hints spell them: ^doubles ^longs ^ints ^floats ^shorts ^bytes
;; (and Fortran's: ^real8s ^int8s ^int4s ^real4s ^int2s ^int1s). An element read is its own kind;
;; clojure.core's operations widen it (Clojure's rule: an int is a long in arithmetic, a float a
;; double), fortran.ops's keep it.
(def ^:private karr-types {:doubles :double :longs :long :ints :int4 :floats :real4 :shorts :int2 :bytes :int1})
(defn- karr? [t] (contains? karr-types t))
(defn- karr-elem [t] (karr-types t))
(defn- kwide
  "The kind clojure.core's arithmetic sees a kind as: integers are longs, reals doubles."
  [t] (case t (:int1 :int2 :int4) :long :real4 :double t))

(defn- decline [why] (throw (ex-info why {::decline why})))

(defn- fort-ident [s] (fort-ident* s))

;;; ---- emitting: one version of one function ---------------------------
;;
;; emit answers [lines expr type]: the statements that compute a value,
;; a Fortran expression for it, and its type. :none is a recur's, which
;; produces nothing. Temporaries and loop labels come from a counter in
;; the version's state atom, which also collects declarations.

(defn- fresh! [st prefix t]
  (let [n (:n (swap! st update :n inc))
        v (str prefix n)]
    (swap! st update :decls conj [v t])
    v))

(defn fort-double
  "A double as an exact Fortran double-precision literal: the shortest
  decimal that reads back as the same double, with its exponent -- or d0
  -- marking it double precision. 1.0E200 is 1.0d200, not 1.0E200d0."
  [v]
  (let [s (pr-str v)]
    (if (str/includes? s "E") (str/replace s "E" "d") (str s "d0"))))

(defn fort-string
  "A string as a Fortran expression: a literal with its quotes doubled,
  a newline as achar(10) -- a Fortran literal cannot hold one."
  [s]
  (let [pieces (map #(str "\"" (str/replace % "\"" "\"\"") "\"") (str/split s #"\n" -1))]
    (str "(" (str/join " // achar(10) // " pieces) ")")))

(defn- lit [v]
  (cond
    (true? v) [[] ".true." :bool]
    (false? v) [[] ".false." :bool]
    (and (int? v) (= v clotran.host.int8/MIN_VALUE)) [[] "(-huge(0_int64) - 1_int64)" :long]
    (int? v) [[] (str v "_int64") :long]
    (and (double? v) (NaN? v)) (decline "a NaN literal")
    (and (double? v) (infinite? v)) (decline "an infinite literal")
    (double? v) [[] (fort-double v) :double]
    (string? v) [[] (fort-string v) :string]
    (nil? v) [[] "" :nil]
    :else (decline (str "the constant " (pr-str v) " is not a number, a string or a boolean"))))

(declare emit)

(defn- as-double [e t] (if (= t :long) (str "real(" e ", real64)") e))

(defn- emit-args
  "Each argument's lines and expression, in order. Clojure evaluates
  every argument, left to right; Fortran may skip a function reference
  whose value is not needed and evaluate operands in any order -- so a
  numeric or boolean argument that is more than a name or a literal is
  assigned to a temporary first, and an argument that would throw
  throws, and throws first, as in clj (fuzz-build-pure, 2026-10-18)."
  [nds env st]
  (reduce (fn [[ls es ts] nd]
            (let [[l e t] (emit nd env st)]
              (when (= t :none) (decline "recur is not in tail position"))
              (if (and (or (#{:long :double :bool} t) (k? t)) (not (#{:const :local} (:op nd))))
                (let [v (fresh! st "a" t)]
                  [(conj (into ls l) (str v " = " e)) (conj es v) (conj ts t)])
                [(into ls l) (conj es e) (conj ts t)])))
          [[] [] []] nds))

(defn- arith2
  "Two numbers through + - * and friends: longs through the checked
  helpers, anything with a double as doubles."
  [op a ta b tb]
  (if (and (= ta :long) (= tb :long))
    [(str (case op :+ "cl_add" :- "cl_sub" :* "cl_mul") "(" a ", " b ")") :long]
    [(str "(" (as-double a ta) " " (name op) " " (as-double b tb) ")") :double]))

(def ^:private math1
  {"sqrt" "sqrt" "sin" "sin" "cos" "cos" "tan" "tan" "asin" "asin" "acos" "acos" "atan" "atan"
   "exp" "exp" "log" "log" "log10" "log10" "sinh" "sinh" "cosh" "cosh" "tanh" "tanh"
   "floor" "real(floor(~, int64), real64)" "ceil" "real(ceiling(~, int64), real64)"})

(defn- op-name
  "What a call head stands for, as a symbol: a clojure.core function, a
  Math/ member (math/sqrt), a same-file function (by its ns/name), or a
  folded builtin by its name."
  [head]
  (case (:op head)
    :var (let [s (#'tiers/var-sym (:p1 head))]
           (if (= "clojure.core" (namespace s)) (symbol (name s)) s))
    :const (when-let [b (some-> (:builtin head) str)]
             (if (str/starts-with? b "clotran-math-")
               (symbol "math" (subs b (count "clotran-math-")))
               (get tiers/builtin-aliases (symbol b) (symbol b))))
    nil))

(defn- chain-compare
  "(< a b c) is (and (< a b) (< b c)), each operand computed once."
  [fop es ts st]
  (let [vs (mapv (fn [e t] (let [v (fresh! st "c" t)] [v (str v " = " e)])) es ts)]
    [(mapv second vs)
     (str "(" (str/join " .and. "
                        (for [[[x tx] [y ty]] (partition 2 1 (map vector (map first vs) ts))]
                          (if (and (= tx :long) (= ty :long))
                            (str x " " fop " " y)
                            (str (as-double x tx) " " fop " " (as-double y ty)))))
          ")")
     :bool]))

;;; ---- fused sequence chains -------------------------------------------
;;
;; (reduce f init (map g (filter p xs))) never builds a seq: it is ONE
;; loop over the source, each step applied to the element in turn --
;; the fusion Clojure's transducers spell out, done here from the plain
;; form. A source is an array or a range of longs; steps are map, filter
;; and remove; the consumer is reduce, count or every?.

(declare emit-call emit-call* emit-call**)

(defn- inline-fn
  "Apply an (fn ...) literal to [expr type] arguments by inlining its
  body: its parameters bound to the arguments, its captured locals to
  the outer ones they capture."
  [fnode args env st]
  (let [[_ arities captures] (:p1 fnode)
        [nargs variadic start body] (first arities)]
    (when (or (not= 1 (count arities)) variadic (not= nargs (count args)))
      (decline "a function literal of other than one fixed arity matching its call"))
    (when (some #(= :recur (:op %)) (filter map? (tree-seq coll? seq body)))
      (decline "a function literal that recurs"))
    (let [binds (map-indexed (fn [i [e t]] (let [v (fresh! st "e" t)] [(+ start i) v t (str v " = " e)])) args)
          inner (merge (into {} (for [[outer in] (partition 2 captures)] [in (get env outer)]))
                       (into {} (for [[slot v t] binds] [slot [v t]])))
          [l e t] (emit body inner st)]
      [(into (mapv #(nth % 3) binds) l) e t])))

(defn- apply-fn
  "The value of the function node f applied to [expr type] arguments."
  [f args env st]
  (case (:op f)
    :fn (inline-fn f args env st)
    (:var :const)
    (let [slots (map (fn [_] (keyword (str "arg" (:n (swap! st update :n inc))))) args)
          env2 (into env (map (fn [s [e t]] [s [e t]]) slots args))]
      (emit-call {:op :call :children (cons f (map (fn [s] {:op :local :i2 s}) slots))} env2 st))
    (decline "a function value that is not a literal or a name")))

(defn- chain-of
  "The chain a node is -- {:source [:array var type] or [:range arg-nodes],
  :steps [[op fnode] ...] in the order they apply} -- or nil."
  [nd env]
  (loop [nd nd steps ()]
    (case (:op nd)
      :local (let [[v t] (get env (:i2 nd))]
               (when (karr? t) {:source [:array v t] :steps (vec steps)}))
      :call (let [[h & as] (:children nd) op (op-name h)]
              (cond
                (and ('#{map filter remove} op) (= 2 (count as)))
                (recur (second as) (cons [op (first as)] steps))
                (and (= op 'range) (<= 1 (count as) 3))
                {:source [:range as] :steps (vec steps)}
                :else nil))
      nil)))

(defn- chain-loop
  "A chain as loop parts: {:pre lines before the loop, :head the loop's
  opening lines, which set the element and advance, :steps the per-element
  step lines (a filtered-out element `cycle`s), :cur and :type of the
  element after the steps, :close, :label}."
  [{:keys [source steps]} env st]
  (let [label (str "fz" (:n (swap! st update :n inc)))
        [pre head elem et]
        (case (first source)
          :array (let [[_ v t] source
                       k (fresh! st "k" :long)
                       et (kwide (karr-elem t))
                       e (fresh! st "e" et)]
                   [[] [(str label ": do " k " = 1, size(" v ", kind=int64)")
                        (str "   " e " = " v "(" k ")")]
                    e et])
          :range (let [[ls es ts] (emit-args (second source) env st)
                       _ (when-not (every? #{:long} ts) (decline "a range of other than longs"))
                       [s e step] (case (count es) 1 ["0_int64" (first es) "1_int64"]
                                    2 [(first es) (second es) "1_int64"]
                                    es)
                       _ (when (= step "0_int64") (decline "(range a b 0) never ends"))
                       k (fresh! st "k" :long) ev (fresh! st "k" :long) sv (fresh! st "k" :long)
                       el (fresh! st "e" :long)]
                   ;; ponytail: k + step can overflow at the very ends of long
                   [(into ls [(str k " = " s) (str ev " = " e) (str sv " = " step)])
                    [(str label ": do while ((" sv " > 0 .and. " k " < " ev ") .or. (" sv " < 0 .and. " k " > " ev "))")
                     (str "   " el " = " k)
                     ;; advance BEFORE the steps, so a filter's `cycle` cannot skip it
                     (str "   " k " = " k " + " sv)]
                    el :long]))
        [step-lines cur ct]
        (reduce (fn [[ls ce ct] [op f]]
                  (let [[l e t] (apply-fn f [[ce ct]] env st)]
                    (if (= op 'map)
                      (let [v (fresh! st "e" t)]
                        [(-> ls (into l) (conj (str v " = " e))) v t])
                      ;; filter keeps and remove drops what is truthy; a number is truthy
                      (let [truthy (if (= t :bool) e ".true.")
                            test (if (= op 'filter) (str "(.not. " truthy ")") truthy)]
                        [(-> ls (into l) (conj (str "if " test " cycle " label))) ce ct]))))
                [[] elem et] steps)]
    {:pre pre :head head :steps step-lines :cur cur :type ct
     :close [(str "end do " label)] :label label}))

(defn- lower-consumer
  "reduce, count or every? over a chain, as one loop: [lines expr type],
  or nil when the call is not a consumer of a chain."
  [op args env st]
  (let [coll (last args)
        ch (chain-of coll env)]
    (when ch
      (let [{:keys [pre head steps cur type close label]} (chain-loop ch env st)
            indent #(map (fn [l] (str "   " l)) %)
            loop-lines (fn [inner] (vec (concat pre head (indent steps) (indent inner) close)))]
        (case op
          reduce
          (let [[f init] (if (= 3 (count args)) [(first args) (second args)] [(first args) nil])]
            (if init
              (let [[il ie it] (emit init env st)
                    acc (fresh! st "s" it)
                    [fl fe ft] (apply-fn f [[acc it] [cur type]] env st)]
                (when (not= ft it)
                  (decline (str "reduce's accumulator starts as a " (name it) " and becomes a " (name ft)
                                ": start it as a " (name ft) " (0.0, not 0)")))
                [(into (conj (vec il) (str acc " = " ie)) (loop-lines (conj (vec fl) (str acc " = " fe))))
                 acc it])
              ;; no init: the first element is the start, and an empty chain
              ;; answers (f) -- which must have the elements' type
              (let [zero (try (apply-fn f [] env st)
                              (catch clotran.host.exception e (if (::decline (ex-data e)) nil (throw e))))
                    ;; (f) that cannot be called is Clojure's ArityException when
                    ;; the chain is empty -- (reduce max []) -- named as clj names it
                    fname (when (= :var (:op f)) (#'tiers/var-sym (:p1 f)))
                    _ (when-not (or zero fname)
                        (decline "reduce with no init over a function literal that takes no zero arguments"))
                    [zl ze zt] (or zero
                                   [[] (case type :double "0.0d0" :long "0_int64" (decline "reduce over booleans"))
                                    type])
                    ;; only after the loop is it known whether the chain was empty
                    after (when-not zero
                            (if *library*
                              ["if (.not. STARTED) then"
                               (str "   call cl_fail('Wrong number of args (0) passed to: " fname "', 5, err)")
                               "   return"
                               "end if"]
                              [(str "if (.not. STARTED) call cl_fail('Wrong number of args (0) passed to: " fname "')")]))
                    _ (when (not= zt type)
                        (decline (str "reduce with no init answers (f), a " (name zt) ", for an empty chain of "
                                      (name type) "s: give it an init of the elements' type")))
                    acc (fresh! st "s" type)
                    started (fresh! st "b" :bool)
                    [fl fe ft] (apply-fn f [[acc type] [cur type]] env st)]
                (when (not= ft type) (decline "reduce's function changes the elements' type"))
                [(-> (conj (vec zl) (str acc " = " ze) (str started " = .false."))
                     (into (loop-lines (concat [(str "if (" started ") then")]
                                               (map #(str "   " %) fl)
                                               [(str "   " acc " = " fe) "else" (str "   " acc " = " cur)
                                                (str "   " started " = .true.") "end if"])))
                     (into (map #(str/replace % "STARTED" started) after)))
                 acc type])))
          count
          (let [n (fresh! st "s" :long)]
            [(into [(str n " = 0_int64")] (loop-lines [(str n " = " n " + 1_int64")])) n :long])
          every?
          (let [[pl pe pt] (apply-fn (first args) [[cur type]] env st)
                r (fresh! st "b" :bool)]
            [(into [(str r " = .true.")]
                   (loop-lines (if (= pt :bool)
                                 (concat pl [(str "if (.not. " pe ") then") (str "   " r " = .false.") (str "   exit " label) "end if"])
                                 pl)))
             r :bool])
          nil)))))

(defn- emit-call [nd env st]
  (or (let [[head & args] (:children nd) op (op-name head)]
        (when ('#{reduce count every?} op) (lower-consumer op args env st)))
      (emit-call* nd env st)))

(defn- emit-call* [nd env st]
  (let [[head & args] (:children nd)]
    (cond
      ;; (:field rec): a field of a record, rec%field
      (and (= :const (:op head)) (keyword? (:p1 head)))
      (let [[ls es ts] (emit-args args env st)
            k (:p1 head) t (first ts)
            r (some #(when (= (:type %) t) %) (vals (:records @st)))]
        (when-not (and (= 1 (count args)) r) (decline (str "looks up " k " in something that is not a record")))
        (if-let [ft (some (fn [[f ft]] (when (= f k) ft)) (:fields r))]
          [ls (str (first es) "%" (fort-ident* (name k))) ft]
          (decline (str "the record " (name t) " has no field " k))))

      ;; (->Name a b ...): the structure constructor, its types checked --
      ;; a field is what the record says; Clojure would keep a long a long
      (and (= :var (:op head))
           (some #(when (= (:factory %) (op-name head)) %) (vals (:records @st))))
      (let [r (some #(when (= (:factory %) (op-name head)) %) (vals (:records @st)))
            [ls es ts] (emit-args args env st)]
        (when (not= (count args) (count (:fields r))) (decline "a record constructed with the wrong number of fields"))
        (doseq [[[f ft] t] (map vector (:fields r) ts)]
          (when (not= ft t)
            (decline (str "the field " f " of " (name (:type r)) " is a " (name ft) "; this passes a " (name t)
                          (when (= ft :double) " -- write 1.0, not 1")))))
        [ls (str (type-name (:type r)) "(" (str/join ", " es) ")") (:type r)])

      :else (emit-call** nd env st))))

;;; ---- fortran.ops: Fortran's kinds, lowered natively ---------------------
;;
;; src/clj/fortran/ops.cljf is the meaning (and test/ftypes/oracle.clj the
;; specification, checked against gfortran and flang); these are its operations
;; on the kinds of fkinds as Fortran, with the result kind a Fortran result has:
;; the larger of two integer kinds, the real's kind of an integer with a real.
;; A narrow integer is computed in integer(8) and checked into its kind by
;; cl_fit1/2/4; integer(8) uses the checked cl_add .. helpers; reals are
;; Fortran's own operators. A result the standard leaves to the processor
;; fails, as fortran.ops throws. (DEVIATIONS 93.)

(defn- kwiden
  "Expression e of kind from, as kind to, where to is at least as wide (or a real)."
  [e from to]
  (cond (= from to) e
        (kcplx? to) (str "cmplx(" e ", kind=" (kiso to) ")")
        (kcplx? from) (decline (str "a " (kwords from) " cannot be used as a " (kwords to) ": use real, aimag or abs"))
        (and (kint? from) (kint? to)) (str "int(" e ", " (kiso to) ")")
        (kreal? to) (str "real(" e ", " (kiso to) ")")
        :else (decline (str "a " (kwords from) " cannot be used as a " (kwords to)))))

(defn- kfit
  "An integer(8) expression as integer kind k: checked into a narrow kind."
  [e k]
  (if (= k :long) e (str "cl_fit" (:n (fkinds k)) "(" e ")")))

(defn- kto
  "Expression e of kind from as kind to, an assignment's or a constructor's: a
  narrowing integer is checked, a real never becomes an integer here."
  [e from to]
  (cond (= from to) e
        (and (kint? from) (kint? to))
        (if (> (:bits (fkinds to)) (:bits (fkinds from)))
          (kwiden e from to)
          (kfit (if (= from :long) e (str "int(" e ", int64)")) to))
        (or (kreal? to) (kcplx? to)) (kwiden e from to)
        :else (decline (str "a " (kwords from) " to a " (kwords to) ": use int, nint, floor or ceiling"))))

(defn- kpromote [a b]
  (cond (or (kcplx? a) (kcplx? b))
        ;; the complex kind whose parts are as wide as the widest real part or real operand
        (let [part (fn [t] (cond (kcplx? t) (:part (fkinds t)) (kreal? t) t))
              ps (remove nil? [(part a) (part b)])
              widest (reduce (fn [m p] (if (> (:bits (fkinds p)) (:bits (fkinds m))) p m)) ps)]
          ({:real4 :complex4 :double :complex8} widest))
        (and (kint? a) (kint? b)) (if (>= (:bits (fkinds a)) (:bits (fkinds b))) a b)
        (and (kreal? a) (kreal? b)) (if (>= (:bits (fkinds a)) (:bits (fkinds b))) a b)
        (kint? a) b
        :else a))

(defn- i64 [e t] (if (= t :long) e (str "int(" e ", int64)")))

(defn- kop
  "a op b, op one of :+ :- :* :/ , for two expressions of Fortran kinds."
  [op a ta b tb]
  (let [k (kpromote ta tb) x (kwiden a ta k) y (kwiden b tb k)]
    (when (and (kcplx? k) (= op :/)) (decline "complex division is processor dependent"))
    (if (kint? k)
      (if (= k :long)
        [(str (case op :+ "cl_add(" :- "cl_sub(" :* "cl_mul(" :/ "cl_quot(") x ", " y ")") :long]
        [(kfit (case op
                 :/ (str "cl_quot(" (i64 x k) ", " (i64 y k) ")")
                 (str "(" (i64 x k) " " (name op) " " (i64 y k) ")")) k)
         k])
      [(str "(" x " " (name op) " " y ")") k])))

(def ^:private real-text #"-?[0-9]+(\.[0-9]*)?([eEdD][+-]?[0-9]+)?|-?\.[0-9]+([eEdD][+-]?[0-9]+)?")

(defn- real-literal
  "A real kind's literal from its decimal text, rounded once from the text, as Fortran rounds it."
  [text k]
  (when-not (re-matches real-text text) (decline (str "the real literal " (pr-str text))))
  (let [t (str/replace text #"[dD]" "e")
        t (if (re-find #"[.eE]" t) t (str t ".0"))
        t (if (re-find #"^-?\." t) (str/replace t #"\." "0." ) t)
        t (str t "_" (kiso k))]
    (if (str/starts-with? t "-") (str "(" t ")") t)))

(defn- const-int
  "The integer a node says, a constant or a fortran.ops constructor of one, else nil."
  [nd]
  (cond (and (= :const (:op nd)) (integer? (:p1 nd))) (:p1 nd)
        (and (= :call (:op nd)) (let [o (op-name (first (:children nd)))]
                                   (and (symbol? o) (= "fortran.ops" (namespace o)) (re-matches #"int[1248]" (name o)))))
        (const-int (second (:children nd)))
        :else nil))

(defn- kzero [t] (if (kint? t) (str "0_" (kiso t)) (str "0.0_" (kiso t))))

(defn- fortran-call [op args env st]
  (let [nm (name op)
        kw? #(and (= :const (:op %)) (keyword? (:p1 %)))
        n (count (remove kw? args))
        vals (vec (remove kw? args))
        [ls es ts] (emit-args vals env st)
        kwk (some #(when (kw? %) (:p1 %)) args)
        tgt (fn [dflt] (let [m {:int1 :int1 :int2 :int2 :int4 :int4 :int8 :long :real4 :real4 :real8 :double
                                :complex4 :complex4 :complex8 :complex8}]
                         (cond (nil? kwk) dflt
                               (m kwk) (m kwk)
                               :else (decline (str "the kind " kwk " is not one of int1 int2 int4 int8 real4 real8")))))
        done (fn [e t & [more]] [(into ls more) e t])
        e0 (first es) t0 (first ts) e1 (second es) t1 (second ts)
        _ (when (and (not (#{"int1" "int2" "int4" "int8" "real4" "real8" "complex4" "complex8"} nm))
                     (not (every? k? ts)))
            (decline (str "fortran." "ops/" nm " of something that is not a Fortran kind: make one with int4, real8 ..., or write long or double")))
        _ (when (and (some kcplx? ts)
                     (not (#{"+" "-" "*" "real" "dble" "cmplx" "conjg" "aimag" "kind" "complex4" "complex8"} nm)))
            (decline (str "fortran.ops/" nm " of a complex is not lowered")))
        same! (fn [] (when-not (apply = ts) (decline (str "fortran.ops/" nm " needs one kind, not " (str/join ", " (map kwords ts))))))
        to-int (fn [e64 k] (kfit e64 k))]
    (case nm
      ("int1" "int2" "int4" "int8")
      (let [k ({"int1" :int1 "int2" :int2 "int4" :int4 "int8" :long} nm)]
        (cond (kint? t0) (done (kto e0 t0 k) k)
              :else (decline (str nm " of a real: use int, nint, floor or ceiling"))))

      ("complex4" "complex8")
      (let [k (keyword nm) pk (:part (fkinds k))
            part (fn [nd e t] (cond (and (= :const (:op nd)) (string? (:p1 nd))) (real-literal (:p1 nd) pk)
                                    (kcplx? t) (decline (str nm " of a complex and another value"))
                                    :else (kto e t pk)))]
        (case n
          1 (if (kcplx? t0)
              (done (kwiden e0 t0 k) k)
              (done (str "cmplx(" (part (first vals) e0 t0) ", kind=" (kiso k) ")") k))
          2 (done (str "cmplx(" (part (first vals) e0 t0) ", " (part (second vals) e1 t1) ", kind=" (kiso k) ")") k)
          (decline (str nm " of other than one or two values"))))

      ;; CMPLX defaults to complex(4), whatever its arguments' kind
      "cmplx"
      (let [k (tgt :complex4)]
        (when-not (kcplx? k) (decline "cmplx to a kind that is not complex"))
        (cond (and (= n 1) (kcplx? t0)) (done (kwiden e0 t0 k) k)
              (<= 1 n 2) (done (str "cmplx(" (str/join ", " es) ", kind=" (kiso k) ")") k)
              :else (decline "cmplx of other than one or two values")))

      "conjg" (done (str "conjg(" e0 ")") t0)
      "aimag" (done (str "aimag(" e0 ")") (:part (fkinds t0)))

      ("real4" "real8")
      (let [k (if (= nm "real4") :real4 :double) a (first vals)]
        (cond (and (= :const (:op a)) (string? (:p1 a))) (done (real-literal (:p1 a) k) k)
              (k? t0) (done (kto e0 t0 k) k)
              :else (decline (str nm " of something that is not a number or a decimal text"))))

      ("+" "*" "/")
      (do (when-not (= 2 n) (decline (str "fortran.ops/" nm " of other than two values")))
          (let [[e t] (kop (keyword nm) e0 t0 e1 t1)] (done e t)))

      "-"
      (cond (= n 1) (cond (= t0 :long) (done (str "cl_neg(" e0 ")") :long)
                          (kint? t0) (done (kfit (str "(-" (i64 e0 t0) ")") t0) t0)
                          :else (done (str "(-" e0 ")") t0))
            (= n 2) (let [[e t] (kop :- e0 t0 e1 t1)] (done e t))
            :else (decline "fortran.ops/- of other than one or two values"))

      "**"
      (let [p (const-int (second vals))]
        (cond (and (kint? t0) (kint? t1))
              (let [k (kpromote t0 t1)] (done (kfit (str "cl_ipow(" (i64 e0 t0) ", " (i64 e1 t1) ")") k) k))
              (and (kreal? t0) (kint? t1) (= p 2)) (done (str "(" e0 " * " e0 ")") t0)
              :else (decline "a real power other than x**2 is processor dependent")))

      "int"
      (let [k (tgt :int4)]
        (when-not (kint? k) (decline "int to a real kind"))
        (if (kint? t0)
          (done (kto e0 t0 k) k)
          (done (to-int (str "cl_long_of(" (kwiden e0 t0 :double) ")") k) k)))

      ("nint" "floor" "ceiling")
      (let [k (tgt :int4)]
        (when-not (kint? k) (decline (str nm " to a real kind")))
        (if (kint? t0)
          (done (kto e0 t0 k) k)
          (let [x (fresh! st "x" :double)]
            (if (= nm "nint")
              (done (to-int (str "cl_long_of(anint(" x "))") k) k [(str x " = " (kwiden e0 t0 :double))])
              (done (to-int (if (= nm "floor")
                              (str "cl_long_of(aint(" x ") - merge(1.0_real64, 0.0_real64, " x " < aint(" x ")))")
                              (str "cl_long_of(aint(" x ") + merge(1.0_real64, 0.0_real64, " x " > aint(" x ")))")) k) k
                    [(str x " = " (kwiden e0 t0 :double))])))))

      "real"
      (if (kcplx? t0)
        ;; REAL of a complex is its real part, of the part's kind unless a kind says otherwise
        (let [k (tgt (:part (fkinds t0)))] (done (str "real(" e0 ", " (kiso k) ")") k))
        (let [k (tgt :real4)]
          (when-not (kreal? k) (decline "real to an integer kind"))
          (done (kto e0 t0 k) k)))

      "dble" (if (kcplx? t0) (done (str "real(" e0 ", real64)") :double) (done (kto e0 t0 :double) :double))

      "abs"
      (cond (= t0 :long) (let [a (fresh! st "x" :long)]
                           (done (str "merge(cl_neg(" a "), " a ", " a " < 0_int64)") :long [(str a " = " e0)]))
            (kint? t0) (done (kfit (str "abs(" (i64 e0 t0) ")") t0) t0)
            :else (done (str "abs(" e0 ")") t0))

      "sign"
      (do (same!)
          (if (kint? t0)
            (let [a (fresh! st "x" :long)]
              (done (kfit (str "merge(-" a ", " a ", " (i64 e1 t1) " < 0_int64)") t0) t0
                    [(str a " = " (if (= t0 :long) (str "merge(cl_neg(" e0 "), " e0 ", " e0 " < 0_int64)") (str "abs(" (i64 e0 t0) ")")))]))
            (done (str "sign(" e0 ", " e1 ")") t0)))

      ("min" "max")
      (do (same!) (done (str nm "(" (str/join ", " es) ")") t0))

      ("mod" "modulo")
      (do (same!)
          (if (kint? t0)
            (let [h (str (if (= nm "mod") "cl_rem(" "cl_mod(") (i64 e0 t0) ", " (i64 e1 t1) ")")]
              (done (if (= t0 :long) h (str "int(" h ", " (kiso t0) ")")) t0))
            (let [h (str "cl_f" nm "(" (kwiden e0 t0 :double) ", " (kwiden e1 t1 :double) ")")]
              (done (if (= t0 :double) h (str "real(" h ", " (kiso t0) ")")) t0))))

      "sqrt"
      (do (when-not (kreal? t0) (decline "sqrt of an integer"))
          (let [h (str "cl_fsqrt(" (kwiden e0 t0 :double) ")")]
            (done (if (= t0 :double) h (str "real(" h ", " (kiso t0) ")")) t0)))

      "huge" (done (str "huge(" (kzero t0) ")") t0)
      "tiny" (do (when-not (kreal? t0) (decline "tiny of an integer")) (done (str "tiny(" (kzero t0) ")") t0))
      "epsilon" (do (when-not (kreal? t0) (decline "epsilon of an integer")) (done (str "epsilon(" (kzero t0) ")") t0))
      "kind" (done (str (:n (fkinds t0)) "_int32") :int4)
      "digits" (done (str (if (kint? t0) (dec (:bits (fkinds t0))) (case t0 :real4 24 :double 53)) "_int32") :int4)

      (decline (str "fortran.ops/" nm " is not lowered")))))

(defn- widen-args
  "clojure.core's operations see the Fortran kinds as Clojure does: an integer kind is a
  long and a real(4) a double (an int in clj arithmetic is a long, a float a double). Only
  the value an aset stores keeps its kind, which the array's element then checks."
  [op es ts]
  (let [pairs (map-indexed (fn [j [e t]]
                             (if (and (#{:int1 :int2 :int4 :real4} t) (not (and (= op 'aset) (= j 2))))
                               [(kwiden e t (kwide t)) (kwide t)]
                               [e t]))
                           (map vector es ts))]
    [(mapv first pairs) (mapv second pairs)]))

(defn- emit-call*** [nd env st]
  (let [[head & args] (:children nd)
        op (op-name head)
        ;; an array hint's checkcast is (clotran-array-cast x :doubles): the
        ;; keyword names the type and is no expression to emit
        args (if (= op 'clotran-array-cast) [(first args)] args)
        [ls es0 ts0] (emit-args args env st)
        [es ts] (widen-args op es0 ts0)
        n (count args)
        done (fn [e t] [ls e t])]
    (cond
      ;; an array hint's checkcast: the version's type IS the check
      (= op 'clotran-array-cast) (done (first es) (first ts))

      (#{'+ '- '*} op)
      (let [kw (keyword (name op))]
        (when-not (every? num? ts) (decline (str op " of something that is not a number")))
        (cond
          (= n 0) (done (if (= op '*) "1_int64" "0_int64") :long)
          (and (= n 1) (= op '-)) (if (= (first ts) :long)
                                    (done (str "cl_neg(" (first es) ")") :long)
                                    (done (str "(-" (first es) ")") :double))
          (= n 1) (done (first es) (first ts))
          :else (let [[e t] (reduce (fn [[a ta] [b tb]] (arith2 kw a ta b tb))
                                    [(first es) (first ts)] (map vector (rest es) (rest ts)))]
                  (done e t))))

      (= op '/)
      (do (when-not (every? num? ts) (decline "/ of something that is not a number"))
          (when (every? #{:long} ts)
            (decline "(/ long long) is a Ratio in Clojure: use quot, or make one side a double"))
          (if (= n 1)
            (done (str "(1.0d0 / " (as-double (first es) (first ts)) ")") :double)
            (done (reduce (fn [a [b tb]] (str "(" a " / " (as-double b tb) ")"))
                          (as-double (first es) (first ts)) (map vector (rest es) (rest ts)))
                  :double)))

      (#{'inc 'dec} op)
      (let [t (first ts) e (first es)]
        (case t
          :long (done (str (if (= op 'inc) "cl_add(" "cl_sub(") e ", 1_int64)") :long)
          :double (done (str "(" e (if (= op 'inc) " + " " - ") "1.0d0)") :double)
          (decline (str op " of something that is not a number"))))

      (#{'quot 'rem 'mod} op)
      (if (every? #{:long} ts)
        (done (str (case op quot "cl_quot(" rem "cl_rem(" mod "cl_mod(") (first es) ", " (second es) ")") :long)
        (decline (str op " of doubles is not lowered yet")))

      (#{'max 'min} op)
      (if (and (seq ts) (apply = ts))
        (if (= :double (first ts))
          (done (reduce (fn [a b] (str (if (= op 'min) "cl_dmin(" "cl_dmax(") a ", " b ")")) es) :double)
          (done (str (name op) "(" (str/join ", " es) ")") (first ts)))
        (decline (str op " of a long and a double: Clojure answers whichever wins, with its own type")))

      (#{'< '> '<= '>= '==} op)
      (do (when-not (every? num? ts) (decline (str op " of something that is not a number")))
          (let [fop (if (= op '==) "==" (name op))
                [cl e t] (chain-compare fop es ts st)]
            [(into ls cl) e t]))

      (#{'= 'not=} op)
      (do (when-not (= 2 n) (decline (str op " of other than two values")))
          (let [[ta tb] ts
                eq (cond
                     ;; Clojure's = on numbers: Long and Double are never equal
                     (and (num? ta) (num? tb) (not= ta tb)) ".false."
                     (and (num? ta) (= ta tb)) (str "(" (first es) " == " (second es) ")")
                     (and (= ta :bool) (= tb :bool)) (str "(" (first es) " .eqv. " (second es) ")")
                     (and (= ta :string) (= tb :string))
                     (str "(len(" (first es) ") == len(" (second es) ") .and. " (first es) " == " (second es) ")")
                     :else (decline (str op " of " (name ta) " and " (name tb))))]
            (done (if (= op 'not=) (str "(.not. " eq ")") eq) :bool)))

      (#{'zero? 'pos? 'neg?} op)
      (let [t (first ts) e (first es)]
        (when-not (num? t) (decline (str op " of something that is not a number")))
        (done (str "(" e (case op zero? " == " pos? " > " neg? " < ") (if (= t :long) "0_int64" "0.0d0") ")") :bool))

      (#{'even? 'odd?} op)
      (if (= (first ts) :long)
        (done (str "(mod(" (first es) ", 2_int64) " (if (= op 'even?) "==" "/=") " 0_int64)") :bool)
        (decline (str op " of a double throws in Clojure")))

      (= op 'not)
      (if (= (first ts) :bool)
        (done (str "(.not. " (first es) ")") :bool)
        ;; (not x) of a number is false: a number is truthy
        (done ".false." :bool))

      (#{'double 'num} op)
      (cond (num? (first ts)) (done (as-double (first es) (first ts)) :double)
            ;; a Fortran kind leaves the kinds here, widened (fortran.ops makes them)
            (and (k? (first ts)) (not (kcplx? (first ts)))) (done (kwiden (first es) (first ts) :double) :double)
            :else (decline (str op " of something that is not a number")))

      (#{'long 'int 'unchecked-long} op)
      (case (first ts)
        :long (done (first es) :long)
        :double (done (str "cl_long_of(" (first es) ")") :long)
        (:int1 :int2 :int4) (done (str "int(" (first es) ", int64)") :long)
        :real4 (done (str "cl_long_of(real(" (first es) ", real64))") :long)
        (decline (str op " of something that is not a number")))

      (#{'abs 'math/abs} op)
      (if (num? (first ts)) (done (str (if (= :long (first ts)) "cl_abs(" "abs(") (first es) ")") (first ts))
          (decline "abs of something that is not a number"))

      (and (= "math" (namespace op)) (math1 (name op)))
      (let [f (math1 (name op)) x (as-double (first es) (first ts))]
        (done (if (str/includes? f "~") (str/replace f "~" x) (str f "(" x ")")) :double))

      (= op 'math/pow)
      (done (str "(" (as-double (first es) (first ts)) " ** " (as-double (second es) (second ts)) ")") :double)

      (= op 'math/atan2)
      (done (str "atan2(" (as-double (first es) (first ts)) ", " (as-double (second es) (second ts)) ")") :double)

      (and ('#{double-array long-array} op) (= 1 n) (= :long (first ts)))
      (done (str (if (= op 'double-array) "cl_dzeros(" "cl_lzeros(") (first es) ")")
            (if (= op 'double-array) :doubles :longs))

      ;; a copy: assigned to its own variable, Fortran array assignment copies
      (and (= op 'aclone) (karr? (first ts)))
      (done (first es) (first ts))

      (and ('#{unchecked-inc unchecked-dec} op) (= :long (first ts)))
      (done (str "(" (first es) (if (= op 'unchecked-inc) " + " " - ") "1_int64)") :long)

      (= op 'alength)
      (if (karr? (first ts))
        (done (str "size(" (first es) ", kind=int64)") :long)
        (decline "alength of something that is not an array"))

      (= op 'aget)
      (let [[ta ti] ts [a i] es]
        (when-not (and (karr? ta) (= ti :long)) (decline "aget of other than an array and a long index"))
        (let [iv (fresh! st "i" :long)]
          [(conj (into ls [(str iv " = " i)]) (str "call cl_bounds(" iv ", size(" a ", kind=int64))"))
           (str a "(" iv " + 1)") (karr-elem ta)]))

      (= op 'aset)
      (let [[ta ti tv] ts [a i v] es]
        (when-not (and (karr? ta) (= ti :long)) (decline "aset of other than an array and a long index"))
        (let [et (karr-elem ta)
              ;; a value of the element's kind, or of another of its class (an integer kind into an integer
              ;; array, checked into it; a real into a real one), or a long into doubles as before
              _ (when-not (or (= tv et) (and (= et :double) (= tv :long)) (and (kint? et) (kint? tv)) (and (kreal? et) (kreal? tv)))
                  (decline "aset of a value of the wrong type"))
              iv (fresh! st "i" :long) vv (fresh! st "v" et)]
          (swap! st update :written conj a)
          [(into ls [(str iv " = " i) (str "call cl_bounds(" iv ", size(" a ", kind=int64))")
                     (str vv " = " (cond (and (= et :double) (= tv :long)) (as-double v tv)
                                         (= tv et) v
                                         :else (kto v tv et)))
                     (str a "(" iv " + 1) = " vv)])
           vv et]))

      (#{'str 'print 'println} op)
      (let [piece (fn [e t]
                    (case t
                      :string e
                      :long (str "cl_lstr(" e ")")
                      :double (str "cl_dstr(" e ")")
                      :bool (str "cl_bstr(" e ")")
                      ;; nil: str makes it \"\", print writes nil
                      :nil (if (= op 'str) "''" "'nil'")
                      (decline (str op " of a " (name t)))))
            parts (map piece es ts)
            text (cond (empty? parts) "''"
                       (= op 'str) (str/join " // " parts)
                       :else (str/join " // ' ' // " parts))]
        (case op
          str (done text :string)
          println (do (swap! st assoc :impure true :prints true) [(conj ls (str "write(*, '(a)') " text)) "" :nil])
          print (do (swap! st assoc :impure true :prints true) [(conj ls (str "write(*, '(a)', advance='no') " text)) "" :nil])))

      (= op 'newline) (do (swap! st assoc :impure true :prints true) [(conj ls "write(*, '(a)') ''") "" :nil])

      (and (= op 'count) (= 1 n) (= :string (first ts)))
      (done (str "cl_nchars(" (first es) ")") :long)

      (and (= op 'count) (= 1 n) (karr? (first ts)))
      (done (str "size(" (first es) ", kind=int64)") :long)

      (= op 'subs)
      (do (when-not (and (= :string (first ts)) (every? #{:long} (rest ts)))
            (decline "subs of other than a string and long indices"))
          (done (str "cl_subs(" (first es) ", " (second es) ", "
                     (if (= n 3) (nth es 2) (str "cl_nchars(" (first es) ")")) ")")
                :string))

      (and ('#{clojure.string/includes? clojure.string/starts-with? clojure.string/ends-with?} op)
           (= [:string :string] ts))
      (let [[s x] es]
        (done (case (name op)
                "includes?" (str "(index(" s ", " x ") > 0)")
                "starts-with?" (str "(len(" s ") >= len(" x ") .and. index(" s ", " x ") == 1)")
                "ends-with?" (str "(len(" s ") >= len(" x ") .and. index(" s ", " x ", back=.true.) == len(" s ") - len(" x ") + 1)"))
              :bool))

      ;; another tier-A function of this file, by its generic name
      (and (symbol? op) (namespace op) (get-in @st [:sigs op]))
      (let [sig (get-in @st [:sigs op])
            rt (get sig ts)]
        (when-not rt (decline (str "`" op "` has no version for " (pr-str (mapv name ts)))))
        (swap! st update :calls (fnil conj #{}) [op ts])
        (when (contains? (:impure-versions @st) [op ts]) (swap! st assoc :impure true))
        (when (contains? (:printing-versions @st) [op ts]) (swap! st assoc :prints true))
        (if (= rt :nil)
          ;; a function answering nil is a subroutine: called, not evaluated
          [(conj ls (str "call " (fort-ident (name op)) "(" (str/join ", " es) ")")) "" :nil]
          (done (str (fort-ident (name op)) "(" (str/join ", " es) ")") rt)))

      :else (decline (str "calls `" (or op (:op head)) "`, which is not lowered yet")))))


(defn- emit-call**
  "fortran.ops's operations are lowered by fortran-call; every other call by emit-call***."
  [nd env st]
  (let [[head & args] (:children nd)
        op (op-name head)]
    (if (and (symbol? op) (= "fortran.ops" (namespace op)))
      (fortran-call op args env st)
      (emit-call*** nd env st))))

(defn- not-in-fns
  "Every node under nd, not descending into fn literals -- their slots
  are their own frame's."
  [nd]
  (filter #(and (map? %) (:op %))
          (tree-seq #(and (coll? %) (not= :fn (:op %))) seq nd)))

(defn- amap-parts
  "The loop amap expands to (core.clj, verbatim):
     (loop [idx 0] (if (< idx l) (do (aset ret idx expr) (recur (unchecked-inc idx))) ret))
  as {:idx :lim :ret :expr}, or nil."
  [nd]
  (let [kids (:children nd) base (:p1 nd)]
    (when (and (= 1 (:i2 nd)) (= :const (:op (first kids))) (= 0 (:p1 (first kids))))
      (let [;; the loop's body is a do around the if
            unwrap (fn [n] (if (and (= :do (:op n)) (= 1 (count (:children n)))) (first (:children n)) n))
            body (unwrap (second kids))
            [test then else] (:children body)
            local? (fn [n slot] (and (= :local (:op n)) (= slot (:i2 n))))
            ;; aset's inline form casts the index: (int i)
            index? (fn [n slot] (or (local? n slot)
                                    (and (= :call (:op n)) (= 'int (op-name (first (:children n))))
                                         (local? (second (:children n)) slot))))]
        (when (and (= :if (:op body)) (= :call (:op test)) (= '< (op-name (first (:children test))))
                   (local? (second (:children test)) base)
                   (= :do (:op then)) (= 2 (count (:children then)))
                   (= :local (:op else)))
          (let [[aset-call recur-node] (:children then)
                [ah r i expr] (:children aset-call)
                [inc-call] (:children recur-node)]
            (when (and (= :call (:op aset-call)) (= 'aset (op-name ah))
                       (local? r (:i2 else)) (index? i base)
                       (= :recur (:op recur-node)) (= :call (:op inc-call))
                       ('#{unchecked-inc inc} (op-name (first (:children inc-call))))
                       (local? (second (:children inc-call)) base)
                       ;; the element must not read the result array, nor recur
                       (not-any? #(or (= :recur (:op %)) (local? % (:i2 else))) (not-in-fns expr)))
              {:idx base :lim (nth (:children test) 2) :ret (:i2 else) :expr expr})))))))

(defn- emit-amap
  "amap as a DO CONCURRENT: every element independent, each iteration's
  temporaries its own (declared in a block). Answers [lines ret-var type],
  or nil when the element is not pure -- then the loop stays serial."
  [{:keys [idx lim ret expr]} env st]
  (let [[ll le lt] (emit lim env st)
        [rv rt] (get env ret)]
    (when (and (= lt :long) (#{:doubles :longs} rt))
      (let [k (str "kc" (:n (swap! st update :n inc)))
            before (count (:decls @st))
            was-impure (:impure @st)
            _ (swap! st assoc :impure false)
            [el ee et] (emit expr (assoc env idx [k :long]) st)
            inner (subvec (:decls @st) before)
            impure? (:impure @st)
            et-ok (or (= et (if (= rt :doubles) :double :long)) (and (= rt :doubles) (= et :long)))]
        (swap! st (fn [s] (assoc s :impure was-impure :decls (subvec (:decls s) 0 before))))
        ;; do concurrent only when the body cannot fail: its procedures must
        ;; be Fortran-pure, and nothing that can fail is (can-fail?); in a
        ;; library the error check's return is not allowed there either
        ;; the index a local of its own either way: a type in the do
        ;; concurrent header, (integer(int64) :: k = ...), is newer than
        ;; gfortran 14, which refused it (Debian 13's, in the Linux gate)
        (when (and (not impure?) et-ok) (swap! st update :decls conj [k :long]))
        (when (and (not impure?) et-ok)
          (let [conc? (not (or *library* (can-fail? (conj (vec el) ee) (map #(fort-ident (name %)) (keys (:sigs @st))))))
                n (str "size(" rv ", kind=int64)")]
            [(concat ll
                     ;; a hand-written loop may run past the array: Clojure throws at
                     ;; the first index past it. Concurrent, that check is made once
                     ;; before the loop, with that same index, so the body cannot fail
                     (when conc? [(str "if (" le " > " n ") call cl_bounds(" n ", " n ")")])
                     [(if conc?
                        (str "do concurrent (" k " = 0:" le " - 1)")
                        (str "do " k " = 0, " le " - 1"))
                      "   block"]
                     (for [[v t] (distinct inner) :when (fort-type t)]
                       (str "      " (if (karr? t) (str (fort-type t) ", allocatable :: " v "(:)") (str (fort-type t) " :: " v))))
                     (map #(str "      " %) el)
                     (when-not conc? [(str "      call cl_bounds(" k ", " n ")")])
                     [(str "      " rv "(" k " + 1) = " (if (and (= rt :doubles) (= et :long)) (str "real(" ee ", real64)") ee))
                      "   end block"
                      "end do"])
             rv rt]))))))

(defn- emit-tail
  "A node in tail position: its value handed to `finish` (a function
  from an expression to the statements that deliver it), a recur jumping
  to its loop."
  [nd env st finish]
  (case (:op nd)
    :if (let [[t th el] (:children nd)]
          (if (= :const (:op t))
            ;; a constant test -- cond's :else -- picks its branch here
            (if (or (nil? (:p1 t)) (false? (:p1 t)))
              (if el (emit-tail el env st finish) (finish "" :nil))
              (emit-tail th env st finish))
          (let [[tl te tt] (emit t env st)]
          (if (not= tt :bool)
            ;; a number is truthy, so only the then branch can run
            (into tl (emit-tail th env st finish))
            (into tl (concat [(str "if (" te ") then")]
                             (map #(str "   " %) (emit-tail th env st finish))
                             ["else"]
                             (map #(str "   " %) (if el (emit-tail el env st finish)
                                                      (finish "" :nil)))
                             ["end if"]))))))
    :do (let [kids (:children nd)]
          (if (empty? kids)
            (decline "an empty do answers nil")
            (into (vec (mapcat #(first (emit % env st)) (butlast kids)))
                  (emit-tail (last kids) env st finish))))
    :let (let [[ls env'] (let [kids (:children nd) n (:i2 nd) base (:p1 nd)]
                           (reduce (fn [[ls env] i]
                                     (let [init (nth kids i)
                                           [l e t] (emit init env st)]
                                       (when (= t :none) (decline "recur in a let binding"))
                                       (if (and (karr? t) (= :local (:op init)))
                                         ;; an array is a reference: this local IS that array
                                         [(into ls l) (assoc env (+ base i) (get env (:i2 init)))]
                                         (let [v (fresh! st "x" t)]
                                           [(-> ls (into l) (conj (str v " = " e)))
                                            (assoc env (+ base i) [v t])]))))
                                   [[] env] (range n)))]
           (into ls (emit-tail (nth (:children nd) (:i2 nd)) env' st finish)))
    :recur (let [{:keys [label vars]} (:loop env)
                 [ls es ts] (emit-args (:children nd) env st)]
             (when-not label (decline "a recur with no loop to go to"))
             (doseq [[[v tv] e t] (map vector vars es ts)]
               (if (karr? tv)
                 ;; an array parameter can only be passed back as it is
                 (when (not= e v) (decline "recur passes a different array"))
                 ;; clj boxes a local a recur passes another type -- (loop
                 ;; [x 0.0] (recur 1)) answers the long 1 -- and pure
                 ;; Fortran has no box, so the function stays compiled
                 (when-not (= t tv)
                   (decline "recur changes a loop local's type"))))
             (let [pairs (remove (fn [[[_ tv]]] (karr? tv)) (map vector vars es ts))
                   tmps (mapv (fn [[[_ tv] e t]] (let [v (fresh! st "r" tv)] [v (str v " = " (if (= tv :double) (as-double e t) e))])) pairs)]
               (-> ls (into (map second tmps))
                   (into (map (fn [[[v _]] [tmp _]] (str v " = " tmp)) pairs tmps))
                   (conj (str "cycle " label)))))
    :loop (if-let [[al ae at] (some-> (amap-parts nd) (emit-amap env st))]
            (into (vec al) (finish ae at))
          (let [kids (:children nd) n (:i2 nd) base (:p1 nd)
                label (str "lp" (:n (swap! st update :n inc)))
                [ls env' vars] (reduce (fn [[ls env vars] i]
                                         (let [[l e t] (emit (nth kids i) env st)
                                               arr? (karr? t)
                                               ;; an array local is the same array under another name
                                               ;; (what `(fn ^double [^doubles a] ..)` expands to:
                                               ;; (let [a a] ..)): no copy, only a plain name may alias
                                               _ (when (and arr? (not (re-matches #"[A-Za-z_][A-Za-z0-9_]*" (str e))))
                                                   (decline "an array as a loop local"))
                                               v (if arr? e (fresh! st "q" t))]
                                           [(if arr? (into ls l) (-> ls (into l) (conj (str v " = " e))))
                                            (assoc env (+ base i) [v t])
                                            (conj vars [v t])]))
                                       [[] env []] (range n))
                body (emit-tail (nth kids n) (assoc env' :loop {:label label :vars vars}) st
                                (fn [e t] (conj (vec (finish e t)) (str "exit " label))))]
            (into ls (concat [(str label ": do")] (map #(str "   " %) body) [(str "end do " label)]))))
    ;; anything else is a value
    (let [[l e t] (emit nd env st)]
      (when (= t :none) (decline "recur is not in tail position"))
      (into l (finish e t)))))

(defn- emit
  "A node as a value: [lines expr type]."
  [nd env st]
  (case (:op nd)
    :const (lit (:p1 nd))
    :local (let [[v t] (get env (:i2 nd))]
             (when-not v (decline (str "the local `" (:p1 nd) "` is not typed")))
             [[] v t])
    :call (emit-call nd env st)
    (:if :do :let :loop)
    (let [res (atom nil)
          lines (emit-tail nd env st
                           (fn [e & [t]]
                             (let [t (or t (throw (ex-info "untyped finish" {})))
                                   r (or @res (reset! res [(when (not= t :nil) (fresh! st "v" t)) t]))]
                               (when (not= (second r) t)
                                 (if (and (num? t) (num? (second r)))
                                   (decline "the branches answer a long and a double: Clojure keeps each one's type")
                                   (decline "the branches answer different types")))
                               (if (= t :nil) [] [(str (first r) " = " e)]))))]
      (if-let [[v t] @res]
        [lines (or v "") t]
        [lines "" :none]))
    :recur [[] "" :none]
    (decline (str "`" (name (:op nd)) "` is not lowered yet"))))

;;; ---- a function: its versions ----------------------------------------

(defn- param-candidates
  "The types each parameter could have: its hint; else what the
  same-file functions it is passed to accept at that position; else by
  its uses -- an array if aget, aset, alength or a sequence function
  reads it, a string if subs or clojure.string does, a number otherwise."
  [params body start sigs records]
  (let [nodes (tree-seq coll? seq body)
        ;; (let [a a] ..) rebinds a parameter under a new slot -- what a return
        ;; hint (`^double [^doubles a]`) expands the body to -- so a use of the
        ;; new slot is a use of the parameter
        alias (into {} (for [nd nodes
                             :when (and (map? nd) (= :loop (:op nd)) (integer? (:p1 nd)))
                             i (range (:i2 nd))
                             :let [k (nth (:children nd) i nil)]
                             :when (and (map? k) (= :local (:op k)))]
                         [(+ (:p1 nd) i) (:i2 k)]))
        resolve-slot (fn [s] (loop [s s n 0] (let [t (alias s)] (if (and t (< n 16)) (recur t (inc n)) s))))
        ;; a parameter read by keywords that are all fields of a record is
        ;; that record -- each record that has them all is a candidate
        looked-up (reduce (fn [m [slot k]] (update m slot (fnil conj #{}) k)) {}
                          (for [nd nodes
                                :when (and (map? nd) (= :call (:op nd)))
                                :let [[h a] (:children nd)]
                                :when (and (= :const (:op h)) (keyword? (:p1 h)) (= :local (:op a)))]
                            [(resolve-slot (:i2 a)) (:p1 h)]))
        record-cands (fn [slot] (when-let [ks (looked-up slot)]
                                  (seq (for [[_ r] (sort-by key records)
                                             :when (every? (set (map first (:fields r))) ks)]
                                         (:type r)))))
        array-slots (set (for [nd nodes
                               :when (and (map? nd) (= :call (:op nd)))
                               :let [op (op-name (first (:children nd)))
                                     a (second (:children nd))
                                     a (if (and (= :call (:op a)) (= 'clotran-array-cast (op-name (first (:children a)))))
                                         (second (:children a)) a)]
                               :when (and (#{'aget 'aset 'alength 'aclone} op) (= :local (:op a)))]
                           (resolve-slot (:i2 a))))
        ;; a parameter passed straight to a same-file function: the types
        ;; that function's versions take in that position
        callee-types (reduce (fn [m [slot ts]] (update m slot (fnil into (sorted-set)) ts)) {}
                             (for [nd nodes
                                   :when (and (map? nd) (= :call (:op nd)))
                                   :let [op (op-name (first (:children nd))) sig (get sigs op)]
                                   :when sig
                                   [j a] (map-indexed vector (rest (:children nd)))
                                   :when (= :local (:op a))]
                               [(resolve-slot (:i2 a)) (set (for [k (keys sig) :when (= (count k) (dec (count (:children nd))))] (nth k j)))]))
        ;; a parameter subs or clojure.string reads is a string
        string-slots (set (for [nd nodes
                                :when (and (map? nd) (= :call (:op nd)))
                                :let [op (op-name (first (:children nd))) a (second (:children nd))]
                                :when (and (or (= op 'subs) (and (symbol? op) (= "clojure.string" (namespace op))))
                                           (= :local (:op a)))]
                            (resolve-slot (:i2 a))))
        ;; ... and so is one a sequence function reads from
        array-slots (into array-slots
                          (for [nd nodes
                                :when (and (map? nd) (= :call (:op nd))
                                           ('#{map filter remove reduce count every?} (op-name (first (:children nd)))))
                                :let [a (last (:children nd))]
                                :when (= :local (:op a))]
                            (resolve-slot (:i2 a))))]
    (vec (map-indexed
          (fn [i p]
            (if-let [h ('{doubles [:doubles] longs [:longs] double [:double] long [:long] clotran.host.string [:string]
                    ints [:ints] floats [:floats] shorts [:shorts] bytes [:bytes]
                    real8s [:doubles] int8s [:longs] real8 [:double] int8 [:long]
                    int4s [:ints] real4s [:floats] int2s [:shorts] int1s [:bytes]} (:tag (meta p)))]
              h
              (cond (callee-types (+ start i)) (vec (callee-types (+ start i)))
                    (record-cands (+ start i)) (vec (record-cands (+ start i)))
                    (array-slots (+ start i)) [:doubles :longs]
                    (string-slots (+ start i)) [:string]
                    :else [:double :long])))
          params))))

(defn- cartesian [colls]
  (reduce (fn [acc c] (for [a acc x c] (conj a x))) [[]] colls))

(def ^:private version-limit 8)

(defn- emit-version
  "One version of fname's arity [nargs variadic start body] for
  parameter types ts: {:name :ret :text} or {:declined why}."
  [fname [nargs variadic start body] ts sigs impure-versions printing-versions records]
  (try
    (let [_ (when variadic (decline "variadic"))
          st (atom {:n 0 :decls [] :sigs sigs :written #{} :impure-versions impure-versions
                    :printing-versions printing-versions :records records})
          pnames (mapv #(str "p" %) (range nargs))
          ;; scalar parameters are copied into locals, so a recur can rebind them
          locals (mapv (fn [t] (when-not (karr? t) (fresh! st "a" t))) ts)
          env (into {} (map-indexed (fn [i t] [(+ start i) [(if (karr? t) (pnames i) (locals i)) t]]) ts))
          label (str "top" (:n (swap! st update :n inc)))
          ret (atom nil)
          body-lines (emit-tail body (assoc env :loop {:label label
                                                       :vars (vec (map-indexed (fn [i t] [(if (karr? t) (pnames i) (locals i)) t]) ts))})
                                st
                                (fn [e t]
                                  (when (and @ret (not= @ret t))
                                    (decline "the function answers different types on different paths"))
                                  (reset! ret t)
                                  (if (= t :nil)
                                    [(str "exit " label)]
                                    [(str "r = " e) (str "exit " label)])))
          rt @ret
          _ (when-not rt (decline "no path answers a value"))
          _ (when (and (karr? rt) (not (#{:doubles :longs} rt)))
              (decline "an array result of that kind is not lowered yet"))
          ;; in a library, the error flag after every call that can fail:
          ;; the support procedures and this file's own functions
          body-lines (if *library*
                       (with-err body-lines (into fallible (map #(fort-ident (name %)) (keys sigs))))
                       body-lines)
          params (str/join ", " (if *library* (conj pnames "err") pnames))
          nm (str (fort-ident (name fname)) "__" (str/join "_" (map suffix ts)))
          {:keys [decls written]} @st
          decl-lines (for [[v t] (distinct decls) :when (fort-type t)]
                       (if (karr? t)
                         (str "    " (fort-type t) ", allocatable :: " v "(:)")
                         (str "    " (fort-type t) " :: " v)))
          sub? (= rt :nil)
          ;; pure in Clojure's sense -- no printing, no write to a parameter
          ;; array, nothing impure called -- which decides what may be lowered
          ;; inline and dispatched to; Fortran's `pure` besides only when the
          ;; body cannot fail (can-fail?)
          pure? (and (not (:impure @st)) (empty? (filter (set pnames) written)))
          own (map #(fort-ident (name %)) (keys sigs))
          pre (if (and pure? (not *library*) (not (can-fail? body-lines own))) "pure " "")]
      ;; :prints -- it writes to standard output, Fortran's way, which a
      ;; library must not (the REPL's *out* would not see it): such a
      ;; version is not dispatched to (clotran.compiler)
      {:name nm :ret rt :calls (:calls @st #{}) :pure pure? :prints (boolean (:prints @st))
       :text (str (if sub?
                    (str "  " pre "subroutine " nm "(" params ")\n")
                    (str "  " pre "function " nm "(" params ") result(r)\n"))
                  (when *library* "    type(cl_err), intent(inout) :: err\n")
                  (apply str (for [[i t] (map-indexed vector ts)]
                               (str "    " (if (= t :string) "character(len=*), intent(in)" (fort-type t))
                                    (cond
                                      (karr? t)
                                      (str ", intent(" (if (written (pnames i)) "inout" "in") ") :: " (pnames i) "(:)\n")
                                      (= t :string) (str " :: " (pnames i) "\n")
                                      :else (str ", intent(in) :: " (pnames i) "\n")))))
                  (when-not sub? (if (karr? rt)
                                   (str "    " (fort-type rt) ", allocatable :: r(:)\n")
                                   (str "    " (fort-type rt) " :: r\n")))
                  (str/join "\n" decl-lines) (when (seq decl-lines) "\n")
                  (apply str (for [[i t] (map-indexed vector ts) :when (not (karr? t))]
                               (str "    " (locals i) " = " (pnames i) "\n")))
                  ;; a library's array result is allocated (empty) before
                  ;; anything can fail: a failed call returns on err, and the
                  ;; caller's copy of an unallocated result is a crash
                  (when (and *library* (not sub?) (karr? rt)) "    allocate(r(0))\n")
                  "    " label ": do\n"
                  (apply str (map #(str "       " % "\n") body-lines))
                  "    end do " label "\n"
                  (if sub? (str "  end subroutine " nm "\n") (str "  end function " nm "\n")))})
    (catch clotran.host.exception e
      (if-let [why (::decline (ex-data e))]
        {:declined why}
        (throw e)))))

;;; ---- a namespace -------------------------------------------------------

(declare generate*)

(defn generate
  "The tier-A functions of `src` as Fortran: {:text the file, :emitted
  {ns/name [versions]}, :skipped {ns/name why}}. Functions are done in
  file order, so a call to an earlier one sees its versions.

  With {:library true} the module is for a compiled library (PLAN step
  13): nothing pure, the error flag threaded through, the support
  module named after this one, and every specific procedure public so
  the library's dispatcher can call the one the argument tags pick."
  ([src] (generate src nil))
  ([src opts]
   (binding [*library* (boolean (:library opts))]
     (generate* src))))

(defn- generate* [src]
  (let [cls (tiers/classify src)
        text (clotran-slurp src)
        [_ ns-name] (read-string text)
        forms (binding [*ns* (the-ns ns-name)] (clotran-read-forms src))
        defns (for [f forms :when (and (seq? f) (#{'defn 'defn-} (first f)))
                    :let [fnf (loader/fn-form f)] :when fnf]
                [(symbol (str ns-name) (str (second f))) fnf])
        records (records-of forms ns-name)
        private? (set (for [f forms :when (and (seq? f) (#{'defn 'defn-} (first f))
                                                (or (= 'defn- (first f)) (:private (meta (second f)))))]
                        (symbol (str ns-name) (str (second f)))))
        result
        (reduce
         (fn [{:keys [sigs] :as acc} [s fnf]]
           (if (not= :A (get-in cls [s :tier]))
             (assoc-in acc [:skipped s] (str "tier " (name (get-in cls [s :tier] :B)) ": see --report"))
             (let [top (binding [*ns* (the-ns ns-name)] (clotran-ast fnf))
                   ;; every fixed arity is its own set of versions under the one
                   ;; generic name -- Fortran tells them apart by argument count.
                   ;; Most arguments first: (f x) usually calls (f x 1), so the
                   ;; longer arity's versions are there to be called.
                   arities (sort-by #(- (first %)) (second (:p1 (:p1 top))))
                   pvecs (or (seq (filter vector? fnf)) (map first (filter seq? fnf)))
                   one (fn [acc [nargs variadic start body :as ar]]
                         (let [params (vec (or (first (filter #(and (= nargs (count %)) (not-any? #{'&} %)) pvecs))
                                               (take nargs (first pvecs))))
                               cands (param-candidates params body start (:sigs acc) records)
                               combos (cartesian cands)]
                           (cond
                             variadic (update-in acc [:why s] (fnil conj []) "variadic: its rest arguments arrive as a heap list")
                             (> (count combos) version-limit)
                             (update-in acc [:why s] (fnil conj [])
                                        (str (count combos) " type combinations; hint some parameters (^double, ^doubles, ...) to settle them"))
                             :else
                             (let [vs (for [ts combos] (assoc (emit-version s ar ts (:sigs acc) (:impure acc) (:printing acc) records) :ts ts))
                                   ok (remove :declined vs)]
                               (-> acc
                                   (update-in [:why s] (fnil into []) (when (empty? ok) (distinct (map :declined vs))))
                                   (update-in [:emitted s] (fnil into []) ok)
                                   (update-in [:sigs s] (fnil into {}) (map (fn [v] [(:ts v) (:ret v)]) ok))
                                   (update :impure into (for [v ok :when (not (:pure v))] [s (:ts v)]))
                                   (update :printing into (for [v ok :when (:prints v)] [s (:ts v)]))
                                   (update-in [:dropped s] (fnil into []) (keep #(when (:declined %) [(:ts %) (:declined %)]) vs)))))))
                   acc (reduce one acc arities)]
               (if (seq (get-in acc [:emitted s]))
                 (update acc :why dissoc s)
                 (-> acc
                     (assoc-in [:skipped s] (str/join "; " (distinct (get-in acc [:why s]))))
                     (update :why dissoc s)
                     (update :emitted dissoc s)
                     (update :sigs dissoc s))))))
         {:sigs {} :emitted {} :skipped {} :dropped {} :impure #{} :printing #{}}
         defns)
        mod-name (str (fort-ident ns-name) "_pure")
        ;; A private function is called only from this file, so only the
        ;; versions reachable from a public one are kept (PLAN.md step 13:
        ;; types from the calls in the program); a public one keeps them all.
        all (:emitted result)
        reached (loop [seen (set (for [[s vs] all :when (not (private? s)) v vs] [s (:ts v)]))]
                  (let [more (into seen (for [[s vs] all v vs :when (seen [s (:ts v)]) c (:calls v)] c))]
                    (if (= more seen) seen (recur more))))
        emitted (into {} (for [[s vs] all
                               :let [kept (filterv #(reached [s (:ts %)]) vs)]
                               :when (seq kept)]
                           [s kept]))
        pruned (into {} (for [[s vs] all
                              :let [gone (vec (remove #(reached [s (:ts %)]) vs))]
                              :when (seq gone)]
                          [s (mapv :ts gone)]))]
    (assoc result
           :records records
           :emitted emitted
           :pruned pruned
           :module mod-name
           :text (str "! GENERATED by clotran.purefort from " src ". Do not edit; regenerate.\n"
                      (if *library*
                        (str "! The tier-A functions of " ns-name " for its compiled library (PLAN step 13):\n"
                             "! an error raised in the running clotran and returned on, nothing pure.\n\n")
                        (str "! Pure Fortran: no clotran runtime. The tier-A functions of " ns-name ",\n"
                             "! one generic name each, one specific procedure per argument type.\n\n"))
                      (support-text *library* (if *library* (str mod-name "_rt") "clotran_pure")) "\n"
                      "module " mod-name "\n"
                      "  use iso_fortran_env, only: int8, int16, int32, int64, real32, real64\n"
                      "  use " (if *library* (str mod-name "_rt") "clotran_pure") "\n"
                      "  implicit none\n"
                      "  private\n"
                      (when *library*
                        (str "  public :: cl_err\n"
                             (apply str (for [[_ vs] (sort-by key emitted) v vs]
                                          (str "  public :: " (:name v) "\n")))))
                      (apply str (for [[_ r] (sort-by key records)]
                                   (str "  public :: " (type-name (:type r)) "\n"
                                        "  type :: " (type-name (:type r)) "\n"
                                        (apply str (for [[f ft] (:fields r)]
                                                     (str "     " (fort-type ft) " :: " (fort-ident* (name f)) "\n")))
                                        "  end type " (type-name (:type r)) "\n")))
                      (apply str (for [[s vs] (sort-by key emitted)]
                                   (str (when-not (private? s) (str "  public :: " (fort-ident (name s)) "\n"))
                                        "  interface " (fort-ident (name s)) "\n"
                                        "     module procedure " (str/join ", " (map :name vs)) "\n"
                                        "  end interface\n")))
                      "contains\n"
                      (str/join "\n" (for [[_ vs] (sort-by key emitted) v vs] (:text v)))
                      "end module " mod-name "\n"))))

(defn report
  "clotran compile --report: the tier report, then a note (N003) for each
  function it calls tier A that pure Fortran declines, with the reason, so
  --report and --pure tell the same story. Answers the classification."
  [src]
  (let [r (tiers/report src)
        g (generate src)]
    (doseq [[s why] (sort-by key (:skipped g))
            :when (= :A (get-in r [s :tier]))]
      (println (str "note[N003]: tier A, but not lowered to pure Fortran: " why "\n"
                    "  in `" s "`\n"
                    "  = help: see clotran explain N003\n")))
    r))
