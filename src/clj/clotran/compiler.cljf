(ns clotran.compiler
  "Compiles a Clojure function to Fortran.

  The input is `(clotran-ast form)` -- the SAME resolved tree the
  executor runs, so there is no second front end that could disagree
  with the first. Every name in it is already a frame slot or a
  constant; this namespace does no analysis of its own and must not
  start.

  The output is Fortran source for one procedure per function, plus a
  `clotran_install` that hands each to `clotran_def_fn`. The procedures
  call the runtime through the C convention (`ClotranABI.f90`), never
  through a Fortran module, so a library built by any compiler loads
  into any clotran.

  WHAT IT REFUSES. A function the generator does not fully understand
  is DECLINED -- `compile-fn` answers nil -- and stays interpreted at
  today's speed. Nothing is half-compiled. Declining rather than
  guessing is what lets this be incomplete without the language losing
  anything, and the list of reasons is `decline-reason` below, so the
  next kind to teach it is always visible.

  The one thing it may not do is change what a form MEANS.
  `scripts/compiler-check` runs the same forms interpreted and compiled
  and compares values, so a generator bug is a difference rather than a
  silent wrong answer."
  (:require [clojure.string :as str]))

;;; ---- the declarations a generated file needs ------------------------
;;;
;;; A generated library cannot `use` a clotran module: a module file is
;;; a private format tied to one compiler and one version of it. So the
;;; entry points it calls are declared in its own source, from their C
;;; bindings alone. This block is the canonical copy.

(def ^:private runtime-decls
  "module clotran_rt_decl
  use iso_c_binding
  implicit none
  interface
     function clotran_frame_enter(n) bind(C, name=\"clotran_frame_enter\") result(base)
       import :: c_int
       integer(c_int), value :: n
       integer(c_int) :: base
     end function clotran_frame_enter
     subroutine clotran_frame_leave(base) bind(C, name=\"clotran_frame_leave\")
       import :: c_int
       integer(c_int), value :: base
     end subroutine clotran_frame_leave
     subroutine clotran_set_nil(slot) bind(C, name=\"clotran_set_nil\")
       import :: c_int
       integer(c_int), value :: slot
     end subroutine clotran_set_nil
     subroutine clotran_set_int(slot, n) bind(C, name=\"clotran_set_int\")
       import :: c_int, c_int64_t
       integer(c_int), value :: slot
       integer(c_int64_t), value :: n
     end subroutine clotran_set_int
     subroutine clotran_set_real(slot, x) bind(C, name=\"clotran_set_real\")
       import :: c_int, c_double
       integer(c_int), value :: slot
       real(c_double), value :: x
     end subroutine clotran_set_real
     subroutine clotran_set_bool(slot, b) bind(C, name=\"clotran_set_bool\")
       import :: c_int
       integer(c_int), value :: slot, b
     end subroutine clotran_set_bool
     subroutine clotran_set_str(slot, chars, n) bind(C, name=\"clotran_set_str\")
       import :: c_int, c_char
       integer(c_int), value :: slot
       character(kind=c_char), intent(in) :: chars(*)
       integer(c_int), value :: n
     end subroutine clotran_set_str
     subroutine clotran_copy(dst, src) bind(C, name=\"clotran_copy\")
       import :: c_int
       integer(c_int), value :: dst, src
     end subroutine clotran_copy
     function clotran_tag(slot) bind(C, name=\"clotran_tag\") result(t)
       import :: c_int
       integer(c_int), value :: slot
       integer(c_int) :: t
     end function clotran_tag
     function clotran_int(slot) bind(C, name=\"clotran_int\") result(n)
       import :: c_int, c_int64_t
       integer(c_int), value :: slot
       integer(c_int64_t) :: n
     end function clotran_int
     function clotran_real(slot) bind(C, name=\"clotran_real\") result(x)
       import :: c_int, c_double
       integer(c_int), value :: slot
       real(c_double) :: x
     end function clotran_real
     function clotran_array_view(slot, kind, ptr, n) bind(C, name=\"clotran_array_view\") result(ok)
       import :: c_int, c_ptr, c_int64_t
       integer(c_int), value :: slot, kind
       type(c_ptr), intent(out) :: ptr
       integer(c_int64_t), intent(out) :: n
       integer(c_int) :: ok
     end function clotran_array_view
     function clotran_bool(slot) bind(C, name=\"clotran_bool\") result(b)
       import :: c_int
       integer(c_int), value :: slot
       integer(c_int) :: b
     end function clotran_bool
     subroutine clotran_frame_new(dst, n) bind(C, name=\"clotran_frame_new\")
       import :: c_int
       integer(c_int), value :: dst, n
     end subroutine clotran_frame_new
     subroutine clotran_frame_get(dst, fr, i) bind(C, name=\"clotran_frame_get\")
       import :: c_int
       integer(c_int), value :: dst, fr, i
     end subroutine clotran_frame_get
     subroutine clotran_frame_put(fr, i, src) bind(C, name=\"clotran_frame_put\")
       import :: c_int
       integer(c_int), value :: fr, i, src
     end subroutine clotran_frame_put
     function clotran_call_slots(dst, fn, argbase, nargs) bind(C, name=\"clotran_call_slots\") result(st)
       import :: c_int
       integer(c_int), value :: dst, fn, argbase, nargs
       integer(c_int) :: st
     end function clotran_call_slots
     subroutine clotran_deref(dst, var) bind(C, name=\"clotran_deref\")
       import :: c_int
       integer(c_int), value :: dst, var
     end subroutine clotran_deref
     function clotran_eval_node(dst, node, fr) bind(C, name=\"clotran_eval_node\") result(st)
       import :: c_int
       integer(c_int), value :: dst, node, fr
       integer(c_int) :: st
     end function clotran_eval_node
     subroutine clotran_pool_get(dst, h, i) bind(C, name=\"clotran_pool_get\")
       import :: c_int
       integer(c_int), value :: dst, h, i
     end subroutine clotran_pool_get
     function clotran_def_fn(ns, nsn, name, namen, fp, arity) bind(C, name=\"clotran_def_fn\") result(st)
       import :: c_int, c_char, c_funptr
       character(kind=c_char), intent(in) :: ns(*), name(*)
       integer(c_int), value :: nsn, namen, arity
       type(c_funptr), value :: fp
       integer(c_int) :: st
     end function clotran_def_fn
  end interface
contains
  function ctext(s) result(a)
    character(len=*), intent(in) :: s
    character(kind=c_char) :: a(len(s))
    integer :: i
    do i = 1, len(s)
       a(i) = s(i:i)
    end do
  end function ctext
end module clotran_rt_decl
")

;;; ---- what the generator understands ---------------------------------

(defn- spellable?
  "A constant a generated procedure can write into its own source.
  Everything else -- a collection, a Var, a string, the function
  analysis folded into a call head -- goes in the CONSTANT POOL
  instead.

  A STRING could be written as a Fortran literal, and deliberately is
  not: its quotes, newlines and byte length are each a way to emit a
  file that compiles into a different string. A BigInt is `integer?`
  and must not be written as a long, so this asks `int?`. A double
  that is not finite has no Fortran spelling, and Long/MIN_VALUE
  cannot be written as a negative literal because its magnitude does
  not fit."
  [v]
  (or (nil? v) (true? v) (false? v)
      (and (int? v) (not= v Long/MIN_VALUE))
      (and (double? v) (not (NaN? v)) (not (infinite? v)))))

(defn- walk-nodes
  "Every node in the tree, depth first."
  [t]
  (filter #(and (map? %) (:op %)) (tree-seq coll? seq t)))

(def ^:private compiled-ops
  "The node kinds the generator emits code for. Everything else goes
  through the escape hatch, which is slower and still correct."
  #{:const :local :if :do :call :var :let :loop :recur})

(defn- pooled
  "The value this node needs out of the pool, or nil if it needs none.

  A :var node holds the Var itself, so the pool holds the Var and the
  procedure derefs it at the call -- which is what makes a redefinition
  visible to compiled code. A :const holding anything unspellable holds
  exactly the value the interpreter would have used, so compiling
  cannot change what the form means."
  [nd]
  (cond
    (= :var (:op nd)) {:kind :var :value (:p1 nd)}
    (and (= :const (:op nd)) (not (spellable? (:p1 nd)))) {:kind :const :value (:p1 nd)}
    ;; a kind we do not emit: the pool holds the NODE and the
    ;; interpreter runs it
    (not (compiled-ops (:op nd))) {:kind :node :value (:node nd)}
    :else nil))

(defn decline-reason
  "Why this function cannot be compiled yet, or nil if it can. A list of
  reasons rather than a boolean, so the next thing to teach the
  generator is always the answer to a question."
  [tmpl]
  (let [[_ arities captures _ selfslot _] tmpl
        body (some-> arities first (nth 3))
        nodes (walk-nodes body)]
    (cond
      (nil? body) "no body"
      (> (count arities) 1) "more than one arity"
      (true? (nth (first arities) 1)) "variadic"
      (seq captures) "closes over an outer local"
      (not= -1 selfslot) "refers to itself by name"
      ;; A recur inside a subtree the interpreter runs would rebind the
      ;; frame and hand back the recur marker as a VALUE; the compiled
      ;; loop around it would never go round again. Declined rather
      ;; than wrong.
      (some (fn [nd] (and (not (compiled-ops (:op nd)))
                          (some #(= :recur (:op %)) (rest (walk-nodes nd)))))
            nodes)
      "a recur inside a form the generator hands to the interpreter"
      :else nil)))

(defn- fn-pool
  "Everything the body needs out of the pool, in order, without
  duplicates. Each gets one read at the top of the procedure rather
  than one per use."
  [body]
  (->> (walk-nodes body) (keep pooled) distinct vec))

;;; ---- types ----------------------------------------------------------
;;;
;;; What makes compiled code FAST rather than merely compiled. A profile
;;; of the first compiled loop had two thirds of its time in the generic
;;; numeric path -- builtin dispatch, tag checks, argument slots -- for
;;; an addition. A value PROVEN to be a long is a Fortran integer(8),
;;; and (+ i 1) on two of them is one add and one overflow test.
;;;
;;; The rules are Clojure's own, which is why they are not a deviation:
;;; a loop or let local takes the primitive type of its init, so
;;; (loop [i 0] ...) has a primitive long `i`, and a parameter with no
;;; hint is boxed. What real Clojure does with :inline on +, <, inc and
;;; the rest -- call Numbers directly rather than through the Var -- is
;;; what this does too.
;;;
;;; Types: :long, :double, :bool, :any (boxed), :none (a recur, which
;;; produces nothing to its surroundings).

(defn- prim? [t] (#{:long :double :bool} t))
(defn- num? [t] (#{:long :double} t))
(defn- join [a b] (cond (= a :none) b (= b :none) a (= a b) a :else :any))

(def ^:private op-kinds
  '{+ :arith, - :arith, * :arith, / :div, inc :inc, dec :dec,
    < :cmp, > :cmp, <= :cmp, >= :cmp, == :cmp, = :eq,
    zero? :pred, pos? :pred, neg? :pred,
    aget :aget, aset :aset, alength :alength,
    int :to-int, long :to-long, double :to-double})

(def ^:private fortran-op
  '{+ "+", - "-", * "*", / "/", < "<", > ">", <= "<=", >= ">=", == "==", = "=="})

(defn- head-op
  "[kind sym] for a call head that is one of the numeric ops, or nil.

  A head analysis FOLDED to a builtin carries the builtin's name on
  :builtin -- the object is fresh per analysis, so identity cannot
  tell + from anything else. A head that is still a Var lookup is
  recognised by being the very Var clojure.core has for the op."
  [head]
  (let [s (case (:op head)
            :const (some-> (:builtin head) name symbol)
            :var (some (fn [s] (when (identical? (:p1 head) (ns-resolve 'clojure.core s)) s))
                       (keys op-kinds))
            nil)]
    (when-let [k (and s (op-kinds s))] [k s])))

(declare infer)

(defn- av-name
  "The Fortran pointer to an array parameter's buffer, one per kind: a
  procedure speculating double then long declares both."
  [slot t]
  (str "av" (if (= t :doubles) "d" "l") slot))

(defn- op-args
  "The argument nodes of a numeric op. The analyser puts Clojure's
  checkcast in front of an array-hinted argument of aget, aset and
  alength, (clotran-array-cast a :doubles); where the version guard has
  already proved `a` is that array, the cast is dropped and the op sees
  the local."
  [nd kind env]
  (let [args (vec (rest (:children nd)))
        a (first args)]
    (if (and (#{:aget :aset :alength} kind)
             (= :call (:op a))
             (= 'clotran-array-cast (some-> (:builtin (first (:children a))) name symbol))
             (let [[_ inner hint] (:children a)]
               (= (infer inner env) (:p1 hint))))
      (assoc args 0 (second (:children a)))
      args)))

(defn- const-type [v]
  (cond (and (int? v) (spellable? v)) :long
        (and (double? v) (spellable? v)) :double
        (or (true? v) (false? v)) :bool
        :else :any))

(defn- call-type [nd env]
  (let [[kind _] (head-op (first (:children nd)))
        ts (mapv #(infer % env) (op-args nd kind env))
        n (count ts)]
    (case kind
      :arith (if (and (= n 2) (every? num? ts))
               (if (every? #{:long} ts) :long :double)
               :any)
      :div (if (and (= n 2) (every? num? ts) (some #{:double} ts)) :double :any)
      (:inc :dec) (if (and (= n 1) (num? (first ts))) (first ts) :any)
      ;; one boxed operand is fine: its tag is checked at run time
      :cmp (if (and (= n 2) (some num? ts) (every? #(or (num? %) (= :any %)) ts)) :bool :any)
      :eq (if (and (= n 2) (num? (first ts)) (= (first ts) (second ts))) :bool :any)
      :pred (if (and (= n 1) (num? (first ts))) :bool :any)
      ;; an array is typed only through a hinted parameter, so its
      ;; argument is always a local
      :aget (if (and (= n 2) (#{:doubles :longs} (ts 0)) (= :long (ts 1)))
              (if (= :doubles (ts 0)) :double :long) :any)
      :aset (if (and (= n 3) (#{:doubles :longs} (ts 0)) (= :long (ts 1))
                     (if (= :doubles (ts 0)) (num? (ts 2)) (= :long (ts 2))))
              (if (= :doubles (ts 0)) :double :long) :any)
      :alength (if (and (= n 1) (#{:doubles :longs} (ts 0))) :long :any)
      (:to-int :to-long) (if (and (= n 1) (num? (ts 0))) :long :any)
      :to-double (if (and (= n 1) (num? (ts 0))) :double :any)
      :any)))

(defn- bind-types
  "The types a let's slots take from their inits, in order, each init
  seeing the bindings before it."
  [nd env]
  (let [kids (:children nd) n (:i2 nd) base (:p1 nd)]
    (reduce (fn [e i] (assoc-in e [:slots (+ base i)] (infer (nth kids i) e)))
            env (range n))))

(defn- loop-env
  "A loop's slots: the join of each init's type and every recur's
  argument type for that slot, iterated until it settles. A slot that
  does not settle is boxed."
  [nd env]
  (let [kids (:children nd) n (:i2 nd) base (:p1 nd)]
    (loop [e (bind-types nd env) k 0]
      (let [acc (atom {})
            _ (infer (nth kids n) (assoc e :recurs acc))
            rts (get @acc base [])
            e' (reduce (fn [e i]
                         (update-in e [:slots (+ base i)]
                                    (fn [t] (reduce join t (map #(nth % i :any) rts)))))
                       e (range n))]
        (cond (= e' e) e
              (> k 4) (reduce (fn [e i] (assoc-in e [:slots (+ base i)] :any)) e (range n))
              :else (recur e' (inc k)))))))

(defn- infer
  "The type a node's value is PROVEN to have, given the types of the
  slots in scope."
  [nd env]
  (case (:op nd)
    :const (const-type (:p1 nd))
    :local (get-in env [:slots (:i2 nd)] :any)
    :do (if (seq (:children nd)) (last (mapv #(infer % env) (:children nd))) :any)
    :if (let [[t th el] (:children nd)]
          (infer t env)
          (join (infer th env) (if el (infer el env) :any)))
    :let (infer (nth (:children nd) (:i2 nd)) (bind-types nd env))
    :loop (infer (nth (:children nd) (:i2 nd)) (loop-env nd env))
    :recur (do (when-let [a (:recurs env)]
                 (swap! a update (nth (:p1 nd) 1) (fnil conj [])
                        (mapv #(infer % env) (:children nd))))
               :none)
    :call (call-type nd env)
    :any))

;;; ---- emitting -------------------------------------------------------

(defn- fort-ident
  "A Fortran identifier from a Clojure name. Fortran allows letters,
  digits and underscore and nothing else -- not the dot a namespace
  is full of, and not the characters `munge` keeps. Case is folded
  because Fortran is case-insensitive and two names differing only in
  case would collide in the symbol table."
  [s]
  (str/lower-case (str/replace s #"[^A-Za-z0-9]" "_")))

(defn- fort-str
  "A Fortran string literal: the only escape is a doubled quote."
  [s]
  (str "\"" (str/replace s "\"" "\"\"") "\""))

(defn- emit-const [slot v]
  (cond
    (nil? v)     [(str "call clotran_set_nil(" slot ")")]
    (true? v)    [(str "call clotran_set_bool(" slot ", 1_c_int)")]
    (false? v)   [(str "call clotran_set_bool(" slot ", 0_c_int)")]
    (int? v)     [(str "call clotran_set_int(" slot ", " v "_c_int64_t)")]
    (double? v)  [(str "call clotran_set_real(" slot ", " v "_c_double)")]
    :else        (throw (ex-info "not spellable" {:value v}))))

;; A procedure's temporaries are slots b+2 upwards; b+1 holds the frame
;; of locals. `next` is the next free one and `high` the most ever used,
;; which is what the frame at the top has to reserve.
(defn- fresh [st] [(:next st) (-> st (update :next inc) (update :high max (:next st)))])

;; Primitive values live in Fortran variables: a slot's own is l<slot>,
;; d<slot> or q<slot> by type, and a temporary is ti/td/tl<n>.
(defn- slot-var [slot t] (str (case t :long "l" :double "d" :bool "q") slot))

(defn- declare-var [st nm t] (update st :decls (fnil conj #{}) [nm t]))

(defn- tmp [st t]
  (let [k (:ntmp st 0)
        nm (str (case t :long "ti" :double "td" :bool "tl") k)]
    [nm (-> st (assoc :ntmp (inc k)) (declare-var nm t))]))

(defn- box
  "The statement that puts a primitive expression into a slot as a value."
  [slot t expr]
  (case t
    :long (str "call clotran_set_int(b + " slot ", " expr ")")
    :double (str "call clotran_set_real(b + " slot ", " expr ")")
    :bool (str "call clotran_set_bool(b + " slot ", merge(1_c_int, 0_c_int, " expr "))")))

(defn- unbox [t slot]
  (case t
    :long (str "clotran_int(b + " slot ")")
    :double (str "clotran_real(b + " slot ")")
    :bool (str "(clotran_bool(b + " slot ") /= 0)")))

(defn- coerce
  "A long where a double is wanted is widened, as Clojure's Numbers
  does. Nothing else is ever asked for."
  [expr from to]
  (cond (= from to) expr
        (and (= from :long) (= to :double)) (str "real(" expr ", c_double)")
        :else (throw (ex-info "bad coerce" {:from from :to to}))))

(defn- lit
  "A primitive literal, parenthesised: a negative one after an operator
  is two operators in a row, which Fortran does not allow."
  [v t]
  (case t
    :long (str "(" v "_c_int64_t)")
    :double (str "(" (double v) "_c_double)")
    :bool (if v ".true." ".false.")))

(def ^:private err-return
  ["if (st /= 0) then" "   call clotran_frame_leave(b)" "   return" "end if"])

(declare gen gp)

(defn- slow-call
  "The GENERIC call, for when the fast path cannot answer: an overflow
  about to happen, or an operand whose tag is not a number. It is the
  interpreter's own path, so it raises exactly what Clojure raises;
  when it does not raise, its answer is read back as the type the
  surrounding code expects.

  operands are [expr type] pairs, where the type :slot means the
  expression is already a slot holding a value."
  [nd operands r rt st]
  (let [head (first (:children nd))
        hs (get (:pool st) (pooled head))
        n (count operands)
        [blk st] (reduce (fn [[bl st] _] (let [[s st'] (fresh st)] [(conj bl s) st']))
                         [[] st] (range n))
        [res st] (fresh st)]
    [(concat (map (fn [s [e t]]
                    (if (= t :slot)
                      (str "call clotran_copy(b + " s ", b + " e ")")
                      (box s t e)))
                  blk operands)
             [(str "st = clotran_call_slots(b + " res ", b + " hs ", b + "
                   (dec (first blk)) ", " n "_c_int)")]
             err-return
             [(str r " = " (unbox rt res))])
     st]))

(defn- lit-long
  "The value of a long LITERAL as `lit` writes it, or nil for anything
  else."
  [e]
  (some-> (re-matches #"\((-?\d+)_c_int64_t\)" e) second parse-long))

(defn- ovf
  "True when a long add, subtract or multiply is about to overflow.
  Checked BEFORE the operation, because signed overflow in Fortran is
  not defined. A multiply is judged in double precision, with a margin
  below 2^63; a product that is merely large takes the generic path,
  which answers it exactly.

  When the right operand is a LITERAL its sign is known, and only the
  half of the test that can run is written. Writing both let gfortran
  fold the other half -- -huge - 1 - 1 -- and refuse the file for an
  overflow in code that could never execute."
  [sym a b]
  (let [h "huge(0_c_int64_t)"
        k (lit-long b)]
    (case sym
      (+ -) (let [pos (str "(" a " > " h (if (= sym '+) " - " " + ") b ")")
                  neg (str "(" a " < -" h " - 1_c_int64_t " (if (= sym '+) "- " "+ ") b ")")]
              (cond
              (nil? k) (if (= sym '+)
                         (str "(" b " > 0 .and. " pos ") .or. (" b " < 0 .and. " neg ")")
                         (str "(" b " < 0 .and. " pos ") .or. (" b " > 0 .and. " neg ")"))
              (zero? k) ".false."
              ;; + overflows upward only for a positive b; - for a negative
              (= (pos? k) (= sym '+)) pos
              :else neg))
      * (str "abs(real(" a ", c_double) * real(" b ", c_double)) > 9.0e18_c_double"))))

(defn- gp-call
  "A numeric op, primitive in and out. Answers [code expr state] with
  expr a Fortran variable of type t."
  [nd t st]
  (let [[kind sym] (head-op (first (:children nd)))
        args (op-args nd kind (:env st))
        ats (mapv #(infer % (:env st)) args)
        fop (fortran-op sym)]
    (case kind
      ;; ARRAYS, through the Fortran pointer the version guard set up. An
      ;; index out of range takes the generic call, which raises what
      ;; Clojure raises; the array for it is read from the frame, where
      ;; the parameter still is.
      ;; CASTS, by RT's own range rules: a value out of range takes the
      ;; generic call, which throws what Clojure throws. (aget a i)
      ;; inlines to (aget a (int i)), so without these no index was ever
      ;; typed.
      :to-double
      (let [[c a st] (gp (args 0) (ats 0) st)]
        [c (coerce a (ats 0) :double) st])

      (:to-int :to-long)
      (let [at (ats 0)
            [c a st] (gp (args 0) at st)
            [r st] (tmp st :long)
            in-range (cond
                       (and (= at :long) (= kind :to-long)) nil
                       (= at :long) (str a " >= -2147483648_c_int64_t .and. " a " <= 2147483647_c_int64_t")
                       (= kind :to-int) (str a " >= -2147483648.0_c_double .and. " a " <= 2147483647.0_c_double")
                       :else (str "abs(" a ") < 9.2e18_c_double"))
            conv (if (= at :long) a (str "int(" a ", c_int64_t)"))]
        (if (nil? in-range)
          [c a st]
          (let [[slow st] (slow-call nd [[a at]] r :long st)]
            [(concat c [(str "if (" in-range ") then") (str "   " r " = " conv) "else"]
                     (map #(str "   " %) slow) ["end if"])
             r st])))

      :alength
      [[] (str "an" (:i2 (args 0))) st]

      :aget
      (let [aslot (:i2 (args 0))
            [ci i st] (gp (args 1) :long st)
            [r st] (tmp st t)
            [as st] (fresh st)
            [slow st] (slow-call nd [[as :slot] [i :long]] r t st)]
        [(concat ci
                 [(str "if (" i " >= 0 .and. " i " < an" aslot ") then")
                  (str "   " r " = " (av-name aslot (ats 0)) "(" i " + 1)")
                  "else"
                  (str "   call clotran_frame_get(b + " as ", b + 1, " aslot "_c_int)")]
                 (map #(str "   " %) slow)
                 ["end if"])
         r st])

      :aset
      (let [aslot (:i2 (args 0))
            [ci i st] (gp (args 1) :long st)
            [cv v st] (gp (args 2) t st)
            [r st] (tmp st t)
            [as st] (fresh st)
            [slow st] (slow-call nd [[as :slot] [i :long] [v t]] r t st)]
        [(concat ci cv
                 [(str "if (" i " >= 0 .and. " i " < an" aslot ") then")
                  (str "   " (av-name aslot (ats 0)) "(" i " + 1) = " v)
                  (str "   " r " = " v)
                  "else"
                  (str "   call clotran_frame_get(b + " as ", b + 1, " aslot "_c_int)")]
                 (map #(str "   " %) slow)
                 ["end if"])
         r st])

      :arith
      (let [[c1 a st] (gp (args 0) t st)
            [c2 b st] (gp (args 1) t st)
            [r st] (tmp st t)]
        (if (= t :double)
          [(concat c1 c2 [(str r " = " a " " fop " " b)]) r st]
          (let [[slow st] (slow-call nd [[a :long] [b :long]] r :long st)]
            [(concat c1 c2 [(str "if (" (ovf sym a b) ") then")]
                     (map #(str "   " %) slow)
                     ["else" (str "   " r " = " a " " fop " " b) "end if"])
             r st])))

      :div
      (let [[c1 a st] (gp (args 0) :double st)
            [c2 b st] (gp (args 1) :double st)
            [r st] (tmp st :double)]
        [(concat c1 c2 [(str r " = " a " / " b)]) r st])

      (:inc :dec)
      (let [[c1 a st] (gp (args 0) t st)
            [r st] (tmp st t)
            op (if (= kind :inc) " + " " - ")]
        (if (= t :double)
          [(concat c1 [(str r " = " a op "1.0_c_double")]) r st]
          (let [edge (if (= kind :inc) "huge(0_c_int64_t)" "(-huge(0_c_int64_t) - 1_c_int64_t)")
                [slow st] (slow-call nd [[a :long]] r :long st)]
            [(concat c1 [(str "if (" a " == " edge ") then")]
                     (map #(str "   " %) slow)
                     ["else" (str "   " r " = " a op "1_c_int64_t") "end if"])
             r st])))

      :pred
      (let [at (ats 0)
            [c1 a st] (gp (args 0) at st)
            [r st] (tmp st :bool)
            zero (lit 0 at)]
        [(concat c1 [(str r " = " a (case sym zero? " == " pos? " > " neg? " < ") zero)])
         r st])

      :eq
      (let [[c1 a st] (gp (args 0) (ats 0) st)
            [c2 b st] (gp (args 1) (ats 1) st)
            [r st] (tmp st :bool)]
        [(concat c1 c2 [(str r " = " a " == " b)]) r st])

      :cmp
      (if (every? num? ats)
        (let [w (if (some #{:double} ats) :double :long)
              [c1 a st] (gp (args 0) w st)
              [c2 b st] (gp (args 1) w st)
              [r st] (tmp st :bool)]
          [(concat c1 c2 [(str r " = " a " " fop " " b)]) r st])
        ;; One operand is boxed. Check its tag: a long or a double is
        ;; compared unboxed, anything else takes the generic call. The
        ;; ORDER is kept -- (< i n) is not (< n i).
        (let [bi (if (num? (ats 0)) 1 0)
              ni (- 1 bi)
              nt (ats ni)
              [cn x st] (gp (args ni) nt st)
              ;; a boxed local that cannot change in this loop was read
              ;; and unboxed once before it (see :loop); otherwise the
              ;; tag and value are read here, every time
              h (when (= :local (:op (args bi))) (get (:hoisted st) (:i2 (args bi))))
              [cb s st] (if h [[] (:slot h) st] (gen (args bi) st))
              tagx (if h (:tag h) (str "clotran_tag(b + " s ")"))
              intx (if h (:i h) (str "clotran_int(b + " s ")"))
              realx (if h (:d h) (str "clotran_real(b + " s ")"))
              [r st] (tmp st :bool)
              ord (fn [xe ye] (if (= bi 1) (str xe " " fop " " ye) (str ye " " fop " " xe)))
              [slow st] (slow-call nd (if (= bi 1) [[x nt] [s :slot]] [[s :slot] [x nt]]) r :bool st)]
          [(concat cn cb
                   [(str "if (" tagx " == 2_c_int) then")
                    (str "   " r " = " (if (= nt :double)
                                          (ord x (str "real(" intx ", c_double)"))
                                          (ord x intx)))
                    (str "else if (" tagx " == 3_c_int) then")
                    (str "   " r " = " (ord (coerce x nt :double) realx))
                    "else"]
                   (map #(str "   " %) slow)
                   ["end if"])
           r st])))))

(defn- gp
  "A node as a PRIMITIVE of type `want`: [code expr state], expr being a
  Fortran expression of that type. Only asked of a node whose inferred
  type is `want`, or a long where a double is wanted."
  [nd want st]
  (let [t (infer nd (:env st))]
    (cond
      (and (= :const (:op nd)) (prim? t))
      [[] (coerce (lit (:p1 nd) t) t want) st]

      (and (= :local (:op nd)) (prim? t))
      [[] (coerce (slot-var (:i2 nd) t) t want) st]

      (and (= :call (:op nd)) (prim? t) (head-op (first (:children nd))))
      (let [[c e st] (gp-call nd t st)] [c (coerce e t want) st])

      ;; Anything else whose type is PROVEN: generate it as a value and
      ;; read the primitive back out. The proof is what makes the read
      ;; safe.
      :else
      (let [[c s st] (gen nd st)] [c (coerce (unbox t s) t want) st]))))

(defn- flush-typed
  "Every primitive local in scope, written back into the frame. The
  interpreter reads locals from the frame, so this runs before a
  subtree is handed to it; it cannot rebind one (a recur inside such a
  subtree is declined), so nothing has to be read back afterwards."
  [st]
  (let [typed (filter (fn [[_ t]] (prim? t)) (get-in st [:env :slots]))]
    (if (empty? typed)
      [[] st]
      (let [[s st] (fresh st)]
        [(mapcat (fn [[slot t]]
                   [(box s t (slot-var slot t))
                    (str "call clotran_frame_put(b + 1, " slot "_c_int, b + " s ")")])
                 typed)
         st]))))

(defn- fallback
  "A node kind the generator has not learned, handed back to the
  interpreter: its NODE goes in the pool and `clotran_eval_node` runs it
  in the same frame the compiled code is using.

  This is why the generator can be permanently incomplete without the
  language losing anything. An unhandled construct costs the
  interpreter's speed for that subtree and nothing else."
  [nd st]
  (let [p {:kind :node :value (:node nd)}
        [fc st] (flush-typed st)
        [r st] (fresh st)]
    [(concat fc
             [(str "st = clotran_eval_node(b + " r ", b + " (get (:pool st) p) ", b + 1)")]
             err-return)
     r st]))

(defn- gen-into
  "Generate a node so that its value ends up in slot `dst`. A constant,
  a local and a pooled value are put there directly; anything else is
  generated where it likes and then copied."
  [nd dst st]
  (let [t (when (= :local (:op nd)) (get-in st [:env :slots (:i2 nd)]))]
    (cond
      ;; a :var or :const entry IS the value; a :node entry is a subtree
      ;; and has to be run
      (#{:var :const} (:kind (pooled nd)))
      [[(str "call clotran_copy(b + " dst ", b + " (get (:pool st) (pooled nd)) ")")] st]

      (= :const (:op nd))
      [(emit-const (str "b + " dst) (:p1 nd)) st]

      (and (= :local (:op nd)) (prim? t))
      [[(box dst t (slot-var (:i2 nd) t))] st]

      (= :local (:op nd))
      [[(str "call clotran_frame_get(b + " dst ", b + 1, " (:i2 nd) "_c_int)")] st]

      :else
      (let [[c s st] (gen nd st)]
        [(conj (vec c) (str "call clotran_copy(b + " dst ", b + " s ")")) st]))))

(defn- gen-seq
  "Generate each node in turn, answering the code and the slot the LAST
  one landed in."
  [nodes st]
  (reduce (fn [[code _ st] nd]
            (let [[c s st'] (gen nd st)]
              [(into code c) s st']))
          [[] nil st] nodes))

(defn- bind-slots
  "Bind a let's or loop's slots in order. A primitive slot is assigned
  its Fortran variable; a boxed one goes into the frame. `types` gives
  a loop's settled types; a let's are inferred as it goes."
  [kids n base types st]
  (reduce (fn [[code st] i]
            (let [slot (+ base i)
                  t (or (get types slot) (infer (nth kids i) (:env st)))]
              (if (prim? t)
                (let [[c e st] (gp (nth kids i) t st)
                      v (slot-var slot t)]
                  [(into code (conj (vec c) (str v " = " e)))
                   (-> st (declare-var v t) (assoc-in [:env :slots slot] t))])
                (let [[c s st] (gen (nth kids i) st)]
                  [(into code (conj (vec c) (str "call clotran_frame_put(b + 1, " slot "_c_int, b + " s ")")))
                   (assoc-in st [:env :slots slot] :any)]))))
          [[] st] (range n)))

(defn- hoist-invariants
  "Read and unbox, ONCE and before the loop, every boxed local the
  loop body compares and cannot change: a parameter, or a local bound
  outside the loop. Locals are immutable and only a recur rebinds
  one, and a recur rebinds only its own loop's slots -- so these are
  fixed for the loop's whole run, and reading them every iteration
  was three runtime calls a time round for nothing. It is what the
  JVM's JIT does by speculation; here it is known."
  [body own st]
  (let [nparams (:nparams st 0)
        slots (->> (walk-nodes body)
                   (filter #(= :local (:op %)))
                   (map :i2)
                   (remove own)
                   (remove #(get (:hoisted st) %))
                   ;; boxed, and in scope at the loop: a parameter, or a
                   ;; local already bound. A HINTED parameter is typed and
                   ;; is not hoisted.
                   (filter #(and (= :any (get-in st [:env :slots %] :any))
                                 (or (< % nparams) (contains? (get-in st [:env :slots]) %))))
                   distinct)]
    (reduce (fn [[code st] slot]
              (let [[s st] (fresh st)
                    k (:ntmp st 0)
                    tg (str "tg" k) hi (str "hi" k) hd (str "hd" k)
                    st (-> st (assoc :ntmp (inc k))
                           (declare-var tg :tag) (declare-var hi :long) (declare-var hd :double)
                           (assoc-in [:hoisted slot] {:slot s :tag tg :i hi :d hd}))]
                [(into code [(str "call clotran_frame_get(b + " s ", b + 1, " slot "_c_int)")
                             (str tg " = clotran_tag(b + " s ")")
                             (str hi " = 0_c_int64_t")
                             (str hd " = 0.0_c_double")
                             (str "if (" tg " == 2_c_int) " hi " = clotran_int(b + " s ")")
                             (str "if (" tg " == 3_c_int) " hd " = clotran_real(b + " s ")")])
                 st]))
            [[] st] slots)))

(defn- gen
  "One node, as a VALUE. Answers [code slot state]: the statements that
  compute it, the slot its value lands in, and the state after."
  [nd st]
  (if (not (compiled-ops (:op nd)))
    (fallback nd st)
    (if-let [p (pooled nd)]
      ;; already in its slot from the top of the procedure
      [[] (get (:pool st) p) st]
      (let [t (infer nd (:env st))]
        (case (:op nd)
          :const (let [[s st] (fresh st)]
                   [(emit-const (str "b + " s) (:p1 nd)) s st])

          :local (let [[s st] (fresh st)]
                   (if (prim? t)
                     [[(box s t (slot-var (:i2 nd) t))] s st]
                     [[(str "call clotran_frame_get(b + " s ", b + 1, " (:i2 nd) "_c_int)")] s st]))

          :do (let [[code s st] (gen-seq (:children nd) st)]
                (if s [code s st] (gen {:op :const :p1 nil} st)))

          :if (let [[test th el] (:children nd)
                    tt (infer test (:env st))
                    [tc cond st] (if (= :bool tt)
                                   (gp test :bool st)
                                   (let [[c s st] (gen test st)]
                                     [c (str "clotran_bool(b + " s ") /= 0") st]))
                    [r st] (fresh st)
                    [thc ths st] (gen th st)
                    [elc els st] (if el (gen el st) (gen {:op :const :p1 nil} st))
                    ;; a recur branch produces nothing anyone reads
                    copy (fn [br s] (when-not (= :recur (:op br))
                                      [(str "   call clotran_copy(b + " r ", b + " s ")")]))]
                [(concat tc
                         [(str "if (" cond ") then")]
                         (map #(str "   " %) thc)
                         (copy th ths)
                         ["else"]
                         (map #(str "   " %) elc)
                         (copy (or el {:op :const}) els)
                         ["end if"])
                 r st])

          :call (if (and (prim? t) (head-op (first (:children nd))))
                  ;; a numeric op on proven numbers: primitive, then boxed
                  ;; once for whoever wants the value
                  (let [[c e st] (gp-call nd t st)
                        [s st] (fresh st)]
                    [(conj (vec c) (box s t e)) s st])
                  (let [kids (:children nd)
                        [hc hs st] (gen (first kids) st)
                        n (count (rest kids))
                        [blk st] (reduce (fn [[bl st] _]
                                           (let [[s st'] (fresh st)] [(conj bl s) st']))
                                         [[] st] (range n))
                        [ac st] (reduce (fn [[code st] [k d]]
                                          (let [[c st'] (gen-into k d st)]
                                            [(into code c) st']))
                                        [[] st] (map vector (rest kids) blk))
                        [r st] (fresh st)]
                    [(concat hc ac
                             [(str "st = clotran_call_slots(b + " r ", b + " hs ", b + "
                                   (if (zero? n) 1 (dec (first blk))) ", " n "_c_int)")]
                             err-return)
                     r st]))

          :let (let [kids (:children nd) n (:i2 nd) outer (:env st)
                     [bc st] (bind-slots kids n (:p1 nd) {} st)
                     [c s st] (gen (nth kids n) st)]
                 [(concat bc c) s (assoc st :env outer)])

          ;; A LOOP is a Fortran loop. Clojure guarantees `recur` is
          ;; constant stack, so it is a jump in any correct
          ;; implementation. A recur rebinds the loop's slots and raises
          ;; its flag; `recur` is always in TAIL position, so whatever
          ;; statements follow it in its branch are never read.
          :loop (let [kids (:children nd) n (:i2 nd) base (:p1 nd)
                      outer-loop (:loop st)
                      outer-env (:env st)
                      lenv (loop-env nd (:env st))
                      types (into {} (for [i (range n)]
                                       [(+ base i) (get-in lenv [:slots (+ base i)])]))
                      [ic st] (bind-slots kids n base types st)
                      outer-hoisted (:hoisted st)
                      [hc st] (hoist-invariants (nth kids n) (set (range base (+ base n))) st)
                      flag (str "recur" (count (:flags st)))
                      st (update st :flags conj flag)
                      [bc bs st] (gen (nth kids n) (assoc st :loop flag))]
                  [(concat ic hc
                           ["do" (str "   " flag " = 0")]
                           (map #(str "   " %) bc)
                           [(str "   if (" flag " == 0) exit") "end do"])
                   bs (assoc st :loop outer-loop :env outer-env :hoisted outer-hoisted)])

          ;; RECUR: every argument is computed BEFORE any slot is
          ;; rebound -- (recur (+ i 1) (+ acc i)) reads the old i twice
          ;; -- then the slots are assigned and the flag raised.
          :recur (let [start (nth (:p1 nd) 1)
                       [code vals st]
                       (reduce (fn [[code vs st] [i k]]
                                 (let [slot (+ start i)
                                       ts (get-in st [:env :slots slot] :any)]
                                   (if (prim? ts)
                                     (let [[c e st] (gp k ts st)
                                           [tv st] (tmp st ts)
                                           ;; the fn's OWN recur rebinds parameters, and a
                                           ;; versioned procedure's guard reads them from
                                           ;; the frame next time round -- so the frame is
                                           ;; kept in step with the Fortran variable
                                           fn-level? (= "recur0" (:loop st))
                                           [bs st] (if fn-level? (fresh st) [nil st])]
                                       [(into code (conj (vec c) (str tv " = " e)))
                                        (into vs (cond-> [(str (slot-var slot ts) " = " tv)]
                                                   fn-level? (into [(box bs ts tv)
                                                                    (str "call clotran_frame_put(b + 1, " slot
                                                                         "_c_int, b + " bs ")")])))
                                        st])
                                     (let [[c s st] (gen k st)]
                                       [(into code c)
                                        (conj vs (str "call clotran_frame_put(b + 1, " slot
                                                      "_c_int, b + " s ")"))
                                        st]))))
                               [[] [] st] (map-indexed vector (:children nd)))
                       [r st] (fresh st)]
                   [(concat code vals [(str (:loop st) " = 1")]) r st]))))))

(defn- decls-text
  "The Fortran declarations for every primitive variable a procedure
  used, grouped by type."
  [decls]
  (apply str
         (for [[t ty] [[:tag "integer(c_int)"] [:long "integer(c_int64_t)"] [:double "real(c_double)"]
                       [:bool "logical"] [:cptr "type(c_ptr)"]
                       [:dptr "real(c_double), pointer"] [:iptr "integer(c_int64_t), pointer"]]
               :let [names (sort (keep (fn [[nm k]] (when (= k t) (if (#{:dptr :iptr} t) (str nm "(:)") nm))) decls))]
               :when (seq names)]
           (str "    " ty " :: " (str/join ", " names) "\n"))))

(defn- param-hints
  "The type each HINTED parameter promises, by slot. Clojure's own
  spelling: ^double and ^long make a primitive, ^doubles and ^longs an
  array of one. A parameter with no hint, or any other hint, is boxed."
  [form]
  (let [params (first (filter vector? form))]
    (into {} (keep-indexed
              (fn [i p]
                (when-let [t ('{doubles :doubles longs :longs double :double long :long}
                              (:tag (meta p)))]
                  [i t]))
              params))))

(defn- array-params
  "The parameters the body uses as arrays -- the first argument of aget,
  aset or alength -- and that carry no hint. Nested fns are skipped:
  their slots are their own frame's."
  [body nargs hints]
  (let [nodes (tree-seq #(and (coll? %) (not= :fn (:op %))) seq body)]
    (into (sorted-set)
          (for [nd nodes
                :when (and (map? nd) (= :call (:op nd)))
                :let [[k] (head-op (first (:children nd)))
                      a (second (:children nd))]
                :when (and (#{:aget :aset :alength} k) (= :local (:op a))
                           (< (:i2 a) nargs) (not (contains? hints (:i2 a))))]
            (:i2 a)))))

(defn- versions
  "The typings a procedure is generated for, tried in order, before the
  untyped body. A scientist writes (aget a i) and no hint, so the
  arrays the body indexes are SPECULATED: all double, then all long.
  The guard checks the argument itself, so a wrong guess costs one
  check and runs the untyped body -- it never changes an answer."
  [hints arrays]
  ;; ponytail: one kind for all arrays per version, not every mix; a fn
  ;; indexing a double array and a long array together runs untyped.
  (cond
    (seq arrays) (for [t [:doubles :longs]] (into hints (map (fn [s] [s t]) arrays)))
    (seq hints) [hints]
    :else []))

(defn- guard-code
  "Read each hinted parameter and check it is what its hint says: a
  double or a long by its tag, an array by asking for a view of it.
  Answers [code setup state]: the checks, which leave `hok` true only
  if every one passed, and what to do once they have -- point the
  array variables at the buffers and unbox the primitives."
  [hints st]
  (reduce (fn [[code setup st] [slot t]]
            (let [[s st] (fresh st)
                  get (str "call clotran_frame_get(b + " s ", b + 1, " slot "_c_int)")]
              (case t
                (:doubles :longs)
                (let [st (-> st (declare-var (str "ap" slot) :cptr)
                             (declare-var (str "an" slot) :long)
                             (declare-var (av-name slot t) (if (= t :doubles) :dptr :iptr)))]
                  [(into code [get (str "hok = hok .and. clotran_array_view(b + " s ", "
                                        (if (= t :doubles) 1 2) "_c_int, ap" slot ", an" slot ") /= 0")])
                   (conj setup (str "call c_f_pointer(ap" slot ", " (av-name slot t) ", [an" slot "])"))
                   st])
                (:double :long)
                (let [v (slot-var slot t)
                      st (declare-var st v t)]
                  [(into code [get (str "hok = hok .and. clotran_tag(b + " s ") == "
                                        (if (= t :double) 3 2) "_c_int")])
                   (conj setup (str v " = " (unbox t s)))
                   st]))))
          [[] [] st] (sort hints)))

(defn- fn-procedure
  "One arity of one function, as a Fortran subroutine.

  With HINTS it is VERSIONED. Every hinted parameter is checked on the
  way in; if all of them are what they promise, the typed body runs,
  with arrays indexed through Fortran pointers and primitives in
  Fortran variables. If any is not, the untyped body runs -- the same
  code the function would get with no hints at all. So a wrong argument
  answers exactly what the interpreter answers, and compiling still
  cannot change what a call means."
  [sym tmpl hints]
  (let [[_ arities _ nslots _ _] tmpl
        [nargs _ _ body] (first arities)
        vs (versions hints (array-params body nargs hints))
        pool (fn-pool body)
        ;; b+1 is the locals frame, b+2 .. b+1+P hold what the pool
        ;; supplies, and temporaries start after them
        pslots (into {} (map-indexed (fn [i p] [p (+ 2 i)]) pool))
        first-temp (+ 2 (count pool))
        ;; the BODY IS A LOOP too, so a recur with no enclosing loop
        ;; rebinds the parameters
        st0 {:next first-temp :high (dec first-temp) :pool pslots
             :flags ["recur0"] :loop "recur0" :env {:slots {}} :nparams nargs}
        [code res st]
        (if (empty? vs)
          (gen body st0)
          ;; each version nests in the previous one's else: guard, typed
          ;; body, and failing that the next -- the untyped body last
          (let [st (declare-var st0 "hok" :bool)
                [r st] (fresh st)
                [uc ures st] (gen body (assoc st :env {:slots {}} :hoisted {}))
                [code st]
                (reduce (fn [[inner st] h]
                          (let [[gc setup st] (guard-code h st)
                                [tc tres st] (gen body (assoc st :env {:slots h} :hoisted {}))]
                            [(concat ["hok = .true."] gc
                                     ["if (hok) then"]
                                     (map #(str "   " %) (concat setup tc))
                                     [(str "   call clotran_copy(b + " r ", b + " tres ")")
                                      "else"]
                                     (map #(str "   " %) inner)
                                     ["end if"])
                             st]))
                        [(concat uc [(str "call clotran_copy(b + " r ", b + " ures ")")]) st]
                        (reverse vs))]
            [code r st]))]
    {:arity nargs
     :symbol sym
     :pool (mapv :value pool)
     :text
     (str "  subroutine " sym "(argbase, nargs, dst) bind(C, name=\"" sym "\")\n"
          "    integer(c_int), value :: argbase, nargs, dst\n"
          "    integer(c_int) :: b, st\n"
          "    integer(c_int) :: " (str/join ", " (:flags st)) "\n"
          (decls-text (:decls st))
          "    st = 0\n"
          "    b = clotran_frame_enter(" (max 1 (:high st)) "_c_int)\n"
          "    call clotran_frame_new(b + 1, " nslots "_c_int)\n"
          (apply str (for [i (range nargs)]
                       (str "    call clotran_frame_put(b + 1, " i "_c_int, argbase + "
                            (inc i) ")\n")))
          (apply str (for [[p s] (sort-by val pslots)]
                       (str "    call clotran_pool_get(b + " s ", cf_pool, "
                            (- s 2) "_c_int)\n"
                            (when (= :var (:kind p))
                              (str "    call clotran_deref(b + " s ", b + " s ")\n")))))
          "    do\n"
          "       recur0 = 0\n"
          (apply str (map #(str "       " % "\n") code))
          "       if (recur0 == 0) exit\n"
          "    end do\n"
          "    call clotran_copy(dst, b + " res ")\n"
          "    call clotran_frame_leave(b)\n"
          "  end subroutine " sym "\n")}))

(defn compile-fn
  "Compiles one function to Fortran. Answers a map with :text, :symbol,
  :arity and :pool, or one with :declined saying why it could not.

  `form` is the (fn ...) form. The :pool is the values the procedure
  needs that Fortran cannot spell -- Vars, collections, the functions
  analysis folded into call heads -- and the driver registers it and
  hands the handle to the library at install time."
  [ns-name fn-name form]
  (let [top (clotran-ast form)
        fnode (:p1 top)]
    (if (not= :fn (:op fnode))
      {:declined "not a fn form"}
      (let [tmpl (:p1 fnode)]
        (if-let [why (decline-reason tmpl)]
          {:declined why}
          (let [sym (str "cf_" (fort-ident (str ns-name)) "_" (fort-ident (str fn-name)))
                proc (fn-procedure sym tmpl (param-hints form))]
            (assoc proc :ns ns-name :name fn-name)))))))

(defn module-text
  "A whole generated file: the declarations, the procedures, and the one
  `clotran_install` the loader looks for.

  Every procedure in one file shares one pool, so `pool-of` below is
  how the driver knows what to register. The install entry takes the
  handle rather than having it baked in, because a file is written
  before it is registered."
  [mod-name procs]
  (str "! GENERATED by clotran.compiler. Do not edit; recompile.\n"
       runtime-decls
       "\nmodule " mod-name "\n"
       "  use iso_c_binding\n"
       "  use clotran_rt_decl\n"
       "  implicit none\n"
       "  ! the handle of this namespace's constant pool, told to us at\n"
       "  ! install time because it is not known when this file is written\n"
       "  integer(c_int), save :: cf_pool = 0\n"
       "contains\n"
       (str/join "\n" (map :text procs))
       "end module " mod-name "\n"
       "\n! The one symbol the loader knows, forever.\n"
       "subroutine clotran_install(pool) bind(C, name=\"clotran_install\")\n"
       "  use iso_c_binding\n"
       "  use clotran_rt_decl\n"
       "  use " mod-name "\n"
       "  implicit none\n"
       "  integer(c_int), value :: pool\n"
       "  integer(c_int) :: st\n"
       "  cf_pool = pool\n"
       (apply str
              (for [p procs]
                (str "  st = clotran_def_fn(ctext(" (fort-str (str (:ns p))) "), "
                     (count (str (:ns p))) "_c_int, ctext(" (fort-str (str (:name p))) "), "
                     (count (str (:name p))) "_c_int, c_funloc(" (:symbol p) "), "
                     (:arity p) "_c_int)\n")))
       "end subroutine clotran_install\n"))

(defn pool-of
  "The constants every procedure in a file needs, as one vector. Each
  procedure numbers its own entries from zero, so a file holding more
  than one has to be given a shared pool; for now a file is one
  function and this is simply its own."
  [procs]
  (vec (mapcat :pool procs)))
