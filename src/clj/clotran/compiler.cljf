(ns clotran.compiler
  "Compiles a Clojure function to Fortran.

  The input is `(clotran-ast form)` -- the SAME resolved tree the
  executor runs, so there is no second front end that could disagree
  with the first. Every name in it is already a frame slot or a
  constant; this namespace does no analysis of its own and must not
  start.

  The output is Fortran source for one procedure per function, plus a
  `clotran_install` that hands each to `clotran_def_fn`. The procedures
  call the runtime through the C convention (`ClotranABI.f90`), never
  through a Fortran module, so a library built by any compiler loads
  into any clotran.

  WHAT IT REFUSES. A function the generator does not fully understand
  is DECLINED -- `compile-fn` answers nil -- and stays interpreted at
  today's speed. Nothing is half-compiled. Declining rather than
  guessing is what lets this be incomplete without the language losing
  anything, and the list of reasons is `decline-reason` below, so the
  next kind to teach it is always visible.

  The one thing it may not do is change what a form MEANS.
  `scripts/compiler-check` runs the same forms interpreted and compiled
  and compares values, so a generator bug is a difference rather than a
  silent wrong answer."
  (:require [clojure.string :as str]
            [clotran.loader :as loader]))

;;; ---- the declarations a generated file needs ------------------------
;;;
;;; A generated library cannot `use` a clotran module: a module file is
;;; a private format tied to one compiler and one version of it. So the
;;; entry points it calls are declared in its own source, from their C
;;; bindings alone. This block is the canonical copy.

(def ^:private runtime-decls
  "module clotran_rt_decl
  use iso_c_binding
  implicit none
  ! a value as the runtime lays it out (GC.f90 gc_value; ClotranABI
  ! clotran_slots checks it): generated code reads and writes stack
  ! slots as these directly
  type, bind(C) :: clotran_val
     integer(c_int32_t) :: tag, ref
     integer(c_int64_t) :: ival
  end type clotran_val
  interface
     function clotran_slots(cs, n) bind(C, name=\"clotran_slots\") result(p)
       import :: c_ptr, c_int
       type(c_ptr), value :: cs
       integer(c_int), intent(out) :: n
       type(c_ptr) :: p
     end function clotran_slots
     function clotran_stack() bind(C, name=\"clotran_stack\") result(cs)
       import :: c_ptr
       type(c_ptr) :: cs
     end function clotran_stack
     function clotran_frame_enter(cs, n) bind(C, name=\"clotran_frame_enter\") result(base)
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: n
       integer(c_int) :: base
     end function clotran_frame_enter
     subroutine clotran_frame_done(cs, base) bind(C, name=\"clotran_frame_done\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: base
     end subroutine clotran_frame_done
     subroutine clotran_frame_leave(cs, base) bind(C, name=\"clotran_frame_leave\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: base
     end subroutine clotran_frame_leave
     subroutine clotran_clear_args(cs, argbase, nargs) bind(C, name=\"clotran_clear_args\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: argbase, nargs
     end subroutine clotran_clear_args
     subroutine clotran_frame_clear(cs, fr, i) bind(C, name=\"clotran_frame_clear\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: fr, i
     end subroutine clotran_frame_clear
     subroutine clotran_set_nil(cs, slot) bind(C, name=\"clotran_set_nil\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: slot
     end subroutine clotran_set_nil
     subroutine clotran_set_int(cs, slot, n) bind(C, name=\"clotran_set_int\")
       import :: c_int, c_int64_t, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: slot
       integer(c_int64_t), value :: n
     end subroutine clotran_set_int
     subroutine clotran_set_real(cs, slot, x) bind(C, name=\"clotran_set_real\")
       import :: c_int, c_double, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: slot
       real(c_double), value :: x
     end subroutine clotran_set_real
     subroutine clotran_set_bool(cs, slot, b) bind(C, name=\"clotran_set_bool\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: slot, b
     end subroutine clotran_set_bool
     subroutine clotran_set_str(cs, slot, chars, n) bind(C, name=\"clotran_set_str\")
       import :: c_int, c_char, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: slot
       character(kind=c_char), intent(in) :: chars(*)
       integer(c_int), value :: n
     end subroutine clotran_set_str
     subroutine clotran_copy(cs, dst, src) bind(C, name=\"clotran_copy\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: dst, src
     end subroutine clotran_copy
     function clotran_tag(cs, slot) bind(C, name=\"clotran_tag\") result(t)
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: slot
       integer(c_int) :: t
     end function clotran_tag
     function clotran_int(cs, slot) bind(C, name=\"clotran_int\") result(n)
       import :: c_int, c_int64_t, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: slot
       integer(c_int64_t) :: n
     end function clotran_int
     function clotran_real(cs, slot) bind(C, name=\"clotran_real\") result(x)
       import :: c_int, c_double, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: slot
       real(c_double) :: x
     end function clotran_real
     function clotran_array_view(cs, slot, kind, ptr, n) bind(C, name=\"clotran_array_view\") result(ok)
       import :: c_int, c_ptr, c_int64_t
       type(c_ptr), value :: cs
       integer(c_int), value :: slot, kind
       type(c_ptr), intent(out) :: ptr
       integer(c_int64_t), intent(out) :: n
       integer(c_int) :: ok
     end function clotran_array_view
     function clotran_bool(cs, slot) bind(C, name=\"clotran_bool\") result(b)
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: slot
       integer(c_int) :: b
     end function clotran_bool
     subroutine clotran_frame_new(cs, dst, n) bind(C, name=\"clotran_frame_new\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: dst, n
     end subroutine clotran_frame_new
     subroutine clotran_frame_stack(cs, dst, base, n) bind(C, name=\"clotran_frame_stack\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: dst, base, n
     end subroutine clotran_frame_stack
     subroutine clotran_frame_get(cs, dst, fr, i) bind(C, name=\"clotran_frame_get\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: dst, fr, i
     end subroutine clotran_frame_get
     subroutine clotran_frame_put(cs, fr, i, src) bind(C, name=\"clotran_frame_put\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: fr, i, src
     end subroutine clotran_frame_put
     function clotran_call_slots(cs, dst, fn, argbase, nargs) bind(C, name=\"clotran_call_slots\") result(st)
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: dst, fn, argbase, nargs
       integer(c_int) :: st
     end function clotran_call_slots
     subroutine clotran_deref(cs, dst, var) bind(C, name=\"clotran_deref\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: dst, var
     end subroutine clotran_deref
     function clotran_register_proc(name, namen, fp) bind(C, name=\"clotran_register_proc\") result(h)
       import :: c_int, c_char, c_funptr
       character(kind=c_char), intent(in) :: name(*)
       integer(c_int), value :: namen
       type(c_funptr), value :: fp
       integer(c_int) :: h
     end function clotran_register_proc
     subroutine clotran_make_closure(cs, dst, h, arity, name, namen, fr, pairs, npairs, selfslot) &
          bind(C, name=\"clotran_make_closure\")
       import :: c_int, c_char, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: dst, h, arity, namen, fr, npairs, selfslot
       character(kind=c_char), intent(in) :: name(*)
       integer(c_int), intent(in) :: pairs(*)
     end subroutine clotran_make_closure
     function clotran_new(cs, dst, name, namen, argbase, nargs) bind(C, name=\"clotran_new\") result(st)
       import :: c_int, c_char, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: dst, namen, argbase, nargs
       character(kind=c_char), intent(in) :: name(*)
       integer(c_int) :: st
     end function clotran_new
     function clotran_dot(cs, dst, node, tv, argbase, nargs, from) bind(C, name=\"clotran_dot\") result(st)
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: dst, node, tv, argbase, nargs, from
       integer(c_int) :: st
     end function clotran_dot
     function clotran_arith(cs, dst, op, fn, a, b, n) bind(C, name=\"clotran_arith\") result(st)
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: dst, op, fn, a, b, n
       integer(c_int) :: st
     end function clotran_arith
     subroutine clotran_poll() bind(C, name=\"clotran_poll\")
     end subroutine clotran_poll
     subroutine clotran_captures(cs, fr) bind(C, name=\"clotran_captures\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: fr
     end subroutine clotran_captures
     function clotran_eval_node(cs, dst, node, fr) bind(C, name=\"clotran_eval_node\") result(st)
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: dst, node, fr
       integer(c_int) :: st
     end function clotran_eval_node
     subroutine clotran_site(h, i) bind(C, name=\"clotran_site\")
       import :: c_int
       integer(c_int), value :: h, i
     end subroutine clotran_site
     subroutine clotran_pool_get(cs, dst, h, i) bind(C, name=\"clotran_pool_get\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: dst, h, i
     end subroutine clotran_pool_get
     subroutine clotran_native_begin(me, rel) bind(C, name=\"clotran_native_begin\")
       import :: c_int
       integer(c_int), intent(out) :: me, rel
     end subroutine clotran_native_begin
     subroutine clotran_reacquire(me, rel) bind(C, name=\"clotran_reacquire\")
       import :: c_int
       integer(c_int), value :: me
       integer(c_int), intent(inout) :: rel
     end subroutine clotran_reacquire
     subroutine clotran_rest_args(cs, dst, argbase, from, nargs) bind(C, name=\"clotran_rest_args\")
       import :: c_int, c_ptr
       type(c_ptr), value :: cs
       integer(c_int), value :: dst, argbase, from, nargs
     end subroutine clotran_rest_args
     subroutine clotran_arity_error(nargs, name, n) bind(C, name=\"clotran_arity_error\")
       import :: c_int, c_char
       integer(c_int), value :: nargs, n
       character(kind=c_char), intent(in) :: name(*)
     end subroutine clotran_arity_error
     function clotran_def_fn(ns, nsn, name, namen, fp, arity) bind(C, name=\"clotran_def_fn\") result(st)
       import :: c_int, c_char, c_funptr
       character(kind=c_char), intent(in) :: ns(*), name(*)
       integer(c_int), value :: nsn, namen, arity
       type(c_funptr), value :: fp
       integer(c_int) :: st
     end function clotran_def_fn
  end interface
contains
  function ctext(s) result(a)
    character(len=*), intent(in) :: s
    character(kind=c_char) :: a(len(s))
    integer :: i
    do i = 1, len(s)
       a(i) = s(i:i)
    end do
  end function ctext
end module clotran_rt_decl
")

;;; ---- what the generator understands ---------------------------------

;; The HOST decides what is pooled (Eval.f90, compiled_pool): these
;; three say the same thing, and a disagreement shows up as an entry
;; the generator asks for and the pool does not have.

(defn- spellable?
  "A constant a generated procedure can write into its own source.
  Everything else -- a collection, a Var, a string, the function
  analysis folded into a call head -- goes in the CONSTANT POOL
  instead.

  A STRING could be written as a Fortran literal, and deliberately is
  not: its quotes, newlines and byte length are each a way to emit a
  file that compiles into a different string. A BigInt is `integer?`
  and must not be written as a long, so this asks `int?`. A double
  that is not finite has no Fortran spelling, and Long/MIN_VALUE
  cannot be written as a negative literal because its magnitude does
  not fit."
  [v]
  (or (nil? v) (true? v) (false? v)
      (and (int? v) (not= v clotran.host.int8/MIN_VALUE))
      (and (double? v) (not (NaN? v)) (not (infinite? v)))))


(defn- walk-nodes
  "Every node in the tree, depth first."
  [t]
  (filter #(and (map? %) (:op %)) (tree-seq coll? seq t)))


(def ^:private compiled-ops
  "The node kinds the generator emits code for. Everything else goes
  through the escape hatch, which is slower and still correct."
  #{:const :local :if :do :call :var :let :loop :recur :fn :lazy :new :dot})


(defn- pooled
  "The value this node needs out of the pool, or nil if it needs none.

  A :var node holds the Var itself, so the pool holds the Var and the
  procedure derefs it at the call -- which is what makes a redefinition
  visible to compiled code. A :const holding anything unspellable holds
  exactly the value the interpreter would have used, so compiling
  cannot change what the form means."
  [nd]
  (cond
    (= :var (:op nd)) {:kind :var :value (:p1 nd)}
    (and (= :const (:op nd)) (not (spellable? (:p1 nd)))) {:kind :const :value (:p1 nd) :shape (loader/const-shape (:p1 nd))}
    ;; a kind we do not emit: the pool holds the NODE and the
    ;; interpreter runs it
    (not (compiled-ops (:op nd))) {:kind :node :value (:node nd)}
    :else nil))



(defn decline-reason
  "Why this function cannot be compiled yet, or nil if it can. A list of
  reasons rather than a boolean, so the next thing to teach the
  generator is always the answer to a question."
  [tmpl]
  (let [[_ arities captures _ selfslot _] tmpl
        bodies (map #(nth % 3) arities)
        nodes (mapcat walk-nodes bodies)]
    (cond
      (or (empty? bodies) (some nil? bodies)) "no body"
      (seq captures) "closes over an outer local"
      (not= -1 selfslot) "refers to itself by name"
      ;; A recur inside a subtree the interpreter runs would rebind the
      ;; frame and hand back the recur marker as a VALUE; the compiled
      ;; loop around it would never go round again. Declined rather
      ;; than wrong. Only a recur that targets the COMPILED code counts:
      ;; one inside a loop, fn or lazy-seq of that subtree is its own,
      ;; and the interpreter runs it whole -- map's variadic arity is
      ;; such a lazy-seq.
      (some (fn [nd] (and (not (compiled-ops (:op nd)))
                          (some #(= :recur (:op %))
                                (filter #(and (map? %) (:op %))
                                        (tree-seq #(and (coll? %) (not (#{:loop :fn :lazy} (:op %))))
                                                  seq nd)))))
            nodes)
      "a recur inside a form the generator hands to the interpreter"
      :else nil)))

;;; ---- types ----------------------------------------------------------
;;;
;;; What makes compiled code FAST rather than merely compiled. A profile
;;; of the first compiled loop had two thirds of its time in the generic
;;; numeric path -- builtin dispatch, tag checks, argument slots -- for
;;; an addition. A value PROVEN to be a long is a Fortran integer(8),
;;; and (+ i 1) on two of them is one add and one overflow test.
;;;
;;; The rules are Clojure's own, which is why they are not a deviation:
;;; a loop or let local takes the primitive type of its init, so
;;; (loop [i 0] ...) has a primitive long `i`, and a parameter with no
;;; hint is boxed. What real Clojure does with :inline on +, <, inc and
;;; the rest -- call Numbers directly rather than through the Var -- is
;;; what this does too.
;;;
;;; Types: :long, :double, :bool, :any (boxed), :none (a recur, which
;;; produces nothing to its surroundings).

(defn- prim? [t] (#{:long :double :bool} t))
(defn- num? [t] (#{:long :double} t))
(defn- join [a b] (cond (= a :none) b (= b :none) a (= a b) a :else :any))

(def ^:private op-kinds
  '{+ :arith, - :arith, * :arith, / :div, inc :inc, dec :dec,
    < :cmp, > :cmp, <= :cmp, >= :cmp, == :cmp, = :eq,
    zero? :pred, pos? :pred, neg? :pred,
    aget :aget, aset :aset, alength :alength,
    int :to-int, long :to-long, double :to-double,
    ;; Math/ members, as analysis folds them: a double in, a double out
    clotran-math-sqrt :math1, clotran-math-sin :math1, clotran-math-cos :math1,
    clotran-math-tan :math1, clotran-math-exp :math1, clotran-math-log :math1,
    clotran-math-log10 :math1, clotran-math-asin :math1, clotran-math-acos :math1,
    clotran-math-atan :math1, clotran-math-sinh :math1, clotran-math-cosh :math1,
    clotran-math-tanh :math1, clotran-math-pow :math2, clotran-math-atan2 :math2})

(def ^:private fortran-math
  "The Fortran intrinsic for each Math/ member: the same libm answers,
  bit for bit (scripts/pure-check compares them with clj)."
  '{clotran-math-sqrt "sqrt", clotran-math-sin "sin", clotran-math-cos "cos",
    clotran-math-tan "tan", clotran-math-exp "exp", clotran-math-log "log",
    clotran-math-log10 "log10", clotran-math-asin "asin", clotran-math-acos "acos",
    clotran-math-atan "atan", clotran-math-sinh "sinh", clotran-math-cosh "cosh",
    clotran-math-tanh "tanh", clotran-math-atan2 "atan2"})

(def ^:private fortran-op
  '{+ "+", - "-", * "*", / "/", < "<", > ">", <= "<=", >= ">=", == "==", = "=="})

(defn- head-op
  "[kind sym] for a call head that is one of the numeric ops, or nil.

  A head analysis FOLDED to a builtin carries the builtin's name on
  :builtin -- the object is fresh per analysis, so identity cannot
  tell + from anything else. A head that is still a Var lookup is
  recognised by being the very Var clojure.core has for the op."
  [head]
  (let [s (case (:op head)
            :const (some-> (:builtin head) name symbol)
            :var (some (fn [s] (when (identical? (:p1 head) (ns-resolve 'clojure.core s)) s))
                       (keys op-kinds))
            nil)]
    (when-let [k (and s (op-kinds s))] [k s])))

(declare infer)

(def ^:private boxed-ops
  "The numeric ops clotran_arith answers for boxed operands, by arity:
  the opcode the runtime switches on."
  '{[+ 2] 1, [- 2] 2, [* 2] 3, [inc 1] 4, [dec 1] 5, [< 2] 6, [> 2] 7,
    [<= 2] 8, [>= 2] 9, [= 2] 10, [== 2] 11, [zero? 1] 12, [pos? 1] 13, [neg? 1] 14})

(defn- av-name
  "The Fortran pointer to an array parameter's buffer, one per kind: a
  procedure speculating double then long declares both."
  [slot t]
  (str "av" (if (= t :doubles) "d" "l") slot))

(defn- op-args
  "The argument nodes of a numeric op. The analyser puts Clojure's
  checkcast in front of an array-hinted argument of aget, aset and
  alength, (clotran-array-cast a :doubles); where the version guard has
  already proved `a` is that array, the cast is dropped and the op sees
  the local."
  [nd kind env]
  (let [args (vec (rest (:children nd)))
        a (first args)]
    (if (and (#{:aget :aset :alength} kind)
             (= :call (:op a))
             (= 'clotran-array-cast (some-> (:builtin (first (:children a))) name symbol))
             (let [[_ inner hint] (:children a)]
               (= (infer inner env) (:p1 hint))))
      (assoc args 0 (second (:children a)))
      args)))

(defn- const-type [v]
  (cond (and (int? v) (spellable? v)) :long
        (and (double? v) (spellable? v)) :double
        (or (true? v) (false? v)) :bool
        :else :any))

(defn- call-type [nd env]
  (let [[kind _] (head-op (first (:children nd)))
        ts (mapv #(infer % env) (op-args nd kind env))
        n (count ts)]
    (case kind
      :arith (if (and (= n 2) (every? num? ts))
               (if (every? #{:long} ts) :long :double)
               :any)
      :div (if (and (= n 2) (every? num? ts) (some #{:double} ts)) :double :any)
      (:inc :dec) (if (and (= n 1) (num? (first ts))) (first ts) :any)
      ;; one boxed operand is fine: its tag is checked at run time
      :cmp (if (and (= n 2) (some num? ts) (every? #(or (num? %) (= :any %)) ts)) :bool :any)
      :eq (if (and (= n 2) (num? (first ts)) (= (first ts) (second ts))) :bool :any)
      :pred (if (and (= n 1) (num? (first ts))) :bool :any)
      ;; an array is typed only through a hinted parameter, so its
      ;; argument is always a local
      :aget (if (and (= n 2) (#{:doubles :longs} (ts 0)) (= :long (ts 1)))
              (if (= :doubles (ts 0)) :double :long) :any)
      :aset (if (and (= n 3) (#{:doubles :longs} (ts 0)) (= :long (ts 1))
                     (if (= :doubles (ts 0)) (num? (ts 2)) (= :long (ts 2))))
              (if (= :doubles (ts 0)) :double :long) :any)
      :alength (if (and (= n 1) (#{:doubles :longs} (ts 0))) :long :any)
      (:to-int :to-long) (if (and (= n 1) (num? (ts 0))) :long :any)
      :to-double (if (and (= n 1) (num? (ts 0))) :double :any)
      :math1 (if (and (= n 1) (num? (ts 0))) :double :any)
      :math2 (if (and (= n 2) (every? num? ts)) :double :any)
      :any)))

(defn- bind-types
  "The types a let's slots take from their inits, in order, each init
  seeing the bindings before it."
  [nd env]
  (let [kids (:children nd) n (:i2 nd) base (:p1 nd)]
    (reduce (fn [e i] (assoc-in e [:slots (+ base i)] (infer (nth kids i) e)))
            env (range n))))

(defn- loop-env
  "A loop's slots: the join of each init's type and every recur's
  argument type for that slot, iterated until it settles. A slot that
  does not settle is boxed."
  [nd env]
  (let [kids (:children nd) n (:i2 nd) base (:p1 nd)]
    (loop [e (bind-types nd env) k 0]
      (let [acc (atom {})
            _ (infer (nth kids n) (assoc e :recurs acc))
            rts (get @acc base [])
            e' (reduce (fn [e i]
                         (update-in e [:slots (+ base i)]
                                    (fn [t] (reduce join t (map #(nth % i :any) rts)))))
                       e (range n))]
        (cond (= e' e) e
              (> k 4) (reduce (fn [e i] (assoc-in e [:slots (+ base i)] :any)) e (range n))
              :else (recur e' (inc k)))))))

(defn- infer
  "The type a node's value is PROVEN to have, given the types of the
  slots in scope."
  [nd env]
  (case (:op nd)
    :const (const-type (:p1 nd))
    :local (get-in env [:slots (:i2 nd)] :any)
    :do (if (seq (:children nd)) (last (mapv #(infer % env) (:children nd))) :any)
    :if (let [[t th el] (:children nd)]
          (infer t env)
          (join (infer th env) (if el (infer el env) :any)))
    :let (infer (nth (:children nd) (:i2 nd)) (bind-types nd env))
    :loop (infer (nth (:children nd) (:i2 nd)) (loop-env nd env))
    :recur (do (when-let [a (:recurs env)]
                 (swap! a update (nth (:p1 nd) 1) (fnil conj [])
                        (mapv #(infer % env) (:children nd))))
               :none)
    :call (call-type nd env)
    :any))

;;; ---- emitting -------------------------------------------------------

(defn- fort-ident
  "A Fortran identifier from a Clojure name. Fortran allows letters,
  digits and underscore and nothing else -- not the dot a namespace
  is full of, and not the characters `munge` keeps. Case is folded
  because Fortran is case-insensitive and two names differing only in
  case would collide in the symbol table."
  [s]
  (str/lower-case (str/replace s #"[^A-Za-z0-9]" "_")))

(defn- fort-str
  "A Fortran string literal: the only escape is a doubled quote."
  [s]
  (str "\"" (str/replace s "\"" "\"\"") "\""))

(defn- emit-const [slot v]
  (cond
    (nil? v)     [(str "call clotran_set_nil(" slot ")")]
    (true? v)    [(str "call clotran_set_bool(" slot ", 1_c_int)")]
    (false? v)   [(str "call clotran_set_bool(" slot ", 0_c_int)")]
    (int? v)     [(str "call clotran_set_int(" slot ", " v "_c_int64_t)")]
    (double? v)  [(str "call clotran_set_real(" slot ", " v "_c_double)")]
    :else        (throw (ex-info "not spellable" {:value v}))))

;; A procedure's temporaries are slots b+2 upwards; b+1 holds the frame
;; of locals. `next` is the next free one and `high` the most ever used,
;; which is what the frame at the top has to reserve.
(defn- fresh [st] [(:next st) (-> st (update :next inc) (update :high max (:next st)))])

;; Primitive values live in Fortran variables: a slot's own is l<slot>,
;; d<slot> or q<slot> by type, and a temporary is ti/td/tl<n>.
(defn- slot-var [slot t] (str (case t :long "l" :double "d" :bool "q") slot))

(defn- declare-var [st nm t] (update st :decls (fnil conj #{}) [nm t]))

(defn- tmp [st t]
  (let [k (:ntmp st 0)
        nm (str (case t :long "ti" :double "td" :bool "tl") k)]
    [nm (-> st (assoc :ntmp (inc k)) (declare-var nm t))]))

(defn- box
  "The statement that puts a primitive expression into a slot as a value."
  [slot t expr]
  (case t
    :long (str "call clotran_set_int(b + " slot ", " expr ")")
    :double (str "call clotran_set_real(b + " slot ", " expr ")")
    :bool (str "call clotran_set_bool(b + " slot ", merge(1_c_int, 0_c_int, " expr "))")))

(defn- unbox [t slot]
  (case t
    :long (str "clotran_int(b + " slot ")")
    :double (str "clotran_real(b + " slot ")")
    :bool (str "(clotran_bool(b + " slot ") /= 0)")))

(defn- coerce
  "A long where a double is wanted is widened, as Clojure's Numbers
  does. Nothing else is ever asked for."
  [expr from to]
  (cond (= from to) expr
        (and (= from :long) (= to :double)) (str "real(" expr ", c_double)")
        :else (throw (ex-info "bad coerce" {:from from :to to}))))

(defn- lit
  "A primitive literal, parenthesised: a negative one after an operator
  is two operators in a row, which Fortran does not allow."
  [v t]
  (case t
    :long (str "(" v "_c_int64_t)")
    :double (str "(" (double v) "_c_double)")
    :bool (if v ".true." ".false.")))

(def ^:private err-return
  ["if (st /= 0) then" "   call clotran_frame_done(b)" "   return" "end if"])

(declare gen gp)

(defn- arith-inline
  "A boxed numeric op done in Fortran when its operands are two longs or
  two doubles, read straight from their slots; `slow` -- clotran_arith,
  which also throws a long's overflow as Clojure does -- for anything
  else, and for a long op that would overflow -- a guard Fortran may
  evaluate whatever the tags, so nothing in it can itself overflow. A
  result of one op is
  the same value clotran_arith gives: a long, a double, or a boolean."
  [opc a b r slow]
  (let [x (str "sv(b + " a ")") y (str "sv(b + " b ")") out (str "sv(b + " r ")")
        xi (str x "%ival") yi (str y "%ival")
        xd (str "transfer(" xi ", 0.0_c_double)") yd (str "transfer(" yi ", 0.0_c_double)")
        h "huge(0_c_int64_t)"
        long (fn [e] (str out " = clotran_val(2, 0, " e ")"))
        dbl (fn [e] (str out " = clotran_val(3, 0, transfer(" e ", 0_c_int64_t))"))
        bool (fn [e] (str out " = clotran_val(1, 0, merge(1_c_int64_t, 0_c_int64_t, " e "))"))
        ;; [long guard (beyond both tags 2), long result, double result]
        [g lr dr] (case (int opc)
                    1 [(str "(" xi " <= " h " - max(" yi ", 0_c_int64_t) .and. " xi " >= -" h " - 1_c_int64_t - min(" yi ", 0_c_int64_t))")
                       (long (str xi " + " yi)) (dbl (str xd " + " yd))]
                    2 [(str "(" xi " <= " h " + min(" yi ", 0_c_int64_t) .and. " xi " >= -" h " - 1_c_int64_t + max(" yi ", 0_c_int64_t))")
                       (long (str xi " - " yi)) (dbl (str xd " - " yd))]
                    3 [(str "(" xi " > -2147483648_c_int64_t .and. " xi " < 2147483648_c_int64_t .and. " yi " > -2147483648_c_int64_t .and. " yi " < 2147483648_c_int64_t)")
                       (long (str xi " * " yi)) (dbl (str xd " * " yd))]
                    4 [(str "(" xi " /= " h ")") (long (str xi " + 1_c_int64_t")) (dbl (str xd " + 1.0_c_double"))]
                    5 [(str "(" xi " /= -" h " - 1_c_int64_t)") (long (str xi " - 1_c_int64_t")) (dbl (str xd " - 1.0_c_double"))]
                    6 [".true." (bool (str xi " < " yi)) (bool (str xd " < " yd))]
                    7 [".true." (bool (str xi " > " yi)) (bool (str xd " > " yd))]
                    8 [".true." (bool (str xi " <= " yi)) (bool (str xd " <= " yd))]
                    9 [".true." (bool (str xi " >= " yi)) (bool (str xd " >= " yd))]
                    10 [".true." (bool (str xi " == " yi)) (bool (str xd " == " yd))]
                    11 [".true." (bool (str xi " == " yi)) (bool (str xd " == " yd))]
                    12 [".true." (bool (str xi " == 0_c_int64_t")) (bool (str xd " == 0.0_c_double"))]
                    13 [".true." (bool (str xi " > 0_c_int64_t")) (bool (str xd " > 0.0_c_double"))]
                    14 [".true." (bool (str xi " < 0_c_int64_t")) (bool (str xd " < 0.0_c_double"))])
        ;; a and b are the same slot for a one-argument op
        tags (fn [t] (if (= a b) (str x "%tag == " t) (str x "%tag == " t " .and. " y "%tag == " t)))]
    (concat [(str "if (" (tags 2) (when (not= g ".true.") (str " .and. " g)) ") then")
             (str "   " lr)
             (str "else if (" (tags 3) ") then")
             (str "   " dr)
             "else"]
            (map #(str "   " %) slow)
            ["end if"])))

(defn- site
  "The line naming this call's site before it is made (Eval.f90 pool_walk's
  :site entries, clotran_site), so a frame of compiled code shows where it
  is, as an interpreted one does; nothing for a call with no position."
  [nd st]
  (when-let [i (get (:pidx st) {:kind :site :value (:node nd)})]
    [(str "call clotran_site(cf_pool, " (+ (:offset st) i) "_c_int)")]))

(defn- slow-call
  "The GENERIC call, for when the fast path cannot answer: an overflow
  about to happen, or an operand whose tag is not a number. It is the
  interpreter's own path, so it raises exactly what Clojure raises;
  when it does not raise, its answer is read back as the type the
  surrounding code expects.

  operands are [expr type] pairs, where the type :slot means the
  expression is already a slot holding a value."
  [nd operands r rt st]
  (let [head (first (:children nd))
        hs (get (:pool st) (pooled head))
        n (count operands)
        [blk st] (reduce (fn [[bl st] _] (let [[s st'] (fresh st)] [(conj bl s) st']))
                         [[] st] (range n))
        [res st] (fresh st)]
    [(concat (map (fn [s [e t]]
                    (if (= t :slot)
                      (str "call clotran_copy(b + " s ", b + " e ")")
                      (box s t e)))
                  blk operands)
             (site nd st)
             [(str "st = clotran_call_slots(b + " res ", b + " hs ", b + "
                   (dec (first blk)) ", " n "_c_int)")]
             err-return
             [(str r " = " (unbox rt res))])
     st]))

(defn- lit-long
  "The value of a long LITERAL as `lit` writes it, or nil for anything
  else."
  [e]
  (some-> (re-matches #"\((-?\d+)_c_int64_t\)" e) second parse-long))

(defn- ovf
  "True when a long add, subtract or multiply is about to overflow.
  Checked BEFORE the operation, because signed overflow in Fortran is
  not defined. A multiply is judged in double precision, with a margin
  below 2^63; a product that is merely large takes the generic path,
  which answers it exactly.

  When the right operand is a LITERAL its sign is known, and only the
  half of the test that can run is written. Writing both let gfortran
  fold the other half -- -huge - 1 - 1 -- and refuse the file for an
  overflow in code that could never execute."
  [sym a b]
  (let [h "huge(0_c_int64_t)"
        k (lit-long b)]
    (case sym
      (+ -) (let [pos (str "(" a " > " h (if (= sym '+) " - " " + ") b ")")
                  neg (str "(" a " < -" h " - 1_c_int64_t " (if (= sym '+) "- " "+ ") b ")")]
              (cond
              (nil? k) (if (= sym '+)
                         (str "(" b " > 0 .and. " pos ") .or. (" b " < 0 .and. " neg ")")
                         (str "(" b " < 0 .and. " pos ") .or. (" b " > 0 .and. " neg ")"))
              (zero? k) ".false."
              ;; + overflows upward only for a positive b; - for a negative
              (= (pos? k) (= sym '+)) pos
              :else neg))
      * (str "abs(real(" a ", c_double) * real(" b ", c_double)) > 9.0e18_c_double"))))

(defn- gp-call
  "A numeric op, primitive in and out. Answers [code expr state] with
  expr a Fortran variable of type t."
  [nd t st]
  (let [[kind sym] (head-op (first (:children nd)))
        args (op-args nd kind (:env st))
        ats (mapv #(infer % (:env st)) args)
        fop (fortran-op sym)]
    (case kind
      ;; ARRAYS, through the Fortran pointer the version guard set up. An
      ;; index out of range takes the generic call, which raises what
      ;; Clojure raises; the array for it is read from the frame, where
      ;; the parameter still is.
      ;; CASTS, by RT's own range rules: a value out of range takes the
      ;; generic call, which throws what Clojure throws. (aget a i)
      ;; inlines to (aget a (int i)), so without these no index was ever
      ;; typed.
      :to-double
      (let [[c a st] (gp (args 0) (ats 0) st)]
        [c (coerce a (ats 0) :double) st])

      :math1
      (let [[c a st] (gp (args 0) :double st)]
        [c (str (fortran-math sym) "(" a ")") st])

      :math2
      (let [[c1 a st] (gp (args 0) :double st)
            [c2 b st] (gp (args 1) :double st)]
        [(concat c1 c2)
         (if (= sym 'clotran-math-pow) (str "(" a " ** " b ")") (str (fortran-math sym) "(" a ", " b ")"))
         st])

      (:to-int :to-long)
      (let [at (ats 0)
            [c a st] (gp (args 0) at st)
            [r st] (tmp st :long)
            in-range (cond
                       (and (= at :long) (= kind :to-long)) nil
                       (= at :long) (str a " >= -2147483648_c_int64_t .and. " a " <= 2147483647_c_int64_t")
                       (= kind :to-int) (str a " >= -2147483648.0_c_double .and. " a " <= 2147483647.0_c_double")
                       :else (str "abs(" a ") < 9.2e18_c_double"))
            conv (if (= at :long) a (str "int(" a ", c_int64_t)"))]
        (if (nil? in-range)
          [c a st]
          (let [[slow st] (slow-call nd [[a at]] r :long st)]
            [(concat c [(str "if (" in-range ") then") (str "   " r " = " conv) "else"]
                     (map #(str "   " %) slow) ["end if"])
             r st])))

      :alength
      [[] (str "an" (:i2 (args 0))) st]

      :aget
      (let [aslot (:i2 (args 0))
            [ci i st] (gp (args 1) :long st)
            [r st] (tmp st t)
            [as st] (fresh st)
            [slow st] (slow-call nd [[as :slot] [i :long]] r t st)]
        [(concat ci
                 [(str "if (" i " >= 0 .and. " i " < an" aslot ") then")
                  (str "   " r " = " (av-name aslot (ats 0)) "(" i " + 1)")
                  "else"
                  (str "   call clotran_frame_get(b + " as ", b + 1, " aslot "_c_int)")]
                 (map #(str "   " %) slow)
                 ["end if"])
         r st])

      :aset
      (let [aslot (:i2 (args 0))
            [ci i st] (gp (args 1) :long st)
            [cv v st] (gp (args 2) t st)
            [r st] (tmp st t)
            [as st] (fresh st)
            [slow st] (slow-call nd [[as :slot] [i :long] [v t]] r t st)]
        [(concat ci cv
                 [(str "if (" i " >= 0 .and. " i " < an" aslot ") then")
                  (str "   " (av-name aslot (ats 0)) "(" i " + 1) = " v)
                  (str "   " r " = " v)
                  "else"
                  (str "   call clotran_frame_get(b + " as ", b + 1, " aslot "_c_int)")]
                 (map #(str "   " %) slow)
                 ["end if"])
         r st])

      :arith
      (let [[c1 a st] (gp (args 0) t st)
            [c2 b st] (gp (args 1) t st)
            [r st] (tmp st t)]
        (if (= t :double)
          [(concat c1 c2 [(str r " = " a " " fop " " b)]) r st]
          (let [[slow st] (slow-call nd [[a :long] [b :long]] r :long st)]
            [(concat c1 c2 [(str "if (" (ovf sym a b) ") then")]
                     (map #(str "   " %) slow)
                     ["else" (str "   " r " = " a " " fop " " b) "end if"])
             r st])))

      :div
      (let [[c1 a st] (gp (args 0) :double st)
            [c2 b st] (gp (args 1) :double st)
            [r st] (tmp st :double)]
        [(concat c1 c2 [(str r " = " a " / " b)]) r st])

      (:inc :dec)
      (let [[c1 a st] (gp (args 0) t st)
            [r st] (tmp st t)
            op (if (= kind :inc) " + " " - ")]
        (if (= t :double)
          [(concat c1 [(str r " = " a op "1.0_c_double")]) r st]
          (let [edge (if (= kind :inc) "huge(0_c_int64_t)" "(-huge(0_c_int64_t) - 1_c_int64_t)")
                [slow st] (slow-call nd [[a :long]] r :long st)]
            [(concat c1 [(str "if (" a " == " edge ") then")]
                     (map #(str "   " %) slow)
                     ["else" (str "   " r " = " a op "1_c_int64_t") "end if"])
             r st])))

      :pred
      (let [at (ats 0)
            [c1 a st] (gp (args 0) at st)
            [r st] (tmp st :bool)
            zero (lit 0 at)]
        [(concat c1 [(str r " = " a (case sym zero? " == " pos? " > " neg? " < ") zero)])
         r st])

      :eq
      (let [[c1 a st] (gp (args 0) (ats 0) st)
            [c2 b st] (gp (args 1) (ats 1) st)
            [r st] (tmp st :bool)]
        [(concat c1 c2 [(str r " = " a " == " b)]) r st])

      :cmp
      (if (every? num? ats)
        (let [w (if (some #{:double} ats) :double :long)
              [c1 a st] (gp (args 0) w st)
              [c2 b st] (gp (args 1) w st)
              [r st] (tmp st :bool)]
          [(concat c1 c2 [(str r " = " a " " fop " " b)]) r st])
        ;; One operand is boxed. Check its tag: a long or a double is
        ;; compared unboxed, anything else takes the generic call. The
        ;; ORDER is kept -- (< i n) is not (< n i).
        (let [bi (if (num? (ats 0)) 1 0)
              ni (- 1 bi)
              nt (ats ni)
              [cn x st] (gp (args ni) nt st)
              ;; a boxed local that cannot change in this loop was read
              ;; and unboxed once before it (see :loop); otherwise the
              ;; tag and value are read here, every time
              h (when (= :local (:op (args bi))) (get (:hoisted st) (:i2 (args bi))))
              [cb s st] (if h [[] (:slot h) st] (gen (args bi) st))
              tagx (if h (:tag h) (str "clotran_tag(b + " s ")"))
              intx (if h (:i h) (str "clotran_int(b + " s ")"))
              realx (if h (:d h) (str "clotran_real(b + " s ")"))
              [r st] (tmp st :bool)
              ord (fn [xe ye] (if (= bi 1) (str xe " " fop " " ye) (str ye " " fop " " xe)))
              [slow st] (slow-call nd (if (= bi 1) [[x nt] [s :slot]] [[s :slot] [x nt]]) r :bool st)]
          [(concat cn cb
                   [(str "if (" tagx " == 2_c_int) then")
                    (str "   " r " = " (if (= nt :double)
                                          (ord x (str "real(" intx ", c_double)"))
                                          (ord x intx)))
                    (str "else if (" tagx " == 3_c_int) then")
                    (str "   " r " = " (ord (coerce x nt :double) realx))
                    "else"]
                   (map #(str "   " %) slow)
                   ["end if"])
           r st])))))

(defn- gp
  "A node as a PRIMITIVE of type `want`: [code expr state], expr being a
  Fortran expression of that type. Only asked of a node whose inferred
  type is `want`, or a long where a double is wanted."
  [nd want st]
  (let [t (infer nd (:env st))]
    (cond
      ;; A NUMBER LITERAL INTO A VARIABLE first: written in place, an
      ;; expression of literals is a constant expression, which gfortran
      ;; evaluates as it compiles and refuses outright when it overflows
      ;; -- (inc Long/MAX_VALUE) under its own guard, which never runs,
      ;; failed a whole namespace's library. The optimiser still sees
      ;; the constant. (scripts/fuzz found it.)
      (and (= :const (:op nd)) (#{:long :double} t))
      (let [[v st] (tmp st t)]
        [[(str v " = " (if (and (= t :long) (= (:p1 nd) clotran.host.int8/MIN_VALUE))
                          "-huge(0_c_int64_t) - 1_c_int64_t"
                          (lit (:p1 nd) t)))]
         (coerce v t want) st])

      (and (= :const (:op nd)) (prim? t))
      [[] (coerce (lit (:p1 nd) t) t want) st]

      (and (= :local (:op nd)) (prim? t))
      [[] (coerce (slot-var (:i2 nd) t) t want) st]

      (and (= :call (:op nd)) (prim? t) (head-op (first (:children nd))))
      (let [[c e st] (gp-call nd t st)] [c (coerce e t want) st])

      ;; Anything else whose type is PROVEN: generate it as a value and
      ;; read the primitive back out. The proof is what makes the read
      ;; safe.
      :else
      (let [[c s st] (gen nd st)] [c (coerce (unbox t s) t want) st]))))

(defn- flush-typed
  "Every primitive local in scope, written back into the frame. The
  interpreter reads locals from the frame, so this runs before a
  subtree is handed to it; it cannot rebind one (a recur inside such a
  subtree is declined), so nothing has to be read back afterwards."
  [st]
  (let [typed (filter (fn [[_ t]] (prim? t)) (get-in st [:env :slots]))]
    (if (empty? typed)
      [[] st]
      (let [[s st] (fresh st)]
        [(mapcat (fn [[slot t]]
                   [(box s t (slot-var slot t))
                    (str "call clotran_frame_put(b + 1, " slot "_c_int, b + " s ")")])
                 typed)
         st]))))

(defn- fallback
  "A node kind the generator has not learned, handed back to the
  interpreter: its NODE goes in the pool and `clotran_eval_node` runs it
  in the same frame the compiled code is using.

  This is why the generator can be permanently incomplete without the
  language losing anything. An unhandled construct costs the
  interpreter's speed for that subtree and nothing else."
  [nd st]
  (let [p {:kind :node :value (:node nd)}
        [fc st] (flush-typed st)
        [r st] (fresh st)]
    [(concat fc
             [(str "st = clotran_eval_node(b + " r ", b + " (get (:pool st) p) ", b + 1)")]
             err-return)
     r st]))

(defn- local-read
  "A local read into slot s; the local's LAST read clears it (the analyser
  marks that read, :p2 true, as the interpreter's F_MOVEC does), so a
  local never holds the head of a seq a later call is walking."
  [s nd]
  (cond-> [(str "call clotran_frame_get(b + " s ", b + 1, " (:i2 nd) "_c_int)")]
    (true? (:p2 nd)) (conj (str "call clotran_frame_clear(b + 1, " (:i2 nd) "_c_int)"))))

(defn- gen-into
  "Generate a node so that its value ends up in slot `dst`. A constant,
  a local and a pooled value are put there directly; anything else is
  generated where it likes and then copied."
  [nd dst st]
  (let [t (when (= :local (:op nd)) (get-in st [:env :slots (:i2 nd)]))]
    (cond
      ;; a :var or :const entry IS the value; a :node entry is a subtree
      ;; and has to be run
      (#{:var :const} (:kind (pooled nd)))
      [[(str "call clotran_copy(b + " dst ", b + " (get (:pool st) (pooled nd)) ")")] st]

      (= :const (:op nd))
      [(emit-const (str "b + " dst) (:p1 nd)) st]

      (and (= :local (:op nd)) (prim? t))
      [[(box dst t (slot-var (:i2 nd) t))] st]

      (= :local (:op nd))
      [(local-read dst nd) st]

      :else
      (let [[c s st] (gen nd st)]
        ;; the subtree's slot is a temporary used once: cleared, so it does
        ;; not hold what it made -- a seq's head -- while the rest runs. A
        ;; pooled value came with no code, and its slot is the pool's.
        [(cond-> (conj (vec c) (str "call clotran_copy(b + " dst ", b + " s ")"))
           (seq c) (conj (str "call clotran_set_nil(b + " s ")")))
         st]))))

(defn- gen-seq
  "Generate each node in turn, answering the code and the slot the LAST
  one landed in."
  [nodes st]
  (reduce (fn [[code _ st] nd]
            (let [[c s st'] (gen nd st)]
              [(into code c) s st']))
          [[] nil st] nodes))

(defn- bind-slots
  "Bind a let's or loop's slots in order. A primitive slot is assigned
  its Fortran variable; a boxed one goes into the frame. `types` gives
  a loop's settled types; a let's are inferred as it goes."
  [kids n base types st]
  (reduce (fn [[code st] i]
            (let [slot (+ base i)
                  t (or (get types slot) (infer (nth kids i) (:env st)))]
              (if (prim? t)
                (let [[c e st] (gp (nth kids i) t st)
                      v (slot-var slot t)]
                  [(into code (conj (vec c) (str v " = " e)))
                   (-> st (declare-var v t) (assoc-in [:env :slots slot] t))])
                (let [[c s st] (gen (nth kids i) st)]
                  ;; the temporary is cleared once the local has it (as
                  ;; gen-into's), or a loop's first binding held the head
                  ;; of the seq the loop walks: protocols' internal-reduce
                  [(into code (cond-> (conj (vec c) (str "call clotran_frame_put(b + 1, " slot "_c_int, b + " s ")"))
                                (seq c) (conj (str "call clotran_set_nil(b + " s ")"))))
                   (assoc-in st [:env :slots slot] :any)]))))
          [[] st] (range n)))

(defn- hoist-invariants
  "Read and unbox, ONCE and before the loop, every boxed local the
  loop body compares and cannot change: a parameter, or a local bound
  outside the loop. Locals are immutable and only a recur rebinds
  one, and a recur rebinds only its own loop's slots -- so these are
  fixed for the loop's whole run, and reading them every iteration
  was three runtime calls a time round for nothing. It is what the
  clj's JIT does by speculation; here it is known."
  [body own st]
  (let [params (:params st #{})
        slots (->> (walk-nodes body)
                   (filter #(= :local (:op %)))
                   (map :i2)
                   (remove own)
                   (remove #(get (:hoisted st) %))
                   ;; boxed, and in scope at the loop: a parameter, or a
                   ;; local already bound. A HINTED parameter is typed and
                   ;; is not hoisted.
                   (filter #(and (= :any (get-in st [:env :slots %] :any))
                                 (or (params %) (contains? (get-in st [:env :slots]) %))))
                   distinct)]
    (reduce (fn [[code st] slot]
              (let [[s st] (fresh st)
                    k (:ntmp st 0)
                    tg (str "tg" k) hi (str "hi" k) hd (str "hd" k)
                    st (-> st (assoc :ntmp (inc k))
                           (declare-var tg :tag) (declare-var hi :long) (declare-var hd :double)
                           (assoc-in [:hoisted slot] {:slot s :tag tg :i hi :d hd}))]
                [(into code [(str "call clotran_frame_get(b + " s ", b + 1, " slot "_c_int)")
                             (str tg " = clotran_tag(b + " s ")")
                             (str hi " = 0_c_int64_t")
                             (str hd " = 0.0_c_double")
                             (str "if (" tg " == 2_c_int) " hi " = clotran_int(b + " s ")")
                             (str "if (" tg " == 3_c_int) " hd " = clotran_real(b + " s ")")])
                 st]))
            [[] st] slots)))

(defn- release-around
  "A loop that gives the baton up while it runs (PLAN.md step 11, stage
  2), or nil when it cannot. It can when every runtime call in it is a
  plain statement: each gets a guard that takes the baton back first, so
  nothing reaches the heap without it -- a slow path, the boxing of the
  result -- and the loop's own arithmetic and array reads run while
  clotran code goes on elsewhere. A runtime call inside a condition has
  no room for a guard, and the loop keeps the baton."
  [lines]
  (let [poll? #(str/includes? % "call clotran_poll()")
        runtime? #(and (str/includes? % "clotran_") (not (poll? %)))
        ;; a statement -- an assignment or a call -- has room for a guard
        ;; in front of it; an if, else or do line does not
        plain? #(re-find #"^\s*(call |\w+ = )" %)
        ;; the body of the do is indented by 3; a runtime call there runs
        ;; every time round, and giving the baton up for it is all cost
        top-level? #(= 3 (count (re-find #"^ *" %)))]
    (when (and (some runtime? lines) (every? #(or (not (runtime? %)) (plain? %)) lines)
               (not-any? #(and (runtime? %) (top-level? %)) lines))
      (concat ["call clotran_native_begin(nme, nrel)"]
              (mapcat (fn [l]
                        (cond
                          (poll? l) [(str (re-find #"^\s*" l) "if (nrel == 0) call clotran_poll()")]
                          (runtime? l) [(str (re-find #"^\s*" l) "if (nrel /= 0) call clotran_reacquire(nme, nrel)") l]
                          :else [l]))
                      lines)
              ["if (nrel /= 0) call clotran_reacquire(nme, nrel)"]))))

(declare fn-procedure)

(defn- gen
  "One node, as a VALUE. Answers [code slot state]: the statements that
  compute it, the slot its value lands in, and the state after."
  [nd st]
  (if (not (compiled-ops (:op nd)))
    (fallback nd st)
    (if-let [p (pooled nd)]
      ;; already in its slot from the top of the procedure
      [[] (get (:pool st) p) st]
      (let [t (infer nd (:env st))]
        (case (:op nd)
          :const (let [[s st] (fresh st)]
                   [(emit-const (str "b + " s) (:p1 nd)) s st])

          :local (let [[s st] (fresh st)]
                   (if (prim? t)
                     [[(box s t (slot-var (:i2 nd) t))] s st]
                     [(local-read s nd) s st]))

          :do (let [[code s st] (gen-seq (:children nd) st)]
                (if s [code s st] (gen {:op :const :p1 nil} st)))

          :if (let [[test th el] (:children nd)
                    tt (infer test (:env st))
                    ;; ts: the test's own slot, let go once a branch is
                    ;; taken -- (if-let [s (seq coll)] ...) otherwise held
                    ;; the seq's head through the branch, all of seq-reduce
                    [tc cond st ts] (if (= :bool tt)
                                      (gp test :bool st)
                                      (let [[c s st] (gen test st)]
                                        [c (str "clotran_bool(b + " s ") /= 0") st (when (seq c) s)]))
                    let-go (when ts [(str "   call clotran_set_nil(b + " ts ")")])
                    [r st] (fresh st)
                    [thc ths st] (gen th st)
                    [elc els st] (if el (gen el st) (gen {:op :const :p1 nil} st))
                    ;; a recur branch produces nothing anyone reads
                    copy (fn [br s] (when-not (= :recur (:op br))
                                      [(str "   call clotran_copy(b + " r ", b + " s ")")]))]
                [(concat tc
                         [(str "if (" cond ") then")]
                         let-go
                         (map #(str "   " %) thc)
                         (copy th ths)
                         ["else"]
                         let-go
                         (map #(str "   " %) elc)
                         (copy (or el {:op :const}) els)
                         ["end if"])
                 r st])

          :call (if (and (prim? t) (head-op (first (:children nd))))
                  ;; a numeric op on proven numbers: primitive, then boxed
                  ;; once for whoever wants the value
                  (let [[c e st] (gp-call nd t st)
                        [s st] (fresh st)]
                    [(conj (vec c) (box s t e)) s st])
                  (if-let [opc (let [[_ s] (head-op (first (:children nd)))]
                                 (get boxed-ops [s (count (rest (:children nd)))]))]
                    ;; a numeric op on BOXED operands: answered by the
                    ;; runtime for two longs or two doubles, the builtin
                    ;; otherwise (clotran_arith)
                    (let [kids (:children nd)
                          ;; the op's own fn is needed only when the inline
                          ;; path cannot answer: fetched (and a Var derefed)
                          ;; there, not in the prologue of every call
                          p (pooled (first kids))
                          [hc hs st] (if p (let [[t st] (fresh st)] [nil t st]) (gen (first kids) st))
                          fetch (when p
                                  (cond-> [(str "call clotran_pool_get(b + " hs ", cf_pool, "
                                                (+ (:offset st) (get (:pidx st) p)) "_c_int)")]
                                    (= :var (:kind p)) (conj (str "call clotran_deref(b + " hs ", b + " hs ")"))))
                          n (count (rest kids))
                          [blk st] (reduce (fn [[bl st] _] (let [[s st'] (fresh st)] [(conj bl s) st'])) [[] st] (range n))
                          [ac st] (reduce (fn [[code st] [k d]] (let [[c st'] (gen-into k d st)] [(into code c) st']))
                                          [[] st] (map vector (rest kids) blk))
                          [r st] (fresh st)]
                      [(concat hc ac
                               (arith-inline opc (first blk) (or (second blk) (first blk)) r
                                             (concat fetch
                                                     [(str "st = clotran_arith(b + " r ", " opc "_c_int, b + " hs ", b + " (first blk)
                                                           ", b + " (or (second blk) (first blk)) ", " n "_c_int)")]
                                                     err-return)))
                       r st])
                  (let [kids (:children nd)
                        [hc hs st] (gen (first kids) st)
                        n (count (rest kids))
                        [blk st] (reduce (fn [[bl st] _]
                                           (let [[s st'] (fresh st)] [(conj bl s) st']))
                                         [[] st] (range n))
                        [ac st] (reduce (fn [[code st] [k d]]
                                          (let [[c st'] (gen-into k d st)]
                                            [(into code c) st']))
                                        [[] st] (map vector (rest kids) blk))
                        [r st] (fresh st)]
                    [(concat hc ac
                             (site nd st)
                             [(str "st = clotran_call_slots(b + " r ", b + " hs ", b + "
                                   (if (zero? n) 1 (dec (first blk))) ", " n "_c_int)")]
                             err-return)
                     r st])))

          ;; A CLOSURE. Its fn is a procedure of its own in this file,
          ;; sharing this fn's pool, registered at install with no Var;
          ;; here it is made from its handle and the captured locals --
          ;; written back to the frame first if a Fortran variable holds
          ;; them. See ClotranABI's clotran_make_closure.
          :fn (let [[nm _ caps _ selfslot] (:p1 nd)
                    n (swap! (:counter st) inc)
                    isym (str (:prefix st) "_" n)
                    ;; the analyser's display name, as the interpreter's frames show it
                    who (or (get (:p1 nd) 8) (str (:who st) "/" (or nm (str "fn" n))))
                    proc (fn-procedure isym who (:p1 nd) nil (:offset st) (:pool-list st)
                                       {:closure? true :counter (:counter st) :prefix (:prefix st)})
                    [fc st] (flush-typed st)
                    st (update st :inners (fnil into []) (cons (dissoc proc :inners) (:inners proc)))
                    [r st] (fresh st)
                    arr (if (seq caps)
                          (str "[integer(c_int) :: " (str/join ", " caps) "]")
                          "[integer(c_int) :: 0]")]
                [(concat fc
                         [(str "call clotran_make_closure(b + " r ", h_" isym ", " (:arity proc) "_c_int, ctext("
                               (fort-str who) "), " (count who) "_c_int, b + 1, " arr ", "
                               (quot (count caps) 2) "_c_int, " selfslot "_c_int)")])
                 r st])

          ;; (lazy-seq body...): the analyser's N_LAZY carries the template a
          ;; (fn* [] body...) would, so its body is a compiled closure, and
          ;; the seq is made around it as (new clotran.host.lazy_seq f) is
          ;; (clotran_new takes the slot BEFORE its arguments)
          :lazy (let [[c f st] (gen (assoc nd :op :fn) st)
                      cname "clotran.host.lazy_seq"
                      [r st] (fresh st)]
                  [(concat c
                           [(str "st = clotran_new(b + " r ", ctext(" (fort-str cname) "), " (count cname)
                                 "_c_int, b + " (dec f) ", 1_c_int)")]
                           err-return)
                   r st])

          ;; (new Class args...): the arguments into consecutive slots,
          ;; as a call's are, and the interpreter's constructor path --
          ;; `lazy-seq` is (new clotran.host.lazy_seq (fn* [] ...)), so
          ;; this is what makes a lazy seq's body compiled code
          :new (let [kids (:children nd)
                     cname (str (:p1 nd))
                     n (count kids)
                     [blk st] (reduce (fn [[bl st] _] (let [[s st'] (fresh st)] [(conj bl s) st']))
                                      [[] st] (range n))
                     [ac st] (reduce (fn [[code st] [k d]]
                                       (let [[c st'] (gen-into k d st)] [(into code c) st']))
                                     [[] st] (map vector kids blk))
                     [r st] (fresh st)]
                 [(concat ac
                          [(str "st = clotran_new(b + " r ", ctext(" (fort-str cname) "), " (count cname)
                                "_c_int, b + " (if (zero? n) 1 (dec (first blk))) ", " n "_c_int)")]
                          err-return)
                  r st])

          ;; INTEROP, (. target member args...): the target -- unless
          ;; the node names a class -- and the arguments into slots, then
          ;; the interpreter's own dispatch with the node from the pool
          :dot (let [kids (:children nd)
                     cls? (symbol? (:p2 nd))
                     from (if cls? 0 1)
                     node-slot (get (:pool st) {:kind :node :value (:node nd)})
                     [tc ts st] (if cls? [[] 1 st] (gen (first kids) st))
                     args (drop from kids)
                     n (count args)
                     [blk st] (reduce (fn [[bl st] _] (let [[s st'] (fresh st)] [(conj bl s) st']))
                                      [[] st] (range n))
                     [ac st] (reduce (fn [[code st] [k d]]
                                       (let [[c st'] (gen-into k d st)] [(into code c) st']))
                                     [[] st] (map vector args blk))
                     [r st] (fresh st)]
                 (when-not node-slot (throw (ex-info "an interop node missing from the pool" {})))
                 [(concat tc ac
                          [(str "st = clotran_dot(b + " r ", b + " node-slot ", b + " ts ", b + "
                                (if (zero? n) 1 (dec (first blk))) ", " n "_c_int, " from "_c_int)")]
                          err-return)
                  r st])

          :let (let [kids (:children nd) n (:i2 nd) outer (:env st)
                     [bc st] (bind-slots kids n (:p1 nd) {} st)
                     [c s st] (gen (nth kids n) st)]
                 [(concat bc c) s (assoc st :env outer)])

          ;; A LOOP is a Fortran loop. Clojure guarantees `recur` is
          ;; constant stack, so it is a jump in any correct
          ;; implementation. A recur rebinds the loop's slots and raises
          ;; its flag; `recur` is always in TAIL position, so whatever
          ;; statements follow it in its branch are never read.
          :loop (let [outermost? (not (:releasing st))
                      st (assoc st :releasing true)
                      kids (:children nd) n (:i2 nd) base (:p1 nd)
                      outer-loop (:loop st)
                      outer-env (:env st)
                      lenv (loop-env nd (:env st))
                      types (into {} (for [i (range n)]
                                       [(+ base i) (get-in lenv [:slots (+ base i)])]))
                      [ic st] (bind-slots kids n base types st)
                      outer-hoisted (:hoisted st)
                      [hc st] (hoist-invariants (nth kids n) (set (range base (+ base n))) st)
                      flag (str "recur" (count (:flags st)))
                      st (update st :flags conj flag)
                      [bc bs st] (gen (nth kids n) (assoc st :loop flag))]
                  (let [loop-lines (concat ["do" (str "   " flag " = 0") "   call clotran_poll()"]
                                           (map #(str "   " %) bc)
                                           [(str "   if (" flag " == 0) exit") "end do"])
                        released (when outermost? (release-around loop-lines))
                        st (cond-> (assoc st :loop outer-loop :env outer-env :hoisted outer-hoisted
                                          :releasing (not outermost?))
                             released (-> (declare-var "nme" :tag) (declare-var "nrel" :tag)))]
                    [(concat ic hc (or released loop-lines)) bs st]))

          ;; RECUR: every argument is computed BEFORE any slot is
          ;; rebound -- (recur (+ i 1) (+ acc i)) reads the old i twice
          ;; -- then the slots are assigned and the flag raised.
          :recur (let [start (nth (:p1 nd) 1)
                       [code vals st]
                       (reduce (fn [[code vs st] [i k]]
                                 (let [slot (+ start i)
                                       ts (get-in st [:env :slots slot] :any)]
                                   (if (prim? ts)
                                     (let [[c e st] (gp k ts st)
                                           [tv st] (tmp st ts)
                                           ;; the fn's OWN recur rebinds parameters, and a
                                           ;; versioned procedure's guard reads them from
                                           ;; the frame next time round -- so the frame is
                                           ;; kept in step with the Fortran variable
                                           fn-level? (= (:fn-loop st) (:loop st))
                                           [bs st] (if fn-level? (fresh st) [nil st])]
                                       [(into code (conj (vec c) (str tv " = " e)))
                                        (into vs (cond-> [(str (slot-var slot ts) " = " tv)]
                                                   fn-level? (into [(box bs ts tv)
                                                                    (str "call clotran_frame_put(b + 1, " slot
                                                                         "_c_int, b + " bs ")")])))
                                        st])
                                     (let [[c s st] (gen k st)]
                                       [(into code c)
                                        (cond-> (conj vs (str "call clotran_frame_put(b + 1, " slot
                                                              "_c_int, b + " s ")"))
                                          (seq c) (conj (str "call clotran_set_nil(b + " s ")")))
                                        st]))))
                               [[] [] st] (map-indexed vector (:children nd)))
                       [r st] (fresh st)]
                   [(concat code vals [(str (:loop st) " = 1")]) r st]))))))

(defn- decls-text
  "The Fortran declarations for every primitive variable a procedure
  used, grouped by type."
  [decls]
  (apply str
         (for [[t ty] [[:tag "integer(c_int)"] [:long "integer(c_int64_t)"] [:double "real(c_double)"]
                       [:bool "logical"] [:cptr "type(c_ptr)"]
                       [:dptr "real(c_double), pointer"] [:iptr "integer(c_int64_t), pointer"]]
               :let [names (sort (keep (fn [[nm k]] (when (= k t) (if (#{:dptr :iptr} t) (str nm "(:)") nm))) decls))]
               :when (seq names)]
           (str "    " ty " :: " (str/join ", " names) "\n"))))

(defn- param-vectors
  "The parameter vector of each arity of a (fn ...) form, in order:
  (fn [x] ...) has one, (fn ([x] ...) ([x y] ...)) one per clause."
  [form]
  (if-let [v (first (filter vector? form))]
    [v]
    (mapv first (filter seq? form))))

(defn- param-hints
  "The type each HINTED fixed parameter of one arity promises, by its
  frame slot (the arity's start plus its position). Clojure's own
  spelling: ^double and ^long make a primitive, ^doubles and ^longs an
  array of one. A parameter with no hint, any other hint, or the rest
  parameter of a variadic arity is boxed."
  [params start]
  (into {} (keep-indexed
            (fn [i p]
              (when-let [t ('{doubles :doubles longs :longs double :double long :long}
                            (:tag (meta p)))]
                [(+ start i) t]))
            (take-while #(not= '& %) params))))

(defn- array-params
  "The parameters the body uses as arrays -- the first argument of aget,
  aset or alength -- and that carry no hint. Nested fns are skipped:
  their slots are their own frame's."
  [body params hints]
  (let [nodes (tree-seq #(and (coll? %) (not (#{:fn :lazy} (:op %)))) seq body)]
    (into (sorted-set)
          (for [nd nodes
                :when (and (map? nd) (= :call (:op nd)))
                :let [[k] (head-op (first (:children nd)))
                      a (second (:children nd))]
                :when (and (#{:aget :aset :alength} k) (= :local (:op a))
                           (params (:i2 a)) (not (contains? hints (:i2 a))))]
            (:i2 a)))))

(defn- versions
  "The typings a procedure is generated for, tried in order, before the
  untyped body. A scientist writes (aget a i) and no hint, so the
  arrays the body indexes are SPECULATED: all double, then all long.
  The guard checks the argument itself, so a wrong guess costs one
  check and runs the untyped body -- it never changes an answer."
  [hints arrays]
  ;; ponytail: one kind for all arrays per version, not every mix; a fn
  ;; indexing a double array and a long array together runs untyped.
  (cond
    (seq arrays) (for [t [:doubles :longs]] (into hints (map (fn [s] [s t]) arrays)))
    (seq hints) [hints]
    :else []))

(defn- guard-code
  "Read each hinted parameter and check it is what its hint says: a
  double or a long by its tag, an array by asking for a view of it.
  Answers [code setup state]: the checks, which leave `hok` true only
  if every one passed, and what to do once they have -- point the
  array variables at the buffers and unbox the primitives."
  [hints st]
  (reduce (fn [[code setup st] [slot t]]
            (let [[s st] (fresh st)
                  get (str "call clotran_frame_get(b + " s ", b + 1, " slot "_c_int)")]
              (case t
                (:doubles :longs)
                (let [st (-> st (declare-var (str "ap" slot) :cptr)
                             (declare-var (str "an" slot) :long)
                             (declare-var (av-name slot t) (if (= t :doubles) :dptr :iptr)))]
                  [(into code [get (str "hok = hok .and. clotran_array_view(b + " s ", "
                                        (if (= t :doubles) 1 2) "_c_int, ap" slot ", an" slot ") /= 0")])
                   (conj setup (str "call c_f_pointer(ap" slot ", " (av-name slot t) ", [an" slot "])"))
                   st])
                (:double :long)
                (let [v (slot-var slot t)
                      st (declare-var st v t)]
                  [(into code [get (str "hok = hok .and. clotran_tag(b + " s ") == "
                                        (if (= t :double) 3 2) "_c_int")])
                   (conj setup (str v " = " (unbox t s)))
                   st]))))
          [[] [] st] (sort hints)))

(defn- arity-code
  "One arity's statements, inside the procedure: its arguments into the
  frame, its body as a loop -- a recur with no enclosing loop rebinds
  the parameters -- and its value copied to dst.

  With speculated or hinted types the body is VERSIONED. Every typed
  parameter is checked on the way in; if all are what they promise,
  the typed body runs, with arrays indexed through Fortran pointers and
  primitives in Fortran variables. If any is not, the untyped body runs
  -- the code the arity would get with no hints at all. So a wrong
  argument answers exactly what the interpreter answers, and compiling
  still cannot change what a call means."
  [[nfixed variadic start body] pvec st]
  (let [params (set (range start (+ start nfixed (if variadic 1 0))))
        hints (param-hints pvec start)
        vs (versions hints (array-params body params hints))
        flag (str "recur" (count (:flags st)))
        st (-> st (update :flags conj flag)
               (assoc :loop flag :fn-loop flag :params params :env {:slots {}} :hoisted {}))
        [rest-code st] (if variadic
                         (let [[s st] (fresh st)]
                           [[(str "call clotran_rest_args(b + " s ", argbase, " nfixed "_c_int, nargs)")
                             (str "call clotran_frame_put(b + 1, " (+ start nfixed) "_c_int, b + " s ")")
                             ;; the local has it: (apply + (take n (range))) walks it
                             (str "call clotran_set_nil(b + " s ")")]
                            st])
                         [[] st])
        [code res st]
        (if (empty? vs)
          (gen body st)
          ;; each version nests in the previous one's else: guard, typed
          ;; body, and failing that the next -- the untyped body last
          (let [st (declare-var st "hok" :bool)
                [r st] (fresh st)
                [uc ures st] (gen body (assoc st :env {:slots {}} :hoisted {}))
                [code st]
                (reduce (fn [[inner st] h]
                          (let [[gc setup st] (guard-code h st)
                                [tc tres st] (gen body (assoc st :env {:slots h} :hoisted {}))]
                            [(concat ["hok = .true."] gc
                                     ["if (hok) then"]
                                     (map #(str "   " %) (concat setup tc))
                                     [(str "   call clotran_copy(b + " r ", b + " tres ")")
                                      "else"]
                                     (map #(str "   " %) inner)
                                     ["end if"])
                             st]))
                        [(concat uc [(str "call clotran_copy(b + " r ", b + " ures ")")]) st]
                        (reverse vs))]
            [code r st]))]
    [(concat (for [i (range nfixed)]
               (str "call clotran_frame_put(b + 1, " (+ start i) "_c_int, argbase + " (inc i) ")"))
             rest-code
             ;; the arguments are this frame's now: the caller's slots let
             ;; go, so the caller does not hold a seq this fn walks
             ["call clotran_clear_args(argbase, nargs)"]
             ["do" (str "   " flag " = 0") "   call clotran_poll()"]
             (map #(str "   " %) code)
             [(str "   if (" flag " == 0) exit") "end do"
              (str "call clotran_copy(dst, b + " res ")")])
     st]))

(def ^:private stack-entries
  "The runtime entries that take this thread's stack as their first
  argument (ClotranABI, clotran_stack)."
  #{"arith" "array_view" "bool" "call_slots" "captures" "clear_args" "copy" "deref" "dot" "eval_node" "frame_clear" "frame_done" "frame_enter" "frame_get" "frame_leave" "frame_new" "frame_put" "frame_stack" "int" "make_closure" "new" "pool_get" "real" "rest_args" "set_bool" "set_int" "set_nil" "set_real" "set_str" "tag"})

(defn- direct-slots
  "A procedure's text with the entries that only read or write one slot
  replaced by the Fortran that does it on sv, the stack's slots viewed
  as clotran_val (ClotranABI, clotran_slots): a copy is an assignment, a
  tag or payload a load. Each was a call into the runtime; a compiled
  (+ a b) made ten. The readers go first: a write's value can hold one."
  [text]
  (let [slot "([^,()]+)"
        rd (fn [nm] (re-pattern (str "clotran_" nm "\\(cs, " slot "\\)")))
        wr (fn [nm] (re-pattern (str "(?m)call clotran_" nm "\\(cs, " slot ", (.*)\\)$")))]
    (-> text
        (str/replace (rd "tag") (fn [[_ a]] (str "sv(" a ")%tag")))
        (str/replace (rd "int") (fn [[_ a]] (str "sv(" a ")%ival")))
        (str/replace (rd "real") (fn [[_ a]] (str "transfer(sv(" a ")%ival, 0.0_c_double)")))
        (str/replace (rd "bool")
                     (fn [[_ a]] (str "merge(0_c_int, 1_c_int, sv(" a ")%tag == 0 .or. (sv(" a
                                      ")%tag == 1 .and. sv(" a ")%ival == 0))")))
        (str/replace (re-pattern (str "call clotran_copy\\(cs, " slot ", " slot "\\)"))
                     (fn [[_ d src]] (str "sv(" d ") = sv(" src ")")))
        (str/replace (re-pattern (str "call clotran_set_nil\\(cs, " slot "\\)"))
                     (fn [[_ d]] (str "sv(" d ") = clotran_val(0, 0, 0_c_int64_t)")))
        (str/replace (wr "set_int") (fn [[_ d e]] (str "sv(" d ") = clotran_val(2, 0, int(" e ", c_int64_t))")))
        (str/replace (wr "set_real")
                     (fn [[_ d e]] (str "sv(" d ") = clotran_val(3, 0, transfer(real(" e ", c_double), 0_c_int64_t))")))
        (str/replace (wr "set_bool")
                     (fn [[_ d e]] (str "sv(" d ") = clotran_val(1, 0, merge(1_c_int64_t, 0_c_int64_t, (" e ") /= 0))"))))))

(defn- with-stack
  "A procedure's text fetching the thread's stack once, into cs, and
  passing it to every entry that takes it: each entry fetching its own
  was a thread-key lookup per call, ~20 per compiled (+ a b)."
  [text]
  (-> text
      (str/replace #"\bclotran_(\w+)\("
                   (fn [[m nm]] (if (stack-entries nm) (str "clotran_" nm "(cs, ") m)))
      direct-slots
      (str/replace-first "    st = 0\n"
                         (str "    type(c_ptr) :: cs\n    type(clotran_val), pointer :: sv(:)\n    integer(c_int) :: nsv\n"
                              "    st = 0\n    cs = clotran_stack()\n"
                              "    call c_f_pointer(clotran_slots(cs, nsv), sv, [nsv])\n"))))

(defn- frameless
  "A procedure's text with its locals in stack slots rather than a heap
  frame. Local i is slot b+high+1+i, and a read or write is a copy
  between slots -- no frame allocated per call, no vector touched per
  local. When something else still takes the frame at b+1 -- a closure
  made or entered, a node handed to the interpreter -- b+1 NAMES those
  slots (clotran_frame_stack, PLAN 26.5) and they read and write the
  same ones."
  [high nslots text]
  (let [get-re #"call clotran_frame_get\((b \+ \d+), b \+ 1, (\d+)_c_int\)"
        put-re #"call clotran_frame_put\(b \+ 1, (\d+)_c_int, ([^)]+)\)"
        clear-re #"call clotran_frame_clear\(b \+ 1, (\d+)_c_int\)"
        new-re #"    call clotran_frame_new\(b \+ 1, \d+_c_int\)\n"
        slot #(str "b + " (+ high 1 (parse-long %)))
        left (-> text (str/replace get-re "") (str/replace put-re "") (str/replace clear-re "") (str/replace new-re ""))]
    (let [named? (re-find #"b \+ 1\b" left)]
      (-> text
          (str/replace get-re (fn [[_ d i]] (str "call clotran_copy(" d ", " (slot i) ")")))
          (str/replace put-re (fn [[_ i src]] (str "call clotran_copy(" (slot i) ", " src ")")))
          (str/replace clear-re (fn [[_ i]] (str "call clotran_set_nil(" (slot i) ")")))
          (str/replace new-re (if named?
                                (str "    call clotran_frame_stack(b + 1, b + " high ", " nslots "_c_int)\n")
                                ""))
          (str/replace (str "clotran_frame_enter(" (max 1 high) "_c_int)")
                       (str "clotran_frame_enter(" (+ (max 1 high) nslots) "_c_int)"))))))

(defn- fn-procedure
  "One function, every arity of it, as a Fortran subroutine.

  A function with ONE fixed arity is registered with that arity and
  the caller checks the count. Any other is registered as taking any
  count and picks here, as the interpreter's bind_closure does: an
  exact fixed arity first, then the variadic one if enough arguments
  came; failing both, Clojure's ArityException."
  [sym who tmpl form offset pool & [{:keys [closure? counter prefix]}]]
  (let [[_ arities _ nslots _ _] tmpl
        ;; an inner fn has no form of its own: no hints, boxed parameters
        pvecs (if form (param-vectors form) (repeat []))
        ;; b+1 is the locals frame, b+2 .. b+1+P hold what the pool
        ;; supplies, and temporaries start after them; a call's :site is
        ;; read from the pool where it is used and takes no slot
        pidx (into {} (map-indexed (fn [i p] [p i]) pool))
        held (remove #(= :site (:kind %)) pool)
        pslots (into {} (map-indexed (fn [i p] [p (+ 2 i)]) held))
        ;; counted from the list: two = entries, '(9) and [9], are one key
        first-temp (+ 2 (count held))
        st0 {:next first-temp :high (dec first-temp) :pool pslots :pidx pidx :flags []
             :who who :offset offset :pool-list pool :counter (or counter (atom 0))
             :prefix (or prefix (str "cc_" sym))}
        [branches st]
        (reduce (fn [[bs st] [ar pv]]
                  (let [[c st] (arity-code ar pv st)] [(conj bs [ar c]) st]))
                [[] st0] (map vector arities pvecs))
        single? (and (= 1 (count arities)) (not (nth (first arities) 1)))
        fixed (remove (fn [[ar _]] (nth ar 1)) branches)
        varg (first (filter (fn [[ar _]] (nth ar 1)) branches))
        indent #(map (fn [l] (str "   " l)) %)
        body (if single?
               (second (first branches))
               (concat
                (apply concat
                       (map-indexed (fn [i [[n] c]]
                                      (concat [(str (if (zero? i) "if" "else if") " (nargs == " n ") then")]
                                              (indent c)))
                                    fixed))
                (when varg
                  (let [[[n] c] varg]
                    (concat [(str (if (seq fixed) "else if" "if") " (nargs >= " n ") then")] (indent c))))
                ["else"
                 (str "   call clotran_arity_error(nargs, ctext(" (fort-str who) "), " (count who) "_c_int)")
                 "end if"]))]
    ;; a variadic fn's required arity rides along as -(req + 2), so apply
    ;; can hand it the rest unrealised (Eval.f90, B_APPLY); -1 is several
    ;; fixed arities, checked here
    {:arity (if single?
              (first (first arities))
              (if-let [req (some #(when (nth % 1) (first %)) arities)] (- (+ req 2)) -1))
     :inners (:inners st [])
     :who who
     :symbol sym
     :pool (mapv :value pool)
     :text
     (with-stack (frameless (:high st) nslots
     (str "  subroutine " sym "(argbase, nargs, dst) bind(C, name=\"" sym "\")\n"
          "    integer(c_int), value :: argbase, nargs, dst\n"
          "    integer(c_int) :: b, st\n"
          (when (seq (:flags st)) (str "    integer(c_int) :: " (str/join ", " (:flags st)) "\n"))
          (decls-text (:decls st))
          "    st = 0\n"
          "    b = clotran_frame_enter(" (max 1 (:high st)) "_c_int)\n"
          "    call clotran_frame_new(b + 1, " nslots "_c_int)\n"
          (when closure? "    call clotran_captures(b + 1)\n")
          ;; an entry the body never reads is not fetched: the head of an
          ;; inline numeric op fetches its own, on the slow path
          (apply str (for [[p s] (sort-by val pslots)
                           :when (some #(re-find (re-pattern (str "b \\+ " s "\\b")) %) body)]
                       (str "    call clotran_pool_get(b + " s ", cf_pool, "
                            (+ offset (pidx p)) "_c_int)\n"
                            (when (= :var (:kind p))
                              (str "    call clotran_deref(b + " s ", b + " s ")\n")))))
          (apply str (map #(str "    " % "\n") body))
          "    call clotran_frame_done(b)\n"
          "  end subroutine " sym "\n")))}))

(defn compile-fn
  "Compiles one function to Fortran. Answers a map with :text, :symbol,
  :arity and :pool, or one with :declined saying why it could not.

  `form` is the (fn ...) form. The :pool is the values the procedure
  needs that Fortran cannot spell -- Vars, collections, the functions
  analysis folded into call heads -- and the driver registers it and
  hands the handle to the library at install time."
  ([ns-name fn-name form] (compile-fn ns-name fn-name form 0 nil))
  ([ns-name fn-name form offset idx]
   (let [{:keys [tmpl fingerprint pool]} (loader/analyse form fn-name)]
     (if (nil? tmpl)
       {:declined "not a fn form"}
       (if-let [why (decline-reason tmpl)]
         {:declined why}
         ;; Mangling is not one-to-one -- volatile! and volatile? are both
         ;; volatile_ -- and Fortran stops at 63 characters, so a file of
         ;; many functions numbers them and keeps the name for reading.
         (let [sym (if idx
                     (let [nm (fort-ident (str fn-name))]
                       (str "cf" idx "_" (subs nm 0 (min 50 (count nm)))))
                     (str "cf_" (fort-ident (str ns-name)) "_" (fort-ident (str fn-name))))
               proc (fn-procedure sym (str ns-name "/" fn-name) tmpl form offset pool
                                  {:prefix (str "cc" (or idx 0))})]
           (assoc proc :ns ns-name :name fn-name :fingerprint fingerprint)))))))

(defn- manifest-text
  "clotran_manifest, the symbol every package answers its EDN through
  (DynLoad.f90). Built up at the first call in short pieces: a manifest
  carries each function's source, and one long literal would run into
  Fortran's limits on line length and continuation lines."
  [edn]
  (str "  function clotran_manifest() bind(C, name=\"clotran_manifest\") result(p)\n"
       "    type(c_ptr) :: p\n"
       "    character(len=:), allocatable :: s\n"
       "    integer :: i\n"
       "    if (.not. allocated(manifest_buf)) then\n"
       "       s = \"\"\n"
       (apply str (for [piece (map #(apply str %) (partition-all 60 edn))]
                    (str "       s = s // " (fort-str piece) "\n")))
       "       s = s // c_null_char\n"
       "       allocate(manifest_buf(len(s)))\n"
       "       do i = 1, len(s)\n"
       "          manifest_buf(i) = s(i:i)\n"
       "       end do\n"
       "    end if\n"
       "    p = c_loc(manifest_buf)\n"
       "  end function clotran_manifest\n\n"))

(defn module-text
  "A whole generated file: the declarations, the procedures, and the one
  `clotran_install` the loader looks for.

  Every procedure in one file shares one pool, so `pool-of` below is
  how the driver knows what to register. The install entry takes the
  handle rather than having it baked in, because a file is written
  before it is registered."
  ([mod-name procs] (module-text mod-name procs nil))
  ([mod-name procs manifest]
  (str "! GENERATED by clotran.compiler. Do not edit; recompile.\n"
       runtime-decls
       "\nmodule " mod-name "\n"
       "  use iso_c_binding\n"
       "  use clotran_rt_decl\n"
       "  implicit none\n"
       "  ! the handle of this namespace's constant pool, told to us at\n"
       "  ! install time because it is not known when this file is written\n"
       "  integer(c_int), save :: cf_pool = 0\n"
       (when manifest
         "  character(kind=c_char), allocatable, target, save :: manifest_buf(:)\n")
       ;; each compiled closure's procedure handle, set at install
       (apply str (for [p procs q (:inners p)]
                    (str "  integer(c_int), save :: h_" (:symbol q) " = 0\n")))
       "contains\n"
       (when manifest (manifest-text manifest))
       (str/join "\n" (map :text (concat procs (mapcat :inners procs))))
       "end module " mod-name "\n"
       "\n! The one symbol the loader knows, forever.\n"
       "subroutine clotran_install(pool) bind(C, name=\"clotran_install\")\n"
       "  use iso_c_binding\n"
       "  use clotran_rt_decl\n"
       "  use " mod-name "\n"
       "  implicit none\n"
       "  integer(c_int), value :: pool\n"
       "  integer(c_int) :: st\n"
       "  cf_pool = pool\n"
       (apply str
              (for [p procs q (:inners p)]
                (str "  h_" (:symbol q) " = clotran_register_proc(ctext(" (fort-str (:who q (str (:symbol q)))) "), "
                     (count (:who q (str (:symbol q)))) "_c_int, c_funloc(" (:symbol q) "))\n")))
       (apply str
              (for [p procs]
                (str "  st = clotran_def_fn(ctext(" (fort-str (str (:ns p))) "), "
                     (count (str (:ns p))) "_c_int, ctext(" (fort-str (str (:name p))) "), "
                     (count (str (:name p))) "_c_int, c_funloc(" (:symbol p) "), "
                     (:arity p) "_c_int)\n")))
       "end subroutine clotran_install\n")))

(defn pool-of
  "The constants every procedure in a file needs, as one vector: each
  procedure's own, in order, and each was compiled with the OFFSET its
  entries start at (compile-file). clotran.loader rebuilds exactly this
  vector in a later process."
  [procs]
  (vec (mapcat :pool procs)))

(defn- last-touch
  "name -> the index of the LAST top-level form that defines it or names
  its Var -- (def x ...), (defn x ...), (alter-var-root #'x ...), any
  (var x) at all. Clojure installs a compiled defn at its own place in
  the file; the loader installs after the whole file has run, so a defn
  anything later touches would clobber what came after it."
  [forms]
  (let [defs '#{def defn defn- defmacro defmulti defonce definline}]
    (reduce (fn [m [i f]]
              (reduce (fn [m x]
                        (if (and (seq? x) (or (defs (first x)) (= 'var (first x))) (symbol? (second x)))
                          (assoc m (second x) i)
                          m))
                      m (tree-seq coll? seq f)))
            {} (map-indexed vector forms))))

(defn- extend-sites
  "The fns a top-level form gives a protocol for a type: each
  (extend T P {:m (fn ...) ...}) it comes to once extend-protocol and
  extend-type are expanded, as [type-form proto-form method fn-form].
  Only literal maps of literal fns: anything built another way stays
  interpreted."
  [form]
  (let [head (when (and (seq? form) (symbol? (first form))) (symbol (name (first form))))
        f (if ('#{extend-protocol extend-type} head) (macroexpand-1 form) form)]
    (cond
      (and (seq? f) (= 'do (first f))) (mapcat extend-sites (rest f))
      ('#{extend-protocol extend-type} (when (and (seq? f) (symbol? (first f))) (symbol (name (first f)))))
      (extend-sites f)
      (and (seq? f) (symbol? (first f)) (= 'extend (symbol (name (first f)))) (even? (count (drop 2 f))))
      (let [t (second f)]
        (for [[p m] (partition 2 (drop 2 f))
              :when (map? m)
              [k v] m
              :when (and (keyword? k) (seq? v) (symbol? (first v)) (= "fn" (name (first v))))]
          [t p k v]))
      :else nil)))

(defn- one-arity
  "(fn ([x] body)) as (fn [x] body), the way loader/fn-form writes a defn's."
  [f]
  (let [arities (rest f)]
    (if (and (= 1 (count arities)) (seq? (first arities)) (vector? (ffirst arities)))
      (list* 'fn (first arities))
      (cons 'fn arities))))

(defn compile-file
  "Compiles every top-level defn in the source file `src` to one
  Fortran file, `out`, and answers what it did: {:compiled [names]
  :declined {name why}}. The file is LOADED first, as it will be every
  time it runs, so each function is analysed against the namespace the
  source makes. What declines stays interpreted; nothing else changes.

  Each function is compiled from its form PRINTED and READ BACK, the
  text the manifest carries, so the process that installs the library
  analyses exactly what this one did."
  [src out]
  (let [text (clotran-slurp src)
        [head ns-name] (read-string text)
        ;; clojure.core is loaded before anything runs, and loading it
        ;; again re-evaluates every definition against itself
        _ (when-not (find-ns ns-name) (load-file src))
        _ (when-not (= 'ns head) (throw (ex-info (str src " does not begin with (ns ...)") {})))
        forms (binding [*ns* (the-ns ns-name)] (read-string (str "[" text "\n]")))
        touched (last-touch forms)
        defns (keep-indexed (fn [i f] (when (and (seq? f) (#{'defn 'defn-} (first f))) [i f])) forms)
        [procs declined]
        (binding [*ns* (the-ns ns-name)]
          (reduce (fn [[procs declined] [i d]]
                    (let [nm (second d)
                          f (some-> (loader/fn-form d) loader/print-form)
                          r (cond
                              (> (touched nm i) i)
                              {:declined "defined again, or its Var named, later in the file"}
                              (not (loader/defined-in? (ns-resolve ns-name nm) src))
                              {:declined "its Var's definition comes from another file"}
                              :else
                            (if f
                              (compile-fn ns-name nm (read-string f) (count (pool-of procs)) (count procs))
                              {:declined "not a fn"}))]
                      (if (:declined r)
                        [procs (assoc declined (str nm) (:declined r))]
                        [(conj procs (assoc r :form f)) declined])))
                  [[] {}] defns))
        ;; PROTOCOL EXTENSIONS (PLAN.md step 12, 1c): each fn literal of a
        ;; top-level extend-protocol / extend-type / extend is compiled as a
        ;; defn is, defined under a hidden name in clotran.extends, and put
        ;; into the protocol's method map when the library installs
        ;; (clotran.loader/install)
        sites (binding [*ns* (the-ns ns-name)] (vec (mapcat extend-sites forms)))
        [xprocs declined]
        (binding [*ns* (the-ns ns-name)]
          (reduce (fn [[xs declined] [i [t p k v]]]
                    (let [nm (symbol (str ns-name "__" i "__" (name k)))
                          f (loader/print-form (one-arity v))
                          r (compile-fn 'clotran.extends nm (read-string f)
                                        (count (pool-of (into procs xs))) (+ (count procs) (count xs)))]
                      (if (:declined r)
                        [xs (assoc declined (str (loader/print-form p) " " (loader/print-form t) " " k) (:declined r))]
                        [(conj xs (assoc r :form f :extend {:type (loader/print-form t) :proto (loader/print-form p)
                                                            :method k}))
                         declined])))
                  [[] declined] (map-indexed vector sites)))
        manifest {:ns (str ns-name) :source-hash (hash text) :abi loader/abi
                  :fns (mapv (fn [p] {:name (str (:name p)) :form (:form p) :fingerprint (:fingerprint p)}) procs)
                  :extends (mapv (fn [p] (merge {:name (str (:name p)) :form (:form p) :fingerprint (:fingerprint p)}
                                                (:extend p)))
                                 xprocs)}
        procs (into procs xprocs)]
    (clotran-spit out (module-text (str "cm_" (subs (fort-ident (str ns-name)) 0 (min 40 (count (fort-ident (str ns-name))))))
                                   procs (pr-str manifest)))
    {:compiled (mapv #(str (:name %)) procs) :declined declined}))
