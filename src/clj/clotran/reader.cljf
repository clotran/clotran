(ns clotran.reader
  "Tagged literals in source. The reader cannot apply a data reader --
  it would have to call the evaluator -- so it leaves #tag form as a
  marker, {:clotran/tagged-literal true :clotran/unread true :tag t
  :form f}, and this resolves the markers in a form before it is
  analysed (gce_analyze) or answered by read-string (B_READSTRING), as
  LispReader.CtorReader does at read time: *data-readers*, then
  default-data-readers, then *default-data-reader-fn*, and otherwise
  Clojure's own 'No reader function for tag'. A tagged-literal a program
  built has no :clotran/unread and is left as it is. DEVIATIONS 46.")

(defn- unread? [x]
  (and (map? x) (:clotran/unread x)))

(defn- read-record
  "#ns.Rec{...} and #ns.Rec[...], as LispReader.CtorReader.readRecord: a
  tag whose name has a dot names a class, not a data reader. A map goes
  through the record's map->Rec (its create), a vector through ->Rec,
  its count checked; refused when *read-eval* is false. clotran printed
  records this way and could not read them back (scripts/fuzz-read)."
  [tag form]
  (when-not *read-eval*
    (throw (clotran.host.runtime_exception. "Record construction syntax can only be used when *read-eval* == true")))
  (let [s (str tag)
        i (.lastIndexOf s ".")
        ctor (fn [prefix] (when-let [n (find-ns (symbol (subs s 0 i)))]
                            (ns-resolve n (symbol (str prefix (subs s (inc i)))))))
        positional (ctor "->")]
    (when-not positional
      (throw (clotran.host.class_not_found_exception. s)))
    (cond
      (map? form)
      (do (doseq [k (keys form) :when (not (keyword? k))]
            (throw (clotran.host.runtime_exception.
                    (str "Unreadable defrecord form: key must be of type clotran.host.keyword, got " k))))
          (if-let [m (ctor "map->")]
            (m form)
            (throw (clotran.host.illegal_argument_exception. (str "No matching method create found taking 1 args for class " s)))))

      (vector? form)
      (let [n (count (first (:arglists (meta positional))))]
        (when (not= n (count form))
          (throw (clotran.host.runtime_exception.
                  (str "Unexpected number of constructor arguments to class " s ": got " (count form)))))
        (apply positional form))

      :else
      (throw (clotran.host.runtime_exception. (str "Unreadable constructor form starting with \"#" s "\""))))))

(defn resolve-tags
  "The form with every reader-made tagged literal in it replaced by what
  its data reader answers, innermost first; collections rebuilt only on
  the path to one, metadata kept."
  [form]
  (cond
    (unread? form)
    (let [tag (:tag form)
          inner (resolve-tags (:form form))
          rdr (or (get *data-readers* tag) (get default-data-readers tag))]
      (cond (and (symbol? tag) (not (neg? (.indexOf (name tag) ".")))) (read-record tag inner)
            rdr (rdr inner)
            *default-data-reader-fn* (*default-data-reader-fn* tag inner)
            :else (throw (clotran.host.runtime_exception. (str "No reader function for tag " tag)))))

    (seq? form)
    (with-meta (apply list (map resolve-tags form)) (meta form))

    (vector? form)
    (with-meta (mapv resolve-tags form) (meta form))

    (map? form)
    (with-meta (into (empty form) (map (fn [[k v]] [(resolve-tags k) (resolve-tags v)])) form) (meta form))

    (set? form)
    (with-meta (into (empty form) (map resolve-tags) form) (meta form))

    :else form))
