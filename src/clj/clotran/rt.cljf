(ns clotran.rt
  "The part of clojure.lang.RT and its neighbours that ClojureScript
  writes in Clojure, written in Clojure here too: the iterators behind
  sequence, iterator-seq and eduction, an ArrayList for the transducers
  that buffer, and Collections.shuffle. core.clj reaches them as the
  JVM members it names -- RT/iter, RT/chunkIteratorSeq,
  TransformerIterator/create, (java.util.ArrayList.), (Eduction. ..) --
  through rows in hosttable.inc that call the vars named here (Eval.f90
  rt_call), and this file loads the first time one is reached. A
  deftype's fields cannot be set! here (DEVIATIONS 20), so each mutable
  one holds an atom.")

;;; ---- iterators ------------------------------------------------------

(deftype SeqIter [remaining]
  Object
  (hasNext [_] (boolean (seq @remaining)))
  (next [_]
    (if-let [s (seq @remaining)]
      (do (reset! remaining (rest s)) (first s))
      (throw (ex-info "No such element" {})))))

(defn iter
  "An iterator over anything seqable; nil is empty."
  [coll]
  (SeqIter. (atom coll)))

(deftype MultiIterator [iters]
  Object
  (hasNext [_] (every? #(.hasNext %) iters))
  (next [_] (doall (map #(.next %) iters))))

(defn- ti-step!
  "Fills the iterator's next slot from its buffer, pulling from the
  source through the transducer until something lands there or the
  source runs out. True when a next value is ready."
  [st]
  (loop []
    (let [{:keys [has-next? buffer completed? source multi? xf]} @st]
      (cond
        has-next? true
        (seq buffer) (do (swap! st assoc :next (nth buffer 0) :buffer (subvec buffer 1) :has-next? true)
                         true)
        completed? false
        (.hasNext source) (let [r (if multi?
                                    (apply xf nil (.next source))
                                    (xf nil (.next source)))]
                            (when (reduced? r)
                              (xf nil)
                              (swap! st assoc :completed? true))
                            (recur))
        :else (do (xf nil)
                  (swap! st assoc :completed? true)
                  (recur))))))

(deftype TransformerIterator [st]
  Object
  (hasNext [_] (ti-step! st))
  (next [_]
    (if (ti-step! st)
      (let [v (:next @st)]
        (swap! st assoc :has-next? false :next nil)
        v)
      (throw (ex-info "No such element" {})))))

(defn- transformer-iterator [xform source multi?]
  (let [st (atom {:buffer [] :has-next? false :completed? false :source source :multi? multi?})]
    (swap! st assoc :xf (xform (fn
                                 ([] nil)
                                 ([acc] acc)
                                 ([acc o] (swap! st update :buffer conj o) acc))))
    (TransformerIterator. st)))

(defn ti-create [xform source] (transformer-iterator xform source false))

(defn ti-create-multi [xform sources] (transformer-iterator xform (MultiIterator. (vec sources)) true))

(defn chunk-iterator-seq
  "A lazy seq over an iterator, 32 at a time, as RT.chunkIteratorSeq."
  [it]
  (lazy-seq
    (when (.hasNext it)
      (let [b (chunk-buffer 32)]
        (loop [n 0]
          (if (and (< n 32) (.hasNext it))
            (do (chunk-append b (.next it)) (recur (inc n)))
            (chunk-cons (chunk b) (chunk-iterator-seq it))))))))

;;; ---- java.util.ArrayList, for the transducers that buffer -----------

(deftype ArrayList [items]
  Object
  (add [_ x] (swap! items conj x) true)
  (size [_] (count @items))
  (isEmpty [_] (empty? @items))
  (clear [_] (reset! items []) nil)
  (get [_ i] (nth @items i))
  (toArray [_] @items)
  (iterator [_] (iter @items))
  (seq [_] (seq @items)))

(defn array-list
  "(ArrayList.), (ArrayList. n) -- a capacity, ignored -- or (ArrayList. coll)."
  ([] (ArrayList. (atom [])))
  ([n-or-coll] (ArrayList. (atom (if (number? n-or-coll) [] (vec n-or-coll))))))

(defn shuffle!
  "Collections.shuffle: the list's items in a random order, in place."
  [^ArrayList al]
  (swap! (.-items al)
         (fn [v]
           (loop [v v i (dec (count v))]
             (if (pos? i)
               (let [j (rand-int (inc i))]
                 (recur (assoc v i (nth v j) j (nth v i)) (dec i)))
               v))))
  nil)

;;; ---- agents -----------------------------------------------------------
;; An agent's actions run on a thread of the agent's own, in order, one
;; at a time, as Agent.dispatch's executor runs them: send queues the
;; action (Eval.f90, B_AGENTDISPATCH) and, if none is running, starts
;; agent-run, whose thread drains the queue until clotran-agent-pop!
;; answers nil -- which also marks the agent not running, in one step.

(defn agent-drain [a]
  (loop []
    (when-let [act (clotran-agent-pop! a)]
      (clotran-agent-run1 a (nth act 0) (nth act 1))
      (recur))))

(defn agent-run [a]
  (future (agent-drain a))
  nil)

;;; ---- small members the language suite named ---------------------------

(defn map-equals
  "APersistentMap.mapEquals, behind a record's .equals: the same object,
  or a map of the same size holding every key of m with an equal value.
  Values compare with = where Java's is Util.equals, which differs only
  on mixed numeric types (1 against 1N)."
  [m o]
  (or (identical? m o)
      (and (map? o)
           (= (count m) (count o))
           (every? (fn [[k v]] (and (contains? o k) (= v (get o k)))) m))))

(defn object
  "(Object.): a fresh object equal only to itself -- a sentinel."
  []
  (reify))

(defn test-bit [x n] (not (zero? (bit-and x (bit-shift-left 1 n)))))
(defn set-bit [x n] (bit-or x (bit-shift-left 1 n)))
(defn clear-bit [x n] (bit-and x (bit-not (bit-shift-left 1 n))))
(defn flip-bit [x n] (bit-xor x (bit-shift-left 1 n)))

(defn- typed-array
  "Numbers.long_array and double_array: a Fortran array of the kind, of
  a size, a size and an initial value, or the elements of a seq."
  ([kind x]
   (if (number? x)
     (fortran/make-array kind x)
     (let [v (vec x) a (fortran/make-array kind (count v))]
       (dotimes [i (count v)] (fortran/aset a i (nth v i)))
       a)))
  ([kind n init]
   (let [a (fortran/make-array kind n)]
     (if (number? init)
       (dotimes [i n] (fortran/aset a i init))
       (let [v (vec (take n init))]
         (dotimes [i (count v)] (fortran/aset a i (nth v i)))))
     a)))

(defn long-array-of ([x] (typed-array "int8" x)) ([n init] (typed-array "int8" n init)))
(defn double-array-of ([x] (typed-array "real8" x)) ([n init] (typed-array "real8" n init)))
(defn int-array-of ([x] (typed-array "int4" x)) ([n init] (typed-array "int4" n init)))
(defn float-array-of ([x] (typed-array "real4" x)) ([n init] (typed-array "real4" n init)))
;; REAL bytes and shorts: integer(1) and integer(2) buffers, one and two
;; bytes an element, as Java's byte[] and short[] -- what binary data
;; (a codec, a protocol, a C library) needs. Elements are stored with
;; Java's truncation, as Number.byteValue does.
(defn short-array-of ([x] (typed-array "int2" x)) ([n init] (typed-array "int2" n init)))
(defn byte-array-of ([x] (typed-array "int1" x)) ([n init] (typed-array "int1" n init)))
(defn boolean-array-of ([x] (typed-array "logical" x)) ([n init] (typed-array "logical" n init)))
;; A char array is Java's char[]: 16-bit UTF-16 units (char2), read back
;; as characters. An object array holds clotran VALUES, anything at all.
(defn char-array-of ([x] (typed-array "char2" x)) ([n init] (typed-array "char2" n init)))
(defn object-array-of ([x] (typed-array "value" x)) ([n init] (typed-array "value" n init)))

(defn cycle-of
  "Cycle.create: the seq repeated forever, realised only as far as it is
  walked -- (take 2 (cycle (map f xs))) never reaches the third f."
  [s]
  (lazy-seq (when-let [s (seq s)] (concat s (cycle-of s)))))

(defn kvreduce-of
  "IKVReduce.kvreduce for a vector: f over index and element, stopping
  at a reduced value, which is unwrapped."
  [v f init]
  (loop [i 0 acc init]
    (if (< i (count v))
      (let [r (f acc i (nth v i))]
        (if (reduced? r) @r (recur (inc i) r)))
      acc)))

