(ns clotran.server
  "A REPL over a socket, into a running clotran: start-server listens on a
  port, and every connection gets a thread of its own running an accept
  function -- repl by default -- with *in* and *out* bound to the
  connection. `nc localhost 5555` is then a prompt inside the program,
  and so is Emacs's inf-clojure. With :accept clotran.server/io-prepl it
  answers in data instead, one map a line, for editor plugins and programs.

  clotran's own, not clojure.core.server: that one is written against
  clj's net and clojure.main, whose error reporting reads clj stack traces.
  The shape is the same -- start-server with :name :port :accept, stop-server
  by name -- so a program that starts one reads alike (PLAN.md step 21)."
  (:require [clotran.net :as net]
            [clojure.string :as str]))

(defonce ^:private servers (atom {}))

(defn- class-name [x]
  (let [s (pr-str (class x))] (subs s (inc (str/last-index-of s ".")))))

(defn- report [phase e]
  (binding [*out* *err*]
    (println (str phase " (" (class-name e) ")."))
    (println (or (ex-message e) (pr-str e)))
    (flush)))

(defn repl
  "Read, evaluate, print, until the stream ends or :repl/quit is read.
  The prompt is the namespace's name, as clj's; *1 *2 *3 and *e are the
  connection's own."
  []
  (binding [*ns* (the-ns 'user) *1 nil *2 nil *3 nil *e nil]
    (loop []
      (print (str (ns-name *ns*) "=> "))
      (flush)
      (let [form (try (read {:eof ::eof :read-cond :allow} *in*)
                      (catch clotran.host.throwable e
                        (report "Syntax error reading source" e)
                        ;; the rest of the line is not a form to try again
                        (.readLine *in*)
                        ::skip))]
        (cond (#{::eof :repl/quit} form) nil
              (= ::skip form) (recur)
              :else
              (do (try (let [v (eval form)]
                         (set! *3 *2) (set! *2 *1) (set! *1 v)
                         (prn v))
                       (catch clotran.host.throwable e
                         (set! *e e)
                         (report "Execution error" e)))
                  (flush)
                  (recur)))))))

(defn- resolve-fn [f]
  (if (symbol? f)
    (do (some-> (namespace f) symbol require)
        (or (resolve f) (throw (ex-info (str "No accept function " f) {:accept f}))))
    f))

(defn- serve [name conn accept args]
  (let [r (net/reader conn) w (net/writer conn)]
    (try
      (binding [*in* r *out* w *err* w]
        (apply accept args))
      (catch clotran.host.throwable _ nil)
      (finally
        (try (.flush w) (catch clotran.host.throwable _ nil))
        (net/close conn)
        (swap! servers update-in [name :conns] disj conn)))))

(defn start-server
  "Starts a server named :name on :port (0 picks one; the answer's :port
  says which), listening on :host (default 127.0.0.1 -- say \"0.0.0.0\" to
  be reachable from elsewhere). Each connection runs (apply accept args),
  accept a function or a qualified symbol, clotran.server/repl if none.
  Answers the server, whose :port is the one bound."
  [{:keys [name port host accept args] :or {host "127.0.0.1" accept 'clotran.server/repl}}]
  (let [f (resolve-fn accept)
        srv (net/listen port {:host host})
        running (atom true)
        loop-thread
        (future
          (loop []
            (when @running
              (when-let [conn (try (net/accept srv 250) (catch clotran.host.throwable _ nil))]
                (swap! servers update-in [name :conns] (fnil conj #{}) conn)
                (future (serve name conn f args)))
              (recur))))]
    (swap! servers assoc name {:server srv :running running :thread loop-thread :conns #{}})
    srv))

(defn stop-server
  "Stops the server named name and closes its connections; true if there
  was one."
  [name]
  (if-let [{:keys [server running conns]} (get @servers name)]
    (do (reset! running false)
        (net/close server)
        (doseq [c conns] (net/close c))
        (swap! servers dissoc name)
        true)
    false))

(defn stop-servers [] (doseq [n (keys @servers)] (stop-server n)))

;;; ---- prepl: the same REPL, answering in data --------------------------
;;
;; clojure.core.server's contract, for editor plugins and programs: out-fn
;; is handed {:tag :ret :val :ns :ms :form} for each evaluation (with
;; :exception true and the error as Throwable->map data if it threw),
;; {:tag :out :val} and {:tag :err :val} for what the evaluation printed,
;; and {:tag :tap :val} for tap>. :repl/quit or the end of the stream
;; ends it.

;; A writer handing each finished line -- and whatever is left at a flush
;; -- to f. Text with no newline waits for one, or for a flush, as it does
;; in clj's PrintWriter-on: (print "a") alone sends no :out.
(deftype FnWriter [f pending]
  clotran.host.value
  (write [this x]
    (let [s (if (integer? x) (str (char x)) (str x))]
      (swap! pending str s)
      (when (str/includes? s "\n") (.flush this))
      nil))
  (append [this x] (.write this x) this)
  (flush [_]
    (let [s @pending]
      (reset! pending "")
      (when (pos? (count s)) (f s))
      nil))
  (close [this] (.flush this)))

(defn- ex->data [ex phase] (assoc (Throwable->map ex) :phase phase))

(defn prepl
  "Reads forms from in-reader (a line-numbering reader) and calls out-fn
  with what each did, as data. :stdin, if given, is what *in* reads during
  an evaluation."
  [in-reader out-fn & {:keys [stdin]}]
  (let [eof (clotran.host.value.)
        tapfn #(out-fn {:tag :tap :val %})
        out (FnWriter. #(out-fn {:tag :out :val %}) (atom ""))
        err (FnWriter. #(out-fn {:tag :err :val %}) (atom ""))]
    (binding [*ns* (the-ns 'user) *1 nil *2 nil *3 nil *e nil
              *in* (or stdin in-reader) *out* out *err* err]
      (try
        (add-tap tapfn)
        (loop []
          (when (try
                  (let [[form s] (read+string {:eof eof :read-cond :allow} in-reader)]
                    (try
                      (when-not (identical? form eof)
                        (let [start (clotran.host.system/nanoTime)
                              ret (eval form)
                              ms (quot (- (clotran.host.system/nanoTime) start) 1000000)]
                          (when-not (= :repl/quit ret)
                            (set! *3 *2) (set! *2 *1) (set! *1 ret)
                            (out-fn {:tag :ret
                                     :val (if (instance? clotran.host.throwable ret) (Throwable->map ret) ret)
                                     :ns (str (ns-name *ns*)) :ms ms :form s})
                            true)))
                      (catch clotran.host.throwable ex
                        (set! *e ex)
                        (out-fn {:tag :ret :val (ex->data ex (or (-> ex ex-data :clojure.error/phase) :execution))
                                 :ns (str (ns-name *ns*)) :form s :exception true})
                        true)))
                  (catch clotran.host.throwable ex
                    (set! *e ex)
                    (out-fn {:tag :ret :val (ex->data ex :read-source)
                             :ns (str (ns-name *ns*)) :exception true})
                    true))
            (recur)))
        (finally (remove-tap tapfn))))))

(defn io-prepl
  "prepl over *in* and *out*, one message a line, printed with prn: the
  accept function for a prepl server. :ret and :tap values are passed
  through valf first (default pr-str), so a client reads them back as
  text."
  [& {:keys [valf] :or {valf pr-str}}]
  (let [valf (resolve-fn valf)
        out *out*
        lock (clotran.host.value.)]
    (prepl *in*
           (fn [m]
             (binding [*out* out *print-readably* true]
               (locking lock
                 (prn (if (#{:ret :tap} (:tag m))
                        (try (assoc m :val (valf (:val m)))
                             (catch clotran.host.throwable ex
                               (assoc m :val (valf (ex->data ex :print-eval-result)) :exception true)))
                        m))
                 (flush)))))))
