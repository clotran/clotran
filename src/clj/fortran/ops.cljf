(ns fortran.ops
  "Fortran's arithmetic and intrinsics over clotran's kind-tagged scalars
  (James, 2026-11-21: clotran's types are Fortran's).

  The kinds are clotran's own, by kind number as Fortran writes them:
  :int1 :int2 :int4 :int8 (integer(1) .. integer(8), the classes
  clotran.host.int1 .. int8) and :real4 :real8 (real(4), real(8)). They
  are values already: (int 5) is an int4. What clojure.core does with them
  is Clojure's -- (+ int4 int4) widens to int8, (/ 7 2) is a ratio -- and
  stays so. The operations HERE are Fortran's: the result keeps the kind a
  Fortran result has (the larger of two integer kinds, the real's kind of an
  integer with a real), integer / truncates, MOD and MODULO differ on
  negatives, REAL defaults to real(4), and a value the standard leaves to
  the processor (integer overflow, division by zero, a result out of the
  kind's range) throws, as a trapping processor would.

  test/ftypes/oracle.clj, plain Clojure run by clj and checked against
  gfortran and flang, is the specification; scripts/ftypes-check runs the
  cases of test/ftypes/cases.edn through it AND through this file and
  compares. See DEVIATIONS.md (types)."
  (:refer-clojure :exclude [+ - * / abs min max mod int]))

(def ^:private specs
  {:int1 {:type :integer :bits 8 :n 1} :int2 {:type :integer :bits 16 :n 2}
   :int4 {:type :integer :bits 32 :n 4} :int8 {:type :integer :bits 64 :n 8}
   :real4 {:type :real :bits 32 :n 4} :real8 {:type :real :bits 64 :n 8}
   :complex4 {:type :complex :bits 64 :n 4 :part :real4} :complex8 {:type :complex :bits 128 :n 8 :part :real8}})

(def default-integer :int4)
(def default-real :real4)

(defn- int-kind? [k] (= :integer (:type (specs k))))
(defn- real-kind? [k] (= :real (:type (specs k))))
(defn- complex-kind? [k] (= :complex (:type (specs k))))
(def ^:private part-complex {:real4 :complex4 :real8 :complex8})

;; A complex(4) or complex(8) value: its kind and its two parts, each a real of the part kind.
;; (clotran has no scalar class for them yet: DEVIATIONS 94.) Printed as Fortran writes one.
(defrecord Complex [kind re im])
(defmethod print-method Complex [z w] (.write w (str "(" (:re z) "," (:im z) ")")))

(def ^:private fortran-words
  {:integer-overflow "integer overflow"
   :division-by-zero "integer division by zero"
   :mod-by-zero "MOD or MODULO with a zero second argument"
   :inexact-power "a real power other than x**2 is processor dependent"
   :zero-to-negative-power "0 raised to a negative integer power"
   :sqrt-of-negative "SQRT of a negative real"
   :non-finite "a NaN or an infinity has no integer value"
   :inexact-complex "a complex product whose parts are not all exact is processor dependent"
   :complex-division "complex division is processor dependent"
   :complex-power "a complex power is processor dependent"
   :inexact-complex-abs "ABS of a complex is exact only where the answer is a whole number of the part kind"
   :domain "the argument is outside the function's domain: the result is the processor's"})

(defn- kind-words
  "A kind as Fortran writes it: :int4 is integer(4), :real8 real(8)."
  [k] (let [s (name k)] (str (if (= \i (first s)) "integer" "real") "(" (subs s (if (= \i (first s)) 3 4)) ")")))

(defn- undefined
  "A result the standard leaves to the processor: throws, in Fortran's words, with the
  reason as a keyword in the ex-data (the oracle's)."
  ([why] (throw (ex-info (str "undefined by the standard: " (fortran-words why (name why))) {:undefined why})))
  ([why k] (throw (ex-info (str "undefined by the standard: " (fortran-words why (name why)) " (" (kind-words k) ")")
                           {:undefined why :kind k}))))
(defn- ill-typed [msg] (throw (ex-info (str "ill-typed: " msg) {:ill-typed msg})))

(def ^:private kind-classes
  {clotran.host.int1 :int1 clotran.host.int2 :int2 clotran.host.int4 :int4 clotran.host.int8 :int8
   clotran.host.real4 :real4 clotran.host.real8 :real8})

(defn kind-of
  "The Fortran kind of a scalar: :int1 .. :int8, :real4, :real8, :complex4, :complex8."
  [v]
  (or (when (instance? Complex v) (:kind v))
      (kind-classes (class v))
      (ill-typed (str "not a Fortran scalar: " (pr-str v)))))

(defn- no-complex [who & vs]
  (when (some #(instance? Complex %) vs) (ill-typed (str who " of a complex"))))

(def ^:private imins {:int1 -128 :int2 -32768 :int4 -2147483648 :int8 -9223372036854775808N})
(def ^:private imaxs {:int1 127 :int2 32767 :int4 2147483647 :int8 9223372036854775807N})

(defn- fit
  "An exact integer as a value of integer kind k, or undefined: overflow."
  [k x]
  (if (clojure.core/<= (imins k) x (imaxs k))
    (case k :int1 (byte (long x)) :int2 (short (long x)) :int4 (clojure.core/int (long x)) :int8 (long x))
    (undefined :integer-overflow k)))

(defn- rnd
  "A double as a value of real kind k (binary32 by one rounding, exact for
  + - * / and sqrt of binary32 operands: a binary64 result has room to spare)."
  [k d]
  ;; unchecked-float is the IEEE narrowing: a value past real(4) is infinity (the checked float refuses it, as
  ;; Clojure's does, which is not Fortran's; DEVIATIONS 90)
  (case k :real8 (double d) :real4 (unchecked-float d)))

(declare pow2)
(defn- pow10 [n] (loop [r 1N i n] (if (zero? i) r (recur (*' r 10) (dec i)))))

(defn- decimal->ratio
  "A decimal text as the exact rational it says, or nil."
  [text]
  (when-let [[_ sign ip fp ex] (re-matches #"([+-]?)(\d*)\.?(\d*)(?:[eEdD]([+-]?\d+))?" text)]
    (when (not (and (empty? ip) (empty? fp)))
      (let [m (bigint (str (if (empty? ip) "0" ip) fp))
            e10 (clojure.core/- (if ex (parse-long (if (= \+ (first ex)) (subs ex 1) ex)) 0) (count fp))
            v (if (clojure.core/>= e10 0) (*' m (pow10 e10)) (clojure.core// m (pow10 (clojure.core/- e10))))]
        (if (= sign "-") (clojure.core/- v) v)))))

(defn- real-of-ratio
  "The rational r rounded ONCE to the nearest real of kind pk (:real4 or :real8), ties to even, as a
  double that holds it exactly; infinity past the greatest. Rounding the text through a real(8) first
  can round the wrong way."
  [pk r]
  (if (zero? r)
    0.0
    (let [a (if (neg? r) (clojure.core/- r) r)
          bits (fn [x] (loop [x (bigint x) c 0] (if (zero? x) c (recur (quot x 2) (inc c)))))
          e0 (clojure.core/- (bits (numerator a)) (bits (denominator a)))
          e (if (clojure.core/>= a (pow2 e0)) e0 (dec e0))
          [p qmin top] (if (= pk :real4) [24 -149 128] [53 -1074 1024])
          q (clojure.core/max (clojure.core/- e (dec p)) qmin)
          scaled (clojure.core// a (pow2 q))
          fl (quot (numerator scaled) (denominator scaled))
          rem (clojure.core/- scaled fl)
          n (cond (< rem 1/2) fl (> rem 1/2) (inc fl) (even? fl) fl :else (inc fl))
          v (if (clojure.core/>= (*' n (pow2 q)) (pow2 top)) ##Inf (clotran.host.math/scalb (double n) q))]
      (if (neg? r) (clojure.core/- v) v))))
(defn- real4-of-ratio [r] (real-of-ratio :real4 r))

(defn lit
  "A literal as the oracle writes it: (lit :int4 5), (lit :real4 \"1.1\") -- a
  real as its text, rounded once."
  [k x]
  (cond (int-kind? k) (fit k x)
        (complex-kind? k) (->Complex k (lit (:part (specs k)) (first x)) (lit (:part (specs k)) (second x)))
        ;; a zero keeps its sign: "-0.0" is -0.0 (the ratio is 0)
        (= k :real4) (let [r (decimal->ratio x)] (rnd k (if (and r (not (zero? r))) (real4-of-ratio r) (parse-double x))))
        :else (rnd k (parse-double x))))

(defn- conv [k v]
  (let [k0 (kind-of v)]
    (cond (= k k0) v
          ;; to a complex kind: a real or integer is the real part, the imaginary part zero
          (and (complex-kind? k) (complex-kind? k0))
          (->Complex k (conv (:part (specs k)) (:re v)) (conv (:part (specs k)) (:im v)))
          (complex-kind? k) (->Complex k (conv (:part (specs k)) v) (rnd (:part (specs k)) 0.0))
          (complex-kind? k0) (ill-typed (str "a complex is not a " (name k) ": use real, aimag or int of its part"))
          (and (int-kind? k) (int-kind? k0)) (fit k (long v))
          (and (real-kind? k) (int-kind? k0)) (rnd k (case k :real8 (double (long v)) :real4 (float (long v))))
          (and (real-kind? k) (real-kind? k0)) (rnd k (double v))
          :else (ill-typed (str "real to integer needs int, nint, floor or ceiling: " k0 " to " k)))))

(defn promote
  "The kind of a mixed operation: integer with integer, the larger; real with
  real, the larger; integer with real, the real's kind."
  [k1 k2]
  (let [b #(:bits (specs %))]
    (cond (or (complex-kind? k1) (complex-kind? k2))
          ;; the complex kind whose parts are as wide as the widest real part or real operand
          (let [part (fn [k] (cond (complex-kind? k) (:part (specs k)) (real-kind? k) k))
                ps (remove nil? [(part k1) (part k2)])]
            (part-complex (reduce (fn [m p] (if (clojure.core/> (b p) (b m)) p m)) ps)))
          (and (int-kind? k1) (int-kind? k2)) (if (clojure.core/>= (b k1) (b k2)) k1 k2)
          (and (real-kind? k1) (real-kind? k2)) (if (clojure.core/>= (b k1) (b k2)) k1 k2)
          (int-kind? k1) k2
          :else k1)))

;; the kind constructors: (fortran.ops/int4 5), (fortran.ops/real4 "1.1")
(defn int1 [x] (if (integer? x) (fit :int1 x) (conv :int1 x)))
(defn int2 [x] (if (integer? x) (fit :int2 x) (conv :int2 x)))
(defn int4 [x] (if (integer? x) (fit :int4 x) (conv :int4 x)))
(defn int8 [x] (if (integer? x) (fit :int8 x) (conv :int8 x)))
(defn real4 [x] (cond (string? x) (lit :real4 x) (integer? x) (rnd :real4 (double x)) :else (conv :real4 x)))
(defn real8 [x] (cond (string? x) (lit :real8 x) (integer? x) (double x) :else (conv :real8 x)))

(defn- part-of [pk x] (cond (string? x) (lit pk x) (integer? x) (conv pk x) :else (conv pk x)))
(defn- complex-of [k re im]
  (let [pk (:part (specs k))] (->Complex k (part-of pk re) (if (nil? im) (rnd pk 0.0) (part-of pk im)))))
(defn complex4
  "A complex(4): (complex4 re im), each a real, an integer or a decimal text; (complex4 x) converts a
  real, integer or complex."
  ([x] (if (instance? Complex x) (conv :complex4 x) (complex-of :complex4 x nil)))
  ([re im] (complex-of :complex4 re im)))
(defn complex8
  ([x] (if (instance? Complex x) (conv :complex8 x) (complex-of :complex8 x nil)))
  ([re im] (complex-of :complex8 re im)))

(declare arith*)

(defn- pow2 [n]
  (if (clojure.core/>= n 0) (loop [r 1N i n] (if (zero? i) r (recur (*' r 2) (dec i)))) (clojure.core// 1 (pow2 (clojure.core/- n)))))

(defn- ->ratio
  "A finite double as the exact rational it is: an integer mantissa times a power of two."
  [x]
  (let [x (double x)]
    (if (zero? x)
      0N
      (let [e (clotran.host.math/getExponent x)
            m (long (clotran.host.math/scalb x (clojure.core/- 52 e)))]
        (clojure.core/* m (pow2 (clojure.core/- e 52)))))))

(defn- ratio->part
  "The exact rational r as a real of kind pk when pk holds it exactly (an odd mantissa of at most 24
  or 53 bits times a power of two), else nil."
  [r pk]
  (if (zero? r)
    (rnd pk 0.0)
    (let [n (numerator r) d (denominator r)
          sign (if (neg? n) -1 1)
          strip (fn [x] (loop [x x s 0] (if (even? x) (recur (quot x 2) (inc s)) [x s])))
          [dodd dshift] (strip d)
          [nodd nshift] (strip (clojure.core/abs n))
          bits (loop [x nodd c 0] (if (zero? x) c (recur (quot x 2) (inc c))))]
      (when (and (= dodd 1) (clojure.core/<= bits (if (= pk :real4) 24 53)))
        (rnd pk (clotran.host.math/scalb (double (clojure.core/* sign nodd)) (clojure.core/- nshift dshift)))))))

(defn- carith
  "Complex + - * /. + and - are IEEE on each part. * is the textbook (ac - bd) + (ad + bc)i and is
  defined only where every product and sum is exact (compilers differ otherwise: FCVS FM828-831);
  / is processor dependent. test/ftypes/oracle.clj says the same."
  [op a b]
  (let [k (promote (kind-of a) (kind-of b)) pk (:part (specs k))
        x (conv k a) y (conv k b)
        a1 (double (:re x)) a2 (double (:im x)) c1 (double (:re y)) c2 (double (:im y))]
    (case op
      :+ (->Complex k (rnd pk (clojure.core/+ a1 c1)) (rnd pk (clojure.core/+ a2 c2)))
      :- (->Complex k (rnd pk (clojure.core/- a1 c1)) (rnd pk (clojure.core/- a2 c2)))
      :* (let [r* (fn [p q] (clojure.core/* (->ratio p) (->ratio q)))
               ac (r* a1 c1) bd (r* a2 c2) ad (r* a1 c2) bc (r* a2 c1)
               re (clojure.core/- ac bd) im (clojure.core/+ ad bc)
               parts (map #(ratio->part % pk) [ac bd ad bc re im])]
           (if (every? some? parts)
             (->Complex k (nth parts 4) (nth parts 5))
             (undefined :inexact-complex)))
      :/ (undefined :complex-division))))

(defn- arith [op a b]
  (if (or (instance? Complex a) (instance? Complex b))
    (carith op a b)
    (arith* op a b)))

(defn- arith* [op a b]
  (let [k (promote (kind-of a) (kind-of b))
        x (conv k a) y (conv k b)]
    (if (int-kind? k)
      (let [x (bigint (long x)) y (bigint (long y))]
        (fit k (case op
                 :+ (+' x y) :- (-' x y) :* (*' x y)
                 :/ (if (zero? y) (undefined :division-by-zero) (quot x y)))))
      (let [x (double x) y (double y)]
        (rnd k (case op :+ (clojure.core/+ x y) :- (clojure.core/- x y) :* (clojure.core/* x y) :/ (clojure.core// x y)))))))

(defn +
  "Fortran's a + b."
  [a b] (arith :+ a b))
(defn -
  "Fortran's a - b, or -a."
  ([a] (let [k (kind-of a)]
         (cond (int-kind? k) (fit k (-' (bigint (long a))))
               (complex-kind? k) (->Complex k (rnd (:part (specs k)) (clojure.core/- (double (:re a)))) (rnd (:part (specs k)) (clojure.core/- (double (:im a)))))
               :else (rnd k (clojure.core/- (double a))))))
  ([a b] (arith :- a b)))
(defn * [a b] (arith :* a b))
(defn / [a b] (arith :/ a b))

(defn **
  "Fortran's a ** b: an integer to an integer power exactly; a real to the
  power 2 as a*a; any other real power is processor dependent here as there."
  [a b]
  (let [ka (kind-of a) kb (kind-of b)]
    (when (or (complex-kind? ka) (complex-kind? kb)) (undefined :complex-power))
    (cond
      (and (int-kind? ka) (int-kind? kb))
      (let [k (promote ka kb) x (long a) n (long b)]
        (cond (and (clojure.core/>= n 0) (#{0 1 -1} x)) (fit k (cond (zero? n) 1 (= x -1) (if (even? n) 1 -1) :else x))
              ;; |x| >= 2: past 64 factors it has left every kind (1**2147483647 looped 2**31 times)
              (clojure.core/>= n 0) (fit k (loop [r 1N i n] (if (or (zero? i) (clojure.core/> (clojure.core/abs r) 18446744073709551616N)) r (recur (*' r (bigint x)) (dec i)))))
              (= x 1) (fit k 1)
              (= x -1) (fit k (if (even? n) 1 -1))
              (zero? x) (undefined :zero-to-negative-power)
              :else (fit k 0)))
      ;; a real to an integer power is x multiplied n times: defined where every partial power is
      ;; exact, and for n = 2, one multiplication, correctly rounded (test/ftypes/oracle.clj)
      (and (real-kind? ka) (int-kind? kb))
      (let [n (long b)]
        (cond (zero? n) (rnd ka 1.0)
              (= n 1) a
              (= n 2) (arith :* a a)
              (clojure.core/> (clojure.core/abs n) 64) (undefined :inexact-power)
              (and (zero? (double a)) (neg? n)) (undefined :zero-to-negative-power)
              :else
              (let [x (->ratio a)
                    partials (take (clojure.core/abs n) (iterate #(clojure.core/* % x) x))]
                (if (every? #(ratio->part % ka) partials)
                  (or (ratio->part (let [p (last partials)] (if (neg? n) (clojure.core// 1 p) p)) ka)
                      (undefined :inexact-power))
                  (undefined :inexact-power)))))
      :else (undefined :inexact-power))))

(defn- need-same [who & vs]
  (when (some #(complex-kind? (kind-of %)) vs) (ill-typed (str who " of a complex")))
  (when-not (apply = (map kind-of vs)) (ill-typed (str who " needs one kind: " (mapv kind-of vs)))))

(defn- kind-arg [more dflt] (if (seq more) (first more) dflt))

(defn- finite! [x] (when (or (not= x x) (= x ##Inf) (= x ##-Inf)) (undefined :non-finite)) x)
(defn- in-int8!
  "A whole real as an integer(8), or undefined: from 2**63 up, or below -2**63, it has none (the host's
  long saturates to 9223372036854775807)."
  [x]
  (when (or (clojure.core/>= x 9.223372036854775808E18) (clojure.core/< x -9.223372036854775808E18)) (undefined :integer-overflow))
  (long x))

(defn int
  "Fortran's INT(x [, kind]): an integer kept, a real truncated toward zero."
  [x & more]
  (no-complex "int" x)
  (let [k (kind-arg more default-integer)]
    (if (int-kind? (kind-of x)) (fit k (long x)) (let [d (finite! (double x))] (fit k (in-int8! (if (neg? d) (clotran.host.math/ceil d) (clotran.host.math/floor d))))))))

(defn- round-away
  "The real x rounded to the nearest whole number, halves away from zero,
  exactly (x - floor x is exact)."
  [x]
  (let [ax (clotran.host.math/abs x)
        f (clotran.host.math/floor ax)
        r (if (clojure.core/>= (clojure.core/- ax f) 0.5) (clojure.core/+ f 1.0) f)]
    (if (neg? x) (clojure.core/- r) r)))

(defn nint [x & more]
  (no-complex "nint" x)
  (let [k (kind-arg more default-integer)]
    (fit k (in-int8! (round-away (finite! (double x)))))))
(defn floor [x & more]
  (no-complex "floor" x)
  (let [k (kind-arg more default-integer)]
    (fit k (in-int8! (clotran.host.math/floor (finite! (double x)))))))
(defn ceiling [x & more]
  (no-complex "ceiling" x)
  (let [k (kind-arg more default-integer)]
    (fit k (in-int8! (clotran.host.math/ceil (finite! (double x)))))))

(defn real
  "Fortran's REAL(x [, kind]): a real of the default kind (real(4)); of a COMPLEX, its real part, of
  the part's kind unless a kind says otherwise."
  [x & more]
  (if (instance? Complex x)
    (conv (kind-arg more (:part (specs (:kind x)))) (:re x))
    (conv (kind-arg more default-real) x)))
(defn dble [x] (if (instance? Complex x) (conv :real8 (:re x)) (conv :real8 x)))

(defn cmplx
  "Fortran's CMPLX(x [, y] [, kind]): a complex of the default kind, complex(4), whatever its
  arguments' (a famous trap); a kind keyword, :complex8, says otherwise."
  [x & more]
  (let [kw (first (filter keyword? more)) ys (remove keyword? more)
        k (or kw :complex4)]
    (when-not (complex-kind? k) (ill-typed "cmplx's kind is a complex kind"))
    (if (instance? Complex x)
      (conv k x)
      (->Complex k (conv (:part (specs k)) x) (if (seq ys) (conv (:part (specs k)) (first ys)) (rnd (:part (specs k)) 0.0))))))
(defn conjg [z] (->Complex (:kind z) (:re z) (rnd (:part (specs (:kind z))) (clojure.core/- (double (:im z))))))
(defn aimag [z] (:im z))

(defn abs [x]
  (let [k (kind-of x)]
    (cond
      (complex-kind? k)
      ;; hypot in real(8), rounded once to the part kind; measured against sqrt(a**2 + b**2) to 80 digits
      (let [a (double (:re x)) b (double (:im x))]
        (finite! a) (finite! b)
        (rnd (:part (specs k)) (clotran.host.math/hypot a b)))
      :else
    (if (int-kind? k)
      (fit k (let [v (bigint (long x))] (if (neg? v) (-' v) v)))
      (rnd k (clotran.host.math/abs (double x)))))))

(defn- fmod
  "C's fmod, exactly: the remainder of a by p with a's sign (binary long
  division in doubles; every subtraction is exact)."
  [a p]
  (let [pa (clotran.host.math/abs p) r0 (clotran.host.math/abs a)]
    (if (< r0 pa)
      (double a)
      (let [t0 (loop [t pa] (let [t2 (clojure.core/* t 2.0)] (if (clojure.core/<= t2 r0) (recur t2) t)))
            r (loop [t t0 r r0]
                (cond (< t pa) r
                      (clojure.core/>= r t) (recur (clojure.core// t 2.0) (clojure.core/- r t))
                      :else (recur (clojure.core// t 2.0) r)))]
        (if (neg? a) (clojure.core/- r) r)))))

(defn mod
  "Fortran's MOD(a, p): a - int(a/p)*p, the sign of a."
  [a p]
  (need-same 'mod a p)
  (let [k (kind-of a)]
    (if (int-kind? k)
      (if (zero? (long p)) (undefined :mod-by-zero) (fit k (rem (bigint (long a)) (bigint (long p)))))
      (if (zero? (double p)) (undefined :mod-by-zero) (rnd k (fmod (double a) (double p)))))))

(defn modulo
  "Fortran's MODULO(a, p): a - floor(a/p)*p, the sign of p."
  [a p]
  (need-same 'modulo a p)
  (let [k (kind-of a)]
    (if (int-kind? k)
      (if (zero? (long p)) (undefined :mod-by-zero) (fit k (clojure.core/mod (bigint (long a)) (bigint (long p)))))
      (if (zero? (double p))
        (undefined :mod-by-zero)
        (let [r (fmod (double a) (double p))
              r (if (and (not (zero? r)) (not= (neg? r) (neg? (double p)))) (clojure.core/+ r (double p)) r)]
          (rnd k r))))))

(defn sign
  "Fortran's SIGN(a, b): the magnitude of a with the sign of b."
  [a b]
  (need-same 'sign a b)
  (let [k (kind-of a)]
    (if (int-kind? k)
      (let [m (let [v (bigint (long a))] (if (neg? v) (-' v) v))] (fit k (if (neg? (long b)) (-' m) m)))
      ;; the sign of b, a -0.0 included (the processor distinguishes negative zero: SIGN(1.0, -0.0) is -1.0)
      (rnd k (clotran.host.math/copySign (clotran.host.math/abs (double a)) (double b))))))

(defn- extreme [f who vs]
  (apply need-same who vs)
  (let [k (kind-of (first vs))]
    (if (int-kind? k)
      (fit k (apply f (map #(long %) vs)))
      ;; MAX and MIN of a NaN are the processor's (gfortran answers the other argument): refused
      (let [ds (map #(double %) vs)]
        (when (some #(not= % %) ds) (undefined :nan-argument))
        (rnd k (apply f ds))))))
(defn max [& vs] (extreme clojure.core/max 'max vs))
(defn min [& vs] (extreme clojure.core/min 'min vs))

(declare celem)
(defn sqrt [x]
  (if (instance? Complex x)
    (celem "sqrt" x)
  (let [k (kind-of x)]
    (when-not (real-kind? k) (ill-typed "sqrt needs a real"))
    (when (neg? (double x)) (undefined :sqrt-of-negative))
    (rnd k (clotran.host.math/sqrt (double x))))))

;; the numeric model of a kind's value x
(defn huge [x]
  (let [k (kind-of x)]
    (when (complex-kind? k) (ill-typed "huge of a complex"))
    (if (int-kind? k) (fit k (imaxs k)) (case k :real8 1.7976931348623157E308 :real4 (float 3.4028234663852886E38)))))
(defn tiny [x]
  (let [k (kind-of x)]
    (when-not (real-kind? k) (ill-typed "tiny needs a real"))
    (case k :real8 2.2250738585072014E-308 :real4 (float 1.1754943508222875E-38))))
(defn epsilon [x]
  (let [k (kind-of x)]
    (when-not (real-kind? k) (ill-typed "epsilon needs a real"))
    (case k :real8 2.220446049250313E-16 :real4 (float 1.1920928955078125E-7))))
(defn kind [x] (fit default-integer (:n (specs (kind-of x)))))
(defn digits [x]
  (let [k (kind-of x)]
    (when (complex-kind? k) (ill-typed "digits of a complex"))
    (fit default-integer (if (int-kind? k) (dec (:bits (specs k))) (case k :real4 24 :real8 53)))))

;; The elementary functions. The standard gives them no accuracy; these are the host's libm's (through
;; clotran.host.math, then rounded to the kind), and scripts/ftypes-check measures them against the
;; correctly rounded value (test/ftypes/refmath.clj) and reports the worst error. An argument outside a
;; function's domain, or not finite, is refused, as everything the processor decides is.
(defn- elem1 [op f x]
  (no-complex op x)
  (let [k (kind-of x)]
    (when-not (real-kind? k) (ill-typed (str op " needs a real")))
    (let [d (double x)]
      (finite! d)
      (when (and (#{"log" "log10"} op) (not (pos? d))) (undefined :domain))
      (when (and (#{"asin" "acos"} op) (clojure.core/> (clotran.host.math/abs d) 1.0)) (undefined :domain))
      (rnd k (f d)))))

;; EXP, LOG, SQRT, SIN, COS and ABS of a complex: the textbook formulas in real(8) (each part rounded once to
;; the part kind, so a complex(4) is nearly correctly rounded), measured part by part against refmath's 80
;; digits by scripts/ftypes-accuracy. LOG and SQRT are principal values, the branch cut on the negative real
;; axis decided by the sign of a zero imaginary part (LOG(-1 - 0i) = -pi i, SQRT(-4 - 0i) = -2i), as the
;; standard has it. LOG of zero is undefined; a part not finite, the processor's: both refused.
(defn- csqrt-d [a b]
  (let [M (fn [x] (clotran.host.math/abs x))
        big (clojure.core/max (M a) (M b))]
    (cond (clojure.core/> big 1.0e300) (mapv #(clojure.core/* 2.0 %) (csqrt-d (clojure.core// a 4.0) (clojure.core// b 4.0)))
          ;; tiny parts scaled by 2**200 and the root back by 2**-100, both exact
          (and (pos? big) (clojure.core/< big 1.0e-300)) (mapv #(clojure.core/* % 7.888609052210118E-31) (csqrt-d (clojure.core/* a 1.6069380442589903E60) (clojure.core/* b 1.6069380442589903E60)))
          :else
          (let [m (clotran.host.math/hypot a b)]
            (if (neg? a)
              (let [t (clotran.host.math/sqrt (clojure.core// (clojure.core/- m a) 2.0))]
                [(clojure.core// (M b) (clojure.core/* 2.0 t)) (clotran.host.math/copySign t b)])
              (let [re (clotran.host.math/sqrt (clojure.core// (clojure.core/+ m a) 2.0))]
                [re (clojure.core// b (clojure.core/* 2.0 re))]))))))

(defn- clog-re [a b]
  ;; log |z|: near the unit circle log1p of |z|^2 - 1, computed exactly and rounded once, so it keeps
  ;; its digits; elsewhere log (hypot a b), halved first where hypot would overflow
  (let [t (clojure.core/- (clojure.core/+ (clojure.core/* (->ratio a) (->ratio a)) (clojure.core/* (->ratio b) (->ratio b))) 1)]
    (if (clojure.core/< (clojure.core/abs t) 1/2)
      (clojure.core// (clotran.host.math/log1p (real-of-ratio :real8 t)) 2.0)
      (let [big (clojure.core/max (clotran.host.math/abs a) (clotran.host.math/abs b))]
        (cond
          ;; hypot would overflow: halve first
          (clojure.core/> big 1.0e300)
          (clojure.core/+ (clotran.host.math/log (clotran.host.math/hypot (clojure.core// a 2.0) (clojure.core// b 2.0))) (clotran.host.math/log 2.0))
          ;; hypot would round to the subnormal grid (log of 4.9e-324 + 4.9e-324i was 0.35 off): 2**54 first
          (clojure.core/< big 1.0e-290)
          (clojure.core/- (clotran.host.math/log (clotran.host.math/hypot (clojure.core/* a 1.8014398509481984E16) (clojure.core/* b 1.8014398509481984E16)))
                          (clojure.core/* 54.0 (clotran.host.math/log 2.0)))
          :else (clotran.host.math/log (clotran.host.math/hypot a b)))))))

(defn- hyp-times
  "x cosh b, or x sinh b: past |b| = 709 cosh overflows where x cosh b need not, so there
  (x/2) e**(|b|/2) e**(|b|/2), e**|b|/2 being cosh |b| and |sinh b| to the last bit."
  [x b sinh?]
  (if (clojure.core/> (clotran.host.math/abs b) 709.0)
    (let [h (clotran.host.math/exp (clojure.core// (clotran.host.math/abs b) 2.0))
          v (clojure.core/* (clojure.core/* (clojure.core/* x 0.5) h) h)]
      (if (and sinh? (neg? b)) (clojure.core/- v) v))
    (clojure.core/* x (if sinh? (clotran.host.math/sinh b) (clotran.host.math/cosh b)))))

(defn- celem [op z]
  (let [k (:kind z) pk (:part (specs k)) a (double (:re z)) b (double (:im z))
        c (fn [re im] (->Complex k (rnd pk re) (rnd pk im)))]
    (finite! a) (finite! b)
    (case op
      "exp" (let [e (clotran.host.math/exp a)]
              (cond (zero? b) (c e b)
                    ;; e**a overflows where e**a cos b need not: e**(a/2) twice
                    (= e ##Inf) (let [h (clotran.host.math/exp (clojure.core// a 2.0))]
                                  (c (clojure.core/* (clojure.core/* h (clotran.host.math/cos b)) h) (clojure.core/* (clojure.core/* h (clotran.host.math/sin b)) h)))
                    :else (c (clojure.core/* e (clotran.host.math/cos b)) (clojure.core/* e (clotran.host.math/sin b)))))
      "log" (do (when (and (zero? a) (zero? b)) (undefined :domain))
                (c (clog-re a b) (clotran.host.math/atan2 b a)))
      "sqrt" (if (and (zero? a) (zero? b))
               (c 0.0 b)
               (let [[re im] (csqrt-d a b)] (c re im)))
      "sin" (c (hyp-times (clotran.host.math/sin a) b false) (hyp-times (clotran.host.math/cos a) b true))
      "cos" (c (hyp-times (clotran.host.math/cos a) b false) (clojure.core/- (hyp-times (clotran.host.math/sin a) b true))))))

(defn exp [x] (if (instance? Complex x) (celem "exp" x) (elem1 "exp" clotran.host.math/exp x)))
(defn log [x] (if (instance? Complex x) (celem "log" x) (elem1 "log" clotran.host.math/log x)))
(defn log10 [x] (elem1 "log10" clotran.host.math/log10 x))
(defn sin [x] (if (instance? Complex x) (celem "sin" x) (elem1 "sin" clotran.host.math/sin x)))
(defn cos [x] (if (instance? Complex x) (celem "cos" x) (elem1 "cos" clotran.host.math/cos x)))
(defn tan [x] (elem1 "tan" clotran.host.math/tan x))
(defn asin [x] (elem1 "asin" clotran.host.math/asin x))
(defn acos [x] (elem1 "acos" clotran.host.math/acos x))
(defn atan [x] (elem1 "atan" clotran.host.math/atan x))
(defn sinh [x] (elem1 "sinh" clotran.host.math/sinh x))
(defn cosh [x] (elem1 "cosh" clotran.host.math/cosh x))
(defn tanh [x] (elem1 "tanh" clotran.host.math/tanh x))
(defn atan2 [y x]
  (need-same 'atan2 y x)
  (let [k (kind-of y)]
    (when-not (real-kind? k) (ill-typed "atan2 needs reals"))
    (finite! (double y)) (finite! (double x))
    (when (and (zero? (double y)) (zero? (double x))) (undefined :domain))
    (rnd k (clotran.host.math/atan2 (double y) (double x)))))
