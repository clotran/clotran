# Everything below is a BUILD PRODUCT of ./configure and make, never
# vendored -- the vendored tree is source only, same rule as core.clj:
# nothing generated lives in git, only what was actually downloaded.
config.status
config.log
config.cache
icudefs.mk
Makefile
*.o
*.ao
*.d
*.1
lib/
bin/
source/data/out/
source/data/build-local
source/data/packagedata
source/data/icupkg.inc
source/data/rules.mk
source/data/tmp/
source/test/testdata/rules.mk

# Per-directory build outputs (stubdata/libicudata.a,
# tools/ctestfw/libicutest.a and similar) -- *.a anywhere in this tree
# is always a build product, never vendored source.
*.a

# The Makefile's stamp that ICU is built: committed once, it told every
# fresh checkout ICU was built when its libraries were not there
source/.built

# configure's outputs from their .in templates, and Windows's (MinGW)
# shared libraries and tools -- these six were committed with the tree
# once, so a build anywhere they came out differently read as a change
source/config/Makefile.inc
source/config/icu.pc
*.dll
*.exe
