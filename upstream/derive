#!/usr/bin/env bb
;; Writes src/clj/clojure and test/clj/clojure from the upstream copies
;; here, every class in clotran's name (upstream/names.clj). Those two
;; trees are generated: never edit them, edit the renaming and run this.
;;
;;   upstream/derive           write them
;;   upstream/derive --check   exit 1 if they are not what this writes
(require '[clojure.java.io :as io] '[clojure.string :as str])
(load-file "upstream/names.clj")

;; a file's path with / between its parts: Windows' java.io.File writes \
(defn slashed [f] (str/replace (str f) "\\" "/"))

(def trees [["upstream/clojure/src/clj/clojure" "src/clj/clojure"]
            ["upstream/clojure/test/clojure" "test/clj/clojure"]])

(def check? (= "--check" (first *command-line-args*)))

(def notice
  "This tree is GENERATED by upstream/derive from the Clojure sources in
upstream/, with each class written in clotran's name. Do not edit it:
change the renaming (upstream/class-names.edn, upstream/names.clj) and
run upstream/derive. upstream/README.md says where the sources came from.
")

(def outputs
  (into (sorted-map)
        (concat
         (for [[from to] trees
               f (file-seq (io/file from))
               :when (.isFile f)
               :let [rel (subs (slashed f) (inc (count from)))]
               :when (not= rel "PROVENANCE.md")]
           [(str to "/" (names/rename-path rel))
            (if (re-find #"\.(clj|cljc|cljs|edn)$" rel)
              (names/rename-source (slurp f))
              (slurp f))])
         (for [[_ to] trees] [(str to "/GENERATED.md") notice]))))

(def existing
  (set (for [[_ to] trees f (file-seq (io/file to)) :when (.isFile f)] (slashed f))))

(if check?
  (let [stale (concat (for [[p text] outputs :when (not= text (when (.exists (io/file p)) (slurp p)))] p)
                      (remove outputs existing))]
    (doseq [p (take 10 stale)] (println "not as upstream/derive writes it:" p))
    (System/exit (if (seq stale) 1 0)))
  (do (doseq [p existing :when (not (outputs p))] (io/delete-file p))
      (doseq [[p text] outputs]
        (io/make-parents p)
        (when (not= text (when (.exists (io/file p)) (slurp p))) (spit p text)))
      (println "upstream/derive:" (count outputs) "files")))
