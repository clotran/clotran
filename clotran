#!/bin/sh
# clotran: the entry point. Loads Clojure's own core.clj into the
# interpreter (clotran-bin, built by make) and hands the REPL to
# rlwrap when there is a terminal to edit in -- the same flags clj
# itself uses: -m multi-line, -r remember words, -q/-b tuned for Lisp.
#
# rlwrap edits lines only on a real terminal: not in a pipe, and not
# where TERM is dumb, as Emacs sets it for a subprocess, whose zero-width
# "terminal" rlwrap refuses.
#
# `clotran` alone is the REPL. `clotran app.cljf a b` runs the file as a
# program, as `clj -M app.clj a b` does: *command-line-args* is ("a" "b"),
# and it ends when the file does, with status 1 on an uncaught error.
# `clotran -m app.core a b` requires app.core and calls its -main with
# the args, as `clj -M -m app.core a b` does.
# CLOTRAN_PATH adds source roots (: separated, ; on Windows), searched
# after clotran's own for require and load: what clotran-deps computes
# from a project's deps.edn (PACKAGES.md).
# core.clj comes from build/core.image, the heap as it stood once core
# and spec had loaded (make image), so the prompt is up in about 0.2 s;
# CLOTRAN_IMAGE=0 loads it from source instead. On a terminal the REPL
# opens with a banner naming the build: clotran's VERSION, the Clojure
# and ClojureScript releases the language is pinned to, the compiler,
# the machine and the image.
#
# `clotran new NAME` makes a project in ./NAME: deps.edn, src and test.
#
# `clotran compile foo.cljf` compiles the namespace to foo.dylib (foo.so
# on Linux) beside it. Loading foo.cljf afterwards installs the library
# over the functions it compiled (clotran.loader); editing the source
# makes the library stale, and it is then reported and not used. FC
# picks the Fortran compiler, gfortran by default.
root=$(cd "$(dirname "$0")" && pwd)
bin="$root/clotran-bin"
core="$root/src/clj/clojure/core.clj"
[ -x "$bin" ] || { echo "build first: make" >&2; exit 1; }

if [ "$1" = "new" ]; then
  # `clotran new NAME`: a project in ./NAME -- deps.edn, src/NAME/core.cljf,
  # test/NAME/core_test.cljf, a README and a .gitignore. The namespace is
  # NAME.core; a dash in NAME is an underscore in the directory, as
  # Clojure maps namespaces to files.
  [ $# -eq 2 ] || { echo "usage: clotran new NAME" >&2; exit 2; }
  name=$2
  case "$name" in
    [abcdefghijklmnopqrstuvwxyz]*) ;;
    *) echo "clotran new: a name starts with a lower-case letter: $name" >&2; exit 2 ;;
  esac
  case "$name" in
    *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) echo "clotran new: a name is lower-case letters, digits and dashes: $name" >&2; exit 2 ;;
  esac
  [ -e "$name" ] && { echo "clotran new: $name is there already" >&2; exit 1; }
  dir=$(printf '%s' "$name" | tr '-' '_')
  mkdir -p "$name/src/$dir" "$name/test/$dir" || exit 1
  cat > "$name/deps.edn" <<EDN
;; clotran reads this as tools.deps does (clotran-deps): :paths, :deps and
;; :aliases. Name a library with :local/root or :git/url + :git/sha.
{:paths ["src"]
 :deps {}
 :aliases {:test {:extra-paths ["test"]}}}
EDN
  cat > "$name/src/$dir/core.cljf" <<CLJF
(ns $name.core
  "$name, on clotran.")

(defn greet
  "A greeting for who."
  [who]
  (str "hello, " who))
CLJF
  cat > "$name/test/$dir/core_test.cljf" <<CLJF
(ns $name.core-test
  (:require [clojure.test :refer [deftest is]]
            [$name.core :as core]))

(deftest greet-test
  (is (= "hello, world" (core/greet "world"))))
CLJF
  printf '.clotran-cache/\n' > "$name/.gitignore"
  printf '# %s\n\nA clotran project: Clojure, hosted on Fortran.\n\n    clotran                       # a REPL with src on the path\n    clotran -A:test               # with test too\n\nIn Emacs with clotran-mode, open src/%s/core.cljf and M-x cider-jack-in.\n' \
    "$name" "$dir" > "$name/README.md"
  echo "made $name: src/$dir/core.cljf, test/$dir/core_test.cljf, deps.edn"
  exit 0
fi

if [ "$1" = "explain" ]; then
  # `clotran explain B001`: what a --report code means (clotran.tiers/codes)
  [ $# -eq 2 ] || { echo "usage: clotran explain CODE" >&2; exit 2; }
  work=$(mktemp -d) || exit 1
  trap 'rm -rf "$work"' EXIT
  printf '(clotran.tiers/explain "%s")\n' "$2" > "$work/explain.clj"
  "$bin" "$core" "$root/src/clj/clotran/loader.cljf" "$root/src/clj/clotran/tiers.cljf" "$work/explain.clj" </dev/null 2>&1 \
    | grep -v '^note: skipping\|^user=>\|WARNING: ->Eduction'
  exit 0
fi

if [ "$1" = "compile" ] && [ "$2" = "--pure" ]; then
  # `clotran compile --pure foo.cljf [out.f90]`: the tier-A functions as one
  # Fortran module with no clotran runtime (clotran.purefort), written
  # beside the source unless a path is given. What was not lowered is
  # listed with why; --report says more.
  [ $# -eq 3 ] || [ $# -eq 4 ] || { echo "usage: clotran compile --pure file.cljf [out.f90]" >&2; exit 2; }
  out=${4:-${3%.*}_pure.f90}
  case "$out" in /*) ;; *) out="$(pwd)/$out" ;; esac
  work=$(mktemp -d) || exit 1
  trap 'rm -rf "$work"' EXIT
  cat > "$work/pure.clj" <<CLJ
(let [r (clotran.purefort/generate "$3")]
  (clotran-spit "$out" (:text r))
  (println "module" (:module r) "->" "$out")
  (doseq [[s vs] (sort-by key (:emitted r))] (println "  pure       " s (str "(" (count vs) " version" (when (> (count vs) 1) "s") ")")))
  (doseq [[s why] (sort-by key (:skipped r))] (println "  not lowered" s "--" why)))
CLJ
  "$bin" "$core" "$root/src/clj/clotran/loader.cljf" "$root/src/clj/clotran/tiers.cljf" "$root/src/clj/clotran/purefort.cljf" "$work/pure.clj" </dev/null 2>&1 \
    | grep -v '^note: skipping\|^user=>\|WARNING: ->Eduction'
  exit 0
fi

if [ "$1" = "compile" ] && [ "$2" = "--report" ]; then
  # `clotran compile --report foo.cljf`: each function's tier -- A pure
  # Fortran, B the collector, C the interpreter -- and, at every call
  # site that leaves tier A, why and how to stay (clotran.tiers).
  [ $# -eq 3 ] || { echo "usage: clotran compile --report file.cljf" >&2; exit 2; }
  work=$(mktemp -d) || exit 1
  trap 'rm -rf "$work"' EXIT
  printf '(clotran.tiers/report "%s")\n' "$3" > "$work/report.clj"
  "$bin" "$core" "$root/src/clj/clotran/loader.cljf" "$root/src/clj/clotran/tiers.cljf" "$work/report.clj" </dev/null 2>&1 \
    | grep -v '^note: skipping\|^user=>\|WARNING: ->Eduction'
  exit 0
fi

if [ "$1" = "compile" ]; then
  [ $# -eq 2 ] || [ $# -eq 3 ] || { echo "usage: clotran compile file.cljf [library]" >&2; exit 2; }
  src=$2
  stem=${src%.*}
  case "$(uname -s)" in
    Darwin) lib="$stem.dylib"; undef="-Wl,-undefined,dynamic_lookup" ;;
    *)      lib="$stem.so";    undef="" ;;
  esac
  # a source under src/clj/ may keep its library under build/compiled/
  # instead -- clojure/core.clj is vendored and gets nothing added
  [ $# -eq 3 ] && lib=$3
  work=$(mktemp -d) || exit 1
  trap 'rm -rf "$work"' EXIT
  printf '(let [r (clotran.compiler/compile-file "%s" "%s/out.f90")]\n  (doseq [[n why] (:declined r)] (println "declined:" n "--" why))\n  (println "compiled:" (count (:compiled r)) "functions"))\n' \
    "$src" "$work" > "$work/driver.clj"
  "$bin" "$core" "$root/src/clj/clotran/compiler.cljf" "$work/driver.clj" </dev/null \
    | grep -v '^note: skipping\|^user=>\|WARNING: ->Eduction' | tee "$work/log"
  [ -s "$work/out.f90" ] || { echo "clotran compile: no Fortran was written" >&2; exit 1; }
  # A compiled namespace resolves clotran_* against the RUNNING binary
  # at dlopen time, so those symbols are undefined at link time on
  # purpose; macOS has to be told. The compiler runs INSIDE the work
  # directory: a stale clotran_rt_decl.mod in the caller's directory was
  # once read in place of the one this file defines, and every new
  # runtime entry became an unresolved implicit external.
  case "$lib" in /*) out="$lib" ;; *) out="$(pwd)/$lib" ;; esac
  # written under another name and moved into place: a background compile
  # (clotran.loader) looks for the library, and must never find half of one
  # gfortran limits a free-form line to 132 columns unless told otherwise;
  # flang has no such limit, and refuses the flag
  # FC if set; else gfortran on PATH; else the compiler this clotran was
  # built with, by absolute path (build/fc) -- a PATH without Homebrew's
  # directory, as an Emacs started from the Dock has, finds no gfortran
  if [ -n "$FC" ]; then fc=$FC
  elif command -v gfortran >/dev/null 2>&1; then fc=gfortran
  elif [ -x "$(cat "$root/build/fc" 2>/dev/null)" ]; then fc=$(cat "$root/build/fc")
  else fc=gfortran
  fi
  case "$(basename "$fc")" in flang*) long="" ;; *) long="-ffree-line-length-none" ;; esac
  (cd "$work" && $fc -O2 -shared -fPIC $long $undef \
    -o "$out.part" out.f90) || exit 1
  mv -f "$out.part" "$out" || exit 1
  echo "wrote $lib"
  exit 0
fi

# A PROJECT: run in a directory with a deps.edn, clotran asks the package
# manager, clotran-deps (PACKAGES.md), for the project's source path and
# sets CLOTRAN_PATH -- as clj asks tools.deps for a classpath. The answer
# is cached beside the deps.edn, so an unchanged project costs a checksum.
# A leading -A:alias[:alias] goes to it. Not when CLOTRAN_PATH is already
# set (clotran-deps' own run sets it, which is also what stops a loop), and
# not in a clotran source tree, whose deps.edn pins the oracle's clj. A
# deps.edn naming nothing to fetch -- no :local/root, no :git/url, no
# :paths -- needs no clotran-deps, so its absence is not worth a word
# there. clotran-deps is found on PATH, else beside this checkout.
# `clotran test [dir ...]`: the project's -test namespaces through
# clojure.test (clotran.test-runner), with deps.edn's :test alias -- or,
# with no deps.edn, src and test on the path; status 1 on a failure.
test_cmd=""
if [ "$1" = "test" ]; then test_cmd=1; shift; fi
deps_aliases=""
case "$1" in -A*) deps_aliases="$1"; shift ;; esac
if [ -n "$test_cmd" ] && [ -z "$deps_aliases" ] && [ -f deps.edn ] && grep -q ':test' deps.edn; then
  deps_aliases="-A:test"
fi
if [ -n "$test_cmd" ] && [ -z "$CLOTRAN_PATH" ] && [ ! -f deps.edn ]; then
  CLOTRAN_PATH=src:test
  export CLOTRAN_PATH
fi
if [ -z "$CLOTRAN_PATH" ] && [ -f deps.edn ] && [ ! -f src/clj/clotran/rt.cljf ]; then
  deps=$(command -v clotran-deps 2>/dev/null)
  [ -n "$deps" ] || deps="$root/../clotran-deps/bin/clotran-deps"
  if [ -x "$deps" ]; then
    CLOTRAN_PATH=$("$deps" $deps_aliases) || exit 1
    export CLOTRAN_PATH
  elif grep -q ':local/root\|:git/url\|:paths\|:extra-paths' deps.edn; then
    echo "clotran: this deps.edn names sources, but there is no clotran-deps to read it (PACKAGES.md)" >&2
  fi
fi

# What loads is compiled in the background and cached, and installed
# from the cache on later loads -- and mid-session, at a REPL prompt,
# when a build finishes (clotran.loader), quietly unless
# CLOTRAN_AUTOCOMPILE_VERBOSE=1. CLOTRAN_AUTOCOMPILE=0 turns it
# off; CLOTRAN_CACHE moves the cache (default ~/.cache/clotran).
export CLOTRAN_AUTOCOMPILE="${CLOTRAN_AUTOCOMPILE-1}"

[ -n "$test_cmd" ] && exec "$bin" "$core" -m clotran.test-runner "$@"

if [ "$1" = "build" ]; then
  # `clotran build -m NS [-o out]` or `clotran build app.cljf [-o out]`: one
  # executable -- this clotran's binary with an image of the heap once the
  # program's namespace has loaded, and its entry, appended (main.f90,
  # APP_MAGIC). It runs NS's -main with every argument as
  # *command-line-args*, needing no clotran installed and no sources. A
  # file is loaded at build time, and must be a namespace with a -main.
  # What the program loads is compiled (the autocompile cache, built now
  # where it has nothing) and carried in the executable, which writes the
  # libraries out on its first start; --interpreted leaves them out.
  shift
  ns="" file="" out="" compiled=1
  while [ $# -gt 0 ]; do
    case "$1" in
      -m) ns=$2; shift 2 ;;
      --interpreted) compiled=0; shift ;;
      -o) out=$2; shift 2 ;;
      *) file=$1; shift ;;
    esac
  done
  [ -n "$ns$file" ] || { echo "usage: clotran build -m NS [-o out] | clotran build app.cljf [-o out]" >&2; exit 2; }
  if [ -z "$out" ]; then
    if [ -n "$ns" ]; then out=${ns##*.}; else out=$(basename "${file%.*}"); fi
  fi
  case "$out" in /*) ;; *) out="$(pwd)/$out" ;; esac
  work=$(mktemp -d) || exit 1
  [ -n "$CLOTRAN_BUILD_KEEP" ] || trap 'rm -rf "$work"' EXIT
  # what clotran otherwise loads on first use, from its sources: a built
  # program has none, so it is in the image
  printf '(require (quote clotran.rt) (quote clotran.io) (quote clotran.files) (quote clotran.uuid) (quote clotran.reader) (quote clotran.multifn) (quote clotran.thread) (quote clotran.net) (quote clotran.data))\n' > "$work/driver.clj"
  if [ -n "$ns" ]; then
    printf '(require (quote %s))\n(def clotran-build-ns (quote %s))\n' "$ns" "$ns" >> "$work/driver.clj"
  else
    case "$file" in /*) ;; *) file="$(pwd)/$file" ;; esac
    printf '(def clotran-build-ns (let [f (read-string (slurp "%s"))] (when (and (seq? f) (= (quote ns) (first f))) (second f))))\n(when-not clotran-build-ns (throw (ex-info "clotran build: the file must start with (ns ...)" {})))\n(load-file "%s")\n' "$file" "$file" >> "$work/driver.clj"
  fi
  printf '(when-not (ns-resolve clotran-build-ns (quote -main)) (throw (ex-info (str "clotran build: " clotran-build-ns " has no -main") {})))\n' >> "$work/driver.clj"
  if [ "$compiled" = 1 ]; then
    # first, everything the program loads built into the cache: the load
    # starts the builds (autocompile), and this waits for them to finish
    cp "$work/driver.clj" "$work/warm.clj"
    printf '(loop [n 0] (when (and (< n 6000) (some #{:compiling} (vals (clotran.loader/compile-status)))) (clotran.host.thread/sleep 100) (recur (inc n))))\n' >> "$work/warm.clj"
    CLOTRAN_AUTOCOMPILE=1 "$bin" "$core" "$work/warm.clj" </dev/null 2>&1 | grep -v '^note: skipping\|^user=>'
    # then the image, from a load that installs them all from the cache
    # and builds nothing: what it installed is what the program carries
    printf '(clotran-spit "%s" (apply str (map #(str %% "\\n") (clotran-installed-libraries))))\n' "$work/libs" >> "$work/driver.clj"
  fi
  printf '(clotran-spit "%s" (str "m " clotran-build-ns "\\n"))\n' "$work/entry" >> "$work/driver.clj"
  auto=0; [ "$compiled" = 1 ] && auto=use
  CLOTRAN_AUTOCOMPILE=$auto CLOTRAN_IMAGE_COMPILED=$compiled CLOTRAN_IMAGE_SAVE="$work/app.image" "$bin" "$core" "$work/driver.clj" </dev/null 2>&1 \
    | grep -v '^note: skipping\|^user=>'
  [ -s "$work/entry" ] && [ -s "$work/app.image" ] || { echo "clotran build: the program did not load" >&2; exit 1; }
  cp "$bin" "$out.part" || exit 1
  ioff=$(( $(wc -c < "$out.part") )); ilen=$(( $(wc -c < "$work/app.image") ))
  cat "$work/app.image" >> "$out.part"
  # the libraries, each a line of the entry: where it lies in the file
  if [ -s "$work/libs" ]; then
    while IFS= read -r lib; do
      loff=$(( $(wc -c < "$out.part") )); llen=$(( $(wc -c < "$lib") ))
      cat "$lib" >> "$out.part"
      printf 'lib %s %s\n' "$loff" "$llen" >> "$work/entry"
    done < "$work/libs"
  fi
  eoff=$(( $(wc -c < "$out.part") )); elen=$(( $(wc -c < "$work/entry") ))
  cat "$work/entry" >> "$out.part"
  printf '%-16s%020d%020d%020d%020d' "CLOTRAN APP 1" "$ioff" "$ilen" "$eoff" "$elen" >> "$out.part"
  chmod +x "$out.part" && mv -f "$out.part" "$out" || exit 1
  echo "wrote $out"
  exit 0
fi

# a program: no REPL after it, and so no rlwrap around it
case "$1" in
  -m) exec "$bin" "$core" "$@" ;;
  -*) echo "clotran: unknown option $1 (a file, -m NS, or new/compile/test/build)" >&2; exit 2 ;;
  ?*) exec "$bin" "$core" --run "$@" ;;
esac

if [ -t 0 ] && [ "${TERM:-dumb}" != dumb ] && type rlwrap >/dev/null 2>&1; then
  exec rlwrap -m -r -q '"' -b "(){}[],^%#@\";:'" "$bin" "$core" "$@"
else
  [ -t 0 ] && echo "note: install rlwrap for line editing and history" >&2
  exec "$bin" "$core" "$@"
fi
