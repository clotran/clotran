#!/bin/sh
# clotran: the entry point on macOS and Linux. The command itself is
# clotran-bin --launch (main.f90, src/clj/clotran/launcher.cljf): it loads
# Clojure's own core.clj -- from build/core.image, the heap as it stood
# once core and spec had loaded, in about 0.2 s -- and reads the rest:
#
#   clotran                     the REPL (-A:alias adds deps.edn aliases)
#   clotran app.cljf a b        a program, as clj -M app.clj a b
#   clotran -m app.core a b     a namespace's -main
#   clotran new NAME            a project in ./NAME
#   clotran test                its -test namespaces, through clojure.test
#   clotran compile foo.cljf    the namespace compiled to a library
#   clotran build -m NS         one executable
#
# The REPL edits its own input on a terminal (clotran.lineedit: history,
# completion from the running REPL, multi-line forms); CLOTRAN_NO_EDITOR=1
# reads plain lines instead. On Windows the command is bin\clotran.cmd,
# which runs clotran-bin.exe --launch itself.
bin="$(cd "$(dirname "$0")" && pwd)/clotran-bin"
[ -x "$bin" ] || { echo "build first: make" >&2; exit 1; }
exec "$bin" --launch "$@"
