*~
\#*
.\#*
/build/
/clotran-bin
/clotran-bin.exe
/.claude/
/packages/*/lib*.dylib
/packages/*/lib*.so
/packages/*/*.mod
/packages/*/*.dSYM
/packages/*/*_bind.f90
# gfortran drops a .mod beside itself; a compiled namespace built in the
# working directory leaves one here
*.mod
/docs/*.pdf
/docs/*.html
/examples/embed/heat
/examples/embed/heat.dSYM/
.cpcache/
.clotran-cache/
# ACL2's certificates and compiled books (model/; `make model` makes them)
/model/*.cert
/model/*.cert.out
/model/*.fasl
/model/*.port
