; THE ANALYZER'S LOCALS' STATE, READ THROUGH ITS WRITES (model/anlocal.lisp's stobj
; anls): what anlocal-proof and anlocal-cost reason with. Each field's read
; (anl-g-X, with its record count; anl-r-X, without) through every write
; but its own is what it was, its own write reads back, a grow leaves
; every read and makes room for its record, and the counts read through
; each other's writes. Generated by macros, a lemma family a field.

(in-package "ACL2")

(include-book "anlocal")

; ---- READING THROUGH THE WRITES ------------------------------------------------------------
;
; A record's field reads the same through every write but its own; its
; own write reads back. r-X is the read without the count.

(defun anl-ind-rl (i l k)
  (if (zp i) (list l k) (anl-ind-rl (- i 1) (if (atom l) l (cdr l)) (- k 1))))

(defthm anl-nth-resize-list
  (implies (and (natp i) (natp k) (< i k))
           (equal (nth i (resize-list l k d)) (if (< i (len l)) (nth i l) d)))
  :hints (("Goal" :induct (anl-ind-rl i l k) :in-theory (enable resize-list) :expand ((resize-list l k d)))))

(defthm anl-len-resize-list (equal (len (resize-list l k d)) (nfix k))
  :hints (("Goal" :in-theory (enable resize-list))))

(defmacro anl-sym (&rest parts)
  `(intern$ (concatenate 'string ,@parts) "ACL2"))

(defconst *anl-arrays*
  '((fctr anl-nf) (fout anl-nf) (fcap anl-nf) (fvar anl-nf) (fah anl-nf) (fnl anl-nf)
    (bpar anl-nb) (bfn anl-nb) (bhead anl-nb)
    (xnm anl-nx) (xsl anl-nx) (xblk anl-nx) (xnext anl-nx)
    (cnm anl-nc) (cout anl-nc) (cin anl-nc) (cbx anl-nc) (cnext anl-nc)
    (nsl anl-nn) (nnm anl-nn) (nnext anl-nn)
    (an anl-na) (anext anl-na)
    (ev anl-nev) (es anl-nev)))

(defconst *anl-scalars* '(anl-nf anl-nb anl-nx anl-nc anl-na anl-nn anl-nev anl-err))

(defun anl-cat-sym (a b)
  (declare (xargs :mode :program))
  (intern$ (concatenate 'string a (symbol-name b)) "ACL2"))

(defun anl-cat-sym2 (a b c)
  (declare (xargs :mode :program))
  (intern$ (concatenate 'string a (symbol-name b) c) "ACL2"))

; prefix each name
(defun anl-syms (pre xs)
  (declare (xargs :mode :program))
  (if (endp xs) nil (cons (anl-cat-sym pre (car xs)) (anl-syms pre (cdr xs)))))

; (equal (f i (op ,@args anls)) rhs) for each op
(defun anl-eqs (f ops args rhs)
  (declare (xargs :mode :program))
  (if (endp ops) nil
    (cons `(equal (,f i (,(car ops) ,@args anls)) ,rhs) (anl-eqs f (cdr ops) args rhs))))

; (equal (x (update-y v anls)) (x anls)) for each y
(defun anl-scalar-eqs-of (x ys)
  (declare (xargs :mode :program))
  (if (endp ys) nil
    (cons `(equal (,x (,(anl-cat-sym "UPDATE-" (car ys)) v anls)) (,x anls)) (anl-scalar-eqs-of x (cdr ys)))))

; (equal (x (op ,@args anls)) (x anls)) for each scalar x
(defun anl-scalar-eqs (xs op args)
  (declare (xargs :mode :program))
  (if (endp xs) nil
    (cons `(equal (,(car xs) (,op ,@args anls)) (,(car xs) anls)) (anl-scalar-eqs (cdr xs) op args))))

; (equal (len (op ,@args anls)) (len anls)) for each op
(defun anl-eqs-len (len ops args)
  (declare (xargs :mode :program))
  (if (endp ops) nil
    (cons `(equal (,len (,(car ops) ,@args anls)) (,len anls)) (anl-eqs-len len (cdr ops) args))))

; the scalars through the scalars' writes
(defun anl-scalar-frames-1 (xs all)
  (declare (xargs :mode :program))
  (if (endp xs) nil
    (let ((x (car xs)))
      (cons `(defthm ,(anl-cat-sym2 "" x "-FRAMES")
               (and (equal (,x (,(anl-cat-sym "UPDATE-" x) v anls)) v)
                    ,@(anl-scalar-eqs-of x (remove-equal x all)))
               :hints (("Goal" :in-theory (enable ,@all ,@(anl-syms "UPDATE-" all)))))
            (anl-scalar-frames-1 (cdr xs) all)))))

(defun anl-frames-1 (a cnt arrays scalars)
  (declare (xargs :mode :program))
  (let* ((nm (symbol-name a))
         (g (anl-sym "ANL-G-" nm)) (r (anl-sym "ANL-R-" nm)) (s (anl-sym "ANL-S-" nm))
         (acc (anl-sym "ANL-" nm "I")) (len (anl-sym "ANL-" nm "-LENGTH")) (rs (anl-sym "RESIZE-ANL-" nm))
         (others (remove-equal a (strip-cars arrays)))
         (oset (anl-syms "ANL-S-" others)) (ors (anl-syms "RESIZE-ANL-" others))
         (upds (anl-syms "UPDATE-" scalars)))
    `((defun ,r (i anls)
        (declare (xargs :stobjs anls :verify-guards nil))
        (if (and (integerp i) (<= 0 i) (< i (,len anls))) (,acc i anls) -1))
      (defthm ,(anl-sym "ANL-G-" nm "-IS") (equal (,g i anls) (if (< i (,cnt anls)) (,r i anls) -1))
        :hints (("Goal" :in-theory (enable ,g))))
      (defthm ,(anl-sym "ANL-R-" nm "-OWN")
        (equal (,r i (,s j v anls)) (if (and (equal i j) (integerp j) (<= 0 j) (< j (,len anls))) v (,r i anls)))
        :hints (("Goal" :in-theory (enable ,s ,@upds))))
      (defthm ,(anl-sym "ANL-R-" nm "-OTHERS")
        (and ,@(anl-eqs r oset '(j v) `(,r i anls))
             ,@(anl-eqs r ors '(k) `(,r i anls))
             ,@(anl-eqs r upds '(v) `(,r i anls)))
        :hints (("Goal" :in-theory (enable ,@oset ,@ors ,@upds))))
      (defthm ,(anl-sym "ANL-R-" nm "-RESIZE")
        (implies (and (natp k) (<= (,len anls) k)) (equal (,r i (,rs k anls)) (,r i anls)))
        :hints (("Goal" :in-theory (enable ,rs))))
      (defthm ,(anl-sym "ANL-" nm "-LENGTH-FRAMES")
        (and (equal (,len (,s j v anls)) (,len anls))
             (equal (,len (,rs k anls)) (nfix k))
             ,@(anl-eqs-len len oset '(j v))
             ,@(anl-eqs-len len ors '(k))
             ,@(anl-eqs-len len upds '(v)))
        :hints (("Goal" :in-theory (enable ,s ,rs ,@oset ,@ors ,@upds))))
      (defthm ,(anl-sym "ANL-S-" nm "-SCALARS")
        (and ,@(anl-scalar-eqs (remove-equal 'anl-err scalars) s '(j v))
             ,@(anl-scalar-eqs scalars rs '(k))
             (equal (anl-err (,s j v anls)) (if (and (integerp j) (<= 0 j) (< j (,len anls))) (anl-err anls) 1)))
        :hints (("Goal" :in-theory (enable ,s ,rs ,@scalars ,@upds)))))))

(defun anl-frames (arrays all scalars)
  (declare (xargs :mode :program))
  (if (endp arrays) nil
    (append (anl-frames-1 (car (car arrays)) (cadr (car arrays)) all scalars)
            (anl-frames (cdr arrays) all scalars))))

(defmacro anl-all-frames ()
  `(progn ,@(anl-frames *anl-arrays* *anl-arrays* *anl-scalars*)))

(anl-all-frames)

(defmacro anl-scalar-frames () `(progn ,@(anl-scalar-frames-1 *anl-scalars* *anl-scalars*)))

(anl-scalar-frames)

(in-theory (disable anl-g-fctr-is anl-g-fout-is anl-g-fcap-is anl-g-fvar-is anl-g-fah-is anl-g-fnl-is
