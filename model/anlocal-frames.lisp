                    anl-g-xnext-is anl-g-cnm-is anl-g-cout-is anl-g-cin-is anl-g-cbx-is anl-g-cnext-is
                    anl-g-nsl-is anl-g-nnm-is anl-g-nnext-is anl-g-an-is anl-g-anext-is anl-g-ev-is anl-g-es-is))

(in-theory (disable anl-fctr-length anl-fout-length anl-fcap-length anl-fvar-length anl-fah-length anl-fnl-length anl-bpar-length anl-bfn-length anl-bhead-length anl-xnm-length anl-xsl-length anl-xblk-length anl-xnext-length anl-cnm-length anl-cout-length anl-cin-length anl-cbx-length anl-cnext-length anl-nsl-length anl-nnm-length anl-nnext-length anl-an-length anl-anext-length anl-ev-length anl-es-length))

; the same of the reads with the count, g-X
(defun anl-gframes-1 (a cnt arrays scalars)
  (declare (xargs :mode :program))
  (let* ((nm (symbol-name a))
         (g (anl-sym "ANL-G-" nm)) (r (anl-sym "ANL-R-" nm)) (s (anl-sym "ANL-S-" nm))
         (len (anl-sym "ANL-" nm "-LENGTH")) (rs (anl-sym "RESIZE-ANL-" nm))
         (others (remove-equal a (strip-cars arrays)))
         (oset (anl-syms "ANL-S-" others)) (ors (anl-syms "RESIZE-ANL-" others))
         (upds (anl-syms "UPDATE-" (remove-equal cnt scalars))))
    `((defthm ,(anl-sym "ANL-G-" nm "-OWN")
        (equal (,g i (,s j v anls))
               (if (and (equal i j) (integerp j) (<= 0 j) (< j (,cnt anls)) (< j (,len anls))) v (,g i anls)))
        :hints (("Goal" :in-theory (enable ,(anl-sym "ANL-G-" nm "-IS")))))
      (defthm ,(anl-sym "ANL-G-" nm "-OTHERS")
        (and ,@(anl-eqs g oset '(j v) `(,g i anls))
             ,@(anl-eqs g ors '(k) `(,g i anls))
             ,@(anl-eqs g upds '(v) `(,g i anls)))
        :hints (("Goal" :in-theory (enable ,(anl-sym "ANL-G-" nm "-IS")))))
      (defthm ,(anl-sym "ANL-G-" nm "-COUNT")
        (equal (,g i (,(anl-cat-sym "UPDATE-" cnt) v anls)) (if (and (integerp i) (<= 0 i) (< i v)) (,r i anls) -1))
        :hints (("Goal" :in-theory (enable ,(anl-sym "ANL-G-" nm "-IS")))))
      (defthm ,(anl-sym "ANL-G-" nm "-RESIZE")
        (implies (and (natp k) (<= (,len anls) k)) (equal (,g i (,rs k anls)) (,g i anls)))
        :hints (("Goal" :in-theory (enable ,(anl-sym "ANL-G-" nm "-IS"))))))))

(defun anl-gframes (arrays all scalars)
  (declare (xargs :mode :program))
  (if (endp arrays) nil
    (append (anl-gframes-1 (car (car arrays)) (cadr (car arrays)) all scalars)
            (anl-gframes (cdr arrays) all scalars))))

(defmacro anl-all-gframes () `(progn ,@(anl-gframes *anl-arrays* *anl-arrays* *anl-scalars*)))

(anl-all-gframes)

(defun anl-syms2 (pre xs suf)
  (declare (xargs :mode :program))
  (if (endp xs) nil (cons (anl-cat-sym2 pre (car xs) suf) (anl-syms2 pre (cdr xs) suf))))

(defun anl-eqs-grow (fs grow)
  (declare (xargs :mode :program))
  (if (endp fs) nil (cons `(equal (,(car fs) i (,grow n anls)) (,(car fs) i anls)) (anl-eqs-grow (cdr fs) grow))))

(defun anl-lt-all (lens grow)
  (declare (xargs :mode :program))
  (if (endp lens) nil (cons `(< n (,(car lens) (,grow n anls))) (anl-lt-all (cdr lens) grow))))

(defun anl-eqs-len-grow (lens grow)
  (declare (xargs :mode :program))
  (if (endp lens) nil (cons `(equal (,(car lens) (,grow n anls)) (,(car lens) anls)) (anl-eqs-len-grow (cdr lens) grow))))

; the grows leave every read and count as it was, and make room for record n
(defmacro anl-grow-lemmas (grow arrays)
  (let ((lens (anl-syms2 "ANL-" arrays "-LENGTH")))
    `(progn
       (defthm ,(anl-cat-sym2 "" grow "-READS")
         (implies (natp n)
                  (and ,@(anl-eqs-grow (anl-syms "ANL-G-" (strip-cars *anl-arrays*)) grow)
                       ,@(anl-eqs-grow (anl-syms "ANL-R-" (strip-cars *anl-arrays*)) grow)
                       ,@(anl-scalar-eqs *anl-scalars* grow '(n))))
         :hints (("Goal" :in-theory (enable ,grow))))
       (defthm ,(anl-cat-sym2 "" grow "-ROOM")
         (implies (natp n) (and ,@(anl-lt-all lens grow)))
         :hints (("Goal" :in-theory (enable ,grow))))
       (defthm ,(anl-cat-sym2 "" grow "-LENGTHS")
         (and ,@(anl-eqs-len-grow (set-difference-equal (anl-syms2 "ANL-" (strip-cars *anl-arrays*) "-LENGTH") lens) grow))
         :hints (("Goal" :in-theory (enable ,grow)))))))

(anl-grow-lemmas anl-grow-f (fctr fout fcap fvar fah fnl))
(anl-grow-lemmas anl-grow-b (bpar bfn bhead))
(anl-grow-lemmas anl-grow-x (xnm xsl xblk xnext))
(anl-grow-lemmas anl-grow-c (cnm cout cin cbx cnext))
(anl-grow-lemmas anl-grow-n (nsl nnm nnext))
(anl-grow-lemmas anl-grow-a (an anext))
(anl-grow-lemmas anl-grow-e (ev es))

