#!/usr/bin/env bb
;; fuzz-anform-gen: the GENERATED special-form checks (src/f/gen/anform_gen.inc,
;; written by scripts/acl2-fortran -b anform from model/anform.lisp) against
;; the ACL2 they were generated from.
;;
;;   scripts/fuzz-anform-gen [-n COUNT] [-s SEED] [-x] [--fc gfortran|flang]
;;
;; Random forms -- symbols (qualified or not, catch, finally, naming a class
;; or not, a def's var here, missing or elsewhere), strings, vectors, and
;; lists of them, many shaped as special forms and try clauses -- and random
;; calls of every check on them, with counts, states and selectors in range
;; and out of it. ACL2 answers with the model's functions; test/anform/
;; anform_check with the generated ones, through mock reads of the same
;; forms. Every answer must agree, call for call.
;;
;; -x is the NEGATIVE CONTROL: the generated side reads frf-class flipped,
;; and the answers must part.
(require '[babashka.process :as p] '[clojure.string :as str] '[clojure.edn :as edn] '[babashka.fs :as fs])

(def broken (some #{"-x"} *command-line-args*))
(def args (apply hash-map (remove #{"-x"} *command-line-args*)))
(def n (parse-long (get args "-n" "200")))
(def seed (parse-long (get args "-s" (str (mod (System/nanoTime) 2147483647)))))
(def fc (get args "--fc" "gfortran"))
(def work (str (fs/create-temp-dir {:prefix "fuzz-anform-gen"})))

;; the house LCG: every case reproduces from its seed
(def rng (atom seed))
(defn rnd [k]
  (let [x (swap! rng #(unchecked-add (unchecked-multiply % 6364136223846793005) 1442695040888963407))]
    (mod (bit-shift-right x 33) (max k 1))))
(defn pick [xs] (nth xs (rnd (count xs))))

;; ---- the cases --------------------------------------------------------------------------
;;
;; forms: rows {:kind :qual :word :class :defvar :kids}, 1-based ids, 0 a
;; form of no kind. Lists and vectors are made after their elements.

(defn sym [] {:kind 2 :qual (pick [0 0 0 1]) :word (pick [0 0 1 2 3]) :class (pick [0 1 1]) :defvar (pick [0 0 1 2 3]) :kids []})

(defn gen-forms []
  (let [atoms (vec (concat (repeatedly (+ 3 (rnd 5)) sym)
                           [{:kind 4 :qual 0 :word 0 :class 0 :defvar 0 :kids []}
                            {:kind 0 :qual 0 :word 0 :class 0 :defvar 0 :kids []}]))
        heads (vec (keep-indexed (fn [i r] (when (pos? (:word r)) (inc i))) atoms))]
    (reduce (fn [rows _]
              (let [k (pick [0 1 2 3 3 4 4 5 6])
                    any #(pick (concat [0] (range 1 (inc (count rows)))))
                    kids (vec (repeatedly k any))
                    ;; half the lists a clause: a catch or finally symbol at the head
                    kids (if (and (seq heads) (seq kids) (zero? (rnd 2))) (assoc kids 0 (pick heads)) kids)]
                (conj rows {:kind (pick [3 3 3 1]) :qual 0 :word 0 :class 0 :defvar 0 :kids kids})))
            atoms (range (+ 2 (rnd 8))))))

(defn gen-calls [nforms]
  (vec (for [_ (range (+ 5 (rnd 40)))]
         (let [f (rnd (inc nforms)) cnt (pick [-1 0 1 2 3 4 5 6])]
           (case (inc (rnd 12))
             1 [1 cnt 0 0 0]
             2 [2 f (pick [0 1 2 3]) 0 0]
             3 [3 cnt 0 0 0]
             4 [4 cnt 0 0 0]
             5 [5 f 0 0 0]
             6 [6 (pick [0 1 1 2]) f (pick [0 1 2]) (pick [0 1 2 3])]
             7 [7 f 0 0 0]
             8 [8 cnt 0 0 0]
             9 [9 f 0 0 0]
             10 [10 f 0 0 0]
             12 [12 cnt f 0 0]
             11 [11 f 0 0 0])))))

(def cases (vec (for [_ (range n)] (let [forms (gen-forms)] {:forms forms :calls (gen-calls (count forms))}))))

;; ---- what ACL2 answers ------------------------------------------------------------------

(defn acl2-form [forms id]
  (if (or (zero? id) (> id (count forms))) "0"
      (let [r (nth forms (dec id))]
        (case (:kind r)
          1 (str "(list :vec " (str/join " " (map #(acl2-form forms %) (:kids r))) ")")
          3 (str "(list :list " (str/join " " (map #(acl2-form forms %) (:kids r))) ")")
          2 (str "(list :sym " id " " (:qual r) " 0 " (:word r) " " (:class r) " " (:defvar r) ")")
          4 "(list :str)"
          "0"))))

(defn acl2-call [forms [op a b c d]]
  (let [f #(acl2-form forms %)]
    (case op
      1 (str "(anf-if " a ")") 2 (str "(anf-def " (f a) " " b ")") 3 (str "(anf-quote " a ")")
      4 (str "(anf-throw " a ")") 5 (str "(anf-try-op " (f a) ")")
      6 (str "(anf-try-step " a " " (f b) " " c " " d ")") 7 (str "(anf-catch " (f a) ")")
      8 (str "(anf-set " a ")") 9 (str "(anf-set-target " (f a) ")") 10 (str "(anf-dot " (f a) ")") 12 (str "(anf-dot-member " a " " (f b) ")")
      11 (str "(anf-new " (f a) ")"))))

(def driver
  (str "(include-book \"anform\")\n"
       "(set-print-case :downcase state)\n"
       (str/join (map-indexed
                  (fn [ci {:keys [forms calls]}]
                    (str "(cw \"CASE " ci " ~x0~%\" (list " (str/join " " (map #(acl2-call forms %) calls)) "))\n"))
                  cases))
       "(good-bye)\n"))

(def acl2 (let [a (or (System/getenv "ACL2") (str (fs/parent (fs/parent (fs/parent (fs/canonicalize *file*)))) "/acl2/saved_acl2"))]
            (if (fs/exists? a) a (str (fs/home) "/clotran/acl2/saved_acl2"))))
(def out (:out (p/shell {:dir "model" :in driver :out :string :err :string} acl2)))
(def expected
  (into {} (for [[_ c l] (re-seq #"CASE (\d+) (\([^)]*\))" (str/replace out #"\s*\n\s*" " "))] [(parse-long c) (vec (edn/read-string l))])))
(when (not= (count expected) n)
  (println (str "fuzz-anform-gen: ACL2 answered " (count expected) " of " n " cases; its output ends:"))
  (println (subs out (max 0 (- (count out) 2000))))
  (System/exit 1))

;; ---- the generated code -----------------------------------------------------------------

(let [r (p/shell {:continue true :out :string :err :string :extra-env (if (System/getenv "ACL2") {} {"ACL2" acl2})}
                 "scripts/acl2-fortran" "-b" "anform" "-o" (str work "/anform_gen.inc"))]
  (when-not (zero? (:exit r)) (println (:out r) (:err r)) (System/exit 1)))
(fs/copy "src/f/gen/anlocal_gen.inc" (str work "/anlocal_gen.inc"))
(fs/copy "test/anform/anform_check.f90" (str work "/anform_check.f90"))
(def exe (str work "/anform_check"))
(let [r (apply p/shell {:continue true :out :string :err :string :dir work} fc (concat ["-O2"] (when (= fc "gfortran") ["-frecursive"]) ["-o" exe "anform_check.f90"]))]
  (when-not (zero? (:exit r)) (println (:err r) (:out r)) (System/exit 1)))

(defn case-file [k {:keys [forms calls]}]
  (let [f (str work "/case" k ".txt")]
    (spit f (str (count forms) " " (count calls) "\n"
                 (str/join "\n" (for [r forms]
                                  (let [vs (concat [(:kind r) (:qual r) (:word r) (:class r) (:defvar r) (count (:kids r))] (:kids r))]
                                    (str (count vs) " " (str/join " " vs)))))
                 "\n"
                 (str/join "\n" (for [c calls] (str/join " " c)))
                 "\n"))
    f))

(def results
  (vec (for [[k c] (map-indexed vector cases)]
         (let [r (apply p/shell {:continue true :out :string :err :string} exe (case-file k c) (when broken ["broken"]))
               got (vec (for [l (str/split-lines (:out r)) :when (not (str/blank? l))] (parse-long (str/trim l))))
               want (expected k)]
           {:k k :got got :want want :ok (= got want)
            :first (first (for [i (range (max (count got) (count want))) :when (not= (get got i) (get want i))] i))}))))

(def bad (remove :ok results))
(def answers (mapcat :want results))
(println (str n " cases, seed " seed (when broken " (negative control: the class read flipped)")))
(println (str "  " (count answers) " calls, " (count (filter pos? answers)) " answering a refusal code or a nonzero shape"))
(println (str "generated special-form checks against ACL2's: " (count bad) " cases differ"))
(doseq [b (take 2 bad)]
  (println "  case" (:k b) "at call" (:first b) (pr-str (get (:calls (nth cases (:k b))) (:first b))))
  (println "    ACL2     " (pr-str (get (:want b) (:first b))))
  (println "    generated" (pr-str (get (:got b) (:first b)))))
(System/exit (if (if broken (empty? bad) (seq bad)) 1 0))
