#!/usr/bin/env bb
;; The compiler's differential test: every form is run INTERPRETED and
;; COMPILED and the two answers are compared.
;;
;; This is `scripts/oracle` applied to the other axis. The oracle holds
;; clotran to real Clojure; this holds compiled clotran to interpreted
;; clotran. No expected value is typed in by hand in either, which is
;; the only reason to trust them: 14 of the 477 hand-typed expectations
;; this project started with turned out to be clotran's answer rather
;; than Clojure's.
;;
;; A case is a [name fn-form [args ...] ...] -- the function, and the
;; argument lists to call it with. A function the generator DECLINES is
;; reported and skipped, not failed: declining is the designed answer
;; for a construct it has not learned, and the report is how the next
;; thing to teach it stays visible.
;;
;;   scripts/compiler-check           run every case
;;   scripts/compiler-check --keep    leave the generated Fortran to read
;;   scripts/compiler-check --bench   also time one loop both ways
(require '[clojure.string :as str]
         '[clojure.java.io :as io]
         '[babashka.process :refer [shell]]
         '[clojure.walk])

(def repo (-> *file* io/file .getCanonicalFile .getParentFile .getParentFile))
(def work (io/file "/tmp/clotran-compiler-check"))
(def keep? (some #{"--keep"} *command-line-args*))
(def bench? (some #{"--bench"} *command-line-args*))

;; Each case: a name, the fn form, and the calls to make on it.
(def cases
  '[["a constant" (fn [] 42) [[]]]
    ["the argument back" (fn [x] x) [[1] ["a"] [nil]]]
    ["a call to a core fn" (fn [x] (inc x)) [[1] [-1] [0]]]
    ["arithmetic" (fn [x] (* x 2)) [[3] [0] [-4]]]
    ["two arguments" (fn [a b] (+ a b)) [[1 2] [-5 5]]]
    ["nested calls" (fn [x] (+ (* x 2) (- x 1))) [[3] [10]]]
    ["an if, both ways" (fn [x] (if (< x 10) :small :big)) [[1] [100]]]
    ["an if with no else" (fn [x] (if x :yes)) [[true] [false] [nil]]]
    ["a string constant" (fn [x] (if x "yes" "no")) [[true] [false]]]
    ["a double" (fn [x] (* x 1.5)) [[2] [0]]]
    ["truthiness is Clojure's" (fn [x] (if x 1 0)) [[0] [""] [false] [nil] [[]]]]
    ["a call through a Var" (fn [x] (compiler-check-target x)) [[5] [0]]]
    ["comparison" (fn [a b] (if (= a b) :same :different)) [[1 1] [1 2] ["a" "a"]]]
    ["a collection constant" (fn [x] (get {:a 1 :b 2} x)) [[:a] [:b] [:c]]]
    ["a vector literal" (fn [a b] [a b]) [[1 2]]]
    ["nesting three deep" (fn [x] (if (< x 0) (- 0 x) (if (= x 0) :zero x))) [[-3] [0] [7]]]
    ["a loop that sums" (fn [n] (loop [i 0 acc 0] (if (< i n) (recur (+ i 1) (+ acc i)) acc)))
     [[0] [1] [10] [100]]]
    ["a loop that never runs" (fn [n] (loop [i 0] (if (< i n) (recur (+ i 1)) i))) [[0] [3]]]
    ["recur on the function itself" (fn [n acc] (if (= n 0) acc (recur (- n 1) (+ acc n))))
     [[0 0] [5 0] [50 0]]]
    ["nested loops" (fn [n] (loop [i 0 t 0]
                             (if (< i n)
                               (recur (+ i 1) (loop [j 0 s t] (if (< j 2) (recur (+ j 1) (+ s 1)) s)))
                               t)))
     [[0] [1] [4]]]
    ["a loop with no recur" (fn [x] (loop [y x] y)) [[7]]]
    ;; these reach node kinds the generator does not emit, so they go
    ;; through the escape hatch and must still answer the same
    ["a try, both ways" (fn [x] (try (/ 10 x) (catch Throwable e :boom)))
     [[2] [0] [5]]]
    ["a set literal" (fn [a b] (count #{a b})) [[1 2] [3 3]]]
    ["a map literal" (fn [a] (get {:k a} :k)) [[9] [nil]]]
    ["destructuring" (fn [v] (let [[a b] v] (+ a b))) [[[1 2]] [[10 20]]]]
    ["a hatch inside a loop" (fn [n] (loop [i 0 acc []] (if (< i n) (recur (+ i 1) (conj acc i)) (count acc))))
     [[0] [3]]]
    ;; PRIMITIVE locals. Each must answer exactly what the interpreter
    ;; answers, overflow included: the fast path hands an overflow to
    ;; the generic call, which raises what Clojure raises.
    ["a primitive let" (fn [a] (let [x 2 y (* x 3)] (+ y a))) [[1] [10]]]
    ["a primitive bool local" (fn [a] (let [ok (< 1 2)] (if ok a 0))) [[5]]]
    ["a double accumulator" (fn [n] (loop [i 0 s 0.0] (if (< i n) (recur (inc i) (+ s (* 0.5 i))) s)))
     [[0] [4] [100]]]
    ["compared with a double" (fn [x] (loop [i 0] (if (< i x) (recur (inc i)) i))) [[3.5] [0.0] [-1.5]]]
    ["compared with a non-number" (fn [x] (loop [i 0] (if (< i x) (recur (inc i)) i))) [["a"] [nil] [3N]]]
    ["long overflow in a loop" (fn [] (loop [i 9223372036854775800 k 0] (if (< k 20) (recur (+ i 1) (+ k 1)) i))) [[]]]
    ["long overflow on multiply" (fn [] (loop [i 3 k 0] (if (< k 60) (recur (* i 3) (+ k 1)) i))) [[]]]
    ["inc at the edge" (fn [] (let [m 9223372036854775807] (inc m))) [[]]]
    ["a primitive local read by the interpreter" (fn [] (let [x 5] (try (+ x 1) (catch Throwable e 0)))) [[]]]
    ["zero? pos? neg?" (fn [] (let [a 0 b 3 c -2.5] [(zero? a) (pos? b) (neg? c) (zero? b)])) [[]]]
    ["= and == on numbers" (fn [] (let [a 2 b 2 c 2.0] [(= a b) (== a c) (= c 2.0)])) [[]]]
    ["double division" (fn [] (let [a 1.0 b 4.0] (/ a b))) [[]]]
    ["long division stays a ratio" (fn [] (let [a 1 b 4] (/ a b))) [[]]]
    ["a recur inside a case is declined" (fn [n] (loop [i 0] (case i 3 i (recur (inc i))))) [[0]]]
    ;; HINTED parameters. A matching argument runs the typed version; a
    ;; vector for ^doubles, or a long for ^double, runs the untyped one,
    ;; and must still answer what the interpreter answers.
    ["sum a double array" (fn [^doubles a] (let [n (alength a)] (loop [i 0 s 0.0] (if (< i n) (recur (inc i) (+ s (aget a i))) s))))
     [[(double-array [1.0 2.5 3.0])] [(double-array 0)] [[1.0 2.0]]]]
    ["scale a double array in place" (fn [^doubles a ^double k] (let [n (alength a)] (loop [i 0] (if (< i n) (do (aset a i (* k (aget a i))) (recur (inc i))) (vec a)))))
     [[(double-array [1.0 2.0]) 3.0] [(double-array [1.0]) 2]]]
    ["aset answers the value" (fn [^doubles a] (aset a 0 2.5)) [[(double-array 1)]]]
    ["an index out of range" (fn [^doubles a] (aget a 5)) [[(double-array 2)]]]
    ["a long array" (fn [^longs a] (loop [i 0 s 0] (if (< i (alength a)) (recur (inc i) (+ s (aget a i))) s)))
     [[(long-array [1 2 3])] [(double-array 2)]]]
    ["a primitive double parameter" (fn [^double x] (* x x)) [[3.0] [2]]]
    ["the fn's own recur on typed parameters" (fn [^long n ^long acc] (if (= n 0) acc (recur (dec n) (+ acc n))))
     [[10 0] [0 5] [3 1.5]]]
    ["casts" (fn [] (let [x 7 d 2.9] [(int x) (long d) (double x) (int -2.9)])) [[]]]
    ;; The array REGISTRY grows while the loop holds a pointer into a's
    ;; buffer: every iteration makes an array and keeps it, so the
    ;; registry has to grow past its first sixteen. Growing it used to
    ;; deep-copy every buffer to a new address, which would leave the
    ;; loop reading freed memory.
    ["arrays allocated while one is held"
     (fn [^doubles a] (loop [i 0 s 0.0 held []] (if (< i (alength a)) (recur (inc i) (+ s (aget a i)) (conj held (double-array (alength a)))) s)))
     [[(double-array (range 300))]]]
    ;; A hint the argument does not honour: the guard fails, the untyped
    ;; body runs, and it must throw what Clojure throws -- a checkcast
    ;; where the array is used, a conversion where a ^long is bound.
    ;; SEVERAL ARITIES and VARIADIC ones: one procedure picks by the
    ;; argument count, an exact fixed arity before the variadic.
    ;; a recur inside a subtree the interpreter runs, targeting its OWN
    ;; loop or fn there: compiled, not declined
    ["a recur the interpreter owns"
     (fn [n] [(try (loop [i 0 s 0] (if (< i n) (recur (inc i) (+ s i)) s)) (catch Exception e :x))
              (doall (take 3 (lazy-seq ((fn step [k] (if (pos? k) (recur (dec k)) (list k n))) n))))])
     [[0] [4]]]
    ["two arities" (fn ([x] (+ x 1)) ([x y] (* x y))) [[3] [3 4] [2.5 2]]]
    ["variadic, rest nil or a list" (fn [x & more] [x more (count more) (seq? more)]) [[1] [1 2] [1 2 3 4]]]
    ["only a rest" (fn [& xs] (apply + xs)) [[] [1] [1 2 3]]]
    ["fixed beats variadic" (fn ([a b] [:fixed a b]) ([a b & c] [:rest a b c])) [[1 2] [1 2 3] [1 2 3 4]]]
    ["recur in a variadic arity" (fn [acc & xs] (if xs (recur (+ acc (first xs)) (next xs)) acc)) [[0] [0 1 2 3] [10 5]]]
    ["three arities, a loop in one"
     (fn ([] 0) ([n] (loop [i 0 s 0] (if (< i n) (recur (inc i) (+ s i)) s))) ([n m] (- n m)))
     [[] [10] [1000] [5 3]]]
    ["hints per arity" (fn ([^long n] (+ n 1)) ([^doubles a i] (aget a i))) [[41] [(double-array [1.5 2.5]) 1] [[1 2] 0]]]
    ["arity recur rebinds its own parameters" (fn ([n] (if (> n 0) (recur (dec n)) :done)) ([n m] (if (> n 0) (recur (dec n) (inc m)) m))) [[5] [5 0]]]
    ;; No hints at all: the arrays are speculated double, then long,
    ;; and anything else runs the untyped body.
    ["arrays with no hints"
     (fn [a b] (loop [i 0 s 0] (if (< i (alength a)) (do (aset b i (* 2 (aget a i))) (recur (inc i) (+ s (aget a i)))) s)))
     [[(double-array [1 2]) (double-array 2)] [(long-array [1 2]) (long-array 2)] [(long-array [1 2]) (double-array 2)]
      [(double-array [1 2]) (long-array 2)] [(object-array [1 2]) (object-array 2)] [[1 2] (double-array 2)]
      [nil (double-array 2)] [(long-array [Long/MAX_VALUE]) (long-array 1)] [(double-array [1 2]) (double-array 1)]]]
    ["a hint the argument does not honour"
     (fn [^doubles a ^long n] (if (< n 0) :unused (loop [i 0 s 0.0] (if (< i n) (recur (inc i) (+ s (aget a i))) s))))
     [[(double-array [1 2 3]) 3] [(double-array [1 2 3]) 2.9] [(long-array [1 2]) 1] [[1 2] 1] [[1 2] -1] [nil 1] [(double-array 2) "x"]]]])

;; Benchmarks are cases like any other -- built the same way and
;; compared for correctness on their small calls -- plus the arguments
;; to TIME them with. PLAN step 10: measured, or not claimed. The
;; second is the form the JVM figure in scripts/bench is taken on,
;; every local primitive, so it is the like-for-like comparison.
(def benches
  '[["bench: sum to n" (fn [n] (loop [i 0 acc 0] (if (< i n) (recur (+ i 1) (+ acc i)) acc)))
     [[1000]] [200000]]
    ["bench: sum to 200000, all primitive" (fn [] (loop [i 0 acc 0] (if (< i 200000) (recur (+ i 1) (+ acc i)) acc)))
     [[]] []]
    ["bench: sum a 200000-element double array"
     (fn [^doubles a] (let [n (alength a)] (loop [i 0 s 0.0] (if (< i n) (recur (inc i) (+ s (aget a i))) s))))
     [[(double-array [1.0 2.0])]] [(double-array (range 200000))]]
    ["bench: sum a 200000-element double array, no hints"
     (fn [a] (let [n (alength a)] (loop [i 0 s 0.0] (if (< i n) (recur (inc i) (+ s (aget a i))) s))))
     [[(double-array [1.0 2.0])]] [(double-array (range 200000))]]])

(def all-cases (if bench? (into cases benches) cases))

(defn- src
  "A form as source, WITH its type hints. pr-str drops metadata, so
  every ^doubles in a case used to reach the compiler stripped and
  the hinted cases ran the untyped version -- the typed path went
  untested and the array benchmark looked 700 times slower than it
  is. Only :tag is kept; the line numbers the reader attaches are
  noise."
  [form]
  (binding [*print-meta* true]
    (pr-str (clojure.walk/postwalk
             (fn [x]
               (cond (symbol? x) (if-let [t (:tag (meta x))] (with-meta x {:tag t}) (with-meta x nil))
                     (instance? clojure.lang.IObj x) (with-meta x nil)
                     :else x))
             form))))

(defn- run-clotran
  "Runs a file through clotran with core.clj loaded, answering stdout."
  [path]
  ;; :in "" closes stdin: clotran enters its REPL after loading a file
  ;; and would otherwise wait on a terminal that never ends.
  (let [r (shell {:out :string :err :string :dir (str repo) :continue true :in ""}
                 "./clotran-bin" "src/clj/clojure/core.clj" (str path))]
    (str (:out r) (:err r))))

(defn- driver-source
  "The Clojure the check runs inside clotran: compile each case and
  PRINT its Fortran between markers. It prints rather than writes
  because `spit` wants clojure.java.io, which DEVIATIONS 12 skips."
  []
  (str
   "(load-file \"src/clj/clotran/compiler.cljf\")\n"
   "(in-ns 'user)\n"
   "(defn compiler-check-target [x] (+ x 100))\n"
   (apply str
          (for [[i [nm form _]] (map-indexed vector all-cases)]
            (str "(let [r (clotran.compiler/compile-fn \"cc\" \"f" i "\" '" (src form) ")]\n"
                 "  (if (:declined r)\n"
                 "    (println \"DECLINED\" " (pr-str nm) " (:declined r))\n"
                 "    (do (println \"===BEGIN " i "\")\n"
                 "        (print (clotran.compiler/module-text \"cc_mod" i "\" [r]))\n"
                 "        (println \"===END\"))))\n")))))

(defn- runner-source
  "The Clojure that loads each built library and compares.

  It COMPILES AGAIN, and throws the Fortran away. The pool holds Vars
  and functions, which cannot be written to a file and read back, so
  the process that registers it has to be the process that built it --
  and compilation is deterministic, so the pool this run produces is
  the one the generated code was written against.

  The interpreted answer comes from evaluating the form; the compiled
  one from the installed Var. Values are compared, never printed text."
  [ids soext]
  (str
   "(load-file \"src/clj/clotran/compiler.cljf\")\n"
   "(in-ns 'user)\n"
   "(defn compiler-check-target [x] (+ x 100))\n"
   "(def fails (atom 0))\n"
   "(def ran (atom 0))\n"
   (apply str
          (for [i ids
                :let [[nm form calls] (nth all-cases i)]]
            (str "(let [r (clotran.compiler/compile-fn \"cc\" \"f" i "\" '" (src form) ")\n"
                 "      h (clotran-pool-register (:pool r))]\n"
                 "  (clotran-load-compiled \"" (str work) "/libf" i "." soext "\" h)\n"
                 "  (let [interp " (src form) "\n"
                 "        comp @(resolve 'cc/f" i ")]\n"
                 (apply str
                        (for [args calls]
                          (str "    (swap! ran inc)\n"
                               "    (let [a (try (apply interp " (pr-str (vec args)) ")"
                               " (catch Throwable e [:threw (first (clojure.string/split (.getMessage e) #\"  at \"))]))\n"
                               "          b (try (apply comp " (pr-str (vec args)) ")"
                               " (catch Throwable e [:threw (first (clojure.string/split (.getMessage e) #\"  at \"))]))]\n"
                               "      (when-not (= a b)\n"
                               "        (swap! fails inc)\n"
                               "        (println \"DIFFER\" " (pr-str nm) " '" (pr-str (vec args)) ")\n"
                               "        (println \"   interpreted:\" (pr-str a))\n"
                               "        (println \"   compiled:   \" (pr-str b))))\n")))
                 (when-let [targs (nth (nth all-cases i) 3 nil)]
                   (str "    (let [targs " (pr-str (vec targs)) "\n          ms (fn [g] (apply min (for [_ (range 5)] (let [t (System/nanoTime)] (g) (/ (- (System/nanoTime) t) 1000000.0)))))]\n"
                        "      (println (str " (pr-str nm) " \": interpreted \" (int (ms (fn [] (apply interp targs)))) \" ms, compiled \"\n"
                        "                    (ms (fn [] (apply comp targs))) \" ms\")))\n"))
                 "))\n")))
   "(println \"---\")\n"
   "(println (str \"compiler-check: \" @ran \" calls, \" (- @ran @fails) \" agree, \" @fails \" differ\"))\n"))

;; ---- run it ----------------------------------------------------------

(.mkdirs work)
(when-not keep? (doseq [f (.listFiles work)] (.delete f)))
(.mkdirs work)

(def soext (if (str/starts-with? (System/getProperty "os.name") "Mac") "dylib" "so"))

(spit (io/file work "gen.clj") (driver-source))
(let [out (run-clotran (io/file work "gen.clj"))
      lines (str/split-lines out)]
  (doseq [l lines :when (str/starts-with? l "DECLINED")]
    (println "declined:" (subs l 9)))
  ;; split the printed Fortran back out, one file per case
  (let [ids (atom [])]
    (loop [ls lines]
      (when-let [l (first ls)]
        (if-let [m (re-matches #"===BEGIN (\d+)" l)]
          (let [i (parse-long (second m))
                [body more] (split-with #(not= "===END" %) (rest ls))]
            (spit (io/file work (str "f" i ".f90")) (str (str/join "\n" body) "\n"))
            (swap! ids conj i)
            (recur (rest more)))
          (recur (rest ls)))))
    ;; EVERY case has to be accounted for, compiled or declined. A
    ;; generator that throws part-way used to leave the rest
    ;; silently unrun, and the check reported success over the
    ;; ones that happened to get through.
    (let [declined (count (filter #(str/starts-with? % "DECLINED") lines))
          accounted (+ declined (count @ids))]
      (when (< accounted (count all-cases))
        (println (str "GENERATOR STOPPED: " accounted " of " (count all-cases)
                      " cases compiled or declined"))
        (println (->> lines (remove #(str/starts-with? % "note:"))
                      (filter #(re-find #"error|Exception|stopped" %)) (take 5)
                      (str/join "\n")))
        (System/exit 1)))
    (when (empty? @ids)
      (println out)
      (println "nothing compiled")
      (System/exit 1))
    (doseq [i @ids
            :let [src (io/file work (str "f" i ".f90"))
                  lib (io/file work (str "libf" i "." soext))
                  ;; A compiled namespace resolves clotran_* against the
                  ;; RUNNING BINARY at dlopen time, so those symbols are
                  ;; undefined at link time on purpose. Linux allows that
                  ;; in a shared object; macOS wants to be told.
                  r (apply shell {:out :string :err :string :continue true :dir (str work)}
                           (concat ["gfortran" "-g" "-O2" "-shared" "-fPIC" "-ffree-line-length-none"]
                                   (when (= soext "dylib")
                                     ["-Wl,-undefined,dynamic_lookup"])
                                   ["-o" (str lib) (str src)]))]]
      (when-not (zero? (:exit r))
        (println "BUILD FAILED for case" i (first (nth all-cases i)))
        (println (:err r))
        (System/exit 1)))
    (spit (io/file work "run.clj") (runner-source @ids soext))
    (let [out2 (run-clotran (io/file work "run.clj"))
          body (->> (str/split-lines out2)
                    (remove #(str/starts-with? % "note:"))
                    (remove #(str/includes? % "WARNING"))
                    (str/join "\n"))]
      (println body)
      (when-not (re-find #", 0 differ" body) (System/exit 1)))))

;; ---- a whole namespace, through `clotran compile` --------------------
;;
;; The same file run twice, once with the library beside it and once
;; without, and the answers compared; then the source edited, and the
;; library must be refused rather than run against text it was not
;; built from. The pool is rebuilt at load time by analysing again
;; (clotran.loader), so this is the check that a later process gets the
;; pool the generated code was written against.
(let [dir (io/file work "ns")
      src (io/file dir "cc_space.cljf")
      lib (io/file dir (str "cc_space." soext))
      run (io/file dir "run.cljf")
      go (fn [] (->> (str/split-lines (run-clotran run))
               (remove #(or (str/starts-with? % "note: skipping") (str/includes? % "WARNING") (str/starts-with? % "user=>")))))]
  (.mkdirs dir)
  (spit src (str "(ns cc-space)\n"
                 "(def scale 3)\n"
                 "(defmacro twice [x] `(* 2 ~x))\n"
                 "(defn total [a] (let [n (alength a)] (loop [i 0 s 0.0] (if (< i n) (recur (inc i) (+ s (aget a i))) s))))\n"
                 "(defn- scaled [x] (twice (* scale x)))\n"
                 "(defn summary [a] {:total (total a) :scaled (scaled (alength a)) :kw ::k :v [1 \"two\" 3.0]})\n"
                 "(defn guarded [^long n] (try (quot 10 n) (catch ArithmeticException e :div0)))\n"
                 "(defn many [& xs] (count xs))\n"))
  (spit run (str "(load-file \"" src "\")\n"
                 "(prn [(cc-space/total (double-array [1 2 3])) (cc-space/total (long-array [1 2]))\n"
                 "      (cc-space/summary (double-array 4)) (cc-space/guarded 5) (cc-space/guarded 0) (cc-space/guarded 2.5)\n"
                 "      (cc-space/many 1 2 3) (try (cc-space/total [1]) (catch Exception e :threw))])\n"))
  (.delete lib)
  (let [interp (go)
        r (shell {:out :string :err :string :dir (str repo) :continue true :in ""} "./clotran" "compile" (str src))
        compiled (go)
        _ (spit src (str (slurp src) "(defn added [] 1)\n"))
        stale (go)]
    (println "namespace: compile says" (pr-str (str/join " / " (remove str/blank? (str/split-lines (:out r))))))
    (cond
      (not (.exists lib))
      (do (println "namespace: NO LIBRARY" (:err r)) (System/exit 1))
      (not= interp compiled)
      (do (println "namespace: DIFFER\n   interpreted:" interp "\n   compiled:   " compiled) (System/exit 1))
      (not (some #(str/includes? % "has changed since it was compiled") stale))
      (do (println "namespace: a STALE library was not refused:" stale) (System/exit 1))
      (not= (remove #(str/starts-with? % "note: not using") stale) interp)
      (do (println "namespace: refused, but the interpreted answer changed:" stale) (System/exit 1))
      :else (println "namespace: compiled and interpreted agree; a stale library is refused"))))
