#!/usr/bin/env bb
;; clojure.core as the community documents it: every example and every
;; code block in the notes on clojuredocs.org, run through `clj` and
;; through clotran, values compared -- scripts/oracle's rule, applied to
;; code nobody here wrote.
;;
;;   scripts/clojuredocs fetch        download the export, print its sha256
;;   scripts/clojuredocs extract      export -> test/clj/clojuredocs/examples.edn
;;   scripts/clojuredocs expect       run every example through clj, keep the answers
;;   scripts/clojuredocs run [var..]  run through clotran, compare, report
;;
;; The site renders its examples with JavaScript, so a page fetch has
;; none; the export (clojuredocs-export.json) has them all. The pinned
;; sha256 is below; `fetch` refuses another.
;;
;; A CASE is one example (or one note's code): its forms, read by the
;; HOST's own reader and evaluated in a namespace of their own, in
;; order. Each form answers one line -- its value through the oracle's
;; canon (maps and sets sorted: hash order is not the language), with
;; anything it printed -- or !error. A case agrees when every line does.
;;
;; Tags, so the scorecard can say what kind of code fails:
;;   :portable  the var is in the clojure.core/cljs.core intersection
;;              (scripts/derive-tests' rule) and the code names no Java
;;   :interop   the code names a Java class, a static, a method or a
;;              constructor -- counted apart, not chased
;;   :nondet    rand, shuffle, gensym, time, ... -- only whether it
;;              throws is compared
(require '[clojure.string :as str]
         '[clojure.java.io :as io]
         '[clojure.edn :as edn]
         '[cheshire.core :as json]
         '[edamame.core :as e]
         '[babashka.process :as p])

(def repo (-> *file* io/file .getCanonicalFile .getParentFile .getParentFile))
(def home (System/getProperty "user.home"))
(def export-url "https://clojuredocs.org/clojuredocs-export.json")
(def export-sha "20f8a78aa6a7c2637eaa19a89ca784c48523563199aa0b0f4cf10a1b56ae75a9")
(def cache (io/file (or (System/getenv "CLOTRAN_CACHE") (str home "/.cache/clotran")) "clojuredocs-export.json"))
(def cd-dir (io/file repo "test/clj/clojuredocs"))
(def examples-file (io/file cd-dir "examples.edn"))
(def expected-dir (io/file cd-dir "expected"))
(def work (io/file repo "build/clojuredocs"))

(defn sha256 [f]
  (let [md (java.security.MessageDigest/getInstance "SHA-256")]
    (apply str (map #(format "%02x" %) (.digest md (java.nio.file.Files/readAllBytes (.toPath f)))))))

;;; ---- fetch --------------------------------------------------------------

(defn fetch []
  (io/make-parents cache)
  (p/shell "curl" "-sSL" "-o" (str cache) export-url)
  (let [h (sha256 cache)]
    (println (str cache) h)
    (when (not= h export-sha)
      (println "NOT the pinned export (" export-sha "): update export-sha deliberately, then re-extract")
      (System/exit 1))))

;;; ---- extract ------------------------------------------------------------

(defn cljs-names
  "The public names of cljs.core, read from the pinned clone as
  scripts/derive-tests reads them."
  []
  (let [read (fn [f] (e/parse-string-all (slurp f) {:all true :read-cond :allow :features #{:clj}
                                                     :auto-resolve name
                                                     :readers (fn [_] identity)}))
        def-heads '#{def defn defmacro definline defmulti defonce defprotocol deftype defrecord
                     core/defmacro core/defn core/def}
        names (fn [forms]
                (into #{} (mapcat (fn [f]
                                    (cond (and (seq? f) (def-heads (first f)) (symbol? (second f))
                                               (not (:private (meta (second f)))))
                                          [(name (second f))]
                                          (and (seq? f) (= 'import-macros (first f)))
                                          (map name (filter symbol? (nth f 2 nil)))))
                              forms)))]
    (into (names (read (io/file home "jborden/clojurescript/src/main/cljs/cljs/core.cljs")))
          (names (read (io/file home "jborden/clojurescript/src/main/clojure/cljs/core.cljc"))))))

(defn form-end
  "The index just past the first complete form in s from i, or nil:
  brackets balanced, strings, characters and comments skipped."
  [^String s i]
  (let [n (count s)]
    (loop [i i depth 0 started false]
      (if (>= i n)
        (when (and started (zero? depth)) i)
        (let [c (.charAt s i)]
          (cond
            (and started (zero? depth) (Character/isWhitespace c)) i
            (= c \;) (let [j (or (str/index-of s "\n" i) n)]
                       (if (and started (zero? depth)) i (recur j depth started)))
            (= c \\) (recur (+ i 2) depth true)
            (= c \") (let [j (loop [j (inc i)]
                               (cond (>= j n) n
                                     (= (.charAt s j) \\) (recur (+ j 2))
                                     (= (.charAt s j) \") (inc j)
                                     :else (recur (inc j))))]
                       (if (zero? depth) j (recur j depth true)))
            (#{\( \[ \{} c) (recur (inc i) (inc depth) true)
            (#{\) \] \}} c) (if (<= depth 1) (inc i) (recur (inc i) (dec depth) true))
            (Character/isWhitespace c) (recur (inc i) depth started)
            :else (recur (inc i) depth true)))))))

;; user=> and CIDER's user> -- a NAME before it, so a bare `=> 15` line of
;; output is not taken for a prompt
(def prompt-re #"(?m)^\s*[\w.\-]+=?>\s?")

(defn code-of
  "An example's text as forms to evaluate. A REPL transcript
  (`user=> (f 1)` followed by what it printed) keeps only what was typed
  at each prompt; lines of output shown as `=> x` or `;=> x` are dropped."
  [text]
  (let [text (str/replace text "\r" "")]
    (if (re-find prompt-re text)
      (let [starts (let [m (re-matcher prompt-re text)]
                     (loop [acc []] (if (.find m) (recur (conj acc (.end m))) acc)))]
        (str/join "\n" (keep #(when-let [end (form-end text %)] (subs text % end)) starts)))
      (->> (str/split-lines text)
           (remove #(re-find #"^\s*(=>|->|;+\s*=>)" %))
           (str/join "\n")))))

(defn note-code
  "The code blocks of a note's Markdown."
  [md]
  (map second (re-seq #"(?s)```(?:clojure|clj)?\s*\n(.*?)```" (or md ""))))

(def nondet-syms
  '#{rand rand-int rand-nth shuffle random-sample random-uuid gensym time System/currentTimeMillis
     System/nanoTime Thread/sleep hash-ordinal repeatedly pmap pcalls pvalues future})

;; What asks the JVM about itself: the class of a value, its supertypes
;; and the names the compiler gives -- JVM class names are not the
;; language, and are counted apart (:host) rather than chased.
(def host-syms '#{class type bases supers ancestors munge instance? ns-imports ns-interns})

(defn tags [var-name portable-var? code]
  (let [syms (try (->> (e/parse-string-all code {:all true :read-cond :allow :features #{:clj}
                                                  :auto-resolve name :readers (fn [_] identity)})
                       (tree-seq coll? seq) (filter symbol?) set)
                  (catch Exception _ ::unreadable))]
    (if (= ::unreadable syms)
      #{:unreadable}
      (let [interop? (some (fn [s]
                             (let [n (name s) ns (namespace s)]
                               (or (and ns (Character/isUpperCase (.charAt ^String ns 0)))
                                   (and ns (str/includes? ns "."))
                                   (and (str/starts-with? n ".") (> (count n) 1) (not= n ".."))
                                   (and (str/ends-with? n ".") (> (count n) 1) (not= n ".."))
                                   (and (nil? ns) (Character/isUpperCase (.charAt n 0))))))
                           syms)
            nondet? (some nondet-syms syms)
            host? (some host-syms syms)]
        (cond-> #{}
          (str/includes? code "#?") (conj :reader-cond)
          interop? (conj :interop)
          host? (conj :host)
          nondet? (conj :nondet)
          (and portable-var? (not interop?) (not host?)) (conj :portable))))))

(defn extract []
  (when-not (.exists cache) (fetch))
  (let [d (json/parse-string (slurp cache) true)
        cljs (cljs-names)
        core (->> (:vars d) (filter #(= "clojure.core" (:ns %))) (sort-by :name))
        cases (vec (for [v core
                         [src i text] (concat (map-indexed (fn [i x] [:example i (:body x)]) (:examples v))
                                              (for [[i n] (map-indexed vector (:notes v))
                                                    [j c] (map-indexed vector (note-code (:body n)))]
                                                [:note (+ (* 100 i) j) c]))
                         :let [code (str/trim (code-of text))]
                         :when (seq code)]
                     {:var (:name v) :source src :n i :code code
                      :tags (tags (:name v) (contains? cljs (:name v)) code)}))]
    (io/make-parents examples-file)
    (spit examples-file
          (str ";; GENERATED by scripts/clojuredocs extract from " export-url "\n"
               ";; sha256 " export-sha " -- do not edit; re-extract.\n"
               (with-out-str (binding [*print-length* nil] (prn cases)))))
    (println (count core) "vars," (count cases) "cases,"
             (count (filter #(:portable (:tags %)) cases)) "portable,"
             (count (filter #(:interop (:tags %)) cases)) "interop,"
             (count (filter #(:unreadable (:tags %)) cases)) "unreadable")))

;;; ---- running ------------------------------------------------------------

(def prelude "
(ns clotran.cd (:require [clojure.string]))
(defn canon [x d]
  (let [lim (fn [xs] (let [v (vec (take 101 xs))] (if (> (count v) 100) (conj (subvec v 0 100) '...) v)))]
    (cond (> d 12) \"...\"
          (map? x) (str \"{\" (clojure.string/join \", \" (sort (map (fn [e] (str (canon (key e) (inc d)) \" \" (canon (val e) (inc d)))) (lim x)))) \"}\")
          (set? x) (str \"#{\" (clojure.string/join \" \" (sort (map #(canon % (inc d)) (lim x)))) \"}\")
          (vector? x) (str \"[\" (clojure.string/join \" \" (map #(canon % (inc d)) (lim x))) \"]\")
          (sequential? x) (str \"(\" (clojure.string/join \" \" (map #(if (= '... %) \"...\" (canon % (inc d))) (lim x))) \")\")
          (var? x) \"#var\"
          (fn? x) \"#fn\"
          :else (pr-str x))))
(defn run-case [id nondet text]
  (let [forms (try (read-string {:read-cond :allow} (str \"[\" text \"\\n]\")) (catch Throwable t ::unread))]
    (if (= ::unread forms)
      (println (str \"@@\" id \" 0 !unreadable\"))
      (doseq [[i f] (map-indexed vector forms)]
        (let [out (java.io.StringWriter.)
              r (try (binding [*out* out] (canon (eval f) 0))
                     (catch Throwable t \"!error\"))
              r (if (and nondet (not= r \"!error\")) \"ok\" r)
              printed (str out)]
          (println (str \"@@\" id \" \" i \" \" r (when (and (not nondet) (seq printed)) (str \" ;;out \" (pr-str printed))))))))))
")

(defn case-id [c] (str (:var c) "#" (name (:source c)) (:n c)))

(defn munge-var [v]
  (-> v (str/replace #"[^A-Za-z0-9_-]" (fn [m] (str "_" (int (first m)) "_")))))

(defn script-for [cases]
  (str prelude
       (str/join "\n"
                 (map-indexed
                  (fn [k c]
                    (str "(in-ns 'cd.e" k ")\n(clojure.core/refer-clojure)\n"
                         "(clojure.core/require '[clojure.string :as str] '[clojure.set :as set])\n"
                         "(clotran.cd/run-case " (pr-str (case-id c)) " " (boolean (:nondet (:tags c))) " "
                         (pr-str (:code c)) ")\n"))
                  cases))
       ;; clj does not exit while the agent pool lives: every agent example
       ;; timed out there, and went unjudged
       "\n(clojure.core/shutdown-agents)\n"))

(defn load-cases [] (edn/read-string (slurp examples-file)))

(defn parse-out [s]
  (reduce (fn [m l]
            (if-let [[_ id i r] (re-matches #"@@(\S+) (\d+) (.*)" l)]
              ;; capped: one example printed 1.7 GB into clj
              (assoc-in m [id (parse-long i)] (if (> (count r) 2000) (str (subs r 0 2000) "...[" (count r) " chars]") r))
              m))
          {} (str/split-lines s)))

;; In a scratch directory: examples spit files (foo.clj, hi.txt, ...)
(def sandbox (io/file work "sandbox"))

(defn run-file [cmd f timeout-s]
  (.mkdirs sandbox)
  (let [r (p/process (into cmd [(str f)]) {:dir sandbox :in "" :out :string :err :string})
        done (deref r (* 1000 timeout-s) ::timeout)]
    (if (= ::timeout done)
      (do (p/destroy-tree r) {:timeout true :out (str (:out @r))})
      {:out (:out done)})))

(defn pmap-n [n f xs]
  (let [pool (java.util.concurrent.Executors/newFixedThreadPool n)]
    (try (mapv deref (mapv #(.submit pool ^Callable (fn [] (f %))) xs))
         (finally (.shutdown pool)))))

(defn by-var [cases] (sort-by key (group-by :var cases)))

(defn answers-for
  "One var's cases run by `cmd`, as {:timeout :lines}. When the var runs out
  of time, every case of it runs again ALONE with its own budget: one slow
  example (printing 10^8 numbers) used to leave the rest of its var
  unanswered, counted as clotran stopping."
  [cmd v cs]
  (let [f (io/file work "cases" (str (munge-var v) ".clj"))
        _ (spit f (script-for cs))
        {:keys [out timeout]} (run-file cmd f 120)]
    (if-not timeout
      {:timeout false :lines (parse-out out)}
      {:timeout true
       :lines (apply merge
                     (for [[k c] (map-indexed vector cs)]
                       (let [g (io/file work "cases" (str (munge-var v) "--" k ".clj"))]
                         (spit g (script-for [c]))
                         (parse-out (:out (run-file cmd g 120))))))})))

(defn expect [only]
  (.mkdirs expected-dir) (.mkdirs (io/file work "cases"))
  (pmap-n 6 (fn [[v cs]]
              (spit (io/file expected-dir (str (munge-var v) ".edn"))
                    (pr-str (answers-for ["clj" "-M"] v cs)))
              (print ".") (flush))
          (cond->> (by-var (load-cases)) (seq only) (filter #(contains? only (key %)))))
  (println))

(def got-dir (io/file work "got"))

(defn run
  "Every var's cases through clotran, each var's answers saved as it
  finishes (build/clojuredocs/got), then scored."
  [only]
  (.mkdirs got-dir) (.mkdirs (io/file work "cases"))
  (let [groups (cond->> (by-var (load-cases)) (seq only) (filter #(contains? only (key %))))]
    (pmap-n (parse-long (or (System/getenv "CLOTRAN_TEST_JOBS") "6"))
            (fn [[v cs]]
              (spit (io/file got-dir (str (munge-var v) ".edn"))
                    (pr-str (answers-for [(str repo "/clotran-bin") (str repo "/src/clj/clojure/core.clj")] v cs))))
            groups)))

(defn norm
  "What is compared of an answer line: an object's identity hash and its
  host toString (`clojure.lang.MultiFn@5710768a`, `[D@53cdecf6`) are not
  the language; its class and any value it shows (an atom's) are."
  [l]
  (some-> l
          (str/replace #"(#object\[\S+) 0x[0-9a-f]+" "$1")
          (str/replace #"(#object\[\S+) \"(?:[^\"\\\\]|\\\\.)*\"\]" "$1]")))

(defn judge
  "Each case with its status: :agree, :differ, :clotran-stopped, or not
  judged (:clj-failed -- clj gave no answer)."
  []
  (for [[v cs] (by-var (load-cases))
        :let [rd (fn [d] (let [x (io/file d (str (munge-var v) ".edn"))]
                           (when (.exists x) (edn/read-string (slurp x)))))
              want (rd expected-dir) got (rd got-dir)]
        :when got
        c cs
        :let [id (case-id c)
              nm (fn [m] (when m (into (sorted-map) (map (fn [[k v]] [k (norm v)])) m)))
              w (nm (get (:lines want) id)) g (nm (get (:lines got) id))]]
    (assoc c :id id :want w :got g :timeout (:timeout got)
           :status (cond (nil? w) :clj-failed
                         (= w g) :agree
                         (nil? g) :clotran-stopped
                         :else :differ))))

(defn score []
  (let [results (judge)
        judged (remove #(= :clj-failed (:status %)) results)
        line (fn [label pred]
               (let [xs (filter pred judged) ok (count (filter #(= :agree (:status %)) xs))]
                 (println (format "  %-30s %5d / %5d  %5.1f%%" label ok (count xs)
                                  (if (seq xs) (* 100.0 (/ ok (count xs))) 0.0)))))
        bad (remove #(= :agree (:status %)) judged)]
    (with-open [w (io/writer (io/file work "REPORT.txt"))]
      (binding [*out* w]
        (doseq [c (sort-by :id bad)]
          (println "====" (:id c) (:status c) (sort (:tags c)))
          (println (:code c))
          (println "-- clj:")
          (doseq [[i l] (sort (:want c))] (println "  " i l))
          (println "-- clotran:" (when (:timeout c) "(var timed out)"))
          (doseq [[i l] (sort (:got c))] (println "  " i l)))))
    (println "clojuredocs clojure.core examples, cases that agree with clj:")
    (line "all" identity)
    (line "portable (cljs intersection)" #(and (:portable (:tags %)) (not (:reader-cond (:tags %)))))
    (line "uses #? (clotran reads :cljf)" #(:reader-cond (:tags %)))
    (line "host (asks the JVM's classes)" #(and (:host (:tags %)) (not (:interop (:tags %)))))
    (line "interop (names Java)" #(:interop (:tags %)))
    (line "other clojure-only" #(not (or (:portable (:tags %)) (:interop (:tags %)) (:host (:tags %)))))
    (println (format "  not judged: %d cases clj gave no answer for" (- (count results) (count judged))))
    (println (format "  of the failures, clotran stopped before answering: %d"
                     (count (filter #(= :clotran-stopped (:status %)) judged))))
    (println "each failure: build/clojuredocs/REPORT.txt")))

(let [[cmd & args] *command-line-args*]
  (case cmd
    "fetch" (fetch)
    "extract" (extract)
    "expect" (expect (set args))
    "run" (do (run (set args)) (score))
    "score" (score)
    (println "usage: scripts/clojuredocs fetch|extract|expect|run [var ...]")))
