#!/usr/bin/env bb
;; clojure.core as the community documents it: every example and every
;; code block in the notes on clojuredocs.org, run through `clj` and
;; through clotran, values compared -- scripts/oracle's rule, applied to
;; code nobody here wrote.
;;
;;   scripts/clojuredocs fetch        download the export, print its sha256
;;   scripts/clojuredocs extract      export -> upstream/clojuredocs/examples.edn
;;   scripts/clojuredocs expect       run every example through clj, keep the answers
;;   scripts/clojuredocs run [var..]  run through clotran, compare, report
;;   scripts/clojuredocs time [var..] the same through clj AND clotran, every case clocked
;;
;; The site renders its examples in the browser, so a page fetch has
;; none; the export (clojuredocs-export.json) has them all. The pinned
;; sha256 is below; `fetch` refuses another.
;;
;; The examples are kept as the site has them, in upstream/ with clj's
;; answers: clotran runs each one renamed (upstream/names.clj), and clj's
;; answers are read back in clotran's names.
;;
;; A CASE is one example (or one note's code): its forms, read by the
;; HOST's own reader and evaluated in a namespace of their own, in
;; order. Each form answers one line -- its value through the oracle's
;; canon (maps and sets sorted: hash order is not the language), with
;; anything it printed -- or !error. A case agrees when every line does.
;;
;; Tags, so the scorecard can say what kind of code fails:
;;   :portable  the var is in the clojure.core/cljs.core intersection
;;              (upstream/derive-tests' rule) and the code names no host class
;;   :interop   the code names a host class, a static, a method or a
;;              constructor -- counted apart, not chased
;;   :nondet    rand, shuffle, gensym, time, ... -- only whether it
;;              throws is compared
(require '[clojure.string :as str]
         '[babashka.fs :as fs]
         '[clojure.edn :as edn]
         '[cheshire.core :as json]
         '[edamame.core :as e]
         '[babashka.process :as p])

(def repo (-> *file* fs/file .getCanonicalFile .getParentFile .getParentFile))
(def home (System/getProperty "user.home"))
(def export-url "https://clojuredocs.org/clojuredocs-export.json")
(def export-sha "20f8a78aa6a7c2637eaa19a89ca784c48523563199aa0b0f4cf10a1b56ae75a9")
(def cache (fs/file (or (System/getenv "CLOTRAN_CACHE") (str home "/.cache/clotran")) "clojuredocs-export.json"))
(def cd-dir (fs/file repo "upstream/clojuredocs"))
(load-file (str (fs/file repo "upstream" "names.clj")))
(def examples-file (fs/file cd-dir "examples.edn"))
(def expected-dir (fs/file cd-dir "expected"))
(def work (fs/file repo "build/clojuredocs"))

(defn sha256 [f]
  (first (str/split (:out (p/shell {:out :string} "shasum" "-a" "256" (str f))) #"\s")))

;;; ---- fetch --------------------------------------------------------------

(defn fetch []
  (fs/create-dirs (fs/parent cache))
  (p/shell "curl" "-sSL" "-o" (str cache) export-url)
  (let [h (sha256 cache)]
    (println (str cache) h)
    (when (not= h export-sha)
      (println "NOT the pinned export (" export-sha "): update export-sha deliberately, then re-extract")
      (System/exit 1))))

;;; ---- extract ------------------------------------------------------------

(defn cljs-names
  "The public names of cljs.core, read from the pinned clone as
  upstream/derive-tests reads them."
  []
  (let [read (fn [f] (e/parse-string-all (slurp f) {:all true :read-cond :allow :features #{:clj}
                                                     :auto-resolve name
                                                     :readers (fn [_] identity)}))
        def-heads '#{def defn defmacro definline defmulti defonce defprotocol deftype defrecord
                     core/defmacro core/defn core/def}
        names (fn [forms]
                (into #{} (mapcat (fn [f]
                                    (cond (and (seq? f) (def-heads (first f)) (symbol? (second f))
                                               (not (:private (meta (second f)))))
                                          [(name (second f))]
                                          (and (seq? f) (= 'import-macros (first f)))
                                          (map name (filter symbol? (nth f 2 nil)))))
                              forms)))]
    (into (names (read (fs/file (or (System/getenv "CLOJURESCRIPT") (str home "/jborden/clojurescript")) "src/main/cljs/cljs/core.cljs")))
          (names (read (fs/file (or (System/getenv "CLOJURESCRIPT") (str home "/jborden/clojurescript")) "src/main/clojure/cljs/core.cljc"))))))

(defn form-end
  "The index just past the first complete form in s from i, or nil:
  brackets balanced, strings, characters and comments skipped."
  [^String s i]
  (let [n (count s)]
    (loop [i i depth 0 started false]
      (if (>= i n)
        (when (and started (zero? depth)) i)
        (let [c (.charAt s i)]
          (cond
            (and started (zero? depth) (Character/isWhitespace c)) i
            (= c \;) (let [j (or (str/index-of s "\n" i) n)]
                       (if (and started (zero? depth)) i (recur j depth started)))
            (= c \\) (recur (+ i 2) depth true)
            (= c \") (let [j (loop [j (inc i)]
                               (cond (>= j n) n
                                     (= (.charAt s j) \\) (recur (+ j 2))
                                     (= (.charAt s j) \") (inc j)
                                     :else (recur (inc j))))]
                       (if (zero? depth) j (recur j depth true)))
            (#{\( \[ \{} c) (recur (inc i) (inc depth) true)
            (#{\) \] \}} c) (if (<= depth 1) (inc i) (recur (inc i) (dec depth) true))
            (Character/isWhitespace c) (recur (inc i) depth started)
            :else (recur (inc i) depth true)))))))

;; user=> and CIDER's user> -- a NAME before it, so a bare `=> 15` line of
;; output is not taken for a prompt
(def prompt-re #"(?m)^\s*[\w.\-]+=?>\s?")

(defn code-of
  "An example's text as forms to evaluate. A REPL transcript
  (`user=> (f 1)` followed by what it printed) keeps only what was typed
  at each prompt; lines of output shown as `=> x` or `;=> x` are dropped."
  [text]
  (let [text (str/replace text "\r" "")]
    (if (re-find prompt-re text)
      (let [starts (let [m (re-matcher prompt-re text)]
                     (loop [acc []] (if (.find m) (recur (conj acc (.end m))) acc)))]
        (str/join "\n" (keep #(when-let [end (form-end text %)] (subs text % end)) starts)))
      (->> (str/split-lines text)
           (remove #(re-find #"^\s*(=>|->|;+\s*=>)" %))
           (str/join "\n")))))

(defn note-code
  "The code blocks of a note's Markdown."
  [md]
  (map second (re-seq #"(?s)```(?:clojure|clj)?\s*\n(.*?)```" (or md ""))))

(def nondet-syms
  '#{rand rand-int rand-nth shuffle random-sample random-uuid gensym time System/currentTimeMillis
     System/nanoTime Thread/sleep hash-ordinal repeatedly pmap pcalls pvalues future})

;; What asks the host about itself: the class of a value, its supertypes
;; and the names the compiler gives -- host class names are not the
;; language, and are counted apart (:host) rather than chased.
(def host-syms '#{class type bases supers ancestors munge instance? ns-imports ns-interns})

(defn tags [var-name portable-var? code]
  (let [syms (try (->> (e/parse-string-all code {:all true :read-cond :allow :features #{:clj}
                                                  :auto-resolve name :readers (fn [_] identity)})
                       (tree-seq coll? seq) (filter symbol?) set)
                  (catch Exception _ ::unreadable))]
    (if (= ::unreadable syms)
      #{:unreadable}
      (let [interop? (some (fn [s]
                             (let [n (name s) ns (namespace s)]
                               (or (and ns (re-find #"^[A-Z]" ns))
                                   (and ns (str/includes? ns "."))
                                   (and (str/starts-with? n ".") (> (count n) 1) (not= n ".."))
                                   (and (str/ends-with? n ".") (> (count n) 1) (not= n ".."))
                                   (and (nil? ns) (re-find #"^[A-Z]" n)))))
                           syms)
            nondet? (some nondet-syms syms)
            host? (some host-syms syms)]
        (cond-> #{}
          (str/includes? code "#?") (conj :reader-cond)
          interop? (conj :interop)
          host? (conj :host)
          nondet? (conj :nondet)
          (and portable-var? (not interop?) (not host?)) (conj :portable))))))

(defn extract []
  (when-not (.exists cache) (fetch))
  (let [d (json/parse-string (slurp cache) true)
        cljs (cljs-names)
        core (->> (:vars d) (filter #(= "clojure.core" (:ns %))) (sort-by :name))
        cases (vec (for [v core
                         [src i text] (concat (map-indexed (fn [i x] [:example i (:body x)]) (:examples v))
                                              (for [[i n] (map-indexed vector (:notes v))
                                                    [j c] (map-indexed vector (note-code (:body n)))]
                                                [:note (+ (* 100 i) j) c]))
                         :let [code (str/trim (code-of text))]
                         :when (seq code)]
                     {:var (:name v) :source src :n i :code code
                      :tags (tags (:name v) (contains? cljs (:name v)) code)}))]
    (fs/create-dirs (fs/parent examples-file))
    (spit examples-file
          (str ";; GENERATED by scripts/clojuredocs extract from " export-url "\n"
               ";; sha256 " export-sha " -- do not edit; re-extract.\n"
               (with-out-str (binding [*print-length* nil] (prn cases)))))
    (println (count core) "vars," (count cases) "cases,"
             (count (filter #(:portable (:tags %)) cases)) "portable,"
             (count (filter #(:interop (:tags %)) cases)) "interop,"
             (count (filter #(:unreadable (:tags %)) cases)) "unreadable")))

;;; ---- running ------------------------------------------------------------

(def prelude "
(ns clotran.cd (:require [clojure.string]))
(defn canon [x d]
  (let [lim (fn [xs] (let [v (vec (take 101 xs))] (if (> (count v) 100) (conj (subvec v 0 100) '...) v)))]
    (cond (> d 12) \"...\"
          (or (uuid? x) (tagged-literal? x)) (pr-str x)
          (map? x) (str \"{\" (clojure.string/join \", \" (sort (map (fn [e] (str (canon (key e) (inc d)) \" \" (canon (val e) (inc d)))) (lim x)))) \"}\")
          (set? x) (str \"#{\" (clojure.string/join \" \" (sort (map #(canon % (inc d)) (lim x)))) \"}\")
          (vector? x) (str \"[\" (clojure.string/join \" \" (map #(canon % (inc d)) (lim x))) \"]\")
          (sequential? x) (str \"(\" (clojure.string/join \" \" (map #(if (= '... %) \"...\" (canon % (inc d))) (lim x))) \")\")
          (var? x) \"#var\"
          (fn? x) \"#fn\"
          :else (pr-str x))))
(defn run-case [id nondet text]
  (let [forms (try (read-string {:read-cond :allow} (str \"[\" text \"\\n]\")) (catch clotran.host.throwable t ::unread))]
    (if (= ::unread forms)
      (println (str \"@@\" id \" 0 !unreadable\"))
      (doseq [[i f] (map-indexed vector forms)]
        (let [res (atom nil)
              printed (with-out-str (reset! res (try (canon (eval f) 0)
                                                     (catch clotran.host.throwable t \"!error\"))))
              r (if (and nondet (not= @res \"!error\")) \"ok\" @res)]
          (println (str \"@@\" id \" \" i \" \" r (when (and (not nondet) (seq printed)) (str \" ;;out \" (pr-str printed))))))))))
")

(defn case-id [c] (str (:var c) "#" (name (:source c)) (:n c)))

(defn munge-var [v]
  (-> v (str/replace #"[^A-Za-z0-9_-]" (fn [m] (str "_" (int (first m)) "_")))))

(declare timed-prelude)
(defn script-for
  "The cases as a script for one side: :clotran runs them renamed, :clj
  as the site has them, and the harness in clj's names."
  ([side cases] (script-for side cases false))
  ([side cases timed?]
  (str ((if (= side :clj) names/to-upstream identity) (str prelude (when timed? timed-prelude)))
       (str/join "\n"
                 (map-indexed
                  (fn [k c]
                    (str "(in-ns 'cd.e" k ")\n(clojure.core/refer-clojure)\n"
                         "(clojure.core/require '[clojure.string :as str] '[clojure.set :as set])\n"
                         (if timed? "(clotran.cd/timed-case " "(clotran.cd/run-case ")
                         (pr-str (case-id c)) " " (boolean (:nondet (:tags c))) " "
                         (pr-str (cond-> (:code c) (= side :clotran) names/rename-source)) ")\n"))
                  cases))
       ;; clj does not exit while the agent pool lives: every agent example
       ;; timed out there, and went unjudged
       "\n(clojure.core/shutdown-agents)\n")))

(defn load-cases [] (edn/read-string (slurp examples-file)))

(defn parse-out [s]
  (reduce (fn [m l]
            (if-let [[_ id i r] (re-matches #"@@(\S+) (\d+) (.*)" l)]
              ;; capped: one example printed 1.7 GB into clj
              (assoc-in m [id (parse-long i)] (if (> (count r) 2000) (str (subs r 0 2000) "...[" (count r) " chars]") r))
              m))
          {} (str/split-lines s)))

;; In a scratch directory: examples spit files (foo.clj, hi.txt, ...)
(def sandbox (fs/file work "sandbox"))

(defn run-file [cmd f timeout-s]
  (.mkdirs sandbox)
  (let [r (p/process (into cmd [(str f)]) {:dir sandbox :in "" :out :string :err :string})
        done (deref r (* 1000 timeout-s) ::timeout)]
    (if (= ::timeout done)
      (do (p/destroy-tree r) {:timeout true :out (str (:out @r))})
      {:out (:out done)})))

(defn pmap-n
  "f over xs, n at a time, in order: each of n futures takes the next
  item until none is left."
  [n f xs]
  (let [xs (vec xs) next-i (atom -1) out (atom {})
        work (fn [] (loop [] (let [i (swap! next-i inc)]
                               (when (< i (count xs)) (swap! out assoc i (f (xs i))) (recur)))))]
    (run! deref (doall (repeatedly n #(future (work)))))
    (mapv @out (range (count xs)))))

(defn by-var [cases] (sort-by key (group-by :var cases)))

(defn answers-for
  "One var's cases run by `cmd`, as {:timeout :lines}. When the var runs out
  of time, the cases it did not answer run again ALONE, each with the
  full budget: one slow example (printing 10^8 numbers) used to leave
  the rest of its var unanswered, counted as clotran stopping -- and
  rerunning the answered ones too cost more than the hang itself (a
  30 s budget lost a slow-but-right case; the budget stays 120)."
  [side cmd v cs]
  (let [f (fs/file work "cases" (str (munge-var v) ".clj"))
        _ (spit f (script-for side cs))
        {:keys [out timeout]} (run-file cmd f 120)
        got (parse-out out)]
    (if-not timeout
      {:timeout false :lines got}
      {:timeout true
       :lines (apply merge got
                     (for [[k c] (map-indexed vector cs)
                           :when (not (contains? got (case-id c)))]
                       (let [g (fs/file work "cases" (str (munge-var v) "--" k ".clj"))]
                         (spit g (script-for side [c]))
                         (parse-out (:out (run-file cmd g 120))))))})))

(defn expect [only]
  (.mkdirs expected-dir) (.mkdirs (fs/file work "cases"))
  (pmap-n 6 (fn [[v cs]]
              (spit (fs/file expected-dir (str (munge-var v) ".edn"))
                    (pr-str (answers-for :clj ["clj" "-Sdeps" (pr-str (clojure.edn/read-string (slurp (fs/file repo "deps.edn")))) "-M"] v cs)))
              (print ".") (flush))
          (cond->> (by-var (load-cases)) (seq only) (filter #(contains? only (key %)))))
  (println))

(def got-dir (fs/file work "got"))

(defn run
  "Every var's cases through clotran, each var's answers saved as it
  finishes (build/clojuredocs/got), then scored."
  [only]
  (.mkdirs got-dir) (.mkdirs (fs/file work "cases"))
  (let [groups (cond->> (by-var (load-cases)) (seq only) (filter #(contains? only (key %))))]
    (pmap-n (parse-long (or (System/getenv "CLOTRAN_TEST_JOBS") "6"))
            (fn [[v cs]]
              (spit (fs/file got-dir (str (munge-var v) ".edn"))
                    (pr-str (answers-for :clotran [(str repo "/clotran-bin") (str repo "/src/clj/clojure/core.clj")] v cs))))
            groups)))

;; `time`: the same scripts through clj and through clotran with a clock
;; around every case, so a slow suite can be read case by case rather
;; than guessed at: build/clojuredocs/TIMING.txt has every case's
;; microseconds on both sides, and the wall time of each var's process
;; minus its cases is what starting the process costs.
(def timed-prelude "
(in-ns 'clotran.cd)
(defn timed-case [id nondet text]
  (let [t0 (clotran.host.system/nanoTime)]
    (run-case id nondet text)
    (println (str \"@@t \" id \" \" (quot (- (clotran.host.system/nanoTime) t0) 1000)))))
")

(defn time-side [side cmd v cs]
  (let [f (fs/file work "cases" (str (munge-var v) "-timed." (name side) ".clj"))
        _ (spit f (script-for side cs true))
        t0 (System/nanoTime)
        {:keys [out timeout]} (run-file cmd f 120)
        wall (quot (- (System/nanoTime) t0) 1000)]
    {:wall wall :timeout (boolean timeout)
     :cases (into {} (for [l (str/split-lines (or out ""))
                           :let [[_ id us] (re-matches #"@@t (\S+) (\d+)" l)]
                           :when id]
                       [id (parse-long us)]))}))

(defn time-suite [only]
  (.mkdirs (fs/file work "cases"))
  (let [jobs (parse-long (or (System/getenv "CLOTRAN_TEST_JOBS") "4"))
        groups (cond->> (by-var (load-cases)) (seq only) (filter #(contains? only (key %))))
        clj-cmd ["clj" "-Sdeps" (pr-str (clojure.edn/read-string (slurp (fs/file repo "deps.edn")))) "-M"]
        ct-cmd [(str repo "/clotran-bin") (str repo "/src/clj/clojure/core.clj")]
        rows (pmap-n jobs (fn [[v cs]]
                            (let [r {:var v :ids (mapv case-id cs)
                                     :clj (time-side :clj clj-cmd v cs) :clotran (time-side :clotran ct-cmd v cs)}]
                              (print ".") (flush) r))
                     groups)
        ms (fn [us] (format "%9.1f" (/ us 1000.0)))
        sum (fn [k] (reduce + (map #(get-in % [k :wall]) rows)))
        csum (fn [k] (reduce + (map #(reduce + (vals (get-in % [k :cases]))) rows)))
        cases (for [r rows id (:ids r)
                    :let [a (get-in r [:clj :cases id]) b (get-in r [:clotran :cases id])]]
                {:id id :clj a :clotran b
                 :ratio (when (and a b (pos? a)) (/ (double b) a))})
        both (filter #(and (:clj %) (:clotran %)) cases)
        nvar (count rows)
        summary
        (with-out-str
          (println (format "%d vars, %d cases; wall time is one process per var, %d at a time" nvar (count cases) jobs))
          (println (format "  %-12s %12s %12s %12s %8s" "" "wall ms" "in cases ms" "startup ms" "timeouts"))
          (doseq [[label k] [["clj" :clj] ["clotran" :clotran]]]
            (println (format "  %-12s %12.0f %12.0f %12.0f %8d" label (/ (sum k) 1000.0) (/ (csum k) 1000.0)
                             (/ (- (sum k) (csum k)) 1000.0 (max 1 nvar))
                             (count (filter #(get-in % [k :timeout]) rows)))))
          (println (format "  cases timed on both sides: %d; clotran/clj on their sum: %.1fx"
                           (count both)
                           (/ (double (reduce + (map :clotran both))) (max 1 (reduce + (map :clj both))))))
          (println "  cases answered by clj alone (clotran hung or died in the var):"
                   (count (filter #(and (:clj %) (nil? (:clotran %))) cases)))
          (println)
          (println "slowest 30 on clotran (ms: clj, clotran, ratio):")
          (doseq [c (take 30 (sort-by :clotran > both))]
            (println (format "  %s %s %8.1fx  %s" (ms (:clj c)) (ms (:clotran c)) (:ratio c) (:id c))))
          (println)
          (println "worst 30 ratios among cases clj takes over 1 ms:")
          (doseq [c (take 30 (sort-by :ratio > (filter #(> (:clj %) 1000) both)))]
            (println (format "  %s %s %8.1fx  %s" (ms (:clj c)) (ms (:clotran c)) (:ratio c) (:id c)))))]
    (println)
    (print summary)
    (spit (fs/file work "TIMING.txt")
      (with-out-str
        (print summary)
        (println)
        (println "every var (ms: clj wall, clotran wall; T = timed out):")
        (doseq [r (sort-by #(- (get-in % [:clotran :wall])) rows)]
          (println (format "  %s %s %s %s" (ms (get-in r [:clj :wall])) (ms (get-in r [:clotran :wall]))
                           (str (when (get-in r [:clj :timeout]) "T") (when (get-in r [:clotran :timeout]) "t"))
                           (:var r))))
        (println)
        (println "every case (ms: clj, clotran, ratio; - = no time):")
        (doseq [c (sort-by #(- (or (:clotran %) ##Inf)) cases)]
          (println (format "  %s %s %s  %s"
                           (if (:clj c) (ms (:clj c)) "        -") (if (:clotran c) (ms (:clotran c)) "        -")
                           (if (:ratio c) (format "%8.1fx" (:ratio c)) "        -") (:id c))))))
    (println "every var and case: build/clojuredocs/TIMING.txt")))

(defn norm
  "What is compared of an answer line: an object's identity hash and its
  host toString (`clotran.host.multi_fn@5710768a`, `[D@53cdecf6`) are not
  the language; its class and any value it shows (an atom's) are."
  [l]
  (some-> l
          (str/replace #"(#object\[\S+) 0x[0-9a-f]+" "$1")
          (str/replace #"(#object\[\S+) \"(?:[^\"\\\\]|\\\\.)*\"\]" "$1]")
          ;; Object.toString inside a string -- (str (map inc [1 2])) is
          ;; "clotran.host.lazy_seq@1b554e1" -- carries an identity hash too
          (str/replace #"([A-Za-z][A-Za-z0-9_.$]*)@[0-9a-f]{4,8}\b" "$1@")))

(defn judge
  "Each case with its status: :agree, :differ, :clotran-stopped, or not
  judged (:clj-failed -- clj gave no answer)."
  []
  (for [[v cs] (by-var (load-cases))
        :let [rd (fn [d] (let [x (fs/file d (str (munge-var v) ".edn"))]
                           (when (.exists x) (edn/read-string (slurp x)))))
              want (rd expected-dir) got (rd got-dir)]
        :when got
        c cs
        :let [id (case-id c)
              nm (fn [m tr] (when m (into (sorted-map) (map (fn [[k v]] [k (norm (tr v))])) m)))
              ;; clj's answers in clotran's names
              w (nm (get (:lines want) id) names/from-clj) g (nm (get (:lines got) id) identity)]]
    (assoc c :id id :want w :got g :timeout (:timeout got)
           :status (cond (nil? w) :clj-failed
                         (= w g) :agree
                         (nil? g) :clotran-stopped
                         :else :differ))))

(defn score []
  (let [results (judge)
        judged (remove #(= :clj-failed (:status %)) results)
        line (fn [label pred]
               (let [xs (filter pred judged) ok (count (filter #(= :agree (:status %)) xs))]
                 (println (format "  %-30s %5d / %5d  %5.1f%%" label ok (count xs)
                                  (if (seq xs) (* 100.0 (/ ok (count xs))) 0.0)))))
        bad (remove #(= :agree (:status %)) judged)]
    (spit (fs/file work "REPORT.txt")
      (with-out-str
        (doseq [c (sort-by :id bad)]
          (println "====" (:id c) (:status c) (sort (:tags c)))
          (println (:code c))
          (println "-- clj:")
          (doseq [[i l] (sort (:want c))] (println "  " i l))
          (println "-- clotran:" (when (:timeout c) "(var timed out)"))
          (doseq [[i l] (sort (:got c))] (println "  " i l)))))
    (println "clojuredocs clojure.core examples, cases that agree with clj:")
    (line "all" identity)
    (line "portable (cljs intersection)" #(and (:portable (:tags %)) (not (:reader-cond (:tags %)))))
    (line "uses #? (clotran reads :cljf)" #(:reader-cond (:tags %)))
    (line "host (asks the host's classes)" #(and (:host (:tags %)) (not (:interop (:tags %)))))
    (line "interop (names host classes)" #(:interop (:tags %)))
    (line "other clojure-only" #(not (or (:portable (:tags %)) (:interop (:tags %)) (:host (:tags %)))))
    (println (format "  not judged: %d cases clj gave no answer for" (- (count results) (count judged))))
    (println (format "  of the failures, clotran stopped before answering: %d"
                     (count (filter #(= :clotran-stopped (:status %)) judged))))
    (println "each failure: build/clojuredocs/REPORT.txt")))

(let [[cmd & args] *command-line-args*]
  (case cmd
    "fetch" (fetch)
    "extract" (extract)
    "expect" (expect (set args))
    "run" (do (run (set args)) (score))
    "score" (score)
    "time" (time-suite (set args))
    (println "usage: scripts/clojuredocs fetch|extract|expect|run|time [var ...]")))
