#!/usr/bin/env bb
;; Fuzz the second extension of the stack machine (model/vmx2.lisp, PLAN
;; step 30): fuzz-vmx's programs -- loops, recur, closures, calls -- and
;; throw and try around any of them, calls into the runtime (a division
;; that throws on zero, a count), and calls of multi-arity and variadic
;; functions with every arity, the wrong ones included (they throw). Run
;; on vcs2-step in ACL2 against the extended meaning, mx2. The generator
;; builds only well-formed programs, each checked with x2wf.
;;
;;   scripts/fuzz-vmx2 [-n COUNT] [-s SEED] [-x] [-i] [-xi] [-xc] [--emit FILE]
;;
;; -x is the NEGATIVE CONTROL: a throw's value goes one slot above the
;; handler's local, and the run must find disagreements.
;;
;; -i also runs each program on THE ARRAYS (model/vmi.lisp, the level the
;; Fortran is generated from): encoded, run in lockstep with vcs2-step,
;; every state read back and compared, and the answer against the
;; meaning. -xi is its negative control: the arrays' unwind puts the
;; caught value one slot high.
;;
;; -i also compiles each program with THE IMPLEMENTATION-LEVEL COMPILER
;; (model/vmic.lisp), whose arrays must read back as vcs2-program. -xc
;; is its negative control: a condition's jump lands one past the else.
;;
;; Needs model/vmx2 (and for -i model/vmic) certified (make model). Exit 1
;; on any disagreement.
(require '[babashka.process :as p] '[clojure.string :as str])

(def broken (some #{"-x"} *command-line-args*))
(def broken-i (some #{"-xi"} *command-line-args*))
(def broken-c (some #{"-xc"} *command-line-args*))
(def arrays (or broken-i broken-c (some #{"-i"} *command-line-args*)))
(def args (apply hash-map (remove #{"-x" "-i" "-xi" "-xc"} *command-line-args*)))
;; --emit FILE: write the generated programs as EDN and stop (scripts/fuzz-vm-gen runs them)
(def emit (get args "--emit"))
(def n (parse-long (get args "-n" "200")))
(def seed (parse-long (get args "-s" (str (mod (System/nanoTime) 2147483647)))))
(def state (atom seed))
(defn rnd [k]
  (let [x (swap! state #(unchecked-add (unchecked-multiply % 6364136223846793005) 1442695040888963407))]
    (mod (unsigned-bit-shift-right x 33) k)))
(defn rep [k f] (doall (repeatedly k f)))

;; *x-defs* (model/vmx.lisp): name -> [arity captures]; each one's
;; argument is a small count, so the loops in them end
(def fns {'sum [1 0] 'tri [1 0] 'sumsums [1 0] 'adders [1 0] 'addc [1 1]})
;; *x2-defs*: the arities each can be called with, wrong ones included
(def fns2 {'vsum [0 1 2 3] 'f2 [0 1 2 3] 'thr [0 1 2] 'to3 [0 1]})

(declare gen)

(defn leaf [nl nc]
  (case (rnd (+ 2 (if (pos? nl) 2 0) (if (pos? nc) 1 0)))
    0 (list :const (- (rnd 11) 5))
    1 (list :const ([true :false nil 0] (rnd 4)))
    (2 3) (if (pos? nl) (list :local (rnd nl)) (list :capt (rnd nc)))
    4 (list :capt (rnd nc))))

;; a counting loop: local i from 0 below a small bound, k-1 more locals
;; each recurred with an expression of the loop's locals; the body's tail
;; is a recur, or a let or an if around one
(defn counting-loop [depth nl nc]
  (let [k (inc (rnd 3)) i nl bound (inc (rnd 5))
        inits (cons (list :const 0) (rep (dec k) #(gen (dec depth) nl nc nil)))
        nl2 (+ nl k)
        step (fn [nl3] (cons (list :add (list :local i) (list :const 1))
                             (rep (dec k) #(gen (dec depth) nl3 nc nil))))
        result (fn [nl3] (gen (dec depth) nl3 nc nil))
        body (case (rnd 3)
               0 (list :if (list :lt (list :local i) (list :const bound))
                       (cons :recur (step nl2)) (result nl2))
               ;; a let under the recur: its local is under the recur's values
               1 (list :let (gen (dec depth) nl2 nc nil)
                       (list :if (list :lt (list :local i) (list :const bound))
                             (cons :recur (step (inc nl2))) (result (inc nl2))))
               ;; the recur in the else branch
               2 (list :if (list :lt (list :const (dec bound)) (list :local i))
                       (result nl2) (cons :recur (step nl2))))]
    (list :loop inits body)))

;; _tail: unused -- a recur is generated only inside counting-loop, in its body's tail
(defn gen [depth nl nc _tail]
  (if (or (<= depth 0) (< (rnd 10) 3))
    (leaf nl nc)
    (case (rnd 10)
      0 (list :if (gen (dec depth) nl nc nil) (gen (dec depth) nl nc nil) (gen (dec depth) nl nc nil))
      1 (list :let (gen (dec depth) nl nc nil) (gen (dec depth) (inc nl) nc nil))
      2 (list :add (gen (dec depth) nl nc nil) (gen (dec depth) nl nc nil))
      3 (list :lt (gen (dec depth) nl nc nil) (gen (dec depth) nl nc nil))
      (4 5) (counting-loop depth nl nc)
      6 (let [[f [a c]] (nth (vec fns) (rnd (count fns)))]
          (list* :callv (list* :mkclo f (rep c #(gen (dec depth) nl nc nil)))
                 (rep a #(list :const (rnd 6)))))
      ;; a closure made of the locals, called
      7 (list :callv (list :mkclo 'addc (gen (dec depth) nl nc nil)) (gen (dec depth) nl nc nil))
      (8 9) (case (rnd 8)
          0 (list :throw (gen (dec depth) nl nc nil))
          1 (list :try (gen (dec depth) nl nc nil) (gen (dec depth) (inc nl) nc nil))
          2 (list :prim :div (gen (dec depth) nl nc nil) (list :const (rnd 3)))
          3 (let [[f as] (nth (vec fns2) (rnd (count fns2)))]
              (list* :callv (list :mkclo f) (rep (nth as (rnd (count as))) #(list :const (rnd 5)))))
          4 (list :try (let [[f as] (nth (vec fns2) (rnd (count fns2)))]
                         (list* :callv (list :mkclo f) (rep (nth as (rnd (count as))) #(list :const (rnd 5)))))
                  (list :local nl))
          5 (list :prim :count (list :const (rnd 3)))
          ;; a throw caught, the handler answering what it caught, the
          ;; body having pushed something else first: where the machine
          ;; puts a caught value is seen directly
          6 (list :try (list :add (list :const 7) (list :throw (gen (dec depth) nl nc nil))) (list :local nl))
          7 (list :try (list :add (list :const 1) (list :prim :div (gen (dec depth) nl nc nil) (list :const 0)))
                  (list :local nl))))))

(defn lisp [x]
  (cond (seq? x) (str "(" (str/join " " (map lisp x)) ")")
        (keyword? x) (str ":" (name x))
        (true? x) "t"
        (nil? x) "nil"
        :else (str x)))

(def exprs (vec (rep n #(gen 5 0 0 nil))))
(when emit
  (spit emit (pr-str exprs))
  (println (str "fuzz-vmx2: " n " programs, seed " seed " -> " emit))
  (System/exit 0))

(def driver
  (str (if arrays "(include-book \"vmic\")\n" "(include-book \"vmx2\")\n")
       ";; fuzz-vmx's functions, each one clause, and vmx2's\n"
       "(defun strip-to-clauses (ds) (if (atom ds) nil (cons (list (caar ds) (list (cadar ds) (caddar ds))) (strip-to-clauses (cdr ds)))))\n"
       "(defconst *xall-defs* (append (strip-to-clauses *x-defs*) *x2-defs*))\n"
       (if arrays
         (str ";; the arrays: the defs named by id, each program encoded and run in lockstep\n"
              "(defconst *xall-names* (strip-cars *xall-defs*))\n"
              "(defconst *xalli-defs* (ren-defs *xall-defs* *xall-names* 0))\n"
              ";; every step: the registers, the control stack and the stack as far as vmx2's\n"
              ";; list goes; at the end, the whole state up to trailing nils\n"
              "(defun stk-prefix-ok (i l vmi) (declare (xargs :stobjs vmi :mode :program))\n"
              "  (if (atom l) t (and (equal (vmi-sreg i vmi) (car l)) (stk-prefix-ok (1+ i) (cdr l) vmi))))\n"
              "(defun step-agrees (s vmi) (declare (xargs :stobjs vmi :mode :program))\n"
              "  (and (equal (car s) (if (equal (v-status vmi) 1) :thrown (v-pc vmi))) (equal (cadr s) (v-fb vmi))\n"
              "       (equal (caddr s) (v-sp vmi)) (equal (car (cddddr s)) (vmi-ctl (nfix (v-ctop vmi)) vmi))\n"
              "       (stk-prefix-ok 0 (cadddr s) vmi)))\n"
              "(defun lockstep-fast (n prog s vmi) (declare (xargs :stobjs vmi :mode :program))\n"
              "  (cond ((zp n) (mv (if (equal (s-norm (vmi-abs vmi)) (s-norm s)) t (list :differ-at-end)) vmi))\n"
              "        ((not (step-agrees s vmi)) (mv (list :differ-at n) vmi))\n"
              "        ((and (not (natp (car s))) (equal (v-status vmi) 1)) (lockstep-fast 0 prog s vmi))\n"
              "        ((and (natp (car s)) (eq (car (nth (car s) (car prog))) :ret) (atom (car (cddddr s))))\n"
              "         (let ((vmi (vmi-step vmi))) (lockstep-fast 0 prog (vcs2-step prog s) vmi)))\n"
              "        (t (let ((vmi (vmi-step vmi)))\n"
              "             (if (equal (v-status vmi) 2) (mv :overflow vmi) (lockstep-fast (1- n) prog (vcs2-step prog s) vmi))))))\n"
              ";; the implementation-level compiler (vmic.lisp): its arrays read back as vcs2-program\n"
              "(defun vmic-fz (e prog vmi vce) (declare (xargs :stobjs (vmi vce) :mode :program))\n"
              "  (mv-let (vmi vce) (vmic-program e *xalli-defs* 1024 256 vmi vce)\n"
              "    (mv (and (equal (ce-err vce) 0) (equal (v-status vmi) 0) (equal (vmi-prog vmi) prog)) vmi vce)))\n"
              "(defun vmic-fuzz-one (e prog) (declare (xargs :mode :program))\n"
              "  (with-local-stobj vmi (mv-let (ok vmi) (with-local-stobj vce (mv-let (ok vmi vce) (vmic-fz e prog vmi vce) (mv ok vmi))) ok)))\n"
              "(defun vmi-check-g (e vmi)\n"
              "  (declare (xargs :stobjs vmi :mode :program))\n"
              "  (let* ((e (ren-e e *xall-names*)) (prog (vcs2-program e *xalli-defs*)))\n"
              "    (if (not (enc-ok prog)) (mv :not-encodable vmi)\n"
              "      (let ((vmi (vmi-load-prog prog 1024 256 vmi)))\n"
              "        (if (not (equal (vmi-prog vmi) prog)) (mv :decodes-differently vmi)\n"
              "        (if (not (eq (vmic-fuzz-one e prog) t)) (mv :compiler vmi)\n"
              "          (mv-let (ok vmi) (lockstep-fast 400000 prog (list 0 0 0 nil nil) vmi)\n"
              "            (mv (cond ((not (eq ok t)) (if (eq ok :overflow) :overflow :lockstep))\n"
              "                      ((equal (vcs2-answer (vmi-abs vmi)) (mx2 e nil nil *xalli-defs* 1000)) t)\n"
              "                      (t :answer))\n"
              "                vmi))))))))\n"
              "(defun vmi-fuzz-one (e) (declare (xargs :mode :program)) (with-local-stobj vmi (mv-let (ok vmi) (vmi-check-g e vmi) ok)))\n")
         "")
       "(defun fuzz-one (e)\n"
       "  (declare (xargs :mode :program))\n"
       "  (let ((r (mx2 e nil nil *xall-defs* 1000)))\n"
       "    (list (x2wf e 0 nil) (if (eq (car r) :out) :out (equal (vcs2-run-program e *xall-defs* 400000) r)) (car r)\n"
       (if arrays "          (if (eq (car r) :out) :out (vmi-fuzz-one e)))))\n" "          :na)))\n")
       "(defun fuzz-all (es i)\n"
       "  (declare (xargs :mode :program))\n"
       "  (if (atom es) nil (prog2$ (cw \"FUZZ ~x0 ~x1~%\" i (fuzz-one (car es))) (fuzz-all (cdr es) (1+ i)))))\n"
       "(set-guard-checking :none)\n"
       (if broken
         "(redef!)\n(defun unwind (v ctl stk) (declare (xargs :mode :program)) (cond ((atom ctl) (list :thrown 0 1 (update-nth 0 v stk) nil)) ((eq (car (car ctl)) :h) (let ((h (nfix (cadr (car ctl)))) (hfb (nfix (caddr (car ctl)))) (hd (nfix (cadddr (car ctl))))) (list h hfb (+ hfb hd 1) (update-nth (+ hfb hd 1) v stk) (cdr ctl)))) (t (unwind v (cdr ctl) stk))))\n"
         "")
       (if broken-i
         "(redef!)\n(defun vmi-unwind (v vmi) (declare (xargs :stobjs vmi :mode :program)) (let ((j (v-hidx vmi))) (if (or (not (integerp j)) (< j 0)) (let* ((vmi (vmi-sset 0 v vmi)) (vmi (if (equal (v-status vmi) 2) vmi (update-v-status 1 vmi))) (vmi (update-v-pc 0 vmi)) (vmi (update-v-fb 0 vmi)) (vmi (update-v-sp 1 vmi)) (vmi (update-v-ctop 0 vmi))) (update-v-hidx -1 vmi)) (let* ((h (nfix (v-cai j vmi))) (hfb (nfix (v-cbi j vmi))) (hd (nfix (v-cci j vmi))) (vmi (vmi-sset (+ hfb hd 1) v vmi)) (vmi (update-v-pc h vmi)) (vmi (update-v-fb hfb vmi)) (vmi (update-v-sp (+ hfb hd 1) vmi)) (vmi (update-v-ctop j vmi))) (update-v-hidx (v-cprevi j vmi) vmi)))))\n"
         "")
       (if broken-c
         ;; the compiler's control: a condition's jump lands one past its else branch's start
         "(redef!)\n(defun vmic-put (pc op a b c k vmi) (declare (xargs :stobjs vmi :mode :program)) (let ((i (* 4 (nfix pc))) (a (if (equal op 6) (1+ a) a))) (if (and (< (+ i 3) (v-code-length vmi)) (< (nfix pc) (v-pool-length vmi))) (let* ((vmi (update-v-codei i op vmi)) (vmi (update-v-codei (+ i 1) a vmi)) (vmi (update-v-codei (+ i 2) b vmi)) (vmi (update-v-codei (+ i 3) c vmi))) (update-v-pooli (nfix pc) k vmi)) (update-v-status 2 vmi))))\n"
         "")
       "(fuzz-all '(" (str/join "\n" (map lisp exprs)) ") 0)\n"
       "(good-bye)\n"))

(def acl2 (or (System/getenv "ACL2") (str (babashka.fs/parent (babashka.fs/parent (babashka.fs/parent (babashka.fs/canonicalize *file*)))) "/acl2/saved_acl2")))
(when (System/getenv "FUZZ_DUMP") (spit (System/getenv "FUZZ_DUMP") driver))
(def out (:out (p/shell {:dir "model" :in driver :out :string :err :string} acl2)))
(def results (into {} (for [[_ i wf ok kind vi] (re-seq #"FUZZ (\d+) \((T|NIL) (T|NIL|:OUT) (\S+)\s+(\S+)\)" out)]
                        [(parse-long i) {:wf wf :ok ok :kind kind :vmi vi}])))

(when (not= n (count results))
  (println "fuzz-vmx2: ACL2 did not report every program; the tail of its output:")
  (println (subs out (max 0 (- (count out) 2000))))
  (System/exit 1))

(def not-wf (sort (keep (fn [[i r]] (when (= "NIL" (:wf r)) i)) results)))
(def disagree (sort (keep (fn [[i r]] (when (= "NIL" (:ok r)) i)) results)))
(def loops (count (filter #(str/includes? (lisp %) ":recur") exprs)))
(println (str "fuzz-vmx2: " n " programs, seed " seed ", " loops " with a loop; the meaning answered "
              (str/join ", " (for [[k c] (sort (frequencies (map :kind (vals results))))]
                               (str c " " (str/lower-case (str/replace k ":" "")))))))
(println (format "not well formed (a generator bug): %d" (count not-wf)))
(doseq [i (take 3 not-wf)] (println "   " (lisp (exprs i))))
(println (format "extended machine against the meaning: %d disagree" (count disagree)))
(doseq [i (take 3 disagree)] (println "   " (lisp (exprs i))))
(def vmi-bad (sort (keep (fn [[i r]] (when-not (#{"T" ":OUT" ":NA"} (:vmi r)) i)) results)))
(when arrays
  (println (format "the arrays against vmx2's machine, in lockstep: %d disagree%s" (count vmi-bad)
                   (if (seq vmi-bad) (str " " (frequencies (map #(:vmi (results %)) vmi-bad))) "")))
  (doseq [i (take 3 vmi-bad)] (println "   " (:vmi (results i)) (lisp (exprs i)))))
(cond
  broken-c
  (do (println (if (seq vmi-bad) "negative control: the compiler's broken jump was caught" "NEGATIVE CONTROL FAILED: the compiler's broken jump went unseen"))
      (System/exit (if (and (seq vmi-bad) (every? #(= ":COMPILER" (:vmi (results %))) vmi-bad)) 0 1)))
  broken-i
  (do (println (if (seq vmi-bad) "negative control: the arrays' broken unwind was caught" "NEGATIVE CONTROL FAILED: the arrays' broken unwind went unseen"))
      (System/exit (if (and (seq vmi-bad) (empty? not-wf) (empty? disagree)) 0 1)))
  (seq vmi-bad) (System/exit 1)
  :else nil)
(if broken
  (do (println (if (seq disagree) "negative control: the broken unwind was caught" "NEGATIVE CONTROL FAILED: a broken unwind went unseen"))
      (System/exit (if (and (seq disagree) (empty? not-wf)) 0 1)))
  (System/exit (if (or (seq disagree) (seq not-wf)) 1 0)))
