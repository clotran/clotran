#!/usr/bin/env bb
;; fuzz-deftype: deftypes with mutable and immutable fields, generated
;; (PLAN step 29; DEVIATIONS 20 resolved, PLAN step 35).
;;
;;   scripts/fuzz-deftype [-n N] [-s SEED] [-m modes] [-o cases.edn]
;;
;; Each case defines a type with one to three fields, each mutable or
;; not, and two methods -- deref, and invoke of one argument -- whose
;; bodies are random statements: a set! of a mutable field to a
;; literal, to an expression over the fields, or to the argument; a loop
;; that sets a field each turn; a let that SHADOWS a field name, inside
;; which the name is the local; a fn made in the method that reads or
;; sets a field through its captured this. The case makes an instance,
;; calls the methods in a random order, and answers every field at the
;; end with what the calls answered. One case in six also defines a type
;; whose method sets a field NOT declared mutable, inside eval, and
;; answers whether that was refused. Through clj and every mode by
;; scripts/fuzz -f: the values and the refusals must agree.
(require '[clojure.test.check.generators :as g]
         '[clojure.string :as str]
         '[babashka.fs :as fs]
         '[babashka.process :as p])
(def opts (loop [as *command-line-args* o {:n 40 :seed 1 :modes "flat,tree,compiled"}]
            (if (empty? as) o
                (case (first as)
                  "-n" (recur (drop 2 as) (assoc o :n (parse-long (second as))))
                  "-s" (recur (drop 2 as) (assoc o :seed (parse-long (second as))))
                  "-m" (recur (drop 2 as) (assoc o :modes (second as)))
                  "-o" (recur (drop 2 as) (assoc o :out (second as)))
                  (do (println "usage: scripts/fuzz-deftype [-n N] [-s SEED] [-m modes] [-o cases.edn]")
                      (System/exit 2))))))

(def field-names '[fa fb fc])

;; an expression over the fields in scope (and the argument x when in
;; invoke): small integers only, so nothing overflows or divides
(defn g-expr [fields with-x?]
  (g/one-of (concat [(g/choose -9 9)
                     (g/fmap (fn [[f k]] `(+ ~f ~k)) (g/tuple (g/elements fields) (g/choose -9 9)))
                     (g/fmap (fn [[f1 f2]] `(- ~f1 ~f2)) (g/tuple (g/elements fields) (g/elements fields)))]
                    (when with-x? [(g/fmap (fn [f] `(+ ~f ~'x)) (g/elements fields))]))))

;; one statement of a method body; `mutable` are the fields a set! may name
(defn g-stmt [fields mutable with-x?]
  (g/one-of
   (concat
    [(g/fmap (fn [f] f) (g/elements fields))
     ;; a let shadowing a field: the local inside, the field outside
     (g/fmap (fn [[f k]] `(let [~f ~k] (+ ~f 1))) (g/tuple (g/elements fields) (g/choose 0 9)))]
    (when (seq mutable)
      [(g/fmap (fn [[f e]] `(set! ~f ~e)) (g/tuple (g/elements mutable) (g-expr fields with-x?)))
       ;; a loop setting a field each turn
       (g/fmap (fn [[f n]] `(loop [i# 0] (when (< i# ~n) (set! ~f (+ ~f 1)) (recur (inc i#)))))
               (g/tuple (g/elements mutable) (g/choose 0 4)))
       ;; a fn made here reads a field through its captured this (a set!
       ;; from a closure is clj's refusal, covered below)
       (g/fmap (fn [[f k]] `((fn [] (+ ~f ~k)))) (g/tuple (g/elements mutable) (g/choose -3 3)))
       ;; a shadowing let around a set! of the FIELD by its (.-f this) name is
       ;; not generated: inside the let the bare name is the local, so a set!
       ;; of it is clj's "Invalid assignment target" on both sides -- covered
       ;; by the refusal case below instead
       ]))))

(def g-type
  (g/let [nf (g/choose 1 3)
          muts (g/vector g/boolean 3)]
    (let [fields (vec (take nf field-names))
          mutable (vec (keep (fn [[f m]] (when m f)) (map vector fields muts)))]
      (g/let [body-d (g/vector (g-stmt fields mutable false) 1 4)
              body-i (g/vector (g-stmt fields mutable true) 1 4)
              inits (g/vector (g/choose -5 5) nf)
              calls (g/vector (g/one-of [(g/return :deref) (g/fmap (fn [k] [:invoke k]) (g/choose -3 3))]) 1 6)]
        (g/return
         (let [tname (symbol (str "T" (hash [fields muts body-d body-i])))
               decl (mapv (fn [f m] (if m (with-meta f {:volatile-mutable true}) f)) fields muts)]
           `(let [~'make (fn []
                           (deftype ~tname ~decl
                             clotran.host.i_deref
                             (~'deref [~'_] ~@body-d)
                             clotran.host.i_fn
                             (~'invoke [~'this ~'x] ~@body-i))
                           (~(symbol (str "->" tname)) ~@inits))
                  ~'o (~'make)
                  ~'rs (mapv (fn [c#] (if (= c# :deref) @~'o (~'o (second c#)))) ~(vec calls))]
              ;; only an IMMUTABLE field is public in clj; a mutable one is read
              ;; through deref above
              [~'rs ~@(map (fn [f] `(~(symbol (str ".-" f)) ~'o)) (remove (set mutable) fields))])))))))

;; a set! of a field not declared mutable, or of a mutable one from a fn
;; made in the method: refused on both sides -- by clj when the type is
;; defined, by clotran when the method first runs (DEVIATIONS 20), so the
;; case defines, makes and calls inside one try
(def g-refusal
  (g/fmap (fn [[k closure?]]
            (let [tname (symbol (str "R" k (if closure? "c" "")))
                  decl (if closure? [(with-meta 'q {:volatile-mutable true})] '[q])
                  body (if closure? `((fn [] (set! ~'q ~k))) `(set! ~'q ~k))]
              `(try (deref (eval '(do (deftype ~tname ~decl clotran.host.i_deref (~'deref [~'_] ~body))
                                   (new ~tname 1))))
                    :ran
                    (catch clotran.host.exception e# :refused))))
          (g/tuple (g/choose 0 99) g/boolean)))

;; a method whose tail recurs to ITSELF, leaving out `this` as clj's recur
;; does (DEVIATIONS 19 resolved): invoke counts k down, touching a mutable
;; field or a loop on the way, and answers the fields and k at the end
(def g-recur
  (g/let [k (g/choose 0 5)
          init (g/choose -5 5)
          shape (g/elements [:plain :set :loop :reify])]
    (let [tname (symbol (str "Q" k init (name shape)))
          body (case shape
                 :plain `(if (pos? ~'k) (recur (dec ~'k)) [~'fa ~'k])
                 :set `(do (set! ~'fa (+ ~'fa 1)) (if (pos? ~'k) (recur (dec ~'k)) [~'fa ~'k]))
                 :loop `(do (loop [i# 0] (when (< i# 2) (set! ~'fa (+ ~'fa 1)) (recur (inc i#))))
                           (if (pos? ~'k) (recur (dec ~'k)) [~'fa ~'k]))
                 :reify `(if (pos? ~'k) (recur (dec ~'k)) [~'fa ~'k]))]
      (if (= shape :reify)
        `(let [~'fa ~init] ((reify clotran.host.i_fn (~'invoke [~'this ~'k] ~body)) ~k))
        `(do (deftype ~tname [~(with-meta 'fa {:volatile-mutable true})]
               clotran.host.i_fn
               (~'invoke [~'this ~'k] ~body))
             ((~(symbol (str "->" tname)) ~init) ~k))))))

;; a type defined in another namespace: its bare name is refused here until
;; imported, its full name works throughout (DEVIATIONS 17 resolved)
(def g-import
  (g/fmap (fn [[k v]]
            (let [nsn (symbol (str "fz" k)) tname (symbol (str "I" k)) full (symbol (str nsn "." tname))]
              `(do (binding [*ns* (create-ns (quote ~nsn))] (clojure.core/refer-clojure) (eval (quote (deftype ~tname [~'a]))))
                   [(try (eval (quote (.-a (new ~tname ~v)))) (catch clotran.host.throwable e# :refused))
                    (eval (quote (.-a (new ~full ~v))))
                    (do (import (quote ~full)) (eval (quote (.-a (new ~tname ~v)))))])))
          (g/tuple (g/choose 0 9999) (g/choose -9 9))))

;; a hash is the method's answer at each hash (DEVIATIONS 60 resolved): a
;; volatile field read by hashCode or hasheq, moved by invoke between
;; hashes, and a counter the method bumps; the hash of the instance, of a
;; vector holding it, and a set built after each move must agree with clj.
;; One case in four names an interface nothing knows, refused on both sides.
(def g-hash
  (g/let [k (g/choose 0 9999)
          how (g/elements [:hashCode :hasheq :unknown])
          init (g/choose -50 50)
          moves (g/vector (g/choose -50 50) 0 4)]
    ;; the counter is a Var: a deftype's method sees no enclosing local
    (let [tname (symbol (str "H" k (name how)))
          n (symbol (str "hn" k (name how)))
          method (if (= how :hasheq)
                   `(clotran.host.i_hash_eq (~'hasheq [~'_] (swap! ~n inc) ~'h))
                   `(clotran.host.value (~'hashCode [~'_] (swap! ~n inc) ~'h)))]
      (if (= how :unknown)
        `(try (eval (quote (deftype ~tname [] ~(symbol (str "no.such.I" k)) (~'x [~'_]))))
              :ran
              (catch clotran.host.throwable e# :refused))
        `(do
           (def ~n (atom 0))
           (deftype ~tname [~(with-meta 'h {:volatile-mutable true})]
             ~@method
             clotran.host.i_fn
             (~'invoke [~'_ ~'v] (set! ~'h ~'v)))
           (let [~'o (~(symbol (str "->" tname)) ~init)]
             [@~n
              (mapv (fn [v#] (when v# (~'o v#)) [(hash ~'o) (hash [~'o]) (count (hash-set ~'o ~'o))])
                    ~(vec (cons nil moves)))
              @~n]))))))

(def g-case (g/frequency [[5 g-type] [1 g-refusal] [2 g-recur] [1 g-import] [2 g-hash]]))

(let [{:keys [n seed]} opts
      forms (vec (for [i (range n)] (g/generate g-case 10 (+ seed i))))
      out (or (:out opts) (str (fs/create-temp-file {:prefix "fuzz-deftype" :suffix ".edn"})))]
  ;; *print-meta*: a field's ^:volatile-mutable is metadata on its symbol,
  ;; and pr-str drops metadata unless told to keep it (as fuzz-fn does for hints)
  (spit out (str "[" (str/join "\n" (map #(binding [*print-meta* true] (pr-str %)) forms)) "]"))
  (println (str "fuzz-deftype: " n " cases -> " out))
  (let [r (p/shell {:continue true} (str (fs/parent *file*) "/fuzz") "-f" out "-m" (:modes opts) "--timeout" "300")]
    (System/exit (:exit r))))
