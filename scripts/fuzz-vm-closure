#!/usr/bin/env bb
;; Fuzz the closure call (model/vm-closure.lisp, PLAN step 30): random
;; programs in its language -- closures made over captured values,
;; called through a register, nested, passed to other functions,
;; recursive through a capture of themselves, and called wrongly (the
;; wrong arity, what is not a closure) -- compiled and run on the
;; machine in ACL2 against the meaning, mc. The oracle is the model's
;; own meaning; the generator builds only well-formed programs (a local
;; or a capture names one that exists), so a disagreement is a bug in
;; the machine, the compiler or here.
;;
;;   scripts/fuzz-vm-closure [-n COUNT] [-s SEED] [-k | -w | -j | -d | -r]
;;
;; Each program runs four ways: the register machine, the one-stack
;; machine, the one-stack machine with every slot at or above its top
;; wiped after every step (vcs-run-wiping) -- the rooting check: a
;; machine that kept a live value above its top would answer otherwise
;; -- and the stack machine's bytecode through the baseline JIT
;; (model/jit.lisp) on the machine-code model, and through the stage-2
;; JIT (model/jit2.lisp), its code addressed by the depth it inferred and
;; checked; the run counts how many programs pass the depth check -- and
;; through stage 2b (model/jit3.lisp), the frame's first slots in machine
;; registers by a lazy allocator.
;;
;; -k is the NEGATIVE CONTROL: the machine's closure captures each value
;; one register late, and the run must find disagreements, or the
;; fuzzer could not see a broken machine. -w is the rooting's: the wipe
;; takes the top slot too, a value still live, and the wiped runs must
;; disagree. -j is the JIT's: :add's block reads its second operand from
;; the first's slot, and only the JIT's runs must disagree. -d is stage 2's:
;; the depth-addressed :add reads its second operand one slot low, and only
;; the stage-2 runs must disagree. -r is stage 2b's: the allocator takes a
;; slot only in memory for one already in its register, so never loads it,
;; and only the stage-2b runs must disagree.
;;
;; Needs the books certified (make model). Exit 1 on any disagreement.

(require '[clojure.string :as str]
         '[babashka.process :as p])

(def broken (some #{"-k"} *command-line-args*))
(def broken-wipe (some #{"-w"} *command-line-args*))
(def broken-jit (some #{"-j"} *command-line-args*))
(def broken-jit2 (some #{"-d"} *command-line-args*))
(def broken-jit3 (some #{"-r"} *command-line-args*))
(def args (apply hash-map (remove #{"-k" "-w" "-j" "-d" "-r"} *command-line-args*)))
(def n (parse-long (get args "-n" "200")))
(def seed (parse-long (get args "-s" (str (mod (System/nanoTime) 2147483647)))))
;; a seeded generator of our own (Knuth's MMIX LCG), so a seed repeats
(def state (atom seed))
(defn rnd [k]
  (let [x (swap! state #(unchecked-add (unchecked-multiply % 6364136223846793005) 1442695040888963407))]
    (mod (unsigned-bit-shift-right x 33) k)))

;; the functions of *jit3-defs* (model/jit3.lisp: *clo-defs* and two) the generator calls: arity and how many values each one's body
;; reads as captures. down recurses on its argument, so it is called on
;; a small constant only.
;; two reads its capture twice: stage 2b once took a capture in the
;; closure's own register, a live cached slot (model/jit3.lisp)
(def fns {'inc1 [1 0] 'adder [1 1] 'apply1 [2 0] 'mk [2 0] 'two [1 1]})

(declare gen)
;; eager: a lazy seq of lazy seqs overflowed the stack when printed
(defn rep [k f] (doall (repeatedly k f)))
(defn closure [depth nl nc & [arity]]
  (let [cands (vec (if arity (filter #(= arity (first (val %))) fns) fns))
        [f [_ k]] (nth cands (rnd (count cands)))]
    (list* :mkclo f (rep k #(gen (dec depth) nl nc)))))

(defn gen [depth nl nc]
  (if (or (<= depth 0) (< (rnd 10) 3))
    (case (rnd (+ 2 (if (pos? nl) 1 0) (if (pos? nc) 1 0)))
      0 (list :const (- (rnd 21) 10))
      1 (list :const ([true :false nil 0] (rnd 4)))
      2 (if (pos? nl) (list :local (rnd nl)) (list :capt (rnd nc)))
      3 (list :capt (rnd nc)))
    (case (min 7 (rnd 9))
      0 (list :if (gen (dec depth) nl nc) (gen (dec depth) nl nc) (gen (dec depth) nl nc))
      1 (list :let (gen (dec depth) nl nc) (gen (dec depth) (inc nl) nc))
      2 (list :add (gen (dec depth) nl nc) (gen (dec depth) nl nc))
      3 (list :lt (gen (dec depth) nl nc) (gen (dec depth) nl nc))
      ;; a call of a fresh closure, its arity right, or now and then not
      4 (let [[f [a k]] (nth (vec fns) (rnd (count fns)))
              a (if (zero? (rnd 12)) (inc a) a)]
          (list* :callv (list* :mkclo f (rep k #(gen (dec depth) nl nc)))
                 (if (= f 'apply1)
                   (cons (closure (dec depth) nl nc 1) (rep (dec a) #(gen (dec depth) nl nc)))
                   (rep a #(gen (dec depth) nl nc)))))
      ;; a closure kept in a local and called twice
      5 (list :let (closure (dec depth) nl nc)
              (list :add (list :callv (list :local nl) (gen (dec depth) (inc nl) nc))
                    (list :callv (list :local nl) (gen (dec depth) (inc nl) nc))))
      ;; recursion through a closure of itself
      6 (list :callv '(:mkclo down) (list :const (rnd 8)))
      ;; what is not a closure, called, now and then; else another
      ;; fresh closure's call
      7 (if (zero? (rnd 4))
          (list :callv (gen (dec depth) nl nc) (gen (dec depth) nl nc))
          (list :callv (closure (dec depth) nl nc 1) (gen (dec depth) nl nc))))))

(defn lisp [x]
  (cond (seq? x) (str "(" (str/join " " (map lisp x)) ")")
        (keyword? x) (str ":" (name x))
        (true? x) "t"
        (nil? x) "nil"
        :else (str x)))

(def exprs (vec (rep n #(gen 5 0 0))))

(def driver
  (str "(include-book \"jit3\")\n"
       ";; the machine code run to its halt: jit-run-program runs every step it is given\n"
       "(defun jrun (np ns n)\n"
       "  (declare (xargs :mode :program))\n"
       "  (if (zp n) ns\n"
       "    (let ((ins (and (natp (car ns)) (nth (car ns) (car np)))))\n"
       "      (cond ((or (not (natp (car ns))) (atom ins) (eq (car ins) :stuck)) ns)\n"
       "            ((< 10000 (max (nfix (cadr ns)) (nfix (caddr ns)))) ns) ; deeper than fuel 1000 lets any run go (stage 2 keeps no SP: its frame base grows)\n"
       "            ((and (eq (car ins) :ret) (atom (car (cddddr ns)))) (nstep np ns))\n"
       "            (t (jrun np (nstep np ns) (1- n)))))))\n"
       "(defun fuzz-one (e)\n"
       "  (declare (xargs :mode :program))\n"
       "  (let ((r (mc e nil nil *jit3-defs* 1000)))\n"
       "    (if (eq (car r) :out) :out\n"
       "      (list (equal (vc-run-program e *jit3-defs* 400000) r) (equal (vcs-run-program e *jit3-defs* 400000) r)\n"
       "            (equal (vcs-run-program-wiping e *jit3-defs* 400000) r)\n"
       "            (equal (vcs-answer (nview (jrun (jit (vcs-program e *jit3-defs*)) (list 0 0 0 nil nil nil) 2000000))) r)\n"
       "            (equal (vcs-answer (nview (jrun (jit2 (vcs-program e *jit3-defs*)) (list 0 0 0 nil nil nil) 2000000))) r)\n"
       "            (equal (vcs-answer (nview (jrun (jit3 (vcs-program e *jit3-defs*)) (list 0 0 0 nil nil (make-list 10)) 2000000))) r)))))\n"
       "(defun fuzz-all (es i)\n"
       "  (declare (xargs :mode :program))\n"
       "  (if (atom es) nil\n"
       "    (prog2$ (cw \"FUZZ ~x0 ~x1 ~x2~%DCHECK ~x0 ~x3~%\" i (fuzz-one (car es)) (car (mc (car es) nil nil *jit3-defs* 1000))\n"
       "                (let ((p (vcs-program (car es) *jit3-defs*))) (dcheck p (dinfer p))))\n"
       "            (fuzz-all (cdr es) (1+ i)))))\n"
       "(set-guard-checking :none)\n"
       (if broken
         "(redef!)\n(defun regs-from (fb a k regs) (declare (xargs :mode :program)) (if (zp k) nil (cons (reg fb (1+ (nfix a)) regs) (regs-from fb (1+ (nfix a)) (1- k) regs))))\n(defun stk-from (a k stk) (declare (xargs :mode :program)) (if (zp k) nil (cons (sreg (1+ (nfix a)) stk) (stk-from (1+ (nfix a)) (1- k) stk))))\n"
         "")
       (if broken-jit3
         "(redef!)\n(defun rdl (j s st) (declare (xargs :mode :program)) (let ((j (nfix j))) (cond ((>= j (sk)) (mv (list (list :ldr s :fb j)) s st)) (t (mv nil j (st-set j :b st))))))\n"
         "")
       (if broken-jit2
         "(redef!)\n(defun jblock2 (ins d tgt) (declare (xargs :mode :program)) (case (car ins) (:push (list (list :movi 0 (cadr ins)) (list :str 0 :fb d))) (:load (list (list :ldr 0 :fb (nfix (cadr ins))) (list :str 0 :fb d))) (:add (list (list :ldr 0 :fb (- d 2)) (list :ldr 1 :fb (- d 2)) (list :add 0 0 1) (list :str 0 :fb (- d 2)))) (:lt (list (list :ldr 0 :fb (- d 2)) (list :ldr 1 :fb (- d 1)) (list :lt 0 0 1) (list :str 0 :fb (- d 2)))) (:slide (list (list :ldr 0 :fb (- d 1)) (list :str 0 :fb (- d 2)))) (:jmpf (list (list :ldr 0 :fb (- d 1)) (list :cbf 0 tgt))) (:jmp (list (list :b tgt))) (:mkclo (list (list :mkclod (cadr ins) (nfix (caddr ins)) d))) (:capt (list (list :ldr 0 :fb (nfix (cadr ins))) (list :capt 0 (nfix (caddr ins))) (list :str 0 :fb d))) (:callv (list (list :calld (nfix (cadr ins)) d))) (:ret (list (list :retd d))) (otherwise (list (list :stuck)))))\n"
         "")
       (if broken-jit
         "(redef!)\n(defun jblock (ins tgt) (declare (xargs :mode :program)) (case (car ins) (:push (list (list :movi 0 (cadr ins)) (list :str 0 :sp 0) (list :addsp 1))) (:load (list (list :ldr 0 :fb (nfix (cadr ins))) (list :str 0 :sp 0) (list :addsp 1))) (:add (list (list :ldr 0 :sp -2) (list :ldr 1 :sp -2) (list :add 0 0 1) (list :str 0 :sp -2) (list :addsp -1))) (:lt (list (list :ldr 0 :sp -2) (list :ldr 1 :sp -1) (list :lt 0 0 1) (list :str 0 :sp -2) (list :addsp -1))) (:slide (list (list :ldr 0 :sp -1) (list :str 0 :sp -2) (list :addsp -1))) (:jmpf (list (list :ldr 0 :sp -1) (list :addsp -1) (list :cbf 0 tgt))) (:jmp (list (list :b tgt))) (:mkclo (list (list :mkclo (cadr ins) (nfix (caddr ins))))) (:capt (list (list :ldr 0 :fb (nfix (cadr ins))) (list :capt 0 (nfix (caddr ins))) (list :str 0 :sp 0) (list :addsp 1))) (:callv (list (list :call (nfix (cadr ins))))) (:ret (list (list :ret))) (otherwise (list (list :stuck)))))\n"
         "")
       (if broken-wipe
         "(redef!)\n(defun wstep (prog s) (declare (xargs :mode :program)) (let ((s2 (vcs-step prog s))) (list (car s2) (cadr s2) (caddr s2) (swipe (1- (nfix (caddr s2))) (cadddr s2)) (car (cddddr s2)))))\n"
         "")
       "(fuzz-all '(" (str/join "\n" (map lisp exprs)) ") 0)\n"
       "(good-bye)\n"))

(def acl2 (or (System/getenv "ACL2") (str (babashka.fs/parent (babashka.fs/parent (babashka.fs/parent (babashka.fs/canonicalize *file*)))) "/acl2/saved_acl2")))
(def out (:out (p/shell {:dir "model" :in driver :out :string :err :string} acl2)))
(def results (into {} (for [[_ i r k] (re-seq #"FUZZ (\d+) (:OUT|\([^)]*\)) (\S+)" out)] [(parse-long i) [r k]])))

;; each program's verdicts: the register machine's, the stack machine's, the wiped stack machine's
(def kinds-of ["register" "stack" "wiped" "jit" "jit2" "jit3"])
(def failures (for [[i [r _]] results :when (not= r ":OUT")
                    [k v] (map vector kinds-of (re-seq #"T|NIL" r)) :when (= v "NIL")] [k i]))
(def fails (distinct (map second failures)))
(def kinds (frequencies (map (comp second val) results)))
(println (str "fuzz-vm-closure: " n " programs, seed " seed ", " (count results) " run; the meaning answered "
              (str/join ", " (for [[k c] (sort kinds)] (str c " " (str/lower-case (str/replace k ":" ""))))) ))
(let [checks (map second (re-seq #"DCHECK \d+ (\S+)" out))]
  (println (format "the depth check passed on %d of %d programs (the rest ran stage 1's code)"
                   (count (filter #{"T"} checks)) (count checks))))
(when (not= n (count results))
  (println "  ACL2 did not report every program; the tail of its output:")
  (println (subs out (max 0 (- (count out) 2000))))
  (System/exit 1))
(doseq [k kinds-of]
  (let [fs (map second (filter #(= k (first %)) failures))]
    (println (format "%-9s machine against the meaning: %d disagree" k (count fs)))
    (doseq [i (take 3 fs)] (println "   " (lisp (exprs i))))))
(cond
  broken
  (do (println (if (seq fails) "negative control: the broken machine was caught" "NEGATIVE CONTROL FAILED: a broken machine went unseen"))
      (System/exit (if (seq fails) 0 1)))
  broken-wipe
  (let [caught (some #(= "wiped" (first %)) failures)
        others (remove #(= "wiped" (first %)) failures)]
    (println (if (and caught (empty? others))
               "negative control: the wipe of a live slot was caught, by the wiped runs alone"
               "NEGATIVE CONTROL FAILED: the wipe of a live slot went unseen, or was seen where it does not run"))
    (System/exit (if (and caught (empty? others)) 0 1)))
  broken-jit3
  (let [caught (some #(= "jit3" (first %)) failures)
        others (remove #(= "jit3" (first %)) failures)]
    (println (if (and caught (empty? others))
               "negative control: the broken allocator was caught, by the stage-2b runs alone"
               "NEGATIVE CONTROL FAILED: the broken allocator went unseen, or was seen where it does not run"))
    (System/exit (if (and caught (empty? others)) 0 1)))
  broken-jit2
  (let [caught (some #(= "jit2" (first %)) failures)
        others (remove #(= "jit2" (first %)) failures)]
    (println (if (and caught (empty? others))
               "negative control: the broken stage-2 block was caught, by the stage-2 runs alone"
               "NEGATIVE CONTROL FAILED: the broken stage-2 block went unseen, or was seen where it does not run"))
    (System/exit (if (and caught (empty? others)) 0 1)))
  broken-jit
  (let [caught (some #(= "jit" (first %)) failures)
        others (remove #(= "jit" (first %)) failures)]
    (println (if (and caught (empty? others))
               "negative control: the broken JIT block was caught, by the JIT's runs alone"
               "NEGATIVE CONTROL FAILED: the broken JIT block went unseen, or was seen where it does not run"))
    (System/exit (if (and caught (empty? others)) 0 1)))
  :else (System/exit (if (seq fails) 1 0)))
