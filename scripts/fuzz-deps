#!/usr/bin/env bb
;; fuzz-deps: the package manager, clotran-deps, on generated projects
;; (PLAN step 29).
;;
;;   scripts/fuzz-deps [-n N] [-s SEED]
;;
;; Each case builds a project and a random acyclic graph of libraries
;; under a scratch directory: :local/root and pinned :git/url + :git/sha
;; coordinates (git repositories made here, over file://), a library
;; reached at two places -- a conflict, which the project sometimes
;; settles by naming it -- the provided Clojure jar, a refused Maven jar,
;; and an alias with an extra path. A MODEL of the documented rules
;; (PACKAGES.md: breadth first, the project's own :deps win, a conflict
;; nobody settled is an error naming the library, any other jar refused)
;; says what clotran-deps must answer -- the path, or the error -- and
;; then clotran, run on that path, must load every library's namespace
;; from the place chosen: each answers its own directory's name.
;;
;; MALFORMED deps.edn: fixed shapes tools.deps refuses -- not a map, :deps
;; not a map, a coordinate that is not one, a root that is not there,
;; :paths not a vector of strings, text after the map -- and a valid file
;; with characters mutated, beside one real library. clj decides
;; (`clj -Srepro -Spath`): clotran-deps must refuse what it refuses, with
;; status 1 and its reason, and answer the same directories for the rest.
;;
;; At most one kind of error per case, so which one comes first is not a
;; question. HOME is a scratch directory, as clotran-deps' own test sets
;; it, so the real git cache is not touched. Needs the clotran-deps checkout beside this one
;; (or CLOTRAN_DEPS); without it, says so and passes.
(require '[clojure.test.check.generators :as g]
         '[clojure.string :as str]
         '[babashka.fs :as fs]
         '[babashka.process :as p])

(def opts (loop [as *command-line-args* o {:n 20 :seed 1}]
            (if (empty? as) o
                (case (first as)
                  "-n" (recur (drop 2 as) (assoc o :n (parse-long (second as))))
                  "-s" (recur (drop 2 as) (assoc o :seed (parse-long (second as))))
                  (do (println "usage: scripts/fuzz-deps [-n N] [-s SEED]") (System/exit 2))))))

(def repo (str (fs/parent (fs/parent (fs/absolutize *file*)))))
(def deps-home (or (System/getenv "CLOTRAN_DEPS") (str (babashka.fs/parent (babashka.fs/parent (babashka.fs/parent (babashka.fs/canonicalize *file*)))) "/clotran-deps")))
(def deps-bin (str deps-home "/bin/clotran-deps"))

(when-not (fs/exists? deps-bin)
  (println "fuzz-deps: no clotran-deps at" deps-home "-- skipped")
  (System/exit 0))

(def problems (atom []))
(def kinds (atom {}))   ; what the cases expected, so a run says what it covered
(defn problem [& xs] (let [m (str/join " " xs)] (swap! problems conj m) (println m)))

;; ---- the generated case ---------------------------------------------------
;;
;; libs: [{:name "f/l3" :copies 1|2 :git? bool :deps [i ...] :paths [...]}]
;; deps point only at higher indices: acyclic. The project depends on a
;; few. :error is :none, :conflict or :mvn.

(def g-case
  (g/let [k (g/choose 2 7)
          edges (g/vector (g/vector g/boolean 7) 7)
          roots (g/fmap distinct (g/vector (g/choose 0 6) 1 3))
          gits (g/vector (g/frequency [[3 (g/return false)] [1 (g/return true)]]) 7)
          extra (g/vector g/boolean 7)
          error (g/frequency [[3 (g/return :none)] [2 (g/return :conflict)] [1 (g/return :mvn)]])
          settle g/boolean
          clj? g/boolean
          alias? g/boolean
          pick (g/choose 0 6)]
    (g/return {:k k :edges edges :roots (vec (filter #(< % k) roots)) :gits gits :extra extra
               :error error :settle settle :clj? clj? :alias? alias? :pick pick})))

(defn lib-name [i] (str "f/l" i))
(defn ns-of [i copy] (str "fzd" i))

;; write the case out; answer {:project dir :expect {:path [...] | :error re} :loads {ns dir-name}}
(defn build! [dir {:keys [k edges roots gits extra error settle clj? alias? pick]}]
  (let [;; a conflict: the last library, reached at two copies -- library
        ;; 0 names its own, library 1 names the second, "c-b" -- and the
        ;; project names both parents
        k (if (= error :conflict) (max k 3) k)
        conflict (when (= error :conflict) (dec k))
        deps-of (fn [i] (vec (for [j (range (inc i) k)
                                   :when (if conflict
                                           (cond (= j conflict) (= i 0)
                                                 :else (get-in edges [i j]))
                                           (get-in edges [i j]))]
                               j)))
        roots (cond-> (if (seq roots) roots [0]) conflict (into [0 1]))
        roots (vec (distinct roots))
        lib-dir (fn [i copy] (str dir "/lib" i (when (= copy :b) "-b")))
        git-sha (atom {})
        coord (fn [i copy]
                (if (and (get gits i) (not= copy :b))
                  {:git/url (str "file://" (lib-dir i :a)) :git/sha (get @git-sha i)}
                  {:local/root (lib-dir i copy)}))
        ;; which copy of c each parent names: the project's roots and the
        ;; first parent of c take :a, a second route takes :b
        b-parent (when conflict 1)
        deps-of* (fn [i] (cond-> (mapv (fn [j] [j :a]) (deps-of i))
                           (and conflict (= i b-parent)) (conj [conflict :b])))]
    ;; the libraries, highest first so a git sha exists before it is named
    (doseq [i (reverse (range k)) copy (if (= i conflict) [:a :b] [:a])]
      (let [d (lib-dir i copy)
            nsn (ns-of i copy)]
        (fs/create-dirs (str d "/src/" nsn))
        (spit (str d "/src/" nsn "/core.cljf")
              (str "(ns " nsn ".core)\n(defn where [] " (pr-str (fs/file-name d)) ")\n"))
        (when (get extra i) (fs/create-dirs (str d "/res")))
        (spit (str d "/deps.edn")
              (pr-str (cond-> {:deps (into (array-map) (for [[j c] (deps-of* i)] [(symbol (lib-name j)) (coord j c)]))}
                        (get extra i) (assoc :paths ["src" "res"]))))
        (when (and (get gits i) (= copy :a))
          (p/shell {:dir d :out :string :err :string} "git" "init" "-q")
          (p/shell {:dir d :out :string :err :string} "git" "add" "-A")
          (p/shell {:dir d :out :string :err :string} "git" "-c" "user.name=t" "-c" "user.email=t@t" "commit" "-q" "-m" "one")
          (swap! git-sha assoc i (str/trim (:out (p/shell {:dir d :out :string} "git" "rev-parse" "HEAD")))))))
    ;; the project
    (let [pd (str dir "/project")
          settled? (and conflict settle)
          proj-deps (cond-> (into (array-map) (for [r roots] [(symbol (lib-name r)) (coord r :a)]))
                      settled? (assoc (symbol (lib-name conflict)) (coord conflict :b))
                      clj? (assoc 'org.clojure/clojure {:mvn/version "1.12.6"})
                      (= error :mvn) (assoc 'cheshire/cheshire {:mvn/version "5.12.0"}))
          ;; a conflict must be reachable from the project at both copies:
          ;; the project names both parents
          proj-deps (if conflict
                      (cond-> proj-deps
                        b-parent (assoc (symbol (lib-name b-parent)) (coord b-parent :a)))
                      proj-deps)]
      (fs/create-dirs (str pd "/src/fzmain"))
      (when alias? (fs/create-dirs (str pd "/dev")))
      (spit (str pd "/deps.edn")
            (pr-str (cond-> {:deps proj-deps}
                      alias? (assoc :aliases {:dev {:extra-paths ["dev"]}}))))
      ;; THE MODEL: breadth first; the project's own :deps chosen first
      (let [proj-named (set (keys proj-deps))
            dir-of (fn [lib c] (if-let [sha (:git/sha c)]
                                 (str (fs/home) "/.cache/clotran/gitlibs/" lib "/" sha)
                                 (str (fs/canonicalize (:local/root c)))))
            result
            (loop [q (vec (for [[l c] proj-deps] [l c "project"])) chosen [] where {} err nil]
              (if (or err (empty? q))
                {:chosen chosen :where where :err err}
                (let [[[l c by] & more] q
                      lib (str l)]
                  (cond
                    (contains? #{"org.clojure/clojure"} lib) (recur (vec more) chosen where err)
                    (:mvn/version c) (recur [] chosen where :mvn)
                    (contains? where lib)
                    (if (and (not= (:dir (where lib)) (dir-of lib c)) (not (proj-named l)))
                      (recur [] chosen where :conflict)
                      (recur (vec more) chosen where err))
                    :else
                    (let [i (parse-long (subs lib 3))
                          copy (if (= (dir-of lib c) (dir-of lib (coord i :b))) :b :a)
                          d (dir-of lib c)
                          sub (for [[j cc] (deps-of* i)] [(symbol (lib-name j)) (coord j cc) lib])]
                      (recur (into (vec more) sub) (conj chosen lib)
                             (assoc where lib {:dir d :i i :copy copy :extra (get extra i)}) err))))))
            expect (if-let [e (:err result)]
                     {:error e}
                     {:path (vec (concat [(str (fs/canonicalize pd) "/src")]
                                         (when alias? [(str (fs/canonicalize pd) "/dev")])
                                         (mapcat (fn [lib] (let [{:keys [dir extra]} ((:where result) lib)]
                                                             (cond-> [(str dir "/src")] extra (conj (str dir "/res")))))
                                                 (:chosen result))))})]
        (spit (str pd "/src/fzmain/core.cljf")
              (str "(ns fzmain.core (:require "
                   (str/join " " (for [lib (:chosen result)] (str "[" (ns-of (:i ((:where result) lib)) nil) ".core]")))
                   "))\n"
                   (str/join "\n" (for [lib (:chosen result) :let [{:keys [i]} ((:where result) lib)]]
                                    (str "(println \"WHERE " i "\" (fzd" i ".core/where))")))
                   "\n"))
        {:project pd :alias? alias? :expect expect
         :loads (into {} (for [lib (:chosen result) :let [{:keys [i copy]} ((:where result) lib)]]
                           [i (str "lib" i (when (= copy :b) "-b"))]))}))))

;; ---- running a case -----------------------------------------------------------

(defn run [cmd env secs]
  (let [proc (apply p/process {:out :string :err :string :extra-env env :in ""} cmd)
        r (deref proc (* 1000 secs) ::timeout)]
    (if (= r ::timeout) (do (p/destroy-tree proc) {:timeout true}) r)))

;; ---- malformed deps.edn ---------------------------------------------------------
;;
;; A project beside one real local library, its deps.edn either a shape
;; tools.deps refuses -- not a map, :deps not a map, a coordinate not a
;; map or with a :local/root that is not a string or not there, :paths
;; not a vector of strings, a git coordinate with no sha, not EDN at all,
;; a key twice -- or a VALID one with characters mutated. clj is the
;; oracle (`clj -Srepro -Spath`: "Error building classpath" is a refusal),
;; and clotran-deps must agree: refuse, with status 1 and its reason
;; ("clotran-deps: ..."), or answer the same source directories. Never a
;; crash, another status, or a hang. The fixed shapes run every time.

(def valid-deps "{:deps {fz/lib {:local/root \"../lib\"}} :paths [\"src\"] :aliases {:dev {:extra-paths [\"dev\"]}}}")

(def shapes
  ["{:deps []}" "{:deps {fz/lib 1}}" "{:deps {fz/lib {}}}" "{:deps {fz/lib {:local/root 5}}}"
   "{:deps {fz/lib {:local/root \"../nowhere\"}}}" "{:paths \"src\"}" "{:paths [1]}" "{:aliases {:dev 5}}"
   "{:deps {fz/lib {:git/url \"x\"}}}" "[1 2]" "" "   " "{:deps {fz/lib {:local/root \"../lib\"}}" "{:deps nil}"
   "{:a 1 :a 2}" "nil" "{:deps {fz/lib {:local/root \"../lib\"}} :paths [\"src\" \"src\"]}" "{\"deps\" {}}"])

(def edn-alphabet (vec "{}[]()\"\\#:;/. 0123456789abs-_\n"))

(def g-malformed
  (g/one-of [(g/elements shapes)
             (g/let [ms (g/vector (g/tuple (g/elements [:delete :insert :swap :cut])
                                           (g/choose 0 500) (g/elements edn-alphabet)) 1 3)]
               (g/return (reduce (fn [s [k i c]]
                                   (let [n (count s) i (if (pos? n) (mod i n) 0)]
                                     (case k
                                       :delete (if (pos? n) (str (subs s 0 i) (subs s (inc i))) s)
                                       :insert (str (subs s 0 i) c (subs s i))
                                       :swap (if (> n 1) (let [i (min i (- n 2))] (str (subs s 0 i) (subs s (inc i) (+ i 2)) (subs s i (inc i)) (subs s (+ i 2)))) s)
                                       :cut (subs s 0 i))))
                                 valid-deps ms)))]))

(defn dirs-of
  "The directories of a path, canonical, a relative one taken from base
  (clj prints the project's own paths relative); jars and what is not
  there dropped."
  [path base]
  (set (for [e (str/split (str/trim path) (re-pattern fs/path-separator)) :when (seq e)
             :let [a (if (fs/absolute? e) e (str base "/" e))] :when (fs/directory? a)]
         (str (fs/canonicalize a)))))

(defn malformed-case [top home c text]
  (let [dir (str top "/bad" c) pd (str dir "/project") ld (str dir "/lib")]
    (fs/create-dirs (str pd "/src")) (fs/create-dirs (str pd "/dev")) (fs/create-dirs (str ld "/src"))
    (spit (str ld "/deps.edn") "{:paths [\"src\"]}")
    (spit (str pd "/deps.edn") text)
    (let [cj (let [proc (p/process {:dir pd :out :string :err :string :in ""} "clj" "-Srepro" "-Spath" "-Sforce")
                   r (deref proc 120000 ::timeout)]
               (if (= r ::timeout) (do (p/destroy-tree proc) nil) r))
          cd (run ["sh" deps-bin pd] {"HOME" home "CLOTRAN" repo} 300)
          clj-refuses (or (nil? cj) (not= 0 (:exit cj)) (str/includes? (str (:err cj)) "Error building classpath"))
          ours-refuses (= 1 (:exit cd))
          msg (str/trim (str (:err cd)))]
      (swap! kinds update (if clj-refuses :malformed-refused :malformed-accepted) (fnil inc 0))
      (cond
        (nil? cj) (println "  (clj did not answer for" (pr-str text) "-- not compared)")
        (:timeout cd) (problem "TIMEOUT malformed" c (pr-str text))
        (not (#{0 1} (:exit cd))) (problem "malformed" c (pr-str text) ": clotran-deps exited" (:exit cd) msg)
        (not= clj-refuses ours-refuses)
        (problem "malformed" c (pr-str text) ": clj" (if clj-refuses "refuses" "accepts") "it, clotran-deps"
                 (if ours-refuses (str "refuses: " msg) (str "answers " (str/trim (:out cd)))))
        ours-refuses
        (when-not (str/starts-with? msg "clotran-deps:")
          (problem "malformed" c (pr-str text) ": refused without its reason:" (pr-str msg)))
        :else
        (let [want (dirs-of (:out cj) pd) got (dirs-of (:out cd) pd)]
          (when (not= want got)
            (problem "malformed" c (pr-str text) ": path\n   clj:  " (pr-str (sort want)) "\n   ours: " (pr-str (sort got)))))))))

(let [{:keys [n seed]} opts
      top (str (fs/create-temp-dir {:prefix "fuzz-deps"}))
      home (str top "/home")]
  (fs/create-dirs home)
  (doseq [c (range n)]
    (let [dir (str top "/case" c)
          cs (g/generate g-case 10 (+ seed c))
          _ (fs/create-dirs dir)
          {:keys [project alias? expect loads]} (with-redefs [fs/home (constantly home)] (build! dir cs))
          _ (swap! kinds update (or (:error expect) (if (some #(str/includes? % ".cache/clotran/gitlibs") (:path expect)) :path-with-git :path)) (fnil inc 0))
          r (run (cond-> ["sh" deps-bin] alias? (conj "-A:dev") true (conj project)) {"HOME" home "CLOTRAN" repo} 300)]
      (cond
        (:timeout r) (problem "TIMEOUT case" c ": clotran-deps did not answer in 300 s")
        (:error expect)
        (let [msg (str/trim (:err r))
              ok (and (= 1 (:exit r))
                      (case (:error expect)
                        :conflict (str/includes? msg "is wanted at two places")
                        :mvn (str/includes? msg "is a Maven jar")))]
          (when-not ok (problem "case" c ": wanted a" (name (:error expect)) "error; got exit" (:exit r) (pr-str msg) "path" (str/trim (:out r)))))
        (not= 0 (:exit r)) (problem "case" c ": clotran-deps failed:" (str/trim (:err r)))
        :else
        (let [got (vec (map #(str (fs/canonicalize %)) (str/split (str/trim (:out r)) (re-pattern fs/path-separator))))
              want (mapv #(str (fs/canonicalize %)) (:path expect))]
          (if (not= (set got) (set want))
            (problem "case" c ": path\n   want:" (pr-str want) "\n   got: " (pr-str got))
            ;; and clotran loads each library from where it was chosen
            (let [l (run [(str repo "/clotran-bin") (str repo "/src/clj/clojure/core.clj") (str project "/src/fzmain/core.cljf")]
                         {"CLOTRAN_PATH" (str/join ":" got) "HOME" home} 120)
                  seen (into {} (for [[_ i w] (re-seq #"WHERE (\d+) \"?([^\"\n]+)\"?" (:out l))] [(parse-long i) w]))]
              (when (not= seen loads)
                (problem "case" c ": loaded" (pr-str seen) "want" (pr-str loads) (str/trim (str (:out l) (:err l))))))))))
    (print ".") (flush))
  (println)
  (doseq [[c text] (map-indexed vector (concat shapes (for [i (range n)] (g/generate g-malformed 10 (+ seed 104729 i)))))]
    (malformed-case top home c text)
    (print "!") (flush))
  (println)
  ;; git leaves its objects read-only, which Windows will not delete
  (doseq [x (fs/glob top "**" {:hidden true})] (.setWritable (fs/file x) true))
  (fs/delete-tree top)
  (println (str "fuzz-deps: " n " projects and " (+ (count shapes) n) " malformed deps.edn " (pr-str @kinds) ", " (count @problems) " problems"))
  (System/exit (if (empty? @problems) 0 1)))
