#!/usr/bin/env bb
;; fuzz-vmtr-gen: the GENERATED VM translation (src/f/gen/vm_tr_gen.inc,
;; written by scripts/acl2-fortran -b vmtrg from model/vmtrg.lisp) against
;; exec-vmtr's ex-tr, the translation ex-vm-agree proves.
;;
;;   scripts/fuzz-vmtr-gen [-n COUNT] [-s SEED] [-x] [--fc gfortran|flang]
;;
;; Random trees of the generated kinds -- a constant, a local (marked for
;; clearing or not, in scope or not), if (two children or three), do (none,
;; one, several: each value but the last a dead local), let* (its
;; slots new or shadowing, too few children), loop (its inits reading the
;; slots before them or not: ex-lind's two shapes), recur, throw, case* (its
;; table's walk, entry j's test 50 + j), letfn (its fns' templates (0 0
;; (o 0 ..)), each outer slot the group's or not: ex-trlf's lets), try (its
;; catch walk, catch j's class 60 + j and slot s2 + j, a finally or none:
;; ex-trh, ex-trfin), a collection (a vector, map, set, new or dot: kinds
;; 7 8 9 22 21, (:prim op args..), op ex-cop), a fn ((:mkclo tm caps..),
;; its template (0 0 (o 0 ..))), a lazy seq ((:prim (:host 15 tm) (:mkclo
;; tm caps..))), a builtin's
;; call (:prim f args..), its head a constant fz-prim calls a builtin or a
;; Var (direct-linked or not) whose fn fz-prim says wraps one, or a constant
;; or Var fz-prim says is an IFn (:callv head args..), else (a local's or any
;; other expression's head, a non-IFn's) ex-trcall's -- with a Var and a
;; kind ex-tr does not know among them (vtg_other's), under a scope of
;; slots and blanks, np parameters and m captures (vtb-cs). ACL2 prints
;; ex-tr :m of the tree in the scope, its captures read in place (ex-cs);
;; test/vmtrg/vmtr_check runs the generated vtg_tr through shims that are
;; vmtrg.lisp's exactly (vtg_blank blanking ex-clr's slots, vtg_restore
;; the saved scope) and prints what it built; they must agree.
;;
;; Then the loop's test, vtg_tlr, against ex-tlr :m: trees with recur,
;; loop and letfn besides (kinds 16, 12, 13), the generated answer t or nil.
;; Then a fn's clause, vtg_clause, against ex-clause (vmtrcl.lisp): random
;; arities (fixed or variadic), captures and self slot, bodies with recur
;; and loop, the scope ex-fbcm -- which the generated vtg_scope must make
;; from none (vtg-scope-fbcm) -- and the arity clause, vtg_arcl, against ex-arcl.
;;
;; -x is the NEGATIVE CONTROL: the Fortran side takes a node's items in the
;; wrong order, and the answers must part (the translation's, the clauses').
(require '[babashka.process :as p] '[clojure.string :as str] '[babashka.fs :as fs])

(def broken (some #{"-x"} *command-line-args*))
(def args (apply hash-map (remove #{"-x"} *command-line-args*)))
(def n (parse-long (get args "-n" "300")))
(def seed (parse-long (get args "-s" (str (mod (System/nanoTime) 2147483647)))))
(def fc (get args "--fc" "gfortran"))
(def work (str (fs/create-temp-dir {:prefix "fuzz-vmtr-gen"})))

;; the house LCG: every case reproduces from its seed
(def rng (atom seed))
(defn rnd [k]
  (let [x (swap! rng #(unchecked-add (unchecked-multiply % 6364136223846793005) 1442695040888963407))]
    (mod (bit-shift-right x 33) (max k 1))))
(defn pick [xs] (nth xs (rnd (count xs))))

;; a node {:k :i2 :s2 :c :mark :kids}; c nil or a small number
(defn node [k & {:keys [i2 s2 c mark kids thens outs] :or {i2 0 s2 0 c nil mark 0 kids [] thens [] outs []}}]
  {:k k :i2 i2 :s2 s2 :c c :mark mark :kids kids :thens thens :outs outs})
;; a letfn's fn: its template (0 0 (o_0 0 o_1 1 ..)), the outer slots o_q
(defn fnode [& [k]] (let [outs (vec (repeatedly (rnd 4) #(rnd 10)))]
                 (node (or k 14) :i2 (count outs) :outs outs
                       :c (str "(0 0 " (if (seq outs) (str "(" (str/join " " (mapcat (fn [o q] [o q]) outs (range))) ")") "nil") ")"))))
(def tlr-kinds (atom []))
(defn gen [d]
  (let [k (if (zero? d) (pick (into [1 2 2 3] (when (seq @tlr-kinds) [16 16]))) (pick (into [1 2 2 3 4 4 4 5 5 5 6 6 11 11 11 12 12 12 13 13 16 16 17 17 18 18 19 19 7 8 9 21 22 14 14 15 15 99] @tlr-kinds)))
        sub #(gen (dec d))]
    (case k
      1 (node 1 :c (pick [nil 0 1 7 42]))
      3 (node 3 :c (pick [nil 5 9]))
      2 (node 2 :i2 (rnd 10) :mark (pick [0 0 1]))
      4 (node 4 :kids (vec (repeatedly (pick [2 3 3 1]) sub)))
      16 (node 16 :kids (vec (repeatedly (rnd 3) #(gen (max 0 (dec d))))))
      13 (let [nb (pick [1 1 2 3])]
           (node 13 :i2 nb :s2 (pick [2 4 6 8]) :kids (conj (vec (repeatedly nb fnode)) (sub))))
      (11 12) (let [nb (pick [0 1 1 2 3])]
           (node k :i2 nb :s2 (pick [2 4 6 8]) :kids (vec (repeatedly (+ nb (pick [1 1 1 1 0])) sub))))
      5 (node 5 :kids (vec (repeatedly (pick [0 1 2 2 3 4]) sub)))
      ;; a call whose head is read at translation (fz-prim below): a constant
      ;; 100..199, a builtin; a Var of 200..299, direct-linked (i2 1) or not,
      ;; its fn wrapping one; a constant or Var of 300 or more, an IFn; any
      ;; other head (ex-trcall): a constant or Var no IFn, a local, a subtree
      6 (node 6 :kids (vec (cons (pick [(node 1 :c (pick [100 101])) (node 3 :i2 (pick [0 1]) :c (pick [200 201]))
                                        (node 1 :c (pick [300 301])) (node 3 :i2 (pick [0 1]) :c (pick [300 301]))
                                        (node 1 :c (pick [nil 7])) (node 3 :c (pick [nil 5])) (node 2 :i2 (rnd 10) :mark (pick [0 0 1])) (sub)])
                                 (repeatedly (rnd 4) sub))))
      17 (node 17 :kids [(sub)])
      ;; a fn: (:mkclo tm caps..), its outer slots read in the template's order
      14 (fnode)
      ;; a lazy seq: (:prim (:host 15 tm) (:mkclo tm caps..))
      15 (fnode 15)
      ;; a collection: its kids the parts, c the host op's constant
      (7 8 9 21 22) (node k :c (pick [nil 3]) :kids (vec (repeatedly (rnd 4) sub)))
      ;; a case*: its test and default, entries' thens (entry j's test 50 + j)
      19 (node 19 :kids [(sub) (sub)] :thens (vec (repeatedly (rnd 4) sub)))
      ;; a try: its body, a finally or none, catches' bodies (c their count)
      18 (let [nc (pick [0 1 1 2 3])]
           (node 18 :s2 (pick [2 4 6 8]) :c nc :kids (vec (repeatedly (pick [1 2 2]) sub)) :thens (vec (repeatedly nc sub))))
      99 (node 99 :kids [(sub)]))))
(defn gen-case [] {:t (gen (pick [1 2 3 3 4 5])) :cm (vec (repeatedly (rnd 6) #(pick [0 1 2 3 4 5 nil]))) :np (rnd 3) :m (rnd 3)})
(def cases (vec (repeatedly n gen-case)))
(reset! tlr-kinds [16 16 16 12 13 18 19])
(def tcases (vec (repeatedly n #(gen (pick [1 2 3 3 4 5])))))
;; a fn's clause: an arity (nf, variadic, its parameters' first slot) whose
;; body is a tree with recur and loop (vtg_tlr's two ways), m captures, a
;; self slot or none, sl 1 or 0 (no self let); the scope the host makes,
;; ex-fbcm, at sl 0 ex-fbcm0 (no self position)
(reset! tlr-kinds [16 16 16 12 18 19])
(defn gen-clause []
  (let [nf (rnd 3) var (pick [false false true]) start (pick [0 1 2 3]) np (+ nf (if var 1 0)) m (rnd 3)
        inners (vec (take m (drop (rnd 3) [5 6 7 8 9]))) self (pick [4 4 nil]) sl (pick [1 0])]
    {:t (gen (pick [1 2 3 3 4])) :nf nf :var var :start start :np np :m m :sl sl
     :cm (vec (concat (range start (+ start np)) inners (if (= sl 1) [self] [])))
     :tm (str "(777 nil " (if (seq inners) (str "(" (str/join " " (mapcat (fn [i] [100 i]) inners)) ")") "nil") " nil " (if self self "nil") ")")}))
(def ccases (vec (repeatedly n gen-clause)))
(def anames [nil 0 1 7 42])

(defn acl2-tree [{:keys [k i2 s2 c mark kids thens]}]
  (str "(" k " " i2 " (" (str/join " " (map acl2-tree kids)) ") "
       (case k
         19 (str "(" (str/join " " (map-indexed (fn [j t] (str "(" (+ 50 j) " " (acl2-tree t) ")")) thens)) ")")
         18 (str "(" (str/join " " (map-indexed (fn [j t] (str "(" (+ 60 j) " " (+ s2 j) " " (acl2-tree t) ")")) thens)) ")")
         (if (nil? c) "nil" c))
       " " s2 " " (if (= mark 1) "t" "nil") ")"))
(defn acl2-cm [cm] (str "(" (str/join " " (map #(if (nil? %) "nil" %) cm)) ")"))

;; the Fortran's case: nodes numbered depth first, the root 1
(defn flat [t]
  (let [out (atom [])]
    (letfn [(walk [{:keys [k i2 s2 c mark kids thens outs]}]
              (let [me (count @out)
                    kids (into kids thens)]
                (swap! out conj nil)
                (if (#{14 15} k)
                  ;; a letfn's fn: its outer slots its row's kids
                  (swap! out assoc me (str/join " " (concat [k i2 s2 -1 mark (count outs)] outs)))
                  (let [ids (mapv walk kids)]
                    (swap! out assoc me (str/join " " (concat [k i2 s2 (if (nil? c) -1 c) mark (count kids)] ids)))))
                (inc me)))]
      (walk t))
    @out))
(defn ftn-case [{:keys [t cm np m]}]
  (let [rows (flat t)]
    (str (str/join " " (concat [(count rows) np m (count cm)] (map #(if (nil? %) -1 %) cm))) "\n" (str/join "\n" rows) "\n")))

;; ---- what ACL2 answers -------------------------------------------------------------------

(def driver
  (str "(include-book \"vmtrcl\")\n(set-print-case :downcase state)\n(set-iprint nil)\n"
       ;; the runtime's builtin test: a constant of 100..199; a fn v of
       ;; 200..299 wraps the builtin 1000 + v + n at n arguments; a value of
       ;; 300 or more is an IFn (vmtr_check's vtg_pk)
       "(defun fz-prim (op vals) (declare (xargs :guard t)) (cond ((and (eq op :clotran.vm/builtin) (consp vals) (integerp (car vals)) (<= 100 (car vals)) (< (car vals) 200)) t) ((eq op :clotran.vm/wraps) (and (consp vals) (consp (cdr vals)) (integerp (car vals)) (<= 200 (car vals)) (< (car vals) 300) (integerp (cadr vals)) (+ 1000 (car vals) (cadr vals)))) ((and (eq op :ifn) (consp vals) (integerp (car vals)) (<= 300 (car vals))) t) (t (prim-impl op vals))))\n(defattach prim fz-prim)\n"
       (str/join (map-indexed (fn [j c] (str "(cw \"~%CASE " j " ~f0 END~%\" (ex-cs nil (ex-tr :m '" (acl2-tree (:t c)) " 0 '" (acl2-cm (:cm c)) ") " (:np c) " " (:m c) "))\n")) cases))
       (str/join (map-indexed (fn [j t] (str "(cw \"~%TLR " j " ~x0 END~%\" (ex-tlr :m '" (acl2-tree t) " 0))\n")) tcases))
       (str/join (map-indexed (fn [j c] (str "(cw \"~%CL " j " ~f0 END~%\" (ex-clause" (if (= (:sl c) 1) "" "0") " '" (:tm c) " '(" (:nf c) " " (if (:var c) "t" "nil") " " (:start c) " " (acl2-tree (:t c)) ")))\n")) ccases))
       (str/join (map-indexed (fn [j a] (str "(cw \"~%AR " j " ~f0 END~%\" (ex-arcl '" (if (nil? a) "nil" a) "))\n")) anames))
       "(good-bye)\n"))
(def acl2 (let [a (or (System/getenv "ACL2") (str (fs/parent (fs/parent (fs/parent (fs/canonicalize *file*)))) "/acl2/saved_acl2"))]
            (if (fs/exists? a) a (str (fs/home) "/clotran/acl2/saved_acl2"))))
(def norm #(-> % (str/replace #"\s+" " ") (str/replace "( " "(") (str/replace " )" ")") str/trim))
(def out (:out (p/shell {:dir "model" :in driver :out :string :err :string} acl2)))
(def expected (into {} (for [[_ c l] (re-seq #"CASE (\d+) (.*?) END" (norm out))] [(parse-long c) l])))
(def texpected (into {} (for [[_ c l] (re-seq #"TLR (\d+) (.*?) END" (norm out))] [(parse-long c) l])))
(def cexpected (into {} (for [[_ c l] (re-seq #"CL (\d+) (.*?) END" (norm out))]
                          [(parse-long c) (str/replace l (norm (:tm (nth ccases (parse-long c)))) "tm")])))
(def aexpected (into {} (for [[_ c l] (re-seq #"AR (\d+) (.*?) END" (norm out))] [(parse-long c) l])))
(when (or (not= (count expected) n) (not= (count texpected) n) (not= (count cexpected) n) (not= (count aexpected) (count anames)))
  (println (str "fuzz-vmtr-gen: ACL2 answered " (count expected) " of " n " cases; its output ends:"))
  (println (subs out (max 0 (- (count out) 3000))))
  (System/exit 1))

;; ---- the generated code ------------------------------------------------------------------

(let [r (p/shell {:continue true :out :string :err :string :extra-env (if (System/getenv "ACL2") {} {"ACL2" acl2})}
                 "scripts/acl2-fortran" "-b" "vmtrg" "-o" (str work "/vm_tr_gen.inc"))]
  (when-not (zero? (:exit r)) (println (:out r) (:err r)) (System/exit 1)))
(fs/copy "test/vmtrg/vmtr_check.f90" (str work "/vmtr_check.f90"))
(def exe (str work "/vmtr_check"))
(let [r (apply p/shell {:continue true :out :string :err :string :dir work} fc
               (concat ["-O2"] (when (= fc "gfortran") ["-frecursive" "-ffree-line-length-none"]) ["-o" exe "vmtr_check.f90"]))]
  (when-not (zero? (:exit r)) (println (:err r) (:out r)) (System/exit 1)))

(def case-file (str work "/cases.txt"))
(spit case-file (str/join (map ftn-case cases)))
(def got (let [r (apply p/shell {:continue true :out :string :err :string} exe case-file (when broken ["broken"]))]
           (mapv norm (str/split-lines (str/trim (:out r))))))
(def results (vec (for [k (range n)] {:k k :got (get got k) :want (expected k) :ok (= (get got k) (expected k))})))
(def tcase-file (str work "/tcases.txt"))
(spit tcase-file (str/join (map #(ftn-case {:t % :cm [] :np 0 :m 0}) tcases)))
(def tgot (let [r (p/shell {:continue true :out :string :err :string} exe tcase-file "tlr")] (mapv norm (str/split-lines (str/trim (:out r))))))
(def tbad (vec (for [k (range n) :when (not= (get tgot k) (texpected k))] k)))
(def bad (remove :ok results))
(def ccase-file (str work "/ccases.txt"))
(spit ccase-file (str/join (for [c ccases]
                             (let [[h & rows] (str/split-lines (ftn-case c))]
                               (str h "\n" (:nf c) " " (if (:var c) 1 0) " " (:start c) " " (:sl c) "\n" (str/join "\n" rows) "\n")))))
(def cgot (let [r (apply p/shell {:continue true :out :string :err :string} exe ccase-file "clause" (when broken ["broken"]))] (mapv norm (str/split-lines (str/trim (:out r))))))
(def cbad (vec (for [k (range n) :when (not= (get cgot k) (cexpected k))] k)))
(def acase-file (str work "/acases.txt"))
(spit acase-file (str/join (map #(ftn-case {:t (node 1 :c %) :cm [] :np 0 :m 0}) anames)))
(def agot (let [r (apply p/shell {:continue true :out :string :err :string} exe acase-file "arcl" (when broken ["broken"]))] (mapv norm (str/split-lines (str/trim (:out r))))))
(def abad (vec (for [k (range (count anames)) :when (not= (get agot k) (aexpected k))] k)))
(defn kinds [t] (cons (:k t) (mapcat kinds (:kids t))))
(println (str n " cases, seed " seed (when broken " (negative control: a node's items reversed)")))
(println (str "  nodes by kind: " (str/join ", " (for [[k c] (sort (frequencies (mapcat (comp kinds :t) cases)))] (str k ":" c)))
              "; marked reads " (count (re-seq #" t\)" (str/join (map (comp acl2-tree :t) cases))))))
(println (str "generated VM translation against ACL2's ex-tr: " (count bad) " cases differ"))
(doseq [b (take 3 bad)]
  (println "  case" (:k b) (acl2-tree (:t (nth cases (:k b)))) (acl2-cm (:cm (nth cases (:k b)))) "np" (:np (nth cases (:k b))) "m" (:m (nth cases (:k b))))
  (println "    ACL2     " (:want b))
  (println "    generated" (:got b)))
(println (str "generated loop test vtg_tlr against ACL2's ex-tlr: " (count tbad) " of " n " differ (" (count (filter #{"t"} (vals texpected))) " recur to the fn)"))
(doseq [k (take 3 tbad)] (println "  case" k (acl2-tree (nth tcases k)) "ACL2" (texpected k) "generated" (get tgot k)))
(println (str "generated clause vtg_clause against ACL2's ex-clause: " (count cbad) " of " n " differ ("
              (count (filter #(str/includes? % "(:loop") (vals cexpected))) " with a loop, "
              (count (filter :var ccases)) " variadic, " (count (filter #(zero? (:sl %)) ccases)) " at sl 0)"))
(doseq [k (take 3 cbad)] (println "  case" k (acl2-tree (:t (nth ccases k))) (dissoc (nth ccases k) :t)) (println "    ACL2     " (cexpected k)) (println "    generated" (get cgot k)))
(println (str "generated arity clause vtg_arcl against ACL2's ex-arcl: " (count abad) " of " (count anames) " differ"))
(doseq [k (take 3 abad)] (println "  name" (nth anames k) "ACL2" (aexpected k) "generated" (get agot k)))
(System/exit (if (or (seq tbad) (if broken (or (empty? bad) (empty? cbad) (empty? abad)) (or (seq bad) (seq cbad) (seq abad)))) 1 0))
