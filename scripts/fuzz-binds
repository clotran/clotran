#!/usr/bin/env bb
;; fuzz-binds: the analyzer's locals (model/anlocal.lisp, generated into
;; src/f/gen/anlocal_gen.inc) against clj.
;;
;;   scripts/fuzz-binds [-n N] [-s SEED]
;;
;; Two kinds of form, half each:
;;   refusal   a let*, loop*, letfn*, fn* or catch with a binding form
;;             drawn at random -- symbols, &, qualified names, keywords,
;;             numbers, vectors, maps, lists, odd counts, no vector, 21
;;             parameters, two methods of one arity or two variadic ones,
;;             a fixed arity above the variadic one, a recur of the wrong
;;             count. Each is evaluated; the answer is :accepted, or the
;;             refusal's class and message.
;;   value     nested let*, loop*, letfn*, fn* (called) and catch, binding
;;             and shadowing a, b and c and closing over them, sometimes
;;             naming one no form binds. The answer is the value, or the
;;             refusal ("Unable to resolve symbol").
;; clj and clotran evaluate every form and must agree, case for case. Not
;; drawn: the forms clj answers with its host's ClassCastException text
;; ((fn* 1 []), a method that is not a list).
(require '[clojure.test.check.generators :as g]
         '[clojure.string :as str]
         '[babashka.fs :as fs]
         '[babashka.process :as p]
         '[clojure.edn])

(def opts (loop [as *command-line-args* o {:n 300 :seed 1}]
            (if (empty? as) o
                (case (first as)
                  "-n" (recur (drop 2 as) (assoc o :n (parse-long (second as))))
                  "-s" (recur (drop 2 as) (assoc o :seed (parse-long (second as))))
                  (do (println "usage: scripts/fuzz-binds [-n N] [-s SEED]") (System/exit 2))))))

(def repo (str (fs/parent (fs/parent (fs/absolutize *file*)))))
(load-file (str repo "/upstream/names.clj"))

;; ---- refusals ---------------------------------------------------------------------------

(def g-bname (g/frequency [[12 (g/elements ["a" "b" "c"])] [2 (g/return "&")] [2 (g/return "a/b")]
                           [1 (g/elements ["1" ":k" "nil" "\"s\"" "[a]" "{:k a}" "(quote a)" "x/y/z"])]]))
(def g-pname (g/frequency [[12 (g/elements ["a" "b" "c" "d"])] [4 (g/return "&")] [2 (g/return "a/b")]
                           [1 (g/elements ["1" ":k" "[a]" "{:keys [a]}" "nil"])]]))
(defn vec-of [g n] (g/fmap #(str "[" (str/join " " %) "]") (g/vector g 0 n)))
(def g-pvec (g/frequency [[20 (vec-of g-pname 4)]
                          [1 (g/fmap (fn [k] (str "[" (str/join " " (map #(str "p" %) (range k))) "]")) (g/elements [20 21 22]))]]))
;; a binding vector, each init `init` (letfn*'s must be fns: clj's host refuses others)
(defn g-bvec [init]
  (g/frequency [[10 (g/fmap (fn [ns] (str "[" (str/join " " (mapcat (fn [n] [n init]) ns)) "]")) (g/vector g-bname 0 3))]
                [3 (g/fmap (fn [ns] (str "[" (str/join " " (concat (mapcat (fn [n] [n init]) ns) ["a"])) "]")) (g/vector g-bname 0 2))]
                [1 (g/elements ["x" "(a 1)" "nil" "{a 1}" "1"])]]))
(def g-refusal
  (g/one-of
   [(g/fmap (fn [[op bv]] (str "(" op " " bv " 1)")) (g/tuple (g/elements ["let*" "loop*"]) (g-bvec "1")))
    (g/fmap (fn [ns] (str "(letfn* [" (str/join " " (mapcat (fn [n] [n "(fn* [] 1)"]) ns)) "] 1)")) (g/vector g-bname 0 3))
    (g/fmap (fn [bv] (str "(letfn* " bv " 1)")) (g-bvec "(fn* [] 1)"))
    (g/fmap (fn [[nm pv]] (str "(fn* " nm pv " 1)")) (g/tuple (g/elements ["" "" "f " "a/b "]) g-pvec))
    (g/fmap (fn [[nm pvs]] (str "(fn* " nm (str/join " " (map #(str "(" % " 1)") pvs)) ")"))
            (g/tuple (g/elements ["" "f "]) (g/vector g-pvec 1 3)))
    (g/fmap (fn [n] (str "(try 1 (catch clotran.host.exception " n " 2))")) g-bname)
    (g/fmap (fn [[k m]] (str "(loop* [a 1 b 2] (if (< a 3) (recur " (str/join " " (repeat k "(inc a)")) ") " m "))"))
            (g/tuple (g/elements [0 1 2 2 2 3]) (g/elements ["a" "b"])))]))

;; ---- values -----------------------------------------------------------------------------

(def g-ref (g/frequency [[20 (g/elements ["a" "b" "c"])] [1 (g/return "d")] [4 (g/elements ["1" "2" "3"])]]))
(def g-local (g/elements ["a" "b" "c"]))
(def g-value
  (g/recursive-gen
   (fn [inner]
     (g/one-of
      [(g/fmap (fn [[x y]] (str "(+ " x " " y ")")) (g/tuple inner inner))
       (g/fmap (fn [[n e b]] (str "(let* [" n " " e "] " b ")")) (g/tuple g-local inner inner))
       (g/fmap (fn [[n e m e2 b]] (str "(let* [" n " " e " " m " " e2 "] " b ")")) (g/tuple g-local inner g-local inner inner))
       (g/fmap (fn [[n e b]] (str "(loop* [" n " " e "] " b ")")) (g/tuple g-local inner inner))
       (g/fmap (fn [[n b e]] (str "((fn* [" n "] " b ") " e ")")) (g/tuple g-local inner inner))
       (g/fmap (fn [[n m b e e2]] (str "((fn* f [" n " " m "] " b ") " e " " e2 ")")) (g/tuple g-local g-local inner inner inner))
       (g/fmap (fn [[n b e]] (str "(letfn* [g (fn* [" n "] " b ")] (g " e "))")) (g/tuple g-local inner inner))
       (g/fmap (fn [[b n h]] (str "(try " b " (catch clotran.host.exception " n " " h "))")) (g/tuple inner g-local inner))
       (g/fmap (fn [[x y]] (str "(do " x " " y ")")) (g/tuple inner inner))]))
   g-ref))

(defn script [forms]
  (str "(defn fz-root [e] (if (and (ex-cause e) (re-find #\"ompiler\" (str (class e)))) (ex-cause e) e))\n"
       (str/join "\n" (map-indexed
                       (fn [i [kind f]]
                         (str "(println \"FZ " i "\" (pr-str (try (let [v (eval '" f ")] "
                              (if (= kind :value) "[:ok v]" "[:accepted]")
                              ") (catch clotran.host.throwable t (let [c (fz-root t)] [:refused (str (class c)) (ex-message c)])))))"))
                       forms))
       "\n"))

(defn norm [s]
  (when s
    (let [v (try (clojure.edn/read-string s) (catch Exception _ s))]
      (if (and (vector? v) (= :refused (first v)))
        (let [cls (str/replace (str (second v)) #"^class " "")]
          ;; clj's class, as clotran names it (upstream/names.clj)
          [:refused (names/class-name cls) (nth v 2 nil)])
        v))))

(defn answers [out]
  (into {} (for [[_ i v] (re-seq #"(?m)^FZ (\d+) (.*)$" (or out ""))] [(parse-long i) (norm v)])))

(defn run [cmd secs]
  (let [proc (apply p/process {:dir repo :out :string :err :string :in ""} cmd)
        r (deref proc (* 1000 secs) ::timeout)]
    (if (= r ::timeout) (do (p/destroy-tree proc) {:timeout true :out "" :err "" :exit -1}) r)))

(let [{:keys [n seed]} opts
      forms (vec (for [i (range n)]
                   (if (even? i)
                     [:refusal (g/generate g-refusal 6 (+ seed i))]
                     [:value (let [v (g/generate g-value 8 (+ seed i))]
                               ;; most inside a let of all three, so their names mostly resolve
                               (if (pos? (mod i 4)) (str "(let* [a 1 b 2 c 3] " v ")") v))])))
      work (str (fs/create-temp-dir {:prefix "fuzz-binds"}))
      clj-f (str work "/binds.clj") ct-f (str work "/binds.cljf")]
  (spit clj-f (names/to-upstream (script forms)))
  (spit ct-f (script forms))
  (let [c (run ["clj" "-Sdeps" (pr-str (clojure.edn/read-string (slurp (str repo "/deps.edn")))) "-M" clj-f] 600)
        r (run [(str repo "/clotran-bin") (str repo "/src/clj/clojure/core.clj") ct-f] 600)
        want (answers (:out c)) got (answers (:out r))
        diffs (for [i (range n) :when (not= (want i) (got i))] i)
        kind (fn [i] (str (name (first (nth forms i))) ": clj " (first (want i)) ", clotran " (first (got i))))]
    (println (str n " forms, seed " seed ": clj accepted "
                  (count (filter #(= :accepted (first %)) (vals want))) ", answered a value "
                  (count (filter #(= :ok (first %)) (vals want)))
                  ", refused " (count (filter #(= :refused (first %)) (vals want)))))
    (when (or (< (count want) n) (< (count got) n))
      (println "answered: clj" (count want) "clotran" (count got) "of" n)
      (println (str/join "\n" (take 5 (str/split-lines (str (:err c) (:err r)))))))
    (println (str "the analyzer's locals, against clj: " (count diffs) " differ"))
    (doseq [[k is] (sort (group-by kind diffs))]
      (println (str "  " k ": " (count is)))
      (doseq [i (take 3 is)]
        (println (str "    " (second (nth forms i))))
        (println (str "      clj " (pr-str (want i)) "\n      clotran " (pr-str (got i))))))
    (System/exit (if (and (empty? diffs) (= n (count want) (count got))) 0 1))))
