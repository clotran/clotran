#!/usr/bin/env bb
;; Differential test for pure Fortran (clotran.purefort, PLAN.md step 13):
;; the tier-A functions of test/clj/pure_sample.cljf are generated as a
;; stand-alone Fortran module, built with gfortran AND flang, and every
;; case below runs three ways -- interpreted, and as each compiler's
;; binary -- with the answers compared: longs exactly, doubles bit for
;; bit, errors by message. No expected value is typed in by hand.
;;
;;   scripts/pure-check
(require '[clojure.string :as str]
         '[babashka.fs :as fs]
         '[clojure.edn :as edn]
         '[babashka.process :refer [shell]])

(def repo (-> *file* fs/file .getCanonicalFile .getParentFile .getParentFile))
;; under this checkout's build/, not the shared temp directory: make
;; crosscheck runs two checkouts at once
(def work (fs/file repo "build" "pure-check"))
(load-file (str (fs/file repo "scripts" "platform.clj")))
;;   scripts/pure-check [SRC CASES.edn]   another namespace and its cases
;;                                       (scripts/fuzz-pure), a vector of calls
(def src (or (first *command-line-args*) "test/clj/pure_sample.cljf"))
(def ns-name (str (second (read-string (slurp src)))))

(def sample-cases
  '[(total (double-array [1.5 2.5 3.0]))
    (total (long-array [1 2 3]))
    (total (double-array []))
    (mean (double-array [1.0 2.0 4.0]))
    (mean (long-array [1 2]))
    (sum-to 100)
    (sum-to 100000)
    (fact 20)
    (fact 21)
    (fact 5.0)
    (hyp 3.0 4.0)
    (hyp 3 4)
    (hyp 1.0E200 1.0E200)
    (clamp 5 0 10)
    (clamp -3 0 10)
    (clamp 2.5 0.0 1.0)
    (sign-of 7)
    (sign-of -0.5)
    (sign-of 0)
    (ratio 7 2)
    (ratio -7 2)
    (ratio 7 0)
    (ratio -9223372036854775808 -1)
    (floor-mod -7 3)
    (floor-mod 7 -3)
    (trunc-rem -7 3)
    (floor-mod 7 0)
    (nth-or (double-array [1.0 2.0]) 1)
    (nth-or (long-array [5 6]) 2)
    (nth-or (long-array [5 6]) -1)
    (to-long 3.99)
    (to-long -3.99)
    (to-long 1.0E30)
    (scale! (double-array [1.0 2.0 3.0]) 2.0)
    (dist2 (double-array [0.0 0.0]) (double-array [3.0 4.0]))
    (dist2 (long-array [1 2]) (long-array [4 6]))
    (sum-squares (double-array [1.0 2.0 3.0]))
    (sum-squares (long-array [1 2 3]))
    (sum-squares (double-array []))
    (sum-longs (long-array [1 2 3]))
    (sum-longs (long-array []))
    (sum-longs (long-array [9223372036854775807 1]))
    (count-big (long-array [5 11 20 3]))
    (count-big (double-array [10.5 1.0]))
    (sum-odd-squares 10)
    (sum-odd-squares 0)
    (all-positive? (long-array [1 2 3]))
    (all-positive? (double-array [1.0 -2.0]))
    (all-positive? (long-array []))
    (scaled-sum (double-array [1.0 2.0]) 3.0)
    (scaled-sum (long-array [1 2]) 3)
    (countdown-sum 10)
    (countdown-sum -1)
    (max-of (long-array [3 9 2]))
    (max-of (double-array [1.5 -2.0]))
    (max-of (long-array []))
    (show (double-array [1.0 2.0]))
    (label 42)
    (label 2.5)
    (first-three "héllo")
    (first-three "ab")
    (tail-of "xyz")
    (has-fe? "café")
    (has-fe? "coffee")
    (same-text? "a" "a ")
    (same-text? "ab" "ab")
    (describe-num 3)
    (describe-num -1.5)
    (countdown 3)
    (quoted)
    (squares-of (double-array [1.0 2.0 3.0]))
    (squares-of (long-array [2 3]))
    (zeros 3)
    (zeros 0)
    (zeros -1)
    (ramp 4)
    (scaled-copy (double-array [1.0 2.0]) 2.0)
    (alias-write (double-array [1.0 2.0]))
    (circle-area 2.0)
    (overrun 2)
    (overrun 3)
    (speed (->Particle 0.0 0.0 3.0 4.0))
    (step (->Particle 1.0 2.0 0.5 -1.0) 2.0)
    (step (->Particle 1.0 2.0 0.5 -1.0) 3)
    (kinetic (->Particle 0.0 0.0 1.0 2.0) 2.0)
    (bump (->Tally 3 1.5) 2.0)
    (bump (->Tally 9223372036854775807 0.0) 1.0)
    (lerp 1.0 3.0) (lerp 1 3) (lerp 0.0 10.0 0.25)
    (add-down 10) (add-down 100 5)])

(def cases (if-let [c (second *command-line-args*)] (read-string (slurp c)) sample-cases))

(defn arg-type [a]
  (cond (int? a) :long (double? a) :double (string? a) :string
        (and (seq? a) (str/starts-with? (name (first a)) "->")) (keyword "record" (subs (name (first a)) 2))
        (and (seq? a) (= 'double-array (first a))) :doubles
        (and (seq? a) (= 'long-array (first a))) :longs
        :else (throw (ex-info "unknown argument form" {:arg a}))))

(defn run-clotran [file]
  (:out (shell {:out :string :err :string :dir (str repo) :continue true :in ""}
               "./clotran-bin" "src/clj/clojure/core.clj" "src/clj/clotran/loader.cljf"
               "src/clj/clotran/tiers.cljf" "src/clj/clotran/purefort.cljf" (str file))))

;; ---- interpreted, and the Fortran generated -------------------------

(.mkdirs work)
(def f90 (fs/file work "pure.f90"))
(spit (fs/file work "drive.clj")
      (str "(let [r (clotran.purefort/generate \"" (platform/slashes src) "\")]\n"
           "  (clotran-spit \"" (platform/slashes f90) "\" (:text r))\n"
           "  (println \"SIGS\" (pr-str (into {} (for [[s vs] (:emitted r)] [(name s) (mapv (juxt :ts :ret) vs)]))))\n"
           "  (println \"SKIPPED\" (pr-str (into {} (for [[s why] (:skipped r)] [(name s) why]))))\n"
           "  (println \"PRUNED\" (pr-str (into {} (for [[s ts] (:pruned r)] [(name s) ts]))))\n"
           "  (println \"RECORDS\" (pr-str (into {} (for [[n rr] (:records r)] [n (:fields rr)])))))\n"
           ;; the versions library mode emits (a checked operation inside a
           ;; condition declines there), for the library road's control below
           "(println \"LIBSIGS\" (pr-str (into {} (for [[s vs] (:emitted (clotran.purefort/generate \"" (platform/slashes src) "\" {:library true}))] [(name s) (mapv (juxt :ts :ret :prints) vs)]))))\n"
           "(in-ns '" ns-name ")\n"
           (apply str (map-indexed
                       (fn [i c]
                         (str "(clojure.core/println \"CASE " i "\" (try (clojure.core/let [v (clojure.core/atom nil) o (clojure.core/with-out-str (clojure.core/reset! v " (pr-str c) "))] (clojure.core/pr-str [:val (clojure.core/let [x @v] (if (clojure.core/instance? (clojure.core/class (clojure.core/double-array 0)) x) (clojure.core/vec x) (if (clojure.core/instance? (clojure.core/class (clojure.core/long-array 0)) x) (clojure.core/vec x) (if (clojure.core/record? x) (clojure.core/vec (clojure.core/vals x)) x)))) o]))"
                              " (catch clotran.host.throwable e (clojure.core/pr-str [:threw (.getMessage e)]))))\n"))
                       cases))))
(def out (run-clotran (fs/file work "drive.clj")))
(def sigs (some #(when (str/starts-with? % "SIGS ") (edn/read-string (subs % 5))) (str/split-lines out)))
(def skipped (some #(when (str/starts-with? % "SKIPPED ") (edn/read-string (subs % 8))) (str/split-lines out)))
(when-not sigs (println out) (println "pure-check: the generator did not run") (System/exit 1))
;; a private function keeps only the versions its callers use: sq is
;; called on a double alone, so its long version is gone and it is not public
(let [pruned (some #(when (str/starts-with? % "PRUNED ") (edn/read-string (subs % 7))) (str/split-lines out))
      text (slurp f90)]
  ;; the sample's own: a generated namespace (fuzz-pure) has no sq
  (when-not (or (not= src "test/clj/pure_sample.cljf")
               (and (= (get pruned "sq") [[:long]])
                 (not (str/includes? text "public :: sq\n"))
                 (str/includes? text "public :: circle_area")))
    (println "pure-check: private pruning is wrong:" (pr-str pruned))
    (System/exit 1)))
;; a line printed on Windows ends CR LF -- by clj, clotran and a pure
;; program's records alike -- read as \n on every side
(defn parse-cases [out]
  (into {} (for [l (str/split-lines (str/replace out "\\r\\n" "\\n")) :let [m (re-matches #"CASE (\d+) (.*)" l)] :when m]
             [(parse-long (second m))
              (let [[k v & more] (edn/read-string {:readers {'Inf (constantly ##Inf)}} (str/replace (nth m 2) #"##(-?)Inf" "$1##Inf"))]
                (into [k (if (and (= k :threw) (string? v)) (first (str/split v #"  at ")) v)] more))])))
(def interp (parse-cases out))
(def records (some #(when (str/starts-with? % "RECORDS ") (edn/read-string (subs % 8))) (str/split-lines out)))

;; clj, the language oracle, runs the same file and the same cases, in
;; the names clj knows its classes by (upstream/names.clj)
(load-file (str (fs/file repo "upstream" "names.clj")))
(spit (fs/file work "sample-for-clj.cljf") (names/to-upstream (slurp src)))
(spit (fs/file work "for-clj.clj")
      (names/to-upstream (str "(load-file \"" (platform/slashes (fs/file work "sample-for-clj.cljf")) "\")\n(in-ns '" ns-name ")\n"
           (apply str (map-indexed
                       (fn [i c]
                         (str "(clojure.core/println \"CASE " i "\" (try (clojure.core/let [v (clojure.core/atom nil) o (clojure.core/with-out-str (clojure.core/reset! v " (pr-str c) "))] (clojure.core/pr-str [:val (clojure.core/let [x @v] (if (clojure.core/instance? (clojure.core/class (clojure.core/double-array 0)) x) (clojure.core/vec x) (if (clojure.core/instance? (clojure.core/class (clojure.core/long-array 0)) x) (clojure.core/vec x) (if (clojure.core/record? x) (clojure.core/vec (clojure.core/vals x)) x)))) o]))"
                              " (catch clotran.host.throwable e (clojure.core/pr-str [:threw (.getMessage e)]))))\n"))
                       cases)))))
(def clj-side (parse-cases (names/from-clj (:out (shell {:out :string :err :string :dir (str repo) :continue true} "clj" "-Sdeps" (pr-str (clojure.edn/read-string (slurp (fs/file repo "deps.edn")))) "-M" (str (fs/file work "for-clj.clj")))))))
(when (empty? clj-side) (println "pure-check: clj did not run the cases") (System/exit 1))

;; ---- the library road (PLAN step 13) ----------------------------------
;;
;; The same file compiled by `clotran compile`: each tier-A function's
;; installed procedure is a dispatcher running its pure version, and the
;; cases go through the installed functions from the REPL. The control:
;; every function library mode emits a version for over numbers and
;; arrays alone, answering a number, a boolean or nil, must have come out
;; pure, else this road would be testing tier B under the pure road's name.
(def lib-sigs (some #(when (str/starts-with? % "LIBSIGS ") (edn/read-string (subs % 8))) (str/split-lines out)))
(def lib (str (fs/file work (str (str/replace (str ns-name) #"[^A-Za-z0-9]" "_")
                                 "." platform/soext))))
(def compile-out (let [r (shell {:out :string :err :string :dir (str repo) :continue true :in ""} "sh" "./clotran" "compile" src lib)]
                   (str (:out r) (:err r))))
(def pure-fns (set (map second (re-seq #"(?m)^pure Fortran: (\S+)" compile-out))))
(let [supported (set (for [[f vs] lib-sigs
                           :when (some (fn [[ts rt prints]] (and (every? #{:long :double :doubles :longs} ts)
                                                                 (#{:long :double :bool :nil :doubles :longs} rt)
                                                                 (not prints)))
                                       vs)]
                       f))
      missing (remove pure-fns supported)]
  (when (or (seq missing) (not (fs/exists? lib)))
    (println "pure-check: the library road did not come out pure for:" (pr-str missing))
    (println compile-out)
    (System/exit 1)))
(spit (fs/file work "drive-lib.clj")
      (str "(load-file \"" (platform/slashes src) "\")\n"
           "(println \"INSTALLED\" (clotran.loader/install \"" (platform/slashes lib) "\" \"" (platform/slashes src) "\"))\n"
           "(in-ns '" ns-name ")\n"
           (apply str (map-indexed
                       (fn [i c]
                         (str "(clojure.core/println \"CASE " i "\" (try (clojure.core/let [v (clojure.core/atom nil) o (clojure.core/with-out-str (clojure.core/reset! v " (pr-str c) "))] (clojure.core/pr-str [:val (clojure.core/let [x @v] (if (clojure.core/instance? (clojure.core/class (clojure.core/double-array 0)) x) (clojure.core/vec x) (if (clojure.core/instance? (clojure.core/class (clojure.core/long-array 0)) x) (clojure.core/vec x) (if (clojure.core/record? x) (clojure.core/vec (clojure.core/vals x)) x)))) o]))"
                              " (catch clotran.host.throwable e (clojure.core/pr-str [:threw (.getMessage e)]))))\n"))
                       cases))))
(def lib-out (run-clotran (fs/file work "drive-lib.clj")))
(when-not (str/includes? lib-out "INSTALLED true")
  (println "pure-check: the library did not install") (println lib-out) (System/exit 1))
(def lib-side (parse-cases lib-out))

;; ---- the Fortran driver ------------------------------------------------

(defn ret-type [[f & args]]
  (let [ts (mapv arg-type args)]
    (some (fn [[vts rt]] (when (= vts ts) rt)) (get sigs (name f)))))

(defn fort-ident [s] (str/lower-case (str/replace (str s) #"[^A-Za-z0-9]" "_")))

(defn fort-double [v]
  (let [s (pr-str v)] (if (str/includes? s "E") (str/replace s "E" "d") (str s "d0"))))

(defn f-lit [a]
  (case (arg-type a)
    :long (if (= a Long/MIN_VALUE) "(-huge(0_int64) - 1_int64)" (str a "_int64"))
    :double (fort-double a)
    :doubles (str "[real(real64) :: " (str/join ", " (map #(fort-double (double %)) (second a))) "]")
    :longs (str "[integer(int64) :: " (str/join ", " (map #(str % "_int64") (second a))) "]")
    :string (str "\"" (str/replace a "\"" "\"\"") "\"")
    ;; a record: its structure constructor, name_t(...)
    (let [t (arg-type a)]
      (if (= "record" (namespace t))
        (str (fort-ident (name t)) "_t(" (str/join ", " (map f-lit (rest a))) ")")
        (throw (ex-info "no literal" {:arg a}))))))


(def driver
  (str "program pure_driver\n"
       "  use iso_fortran_env, only: int64, real64\n"
       "  use " (fort-ident ns-name) "_pure\n"
       "  implicit none\n"
       "  integer :: k\n"
       "  character(len=16) :: arg\n"
       "  call get_command_argument(1, arg)\n"
       "  read(arg, *) k\n"
       "  select case (k)\n"
       (apply str
              (for [[i [f & args :as c]] (map-indexed vector cases)
                    :let [rt (ret-type c)] :when rt]
                (str "  case (" i ")\n"
                     "    block\n"
                     (apply str (for [[j a] (map-indexed vector args) :when (#{:doubles :longs} (arg-type a))]
                                  (str "      " (if (= :doubles (arg-type a)) "real(real64)" "integer(int64)")
                                       ", allocatable :: a" j "(:)\n")))
                     (apply str (for [[j a] (map-indexed vector args) :when (#{:doubles :longs} (arg-type a))]
                                  (str "      a" j " = " (f-lit a) "\n")))
                     (let [call (str (fort-ident (name f)) "("
                                     (str/join ", " (for [[j a] (map-indexed vector args)]
                                                      (if (#{:doubles :longs} (arg-type a)) (str "a" j) (f-lit a))))
                                     ")")]
                       (if (= rt :nil)
                         (str "      call " call "\n      print '(a)', '==R=='\n      print '(a)', 'N'\n")
                         (str "      print '(a)', '==R=='\n"
                              (case (if (= "record" (namespace rt)) :record rt)
                                :record (str "      print '(a, "
                                             (str/join ", " (for [[_ ft] (get records (name rt))] (if (= ft :double) "1x, es26.17e3" "1x, i0")))
                                             ")', 'R', " call "\n")
                                :doubles (str "      print '(a, *(1x, es26.17e3))', 'A', " call "\n")
                                :longs (str "      print '(a, *(1x, i0))', 'A', " call "\n")
                                (str "      print '(a, " (case rt :long "i0" :double "es26.17e3" :bool "l1" :string "a") ")', '"
                                     (case rt :long "L " :double "D " :bool "B " :string "S ") "', " call "\n")))))
                     "    end block\n")))
       "  end select\n"
       "end program pure_driver\n"))
(spit (fs/file work "driver.f90") driver)

;; ---- build and run under both compilers ------------------------------

(defn build [fc exe flags]
  (let [r (apply shell {:out :string :err :string :continue true :dir (str work)}
                 fc "-O2" "-ffp-contract=off" (concat (when (= fc "gfortran") ["-ffree-line-length-none"]) flags
                                  ["pure.f90" "driver.f90" "-o" exe]))]
    (when-not (zero? (:exit r))
      (println "BUILD FAILED with" fc) (println (:err r)) (System/exit 1))))

(defn run-case [exe i]
  (let [r (shell {:out :string :err :string :continue true :dir (str work)} (str "./" exe) (str i))]
    (if (zero? (:exit r))
      (let [out (str/replace (:out r) "\r\n" "\n")   ; a Fortran record on Windows ends CR LF
            at (str/last-index-of out "==R==\n")
            printed (subs out 0 at)
            result (let [s (subs out (+ at 6))] (if (str/ends-with? s "\n") (subs s 0 (dec (count s))) s))
            [kind v] (str/split result #" " 2)
            kind (cond (str/starts-with? result "A") "A" (str/starts-with? result "R") "R" :else kind)
            v (if (#{"A" "R"} kind) (str/trim (subs result 1)) v)]
        [:val (case kind
                "N" nil
                "R" (mapv #(if (re-find #"[.eE]" %) (Double/parseDouble %) (parse-long %)) (remove str/blank? (str/split (or v "") #"\s+")))
                "A" (mapv #(if (re-find #"[.eE]" %) (Double/parseDouble %) (parse-long %)) (remove str/blank? (str/split (or v "") #"\s+")))
                "S" (or v "")
                "L" (parse-long v)
                "D" (let [s (str/lower-case v)]
                      (cond (str/includes? s "nan") ##NaN
                            (str/includes? s "inf") (if (str/starts-with? s "-") ##-Inf ##Inf)
                            :else (Double/parseDouble v)))
                "B" (= v "T"))
         printed])
      ;; the message, without the compiler's error-stop prefix
      [:threw (-> (first (str/split-lines (str (:err r) "\n")))
                  (str/replace #"^(Fortran ERROR STOP: |ERROR STOP )" "")
                  str/trim)])))

(defn- trailing-number
  "A message split into its text and the number that ends it, if any."
  [s]
  (if-let [[_ text num] (and (string? s) (re-matches #"(.*?)(-?[0-9][0-9.]*(?:[eE][-+]?[0-9]+)?)" s))]
    [text (Double/parseDouble num)]
    [s nil]))

(defn- numbers-as-values
  "Text with every number replaced by its value as clj prints it: pure
  Fortran writes 2.5 as 2.5000000000000000E+000 (DEVIATIONS 50)."
  [s]
  (str/replace (str s) #"-?[0-9]+\.[0-9]+(?:[eE][-+]?[0-9]+)?" #(pr-str (Double/parseDouble %))))

(defn- same-printed? [a b]
  (let [toks #(remove str/blank? (str/split (str %) #"[ \n]+"))
        norm (fn [t] (cond (= t "T") "true" (= t "F") "false"
                           (re-matches #"-?[0-9][0-9.]*(?:[eE][-+]?[0-9]+)?" t) (Double/parseDouble t)
                           :else t))]
    (and (= (count (str/split-lines (str a))) (count (str/split-lines (str b))))
         (= (map norm (toks a)) (map norm (toks b))))))

(defn same? [a b]
  (let [[ka va oa] a [kb vb ob] b]
    (and (= ka kb)
         (or (= ka :threw) (same-printed? oa ob))
         (cond
           (and (double? va) (double? vb))
           (= (Double/doubleToLongBits va) (Double/doubleToLongBits vb))
           ;; pure Fortran writes a double in a message in Fortran's ES form,
           ;; not clj's (DEVIATIONS 50): the text before it must match, and
           ;; the number by value
           (and (= :val ka) (string? va) (string? vb))
           (= (numbers-as-values va) (numbers-as-values vb))
           (and (= :threw ka) (string? va) (string? vb))
           (let [[ta na] (trailing-number va) [tb nb] (trailing-number vb)]
             (and (= ta tb) (= na nb)))
           :else (= va vb)))))

(def all-compilers
  [["gfortran" "pure_g" []]
   ["flang" "pure_f" []]
   ;; and threaded: do concurrent run in parallel, the same answers
   ["flang" "pure_fp" ["-fopenmp" "-fdo-concurrent-to-openmp=host"]]
   ["gfortran" "pure_gp" ["-fopenmp" "-ftree-parallelize-loops=4"]]])

;; a compiler that does not take a threaded build's flags -- flang before
;; 20 has no -fdo-concurrent-to-openmp (Debian 13's 19, in the Linux gate)
;; -- builds it not, and says so
(defn takes-flags? [fc flags]
  (let [d (str (fs/create-temp-dir {:prefix "pure-flags"}))]
    (spit (str d "/t.f90") "program t\nend program t\n")
    (zero? (:exit (shell {:dir d :out :string :err :string :continue true} (str/join " " (concat [fc] flags ["t.f90" "-o" "t"])))))))
(def compilers
  (filterv (fn [[fc exe flags]]
             (cond
               ;; a compiler not installed is said, not crashed on: MSYS2
               ;; has flang only in its CLANG64 environment, not UCRT64's
               (not (fs/which fc)) (do (println "pure-check: not built:" exe "--" fc "is not installed") false)
               (or (empty? flags) (takes-flags? fc flags)) true
               :else (do (println "pure-check: not built:" exe "--" fc "does not take" (str/join " " flags)) false)))
           all-compilers))
(doseq [[fc exe flags] compilers] (build fc exe flags))
(def sample? (= src "test/clj/pure_sample.cljf"))
(when-not (or (not sample?) (re-find #"(?m)^\s*do concurrent \(" (slurp f90)))
  (println "pure-check: no amap came out as do concurrent")
  (System/exit 1))

(def fails (atom 0))
(def ran (atom 0))
(def not-emitted (atom []))
(doseq [[i c] (map-indexed vector cases)]
  (if-not (ret-type c)
    (swap! not-emitted conj c)
    (let [want (clj-side i)]
      ;; the interpreter is clotran too: on generated code (fuzz-pure) a
      ;; difference from clj is a failure, not a note
      (when-not (same? want (interp i))
        (when-not sample? (swap! fails inc))
        (println (if sample? "NOTE" "DIFFER") "interpreter differs from clj:" (pr-str c) (pr-str (interp i)) "vs" (pr-str want)))
      (doseq [[fc exe _] compilers]
        (swap! ran inc)
        (let [got (run-case exe i)]
          (when-not (same? want got)
            (swap! fails inc)
            (println "DIFFER" exe (pr-str c))
            (println "   clj        :" (pr-str want))
            (println "   pure       :" (pr-str got)))))
      ;; and through the installed library, from the REPL
      (swap! ran inc)
      ;; exactly: a library's message is the interpreter's, a double in it
      ;; written by the runtime (DEVIATIONS 50 is the standalone road's)
      (let [got (lib-side i)]
        (when-not (and (same? want got) (or (not= :threw (first want)) (= (second want) (second got))))
          (swap! fails inc)
          (println "DIFFER library" (pr-str c))
          (println "   clj        :" (pr-str want))
          (println "   library    :" (pr-str got)))))))

(println "skipped functions:" (pr-str skipped))
(when (seq @not-emitted) (println "cases with no pure version:" (pr-str @not-emitted)))
(println (str "pure-check: " @ran " runs (" (count cases) " cases x " (count compilers)
              " compilers + the library), " (- @ran @fails) " agree, " @fails " differ; "
              (count pure-fns) " functions pure in the library"))
(when (pos? @fails) (System/exit 1))
