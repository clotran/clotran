#!/usr/bin/env bb
;; Differential test for pure Fortran (clotran.purefort, PLAN.md step 13):
;; the tier-A functions of test/clj/pure_sample.cljf are generated as a
;; stand-alone Fortran module, built with gfortran AND flang, and every
;; case below runs three ways -- interpreted, and as each compiler's
;; binary -- with the answers compared: longs exactly, doubles bit for
;; bit, errors by message. No expected value is typed in by hand.
;;
;;   scripts/pure-check
(require '[clojure.string :as str]
         '[clojure.java.io :as io]
         '[clojure.edn :as edn]
         '[babashka.process :refer [shell]])

(def repo (-> *file* io/file .getCanonicalFile .getParentFile .getParentFile))
(def work (io/file (System/getProperty "java.io.tmpdir") "clotran-pure-check"))
(def src "test/clj/pure_sample.cljf")
(def ns-name "pure-sample")

(def cases
  '[(total (double-array [1.5 2.5 3.0]))
    (total (long-array [1 2 3]))
    (total (double-array []))
    (mean (double-array [1.0 2.0 4.0]))
    (mean (long-array [1 2]))
    (sum-to 100)
    (sum-to 100000)
    (fact 20)
    (fact 21)
    (fact 5.0)
    (hyp 3.0 4.0)
    (hyp 3 4)
    (hyp 1.0E200 1.0E200)
    (clamp 5 0 10)
    (clamp -3 0 10)
    (clamp 2.5 0.0 1.0)
    (sign-of 7)
    (sign-of -0.5)
    (sign-of 0)
    (ratio 7 2)
    (ratio -7 2)
    (ratio 7 0)
    (ratio -9223372036854775808 -1)
    (floor-mod -7 3)
    (floor-mod 7 -3)
    (trunc-rem -7 3)
    (floor-mod 7 0)
    (nth-or (double-array [1.0 2.0]) 1)
    (nth-or (long-array [5 6]) 2)
    (nth-or (long-array [5 6]) -1)
    (to-long 3.99)
    (to-long -3.99)
    (to-long 1.0E30)
    (scale! (double-array [1.0 2.0 3.0]) 2.0)
    (dist2 (double-array [0.0 0.0]) (double-array [3.0 4.0]))
    (dist2 (long-array [1 2]) (long-array [4 6]))
    (sum-squares (double-array [1.0 2.0 3.0]))
    (sum-squares (long-array [1 2 3]))
    (sum-squares (double-array []))
    (sum-longs (long-array [1 2 3]))
    (sum-longs (long-array []))
    (sum-longs (long-array [9223372036854775807 1]))
    (count-big (long-array [5 11 20 3]))
    (count-big (double-array [10.5 1.0]))
    (sum-odd-squares 10)
    (sum-odd-squares 0)
    (all-positive? (long-array [1 2 3]))
    (all-positive? (double-array [1.0 -2.0]))
    (all-positive? (long-array []))
    (scaled-sum (double-array [1.0 2.0]) 3.0)
    (scaled-sum (long-array [1 2]) 3)
    (countdown-sum 10)
    (countdown-sum -1)
    (max-of (long-array [3 9 2]))
    (max-of (double-array [1.5 -2.0]))
    (max-of (long-array []))
    (show (double-array [1.0 2.0]))
    (label 42)
    (label 2.5)
    (first-three "héllo")
    (first-three "ab")
    (tail-of "xyz")
    (has-fe? "café")
    (has-fe? "coffee")
    (same-text? "a" "a ")
    (same-text? "ab" "ab")
    (describe-num 3)
    (describe-num -1.5)
    (countdown 3)
    (quoted)
    (squares-of (double-array [1.0 2.0 3.0]))
    (squares-of (long-array [2 3]))
    (zeros 3)
    (zeros 0)
    (zeros -1)
    (ramp 4)
    (scaled-copy (double-array [1.0 2.0]) 2.0)
    (alias-write (double-array [1.0 2.0]))])

(defn arg-type [a]
  (cond (int? a) :long (double? a) :double (string? a) :string
        (and (seq? a) (= 'double-array (first a))) :doubles
        (and (seq? a) (= 'long-array (first a))) :longs
        :else (throw (ex-info "unknown argument form" {:arg a}))))

(defn run-clotran [file]
  (:out (shell {:out :string :err :string :dir (str repo) :continue true :in ""}
               "./clotran-bin" "src/clj/clojure/core.clj" "src/clj/clotran/loader.cljf"
               "src/clj/clotran/tiers.cljf" "src/clj/clotran/purefort.cljf" (str file))))

;; ---- interpreted, and the Fortran generated -------------------------

(.mkdirs work)
(def f90 (io/file work "pure.f90"))
(spit (io/file work "drive.clj")
      (str "(let [r (clotran.purefort/generate \"" src "\")]\n"
           "  (clotran-spit \"" f90 "\" (:text r))\n"
           "  (println \"SIGS\" (pr-str (into {} (for [[s vs] (:emitted r)] [(name s) (mapv (juxt :ts :ret) vs)]))))\n"
           "  (println \"SKIPPED\" (pr-str (into {} (for [[s why] (:skipped r)] [(name s) why])))))\n"
           "(in-ns '" ns-name ")\n"
           (apply str (map-indexed
                       (fn [i c]
                         (str "(clojure.core/println \"CASE " i "\" (try (clojure.core/let [v (clojure.core/atom nil) o (clojure.core/with-out-str (clojure.core/reset! v " (pr-str c) "))] (clojure.core/pr-str [:val (clojure.core/let [x @v] (if (clojure.core/instance? (clojure.core/class (clojure.core/double-array 0)) x) (clojure.core/vec x) (if (clojure.core/instance? (clojure.core/class (clojure.core/long-array 0)) x) (clojure.core/vec x) x))) o]))"
                              " (catch Throwable e (clojure.core/pr-str [:threw (.getMessage e)]))))\n"))
                       cases))))
(def out (run-clotran (io/file work "drive.clj")))
(def sigs (some #(when (str/starts-with? % "SIGS ") (edn/read-string (subs % 5))) (str/split-lines out)))
(def skipped (some #(when (str/starts-with? % "SKIPPED ") (edn/read-string (subs % 8))) (str/split-lines out)))
(when-not sigs (println out) (println "pure-check: the generator did not run") (System/exit 1))
(defn parse-cases [out]
  (into {} (for [l (str/split-lines out) :let [m (re-matches #"CASE (\d+) (.*)" l)] :when m]
             [(parse-long (second m))
              (let [[k v & more] (edn/read-string {:readers {'Inf (constantly ##Inf)}} (str/replace (nth m 2) #"##(-?)Inf" "$1##Inf"))]
                (into [k (if (and (= k :threw) (string? v)) (first (str/split v #"  at ")) v)] more))])))
(def interp (parse-cases out))

;; clj, the language oracle, runs the same file and the same cases
(spit (io/file work "jvm.clj")
      (str "(load-file \"" src "\")\n(in-ns '" ns-name ")\n"
           (apply str (map-indexed
                       (fn [i c]
                         (str "(clojure.core/println \"CASE " i "\" (try (clojure.core/let [v (clojure.core/atom nil) o (clojure.core/with-out-str (clojure.core/reset! v " (pr-str c) "))] (clojure.core/pr-str [:val (clojure.core/let [x @v] (if (clojure.core/instance? (clojure.core/class (clojure.core/double-array 0)) x) (clojure.core/vec x) (if (clojure.core/instance? (clojure.core/class (clojure.core/long-array 0)) x) (clojure.core/vec x) x))) o]))"
                              " (catch Throwable e (clojure.core/pr-str [:threw (.getMessage e)]))))\n"))
                       cases))))
(def jvm (parse-cases (:out (shell {:out :string :err :string :dir (str repo) :continue true} "clj" "-M" (str (io/file work "jvm.clj"))))))
(when (empty? jvm) (println "pure-check: clj did not run the cases") (System/exit 1))

;; ---- the Fortran driver ------------------------------------------------

(defn ret-type [[f & args]]
  (let [ts (mapv arg-type args)]
    (some (fn [[vts rt]] (when (= vts ts) rt)) (get sigs (name f)))))

(defn fort-double [v]
  (let [s (pr-str v)] (if (str/includes? s "E") (str/replace s "E" "d") (str s "d0"))))

(defn f-lit [a]
  (case (arg-type a)
    :long (if (= a Long/MIN_VALUE) "(-huge(0_int64) - 1_int64)" (str a "_int64"))
    :double (fort-double a)
    :doubles (str "[real(real64) :: " (str/join ", " (map #(fort-double (double %)) (second a))) "]")
    :longs (str "[integer(int64) :: " (str/join ", " (map #(str % "_int64") (second a))) "]")
    :string (str "\"" (str/replace a "\"" "\"\"") "\"")))

(defn fort-ident [s] (str/lower-case (str/replace (str s) #"[^A-Za-z0-9]" "_")))

(def driver
  (str "program pure_driver\n"
       "  use iso_fortran_env, only: int64, real64\n"
       "  use " (fort-ident ns-name) "_pure\n"
       "  implicit none\n"
       "  integer :: k\n"
       "  character(len=16) :: arg\n"
       "  call get_command_argument(1, arg)\n"
       "  read(arg, *) k\n"
       "  select case (k)\n"
       (apply str
              (for [[i [f & args :as c]] (map-indexed vector cases)
                    :let [rt (ret-type c)] :when rt]
                (str "  case (" i ")\n"
                     "    block\n"
                     (apply str (for [[j a] (map-indexed vector args) :when (#{:doubles :longs} (arg-type a))]
                                  (str "      " (if (= :doubles (arg-type a)) "real(real64)" "integer(int64)")
                                       ", allocatable :: a" j "(:)\n")))
                     (apply str (for [[j a] (map-indexed vector args) :when (#{:doubles :longs} (arg-type a))]
                                  (str "      a" j " = " (f-lit a) "\n")))
                     (let [call (str (fort-ident (name f)) "("
                                     (str/join ", " (for [[j a] (map-indexed vector args)]
                                                      (if (#{:doubles :longs} (arg-type a)) (str "a" j) (f-lit a))))
                                     ")")]
                       (if (= rt :nil)
                         (str "      call " call "\n      print '(a)', '==R=='\n      print '(a)', 'N'\n")
                         (str "      print '(a)', '==R=='\n"
                              (case rt
                                :doubles (str "      print '(a, *(1x, es26.17e3))', 'A', " call "\n")
                                :longs (str "      print '(a, *(1x, i0))', 'A', " call "\n")
                                (str "      print '(a, " (case rt :long "i0" :double "es26.17e3" :bool "l1" :string "a") ")', '"
                                     (case rt :long "L " :double "D " :bool "B " :string "S ") "', " call "\n")))))
                     "    end block\n")))
       "  end select\n"
       "end program pure_driver\n"))
(spit (io/file work "driver.f90") driver)

;; ---- build and run under both compilers ------------------------------

(defn build [fc exe]
  (let [r (shell {:out :string :err :string :continue true :dir (str work)}
                 fc "-O2" (if (= fc "gfortran") "-ffree-line-length-none" "-O2")
                 "pure.f90" "driver.f90" "-o" exe)]
    (when-not (zero? (:exit r))
      (println "BUILD FAILED with" fc) (println (:err r)) (System/exit 1))))

(defn run-case [exe i]
  (let [r (shell {:out :string :err :string :continue true :dir (str work)} (str "./" exe) (str i))]
    (if (zero? (:exit r))
      (let [out (:out r)
            at (str/last-index-of out "==R==\n")
            printed (subs out 0 at)
            result (let [s (subs out (+ at 6))] (if (str/ends-with? s "\n") (subs s 0 (dec (count s))) s))
            [kind v] (str/split result #" " 2)
            kind (if (str/starts-with? result "A") "A" kind)
            v (if (= kind "A") (str/trim (subs result 1)) v)]
        [:val (case kind
                "N" nil
                "A" (mapv #(if (re-find #"[.eE]" %) (Double/parseDouble %) (parse-long %)) (remove str/blank? (str/split (or v "") #"\s+")))
                "S" (or v "")
                "L" (parse-long v)
                "D" (let [s (str/lower-case v)]
                      (cond (str/includes? s "nan") ##NaN
                            (str/includes? s "inf") (if (str/starts-with? s "-") ##-Inf ##Inf)
                            :else (Double/parseDouble v)))
                "B" (= v "T"))
         printed])
      [:threw (str/trim (first (str/split-lines (str (:err r) "\n"))))])))

(defn- trailing-number
  "A message split into its text and the number that ends it, if any."
  [s]
  (if-let [[_ text num] (and (string? s) (re-matches #"(.*?)(-?[0-9][0-9.]*(?:[eE][-+]?[0-9]+)?)" s))]
    [text (Double/parseDouble num)]
    [s nil]))

(defn- numbers-as-values
  "Text with every number replaced by its value as Java prints it: pure
  Fortran writes 2.5 as 2.5000000000000000E+000 (DEVIATIONS 50)."
  [s]
  (str/replace (str s) #"-?[0-9]+\.[0-9]+(?:[eE][-+]?[0-9]+)?" #(pr-str (Double/parseDouble %))))

(defn- same-printed? [a b]
  (let [toks #(remove str/blank? (str/split (str %) #"[ \n]+"))
        norm (fn [t] (cond (= t "T") "true" (= t "F") "false"
                           (re-matches #"-?[0-9][0-9.]*(?:[eE][-+]?[0-9]+)?" t) (Double/parseDouble t)
                           :else t))]
    (and (= (count (str/split-lines (str a))) (count (str/split-lines (str b))))
         (= (map norm (toks a)) (map norm (toks b))))))

(defn same? [a b]
  (let [[ka va oa] a [kb vb ob] b]
    (and (= ka kb)
         (or (= ka :threw) (same-printed? oa ob))
         (cond
           (and (double? va) (double? vb))
           (= (Double/doubleToLongBits va) (Double/doubleToLongBits vb))
           ;; pure Fortran writes a double in a message in Fortran's ES form,
           ;; not Java's (DEVIATIONS 50): the text before it must match, and
           ;; the number by value
           (and (= :val ka) (string? va) (string? vb))
           (= (numbers-as-values va) (numbers-as-values vb))
           (and (= :threw ka) (string? va) (string? vb))
           (let [[ta na] (trailing-number va) [tb nb] (trailing-number vb)]
             (and (= ta tb) (= na nb)))
           :else (= va vb)))))

(def compilers [["gfortran" "pure_g"] ["flang" "pure_f"]])
(doseq [[fc exe] compilers] (build fc exe))

(def fails (atom 0))
(def ran (atom 0))
(def not-emitted (atom []))
(doseq [[i c] (map-indexed vector cases)]
  (if-not (ret-type c)
    (swap! not-emitted conj c)
    (let [want (jvm i)]
      (when-not (same? want (interp i))
        (println "NOTE interpreter differs from clj:" (pr-str c) (pr-str (interp i)) "vs" (pr-str want)))
      (doseq [[fc exe] compilers]
        (swap! ran inc)
        (let [got (run-case exe i)]
          (when-not (same? want got)
            (swap! fails inc)
            (println "DIFFER" fc (pr-str c))
            (println "   clj (JVM)  :" (pr-str want))
            (println "   pure       :" (pr-str got))))))))

(println "skipped functions:" (pr-str skipped))
(when (seq @not-emitted) (println "cases with no pure version:" (pr-str @not-emitted)))
(println (str "pure-check: " @ran " runs (" (count cases) " cases x " (count compilers)
              " compilers), " (- @ran @fails) " agree, " @fails " differ"))
(when (pos? @fails) (System/exit 1))
