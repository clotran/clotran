#!/usr/bin/env bb
;; dist-pkg: the .deb and .rpm of a release, from its glibc tarballs.
;;
;;   scripts/dist-pkg [build/dist]
;;
;; Each linux-<arch> tarball (glibc; musl systems take install.sh) becomes
;; clotran_<version>_<arch>.deb and clotran-<version>.<arch>.rpm in the same
;; directory. The release goes in /opt/clotran whole, as it is relocatable
;; only as a directory, and /usr/bin gets two wrappers. Nothing is
;; compiled: dpkg-deb runs in debian:12 and rpmbuild in fedora:41, each
;; packing the files the tarball already holds, so either is built on any
;; machine for either architecture.
(require '[clojure.string :as str]
         '[babashka.fs :as fs]
         '[babashka.process :as p])

(def repo (str (fs/parent (fs/parent (fs/absolutize *file*)))))
(def out-dir (str (fs/absolutize (or (first *command-line-args*) (str repo "/build/dist")))))
(def version (str/trim (slurp (str repo "/VERSION"))))
;; deb and rpm versions: a pre-release sorts before its release with ~
(def pkg-version (str/replace version "-" "~"))

(def wrapper "#!/bin/sh\nexec /opt/clotran/bin/%s \"$@\"\n")

(defn docker [image & cmd]
  (apply p/shell {:dir out-dir} "docker" "run" "--rm" "-v" (str out-dir ":/dist") image cmd))

(doseq [[arch deb-arch] [["aarch64" "arm64"] ["x86_64" "amd64"]]]
  (let [tarball (str "clotran-" version "-linux-" arch ".tar.gz")
        top (str "clotran-" version "-linux-" arch)
        deb (str "clotran_" pkg-version "_" deb-arch ".deb")
        rpm (str "clotran-" pkg-version "-1." arch ".rpm")]
    (when-not (fs/exists? (str out-dir "/" tarball))
      (throw (ex-info (str "no " tarball " in " out-dir) {})))
    (println "deb" deb)
    (docker "debian:12" "sh" "-euc"
            (str "r=/tmp/root; mkdir -p $r/opt $r/usr/bin $r/DEBIAN\n"
                 "tar xzf /dist/" tarball " -C $r/opt && mv $r/opt/" top " $r/opt/clotran\n"
                 "for c in clotran clotran-deps; do printf '" (str/replace wrapper "\n" "\\n") "' $c > $r/usr/bin/$c; chmod 755 $r/usr/bin/$c; done\n"
                 "cat > $r/DEBIAN/control <<EOF\n"
                 "Package: clotran\nVersion: " pkg-version "\nArchitecture: " deb-arch "\n"
                 "Maintainer: James Borden <https://github.com/jborden/clotran>\n"
                 "Depends: libc6 (>= 2.28)\nSection: devel\nPriority: optional\n"
                 "Homepage: https://github.com/jborden/clotran\n"
                 "Description: Clojure, hosted on Fortran\n"
                 " Clojure's own core.clj on a Fortran host: one binary, its heap image,\n"
                 " the launcher and clotran-deps.\nEOF\n"
                 "dpkg-deb --build --root-owner-group $r /dist/" deb))
    (println "rpm" rpm)
    (docker "fedora:41" "sh" "-euc"
            (str "dnf -q -y install rpm-build >/dev/null\n"
                 "t=/tmp/rpm; mkdir -p $t/SOURCES $t/SPECS\n"
                 "cp /dist/" tarball " $t/SOURCES/\n"
                 "cat > $t/SPECS/clotran.spec <<'EOF'\n"
                 "Name: clotran\nVersion: " pkg-version "\nRelease: 1\n"
                 "Summary: Clojure, hosted on Fortran\nLicense: EPL-2.0\n"
                 "URL: https://github.com/jborden/clotran\nSource0: " tarball "\n"
                 "AutoReqProv: no\nRequires: glibc >= 2.28\n"
                 "%global debug_package %{nil}\n%global __os_install_post %{nil}\n%define _build_id_links none\n"
                 "%description\nClojure's own core.clj on a Fortran host: one binary, its heap image,\nthe launcher and clotran-deps.\n"
                 "%prep\n%install\nmkdir -p %{buildroot}/opt %{buildroot}/usr/bin\n"
                 "tar xzf %{SOURCE0} -C %{buildroot}/opt && mv %{buildroot}/opt/" top " %{buildroot}/opt/clotran\n"
                 "for c in clotran clotran-deps; do printf '" (str/replace wrapper "\n" "\\n") "' $c > %{buildroot}/usr/bin/$c; chmod 755 %{buildroot}/usr/bin/$c; done\n"
                 "%files\n/opt/clotran\n/usr/bin/clotran\n/usr/bin/clotran-deps\nEOF\n"
                 "rpmbuild -bb --target " arch " --define \"_topdir $t\" $t/SPECS/clotran.spec >/dev/null\n"
                 "cp $t/RPMS/" arch "/" rpm " /dist/"))))
(println "dist-pkg: done in" out-dir)
