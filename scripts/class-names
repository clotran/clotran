#!/usr/bin/env bb
;; scripts/class-names -- clotran's class names (src/clj/clotran/class-aliases.edn):
;; every JVM and clojure.lang class name clotran handles, mapped to the name
;; clotran gives it. The convention is the host's (memory: class names):
;; what is written in Fortran is snake_case under clotran. -- scalars by
;; Fortran kind (clotran.int8, clotran.real8, clotran.value) -- and what is
;; written in Clojure keeps its Clojure type name (clotran.io.File).
;;
;;   scripts/class-names          write src/f/classalias.inc from the table
;;   scripts/class-names --check  exit 1 if classalias.inc is out of date
;;
;; The JVM names are INPUT only: vendored Clojure writes them and runs
;; unmodified, so each resolves to its clotran name (Eval.f90 canon_class).
(require '[clojure.edn :as edn] '[clojure.string :as str])
(def table-file "src/clj/clotran/class-aliases.edn")
(def inc-file "src/f/classalias.inc")
(def table (into (sorted-map) (edn/read-string (slurp table-file))))
(let [targets (group-by val table)]
  (doseq [[t ns] targets :when (> (count ns) 1)
          :when (not (#{"clotran.host.bigint" "clotran.host.decimal" "clotran.host.map_entry"} t))]
    (binding [*out* *err*] (println "class-names: two names become" t ":" (mapv key ns)))
    (System/exit 1)))
;; bare names: a simple name that names exactly one clotran class resolves by
;; itself -- ArityException, which the host raises bare, is clojure.lang's
(def simple (into (sorted-map)
  (for [[s ks] (group-by #(last (str/split % #"\.")) (keys table))
        :let [ts (distinct (map table ks))] :when (= 1 (count ts))]
    [s (first ts)])))
(def width (apply max (map (comp count key) table)))
(def swidth (apply max (map (comp count key) simple)))
(def twidth (apply max (map (comp count val) table)))
(defn fstr [s w] (str "\"" s (apply str (repeat (- w (count s)) " ")) "\""))
(def text
  (str "! GENERATED by scripts/class-names from " table-file " -- do not edit.\n"
       "! The JVM and clojure.lang class names clotran takes as INPUT, sorted, and\n"
       "! the clotran name each one resolves to (canon_class, class_alias).\n"
       "  integer, parameter :: N_CLASS_ALIASES = " (count table) "\n"
       "  character(len=" width "), parameter :: CLASS_ALIAS_FROM(N_CLASS_ALIASES) = [character(len=" width ") :: &\n"
       (str/join ", &\n" (map #(str "       " (fstr (key %) width)) table)) "]\n"
       "  character(len=" twidth "), parameter :: CLASS_ALIAS_TO(N_CLASS_ALIASES) = [character(len=" twidth ") :: &\n"
       (str/join ", &\n" (map #(str "       " (fstr (val %) twidth)) table)) "]\n"
       "  integer, parameter :: N_CLASS_SIMPLE = " (count simple) "\n"
       "  character(len=" swidth "), parameter :: CLASS_SIMPLE_FROM(N_CLASS_SIMPLE) = [character(len=" swidth ") :: &\n"
       (str/join ", &\n" (map #(str "       " (fstr (key %) swidth)) simple)) "]\n"
       "  character(len=" twidth "), parameter :: CLASS_SIMPLE_TO(N_CLASS_SIMPLE) = [character(len=" twidth ") :: &\n"
       (str/join ", &\n" (map #(str "       " (fstr (val %) twidth)) simple)) "]\n"))
(if (= "--check" (first *command-line-args*))
  (when (not= text (try (slurp inc-file) (catch Exception _ "")))
    (println "src/f/classalias.inc is out of date: run scripts/class-names")
    (System/exit 1))
  (do (spit inc-file text) (println "wrote" inc-file ":" (count table) "names")))
