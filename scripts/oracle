#!/usr/bin/env bb
;; Differential test: the same forms through real Clojure and through
;; clotran, values compared. `clj` is the oracle. Memory is not.
;;
;;   scripts/oracle [forms.clj]          default test/clj/oracle.clj
;;
;; The file is ordinary Clojure, evaluated top to bottom in ONE process
;; on each side, so a def early on is visible to a form later. Every
;; top-level form is a case. Two kinds are special:
;;
;;   - a form headed by def, defn, deftype, ns, require, ... (see
;;     `setup-heads`) is SETUP: run on both sides, its value not
;;     compared, because a Var prints differently per host. It still
;;     prints one line, so a setup form that throws on one side is a
;;     difference, not a silent misalignment.
;;   - (expect-diff "why") marks the NEXT form as one that must DIFFER.
;;     It records a deviation (DEVIATIONS.md) and turns red the day the
;;     deviation quietly closes, so the ledger stays honest.
;;
;; Values are compared through `canon`, a printer that sorts sets and
;; maps by the text of their elements: hash order is not part of the
;; language (DEVIATIONS 15), everything else is. A throw prints as
;; !error, so both sides throwing is agreement. Each form is fed to
;; `eval` as a string, so an error at analysis (a macro that fails to
;; expand) is caught like any other and the two outputs stay aligned.
;;
;; Non-zero exit on any unexpected difference. `make test` runs this.
(require '[clojure.string :as str]
         '[clojure.walk :as walk]
         '[clojure.java.io :as io]
         '[edamame.core :as e]
         '[babashka.process :as p])

(def repo (-> *file* io/file .getCanonicalFile .getParentFile .getParentFile))

;; clj names classes as its host does, clotran its own way. Each form
;; goes to clj in upstream's names (upstream/names.clj to-upstream) and
;; clj's answer comes back in clotran's (from-clj), so a case checks the
;; same fact on both sides, under each one's name for the class.
(load-file (str (io/file repo "upstream" "names.clj")))

(def forms-file (or (first *command-line-args*) "test/clj/oracle.clj"))

(def setup-heads '#{def defn defn- defmacro deftype defrecord defprotocol defmulti
                    defmethod defstruct defonce ns in-ns require alias import declare
                    extend extend-type extend-protocol use refer})

;; edamame, because it reads every reader macro clj does (#"", #(), `,
;; #', @, ^) and bb's own `read` overflows its pushback buffer on this
;; file. One difference worth knowing: its syntax-quote leaves symbols
;; unqualified and expands to `sequence` rather than `seq`.
(defn read-forms [text] (e/parse-string-all text {:all true}))

(defn strip-positions [form]
  (walk/postwalk (fn [x] (if-let [m (and (instance? clojure.lang.IObj x) (meta x))]
                           (let [m (dissoc m :row :col :end-row :end-col :line :column :end-line :end-column :source)]
                             (with-meta x (when (seq m) m)))
                           x))
                 form))

(defn form-text [form] (binding [*print-meta* true] (pr-str (strip-positions form))))

;; Pair each case with an optional expect-diff reason.
(defn cases [forms]
  (loop [fs forms acc [] why nil]
    (if-let [f (first fs)]
      (if (and (seq? f) (= 'expect-diff (first f)))
        (recur (rest fs) acc (second f))
        (recur (rest fs)
               (conj acc {:form f :text (form-text f) :why why
                          :setup? (boolean (and (seq? f) (contains? setup-heads (first f))))})
               nil))
      acc)))

(def prelude "
(defn clotran-oracle-canon [x]
  (cond (or (uuid? x) (tagged-literal? x)) (pr-str x)
        (map? x) (str \"{\" (clojure.string/join \", \" (sort (map (fn [e] (str (clotran-oracle-canon (key e)) \" \" (clotran-oracle-canon (val e)))) x))) \"}\")
        (set? x) (str \"#{\" (clojure.string/join \" \" (sort (map clotran-oracle-canon x))) \"}\")
        (vector? x) (str \"[\" (clojure.string/join \" \" (map clotran-oracle-canon x)) \"]\")
        (sequential? x) (str \"(\" (clojure.string/join \" \" (map clotran-oracle-canon x)) \")\")
        :else (pr-str x)))
(defn clotran-oracle-case [s]
  (println (try (clotran-oracle-canon (eval (read-string s))) (catch clotran.host.throwable t \"!error\"))))
(defn clotran-oracle-setup [s]
  (println (try (do (eval (read-string s)) \"#setup\") (catch clotran.host.throwable t \"!error\"))))
")

(defn script [cs & [translate]]
  (str "(in-ns 'user)\n(require 'clojure.string)\n" ((or translate identity) prelude)
       (str/join "\n" (for [c cs]
                        ;; qualified: a setup form may (ns elsewhere)
                        (str (if (:setup? c) "(user/clotran-oracle-setup " "(user/clotran-oracle-case ")
                             (pr-str ((or translate identity) (:text c))) ")")))
       ;; clj's agent pool is non-daemon: without this a case that sends
       ;; keeps the JVM alive and the oracle waits forever
       "\n(shutdown-agents)\n"))

(defn run [& cmd]
  (let [r (apply p/shell {:dir repo :in "" :out :string :err :string :continue true} cmd)]
    (->> (str/split-lines (:out r))
         (remove #(or (str/starts-with? % "note:") (str/starts-with? % "user=>") (str/blank? %)))
         vec)))

;; ORACLE_GC=n: no clj. The same script through clotran twice -- as it
;; is, and collecting every n allocations -- and the answers compared.
;; A value the collector frees while it is still in use shows up only
;; when a collection lands on the wrong allocation, which is where the
;; heap's layout put it that run: one oracle run in a hundred (PLAN step
;; 20). Collecting every n allocations lands one on every n-th, the same
;; places each time. Run in a directory of its own under build/, so the
;; file case's build/oracle-io-*.txt is not the plain oracle's.
(when-let [every (System/getenv "ORACLE_GC")]
  
(let [cs (cases (read-forms (slurp (io/file repo forms-file))))
        dir (io/file repo "build" "oracle-gc")
        _ (.mkdirs (io/file dir "build"))
        gen (io/file dir "gen.clj")
        _ (spit gen (script cs))
        bin (str repo "/clotran-bin")
        core (str repo "/src/clj/clojure/core.clj")
        go (fn [env] (let [r (p/shell {:dir (str dir) :in "" :out :string :err :string :continue true :extra-env env}
                                      bin core (str gen))]
                       (->> (str/split-lines (:out r))
                            (remove #(or (str/starts-with? % "note:") (str/starts-with? % "user=>") (str/blank? %)))
                            (mapv #(str/replace % #"0x[0-9a-f]+" "0x")))))
        plain (go {})
        tortured (go {"CLOTRAN_GC_EVERY" every})
        diffs (keep-indexed (fn [i c] (let [a (nth plain i ::missing) b (nth tortured i ::missing)]
                                        (when (not= a b) [c a b])))
                            cs)]
    (doseq [[c a b] (take 10 diffs)]
      (println "DIFFER   " (:text c))
      (println "   plain:  " a)
      (println "   every" every ":" b))
    (println (str "oracle-gc: " (count cs) " cases, collecting every " every " allocations: "
                  (count diffs) " differ from the plain run"))
    (System/exit (if (seq diffs) 1 0))))

(let [cs (cases (read-forms (slurp (io/file repo forms-file))))
      gen (io/file repo "test/clj/.oracle-gen.clj")
      _ (spit gen (script cs))
      clj-gen (io/file repo "test/clj/.oracle-gen-clj.clj")
      _ (spit clj-gen (script cs names/to-upstream))
      ;; the two sides at once: neither reads what the other writes
      want-f (future (run "clj" "-Sdeps" (slurp (io/file repo "deps.edn")) "-M" (str clj-gen)))
      got (run "./clotran-bin" "src/clj/clojure/core.clj" (str gen))
      raw @want-f
      want (mapv names/from-clj raw)
      _ (when (System/getenv "ORACLE_KEEP") nil) _ (when-not (System/getenv "ORACLE_KEEP") (.delete gen) (.delete clj-gen))
      n (count cs)]
  (when (not= (count want) n)
    (println "clj produced" (count want) "lines for" n "cases; the oracle side is broken:")
    (doseq [l (take 5 want)] (println "  " l))
    (System/exit 2))
  (let [results (map-indexed (fn [i c]
                               ;; clj's line as it is, or with its class names in clotran's:
                               ;; a quoted java.util.Map is a symbol, not a class
                               (let [w (nth want i) g (nth got i ::missing)
                                     same (or (= w g) (= (nth raw i) g))]
                                 (assoc c :want w :got g
                                        :ok (if (:why c) (not same) same))))
                             cs)
        bad (remove :ok results)]
    (doseq [r bad]
      (println (if (:why r) "SHOULD DIFFER" "DIFFER      ") (:text r))
      (println "   clojure:" (:want r))
      (println "   clotran:" (if (= ::missing (:got r)) "<no output: clotran stopped early>" (:got r)))
      (when (:why r) (println "   expected to differ because:" (:why r))))
    (println "---")
    (println (format "oracle: %d cases, %d agree, %d expected differences, %d unexpected"
                     n (count (filter #(and (:ok %) (not (:why %))) results))
                     (count (filter #(and (:ok %) (:why %)) results)) (count bad)))
    (System/exit (if (seq bad) 1 0))))
