#!/usr/bin/env bb
;; fuzz-exec-gen: the GENERATED tree evaluator's decisions
;; (src/f/gen/exec_gen.inc, written by scripts/acl2-fortran -b exec from
;; model/exec.lisp) against the ACL2 they were generated from.
;;
;;   scripts/fuzz-exec-gen [-n COUNT] [-s SEED] [-x] [--fc gfortran|flang]
;;
;; Random cases: a record's node kind (the core's sixteen -- throw, try,
;; case* and the collections among them -- and others), its
;; pc and i, the node's count of children and its operand, whether the
;; value in flight is truthy, and k_finish's restart flag and marker; and a
;; call's callee: one to four arities, fixed and variadic, of 0 to 4 fixed
;; parameters (a multi-arity fn, a variadic one, both, two that could fit),
;; the call's count and whether the callee is one of the machine's closures;
;; and apply: its way, and its walk over a seq of each kind (model/seqk.lisp:
;; a list, a vector, a lazy seq of cells ending in nothing, a list or a
;; vector), ACL2's realisation attached (defattach) -- the walk's way, its
;; fixed arguments, its rest and how many realisations it makes.
;; ACL2 runs ex-act, ex-kid, ex-pc, ex-i, ex-fin, ex-arity (the arity the
;; count picks) and ex-entry; test/exec/exec_check runs the generated
;; Fortran, the arity picked by exec.inc pick_arity's walk over ex_arfit;
;; both print every answer, and they must agree.
;;
;; -x is the NEGATIVE CONTROL: the Fortran side reads the value's
;; truthiness the wrong way round, every record as restarting and every
;; arity's variadic flag reversed, and the answers must part.
(require '[babashka.process :as p] '[clojure.string :as str] '[babashka.fs :as fs])

(def broken (some #{"-x"} *command-line-args*))
(def args (apply hash-map (remove #{"-x"} *command-line-args*)))
(def n (parse-long (get args "-n" "300")))
(def seed (parse-long (get args "-s" (str (mod (System/nanoTime) 2147483647)))))
(def fc (get args "--fc" "gfortran"))
(def work (str (fs/create-temp-dir {:prefix "fuzz-exec-gen"})))

;; the house LCG: every case reproduces from its seed
(def rng (atom seed))
(defn rnd [k]
  (let [x (swap! rng #(unchecked-add (unchecked-multiply % 6364136223846793005) 1442695040888963407))]
    (mod (bit-shift-right x 33) (max k 1))))
(defn pick [xs] (nth xs (rnd (count xs))))

(defn gen-case []
  (let [nk (pick [0 1 2 2 3 3 4 5 9])]
    {:k (pick [1 2 3 4 4 4 5 5 5 6 6 6 6 6 11 11 11 12 12 12 14 16 16 16 17 17 18 18 18 18 19 19 19 7 7 8 8 9 9 0 -1])
     :pc (pick [0 0 1 1 2 2 3 4 5 -1])
     :i (pick [0 0 1 2 3 4 8 -1 (dec nk) nk])
     :nk nk :n2 (pick [0 1 2 3 4 -1 (dec nk)])
     :tv (rnd 2) :rf (rnd 2) :mk (pick [0 1 1 2])
     ;; the callee's arities [nf vr], up to 4, and the call's count
     :ars (vec (repeatedly (inc (rnd 4)) (fn [] [(pick [0 1 1 2 2 3 4 -1]) (pick [0 0 0 1])])))
     :m (pick [0 1 1 2 2 3 4 5 -1]) :cl (pick [1 1 1 0 2])
     ;; an apply: whether the callee is apply, its count, whether the fn is a
     ;; closure and the last a seq; and its walk: the variadic arity's req
     ;; (-1 none), the leading arguments k and the seq's length
     :ap (pick [1 1 1 0 2]) :an (pick [0 1 2 2 3 4 -1]) :fk (pick [1 1 1 0 2]) :sq (pick [1 1 1 0 2])
     :req (pick [-1 0 1 1 2 3]) :ak (pick [0 0 1 2 3 4]) :al (pick [0 1 2 3 5])
     ;; the seq's kind (model/seqk.lisp): 1 a list of al, 2 a vector of al, 3
     ;; a lazy seq of al cells, then a tail tk -- 0 none, 1 a list, 2 a vector
     ;; (a lazy seq delegating to it) -- of l2
     :sk (pick [1 2 2 3 3 3]) :tk (pick [0 1 2]) :l2 (pick [0 1 2 4])
     ;; k_unwind's: whether a catch takes the throw, whether the try has a finally
     :mt (pick [0 1 1 2]) :fin (rnd 2)}))

(def cases (vec (repeatedly n gen-case)))
(defn row [{:keys [k pc i nk n2 tv]}] (str/join " " [k pc i nk n2 tv]))
(defn arow [{:keys [ars m cl ap an fk sq req ak al sk tk l2 mt fin]}]
  (str/join " " (concat [(count ars)] (flatten (take 4 (concat ars (repeat [0 0])))) [m cl ap an fk sq req ak al sk tk l2 mt fin])))
;; the arities as ACL2 reads a template's: (nf variadic index), the index
;; in the start slot so the pick names its place
(defn acl2-ars [{:keys [ars]}]
  (str "'(" (str/join " " (map-indexed (fn [j [nf vr]] (str "(" nf (if (= vr 1) " t " " nil ") j ")")) ars)) ")"))

;; ---- what ACL2 answers -------------------------------------------------------------------

(defn acl2-case [j {:keys [rf mk] :as c}]
  (let [as (row c)]
    (str "(cw \"~%CASE " j " ~x0~%\" (let ((a (ex-arity " (acl2-ars c) " " (:m c) ")))"
         " (append (list (ex-act " as ") (ex-kid " as ") (ex-pc " as ") (ex-i " as ") (ex-fin " rf " " mk ")"
         " (if a (nth 2 a) -1) (ex-entry " (:cl c) " (if a 1 0))"
         " (ex-apentry " (str/join " " (map c [:ap :an :fk :sq])) ")"
         ") (fz-walk " (str/join " " (map c [:req :ak :sk :al :tk :l2])) ") (list (ex-unw " (:k c) " " (:pc c) " " (:mt c) " " (:fin c) ")))))\n")))

(def driver
  (str "(include-book \"exec-proof\")\n"
       "(set-print-case :downcase state)\n"
       "(set-iprint nil)\n"
       ;; the runtime's realisation, for the fuzzer: a lazy seq (:lazy lc tk
       ;; l2) is lc cells, each realising to a cell whose rest is the next,
       ;; then its tail -- none, a list or a vector of l2 (a delegation)
       "(defun fz-real (c) (declare (xargs :guard t))
          (let* ((c (if (true-listp c) c nil)) (lc (nfix (nth 0 c))) (tk (nth 1 c)) (l2 (nfix (nth 2 c))))
            (cond ((not (zp lc)) (list* :cons 7 :lazy (1- lc) tk l2 nil))
                  ((equal tk 1) (make-list l2 :initial-element 7))
                  ((equal tk 2) (cons :vec (make-list l2 :initial-element 7)))
                  (t nil))))\n"
       "(defattach sk-real fz-real)\n"
       ;; the walk's way, its fixed arguments' count, its rest's elements and its realisations
       "(defun fz-walk (req ak sk al tk l2)
          (let* ((v (case sk (1 (make-list al :initial-element 7)) (2 (cons :vec (make-list al :initial-element 7)))
                              (t (list :lazy al tk l2))))
                 (w (ex-apwalk req (make-list ak :initial-element 7) (sk-cur v))))
            (if (equal (car w) 2)
                (list 2 (len (cadr w)) (+ (len (caddr w)) (len (cdr (sk-els (cadddr w) 1000)))) (nfix (nth 4 w)))
              (list 3 (+ (len (cadr w)) (len (cdr (sk-els (caddr w) 1000)))) 0 (nfix (nth 4 w))))))\n"
       (str/join (map-indexed acl2-case cases))
       "(good-bye)\n"))

(def acl2 (let [a (or (System/getenv "ACL2") (str (fs/parent (fs/parent (fs/parent (fs/canonicalize *file*)))) "/acl2/saved_acl2"))]
            (if (fs/exists? a) a (str (fs/home) "/clotran/acl2/saved_acl2"))))
(def out (:out (p/shell {:dir "model" :in driver :out :string :err :string} acl2)))
(def expected
  (into {} (for [[_ c l] (re-seq #"CASE (\d+) \(([-\d\s]*)\)" (str/replace out #"\s*\n\s*" " "))]
             [(parse-long c) (mapv parse-long (remove str/blank? (str/split l #"\s+")))])))
(when (not= (count expected) n)
  (println (str "fuzz-exec-gen: ACL2 answered " (count expected) " of " n " cases; its output ends:"))
  (println (subs out (max 0 (- (count out) 3000))))
  (System/exit 1))

;; ---- the generated code ------------------------------------------------------------------

(let [r (p/shell {:continue true :out :string :err :string :extra-env (if (System/getenv "ACL2") {} {"ACL2" acl2})}
                 "scripts/acl2-fortran" "-b" "exec" "-o" (str work "/exec_gen.inc"))]
  (when-not (zero? (:exit r)) (println (:out r) (:err r)) (System/exit 1)))
(fs/copy "test/exec/exec_check.f90" (str work "/exec_check.f90"))
(def exe (str work "/exec_check"))
(let [r (apply p/shell {:continue true :out :string :err :string :dir work} fc
               (concat ["-O2"] (when (= fc "gfortran") ["-frecursive" "-ffree-line-length-none"]) ["-o" exe "exec_check.f90"]))]
  (when-not (zero? (:exit r)) (println (:err r) (:out r)) (System/exit 1)))

(def case-file (str work "/cases.txt"))
(spit case-file (str/join (for [{:keys [rf mk] :as c} cases] (str (row c) " " rf " " mk " " (arow c) "\n"))))
(def got (let [r (apply p/shell {:continue true :out :string :err :string} exe case-file (when broken ["broken"]))]
           (mapv (fn [l] (mapv parse-long (str/split (str/trim l) #"\s+"))) (str/split-lines (str/trim (:out r))))))
(def results (vec (for [k (range n)] {:k k :got (get got k) :want (expected k) :ok (= (get got k) (expected k))})))
(def bad (remove :ok results))
(println (str n " cases, seed " seed (when broken " (negative control: truthiness reversed, every record restarting, variadic flags reversed, apply's callee and its seq's end misread, catches' matches reversed)")))
(println (str "  by action: "
              (str/join ", " (for [[a c] (sort (frequencies (map #(first (:want %)) results)))] (str a ":" c)))
              "; restarts " (count (filter #(= 1 (nth (:want %) 4)) results))
              "; arity picked " (count (filter #(<= 0 (nth (:want %) 5)) results))
              ", by entry " (str/join "," (for [[a c] (sort (frequencies (map #(nth (:want %) 6) results)))] (str a ":" c)))
              "; apply by way " (str/join "," (for [[a c] (sort (frequencies (map #(nth (:want %) 7) results)))] (str a ":" c)))
              ", walks handing the rest over " (count (filter #(= 2 (nth (:want %) 8)) results))
              ", by seq kind " (str/join "," (for [[a c] (sort (frequencies (map :sk cases)))] (str a ":" c)))
              ", realising " (count (filter #(pos? (nth (:want %) 11)) results))))
(println (str "generated tree-evaluator decisions against ACL2's: " (count bad) " cases differ"))
(doseq [b (take 3 bad)]
  (println "  case" (:k b) (pr-str (nth cases (:k b))))
  (println "    ACL2     " (pr-str (:want b)))
  (println "    generated" (pr-str (:got b))))
(System/exit (if (if broken (empty? bad) (seq bad)) 1 0))
