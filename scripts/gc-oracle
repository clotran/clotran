#!/bin/sh
# Diffs the GC-backed evaluator against real Clojure, using babashka as
# the oracle -- the same role gfortran plays for flang. Memory is not a
# specification; bb is.
#
#   scripts/gc-oracle [file-of-expressions]
#
# One expression per line. Each is evaluated by both and the printed
# results compared. Expressions using anything clotran-gc does not have
# yet will differ, which is the point: the diff IS the todo list.
set -e
cd "$(dirname "$0")/.."
[ -x ./clotran-gc ] || make clotran-gc >/dev/null 2>&1
exprs="${1:-test/clj/gc_oracle.clj}"
pass=0; fail=0

while IFS= read -r e; do
  case "$e" in ''|';'*) continue;; esac
  want=$(bb -e "(prn $e)" 2>&1 | tail -1)
  got=$(printf '%s\n' "$e" | ./clotran-gc 2>&1 | tail -2 | head -1 | sed 's/^user=> //')
  if [ "$want" = "$got" ]; then
    pass=$((pass + 1))
  else
    fail=$((fail + 1))
    printf '%-44s clojure=%-22s clotran=%s\n' "$e" "$want" "$got"
  fi
done < "$exprs"
echo "---"
printf 'agree=%s  differ=%s\n' "$pass" "$fail"
