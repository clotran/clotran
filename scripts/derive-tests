#!/usr/bin/env bb
;; Derives clotran's LANGUAGE test suite from Clojure's own, mechanically.
;;
;;   scripts/derive-tests --report      classify, print counts, write nothing
;;   scripts/derive-tests               write test/clj/derived/*.clj
;;   DERIVE_WHY=test-name ...           also print what put that test in its bucket
;;
;; THE RULE. The language is the intersection of two implementations:
;; the public names of clojure.core (the pinned clone we vendor) and of
;; cljs.core (the pinned ClojureScript clone). A deftest whose symbols
;; all fall inside that set -- plus clojure.test, the portable libs, the
;; special forms and a short allowlist of exception classes -- is a
;; LANGUAGE test. One that names a Java class, a member call, a
;; constructor, or a clojure.core public that ClojureScript never had is
;; a HOST test and is left out -- whether it names it directly, in a
;; type hint, in a syntax-quoted helper macro, in a quoted namespace
;; name, or in code it hands to `eval`. Between the two sits CONCURRENCY: refs,
;; agents, futures, STM -- Clojure-only, but a stated goal (PLAN.md), so
;; they are kept in their own bucket rather than discarded.
;;
;; Nothing is hand-listed except the exception allowlist and the
;; concurrency vocabulary; both are printed by --report so they can be
;; argued with. The vendored tree is never edited: the derived files
;; carry the source file and line of every test they keep, and the
;; derivation re-runs on the next Clojure release.
(require '[clojure.string :as str]
         '[clojure.java.io :as io]
         '[clojure.walk :as walk]
         '[edamame.core :as e])

(def repo (-> *file* io/file .getCanonicalFile .getParentFile .getParentFile))
(def home (System/getProperty "user.home"))
;; core.clj and the files it (load)s: defrecord, defprotocol and
;; print-method live in the siblings, not in core.clj itself.
(def core-clj-files (map #(io/file repo "src/clj/clojure" %)
                         ["core.clj" "core_deftype.clj" "core_print.clj" "core/protocols.clj"]))
(def core-cljs (io/file home "jborden/clojurescript/src/main/cljs/cljs/core.cljs"))
(def core-cljc (io/file home "jborden/clojurescript/src/main/clojure/cljs/core.cljc"))
(def suite-dir (io/file repo "test/clj/clojure/test_clojure"))
(def out-dir   (io/file repo "test/clj/derived"))

;; Any tagged literal (#js {...}, a record literal) reads as its payload;
;; reader conditionals take the :clj branch. Neither affects which
;; symbols a form mentions, which is all this script reads. A symbol a
;; syntax-quote would resolve -- `(binding [*unchecked-math* ..]) in a
;; helper macro -- comes out as sq/*unchecked-math*, so it is told apart
;; from a hand-quoted 'symbol (data) and judged as the bare name.
(defn parse [f]
  (try (e/parse-string-all (slurp f) {:all true :end-location true :auto-resolve name
                                       :syntax-quote {:resolve-symbol (fn [s] (if (namespace s) s (symbol "sq" (name s))))}
                                       :readers (fn [_tag] (fn [v] (list (quote clotran-tagged-literal) v)))
                                       :read-cond :allow :features #{:clj}})
       (catch Exception ex (println "  cannot parse" (str f) ":" (.getMessage ex)) nil)))

(def def-heads '#{def defn defmacro definline defmulti defonce defprotocol deftype defrecord
                  defn- core/defmacro core/defn core/def defcurried})

;; Public names defined at top level. `defn-` and ^:private are not public.
;; cljs/core.cljc borrows a dozen macros from clojure.core by name --
;; (import-macros clojure.core [-> when ...]) -- and those count too.
(defn public-names [forms]
  (into #{} (mapcat (fn [f]
                      (cond
                        (and (seq? f) (contains? def-heads (first f)) (symbol? (second f))
                             (not= 'defn- (first f)) (not (:private (meta (second f)))))
                        [(second f)]
                        (and (seq? f) (= 'import-macros (first f)))
                        (filter symbol? (nth f 2 nil))
                        ;; (defmethod assert-expr 'thrown-with-cause-msg? ...) makes
                        ;; that symbol usable inside (is ...)
                        (and (seq? f) (= 'defmethod (first f)) (seq? (nth f 2 nil))
                             (= 'quote (first (nth f 2))) (symbol? (second (nth f 2))))
                        [(second (nth f 2))]
                        :else nil))
                    forms)))

;; ns is a macro on the JVM and a special form in ClojureScript; either way both have it.
(def specials '#{if do let* fn* quote var def loop* recur throw try catch finally new . set!
                 letfn* case* deftype* reify* & monitor-enter monitor-exit import* clojure.core/import* ns})

(def portable-libs #{"clojure.core" "clojure.test" "clojure.string" "clojure.set" "clojure.walk"
                     "clojure.template" "clojure.zip" "clojure.data" "clojure.edn" "clojure.pprint"
                     "clojure.math" "clojure.test-helper" "clojure.test-clojure.test-helper"})

;; What clojure.test refers into every test namespace. Listed because
;; (:require [clojure.test :refer :all]) cannot be enumerated from the
;; ns form; clojure.test-helper's publics are read from its file.
(def test-vocab
  '#{deftest deftest- testing is are thrown? thrown-with-msg? use-fixtures compose-fixtures
     join-fixtures set-test with-test run-tests run-all-tests run-test test-var test-vars
     test-all-vars successful? do-report inc-report-counter report assert-expr try-expr
     testing-vars-str testing-contexts-str file-position function? *load-tests* *stack-trace-depth*
     *report-counters* *testing-vars* *testing-contexts* *test-out* with-test-out})

;; Exceptions whose CLASS NAME is how Clojure spells a language-level
;; failure -- (thrown? ArityException ...) is about arity, not about Java.
(def exception-allowlist
  '#{Exception Throwable RuntimeException Error IllegalArgumentException IllegalStateException
     ArithmeticException ClassCastException IndexOutOfBoundsException NullPointerException
     UnsupportedOperationException NumberFormatException StackOverflowError AssertionError
     ExceptionInfo ArityException clojure.lang.ExceptionInfo clojure.lang.ArityException
     Object})

(def concurrency-vocab
  '#{ref deref dosync alter commute ref-set ensure ref-history-count ref-min-history ref-max-history
     agent send send-off await await-for agent-error restart-agent set-error-handler!
     set-error-mode! error-handler error-mode shutdown-agents release-pending-sends
     future future-call future-cancel future-cancelled? future-done? future? pmap pcalls pvalues
     promise deliver locking add-watch remove-watch io! sync
     thread-bound? get-thread-bindings push-thread-bindings pop-thread-bindings
     Thread})

;; Host constants that spell LANGUAGE-level numeric facts: Clojure's
;; integers are 64-bit longs and its doubles IEEE, and so are clotran's.
(def numeric-constants
  '#{Long/MAX_VALUE Long/MIN_VALUE Integer/MAX_VALUE Integer/MIN_VALUE
     Double/MAX_VALUE Double/MIN_VALUE Double/POSITIVE_INFINITY Double/NEGATIVE_INFINITY Double/NaN})

(defn capitalized? [s] (let [c (first (name s))] (and c (Character/isUpperCase c))))

(defn require-specs [ns-form]
  (for [clause (drop 2 ns-form)
        :when (and (seq? clause) (#{:require :use} (first clause)))
        spec (rest clause)
        :let [[lib & {:as opts}] (if (vector? spec) spec [spec])]]
    {:lib (name lib) :as (some-> (:as opts) name) :refer (:refer opts) :use? (= :use (first clause))}))

(defn ns-aliases [ns-form]
  (into {} (for [{:keys [lib as]} (require-specs ns-form) :when as] [as lib])))

;; Every symbol a form USES. A quoted collection is data, not a use, and
;; so is a quoted bare symbol -- with three exceptions. A quoted QUALIFIED
;; symbol is kept: edamame expands a syntax-quote template into (quote
;; gen/fmap) and that is a reference to a library, alias and all. A quoted
;; bare symbol spelled clojure.something names a NAMESPACE, and a
;; namespace we do not have is host (metadata.clj enumerates
;; clojure.java.io's publics). And the argument of `eval` is CODE that
;; happens to be quoted -- but code a test evaluates is where it puts
;; the symbols it MEANS to leave unbound, (eval '(let [{:keys! [a & :b]}
;; m] b)), so only what looks like a class, a member or a namespace
;; counts there: (eval '(fn [^some.Class c])) uses the class. A symbol's
;; :tag is a use too -- the class a hint names.
(defn class-like? [s]
  (or (namespace s) (capitalized? s) (str/includes? (name s) ".")))

(defn unsq [s] (if (= "sq" (namespace s)) (symbol (name s)) s))

(defn symbols-in [form]
  (let [acc (atom [])
        use! (fn [s code?]
               (let [s (unsq s)]
                 (when (and (not (str/ends-with? (name s) "__auto__"))   ; a gensym
                            (or (not code?) (class-like? s)))
                   (swap! acc conj s))))
        walk (fn walk [x code?]
               (when-let [tag (and (instance? clojure.lang.IObj x) (:tag (meta x)))]
                 (when (symbol? tag) (use! tag false)))
               (cond (symbol? x) (use! x code?)
                     (and (seq? x) (= 'quote (first x)))
                     (let [q (second x)]
                       (cond code? (walk q true)
                             (and (symbol? q) (or (namespace q) (str/starts-with? (name q) "clojure.")))
                             (use! q false)
                             (coll? q) (doseq [y (flatten (seq q))]
                                         (when (and (symbol? y) (str/starts-with? (name y) "clojure."))
                                           (swap! acc conj y)))))
                     (and (seq? x) (= 'eval (first x)))
                     (doseq [y (rest x)] (walk y true))
                     ;; the name a def introduces is not a use of it
                     (and (seq? x) (contains? def-heads (first x)) (symbol? (second x)))
                     (doseq [y (cons (first x) (drop 2 x))] (walk y code?))
                     (coll? x) (doseq [y x] (walk y code?))))]
    (walk form false)
    @acc))

;; Symbols that appear inside any vector literal of a form: an
;; over-approximation of its binding positions (fn params, let/loop/for
;; bindings, catch names, destructuring), used to tell a local from a
;; name nothing defines. A symbol outside every vector that resolves to
;; nothing is HOST: (vector-of :int) names gvec, (doc x) names
;; clojure.repl, and neither is here.
(defn vector-bound [form]
  (let [acc (atom #{})
        ;; symbols directly in the vector, or in nested vectors/maps
        ;; (destructuring) -- but not inside a list, which is a call
        grab (fn grab [x]
               (cond (symbol? x) (swap! acc conj x)
                     (seq? x) nil
                     (coll? x) (doseq [y x] (grab y))))]
    (walk/postwalk (fn [x]
                     (cond (vector? x) (grab x)
                           ;; the two binders that do not use a vector
                           (and (seq? x) (= 'catch (first x)) (>= (count x) 3)) (grab (nth x 2))
                           (and (seq? x) (= 'as-> (first x)) (>= (count x) 3)) (grab (nth x 2)))
                     x)
                   form)
    @acc))

;; Why a symbol is outside the language, or nil if it is inside.
(defn offence [sym {:keys [aliases local-names core-only-names lang dropped bound helper-vocab self-ns] :as ctx}]
  (let [n (name sym) nsp (namespace sym)]
    (cond
      ;; the file's own namespace: naming it is fine, and a name
      ;; qualified with it is judged as the bare name would be
      (and self-ns (= n self-ns) (nil? nsp)) nil
      (and self-ns (= nsp self-ns)) (offence (symbol n) (dissoc ctx :self-ns))
      (= sym 'clotran-tagged-literal) [:host sym]     ; #tag{...}: no tagged literals here
      (contains? numeric-constants sym) nil
      ;; a quoted namespace name: ours, or not here
      (and (nil? nsp) (str/starts-with? n "clojure.") (not (str/ends-with? n "."))
           (not (contains? exception-allowlist sym)))
      (if (contains? portable-libs n) nil [:host sym])
      nsp (let [nsp (get aliases nsp nsp)]
            (cond ;; clojure.core/x names x, and x had better be the language's:
                  ;; a syntax-quoted *unchecked-math* is the JVM's compiler flag
                  (= nsp "clojure.core") (when-not (or (contains? lang (symbol n)) (contains? specials (symbol n)))
                                           (if (contains? concurrency-vocab (symbol n)) [:concurrency sym] [:host sym]))
                  (contains? portable-libs nsp) nil
                  ;; a class, however lowercase its package: compilation.JDK8InterfaceMethods/staticMethod0
                  (or (capitalized? (symbol nsp)) (capitalized? (symbol (last (str/split nsp #"\."))))
                      (str/starts-with? nsp "java.")
                      (str/starts-with? nsp "clojure.lang")) [:host sym]
                  (str/starts-with? nsp "clojure.") [:host sym]   ; clojure.java.io, clojure.reflect ...
                  :else nil))                                    ; a test's own helper ns
      (str/starts-with? n ".") (if (= n ".") nil [:host sym])
      (and (> (count n) 1) (str/ends-with? n "."))
      (if (contains? exception-allowlist (symbol (subs n 0 (dec (count n))))) nil [:host sym])
      (contains? specials sym) nil
      (contains? lang sym) nil
      (contains? concurrency-vocab sym) [:concurrency sym]
      (contains? core-only-names sym) [:host sym]
      (contains? exception-allowlist sym) nil
      (contains? dropped sym) [:host sym]              ; defined by a helper that was itself host
      (contains? local-names sym) nil
      (contains? test-vocab sym) nil
      (contains? helper-vocab sym) nil
      (capitalized? sym) [:host sym]
      (contains? bound sym) nil                        ; a local, probably
      (= sym 'this) nil
      (= sym '&) nil
      :else [:host sym])))                             ; nothing defines it

;; A top-level form's HEAD must be something we can name: a special form,
;; a language or test name, or a definition in this file. An unknown head
;; -- test.check's defspec, generative's defspec -- is a library we do
;; not have, and the whole form goes with it.
(defn unknown-head [form {:keys [lang local-names helper-vocab]}]
  (when (and (seq? form) (symbol? (first form)) (nil? (namespace (first form))))
    (let [h (first form)]
      (when-not (or (contains? specials h) (contains? lang h) (contains? test-vocab h)
                    (contains? helper-vocab h) (contains? local-names h)
                    (contains? concurrency-vocab h))
        h))))

(defn bucket [form ctx]
  (let [ctx (assoc ctx :bound (vector-bound form))
        offs (keep #(offence % ctx) (symbols-in form))
        offs (if-let [h (unknown-head form ctx)] (cons [:host h] offs) offs)
        kinds (set (map first offs))]
    {:bucket (cond (kinds :host) :host (kinds :concurrency) :concurrency :else :language)
     :offences (distinct (map second offs))}))

(defn deftest? [f] (and (seq? f) (= 'deftest (first f))))
(defn ns-form? [f] (and (seq? f) (= 'ns (first f))))
(defn defined-name [f] (when (and (seq? f) (symbol? (first f)) (symbol? (second f))
                                  (str/starts-with? (name (first f)) "def"))
                         (second f)))

;; (declare a b c) defines every name it lists.
(defn local-names-in [forms]
  (into (set (keep defined-name forms))
        (for [f forms :when (and (seq? f) (= 'declare (first f))) s (rest f) :when (symbol? s)] s)))

;; Classify one file: helpers first, to a fixpoint (a helper using a dropped
;; helper is dropped too), then the tests against the surviving helpers.
(defn classify-file [forms ns-form base-ctx test-namespaces]
  (let [specs (when ns-form (require-specs ns-form))
        ;; a require of ANOTHER test file loads the vendored, JVM-shaped
        ;; original from the classpath, so it goes, and what it referred
        ;; becomes unavailable
        portable-lib? (fn [lib] (or (contains? portable-libs lib)
                                    (and (str/starts-with? lib "clojure.test-clojure")
                                         (not (contains? test-namespaces lib))
                                         (not= lib "clojure.test-clojure.generators"))))
        foreign (remove #(portable-lib? (:lib %)) specs)
        dropped0 (into #{} (for [s foreign, r (if (sequential? (:refer s)) (:refer s) [])] r))
        helpers (remove #(or (deftest? %) (ns-form? %)) forms)
        ctx0 (assoc base-ctx :local-names (local-names-in forms) :aliases (ns-aliases ns-form)
                    :self-ns (some-> ns-form second name))
        step (fn [dropped]
               (let [ctx (assoc ctx0 :dropped dropped)
                     bad (filter #(= :host (:bucket (bucket % ctx))) helpers)]
                 (into dropped (keep defined-name bad))))
        dropped (loop [d dropped0] (let [d2 (step d)] (if (= d d2) d (recur d2))))
        ctx (assoc ctx0 :dropped dropped)
        kept-helpers (remove #(= :host (:bucket (bucket % ctx))) helpers)
        tests (for [t (filter deftest? forms)] (assoc (bucket t ctx) :form t))]
    ;; DERIVE_WHY=test-name prints what made that test host
    (when-let [why (System/getenv "DERIVE_WHY")]
      (doseq [t tests :when (= why (name (second (:form t))))]
        (println "WHY" why (:bucket t) (:offences t))))
    {:tests tests :helpers kept-helpers :dropped dropped
     :ns-clean (when ns-form
                 (let [portable? (fn [{:keys [lib]}]
                                   (or (contains? portable-libs lib)
                                       (and (str/starts-with? lib "clojure.test-clojure")
                                            (not (contains? test-namespaces lib))
                                            ;; wraps clojure.data.generators, a third-party artifact
                                            (not= lib "clojure.test-clojure.generators"))))]
                   (concat (take 2 ns-form)
                           (keep (fn [clause]
                                   (cond (not (seq? clause)) clause
                                         (= :import (first clause)) nil
                                         (#{:require :use} (first clause))
                                         (let [specs (filter (fn [spec] (portable? {:lib (name (if (vector? spec) (first spec) spec))}))
                                                             (rest clause))]
                                           (when (seq specs) (cons (first clause) specs)))
                                         :else clause))
                                 (drop 2 ns-form)))))}))

(let [report? (#{"--report" "--coverage"} (first *command-line-args*))
      coverage? (= "--coverage" (first *command-line-args*))
      clj-names  (reduce into #{} (map (comp public-names parse) core-clj-files))
      cljs-names (into (public-names (parse core-cljs)) (public-names (parse core-cljc)))
      lang (set (filter cljs-names clj-names))
      core-only (set (remove cljs-names clj-names))
      ;; less the helper that asserts the JVM compiler emitted no reflection
      ;; warning: there is no reflection here to warn about
      helper-vocab (disj (public-names (parse (io/file repo "test/clj/clojure/test_helper.clj"))) 'should-not-reflect)
      files (sort-by #(.getName %) (filter #(str/ends-with? (.getName %) ".clj") (.listFiles suite-dir)))
      parsed (for [f files :let [forms (parse f)] :when forms]
               {:file f :forms forms :ns-form (first (filter ns-form? forms))})
      test-namespaces (into #{} (keep #(some-> (:ns-form %) second name) parsed))
      base-ctx {:core-only-names core-only :lang lang :helper-vocab helper-vocab}
      offence-count (atom {})
      rows (for [{:keys [file forms ns-form]} parsed
                 :let [r (classify-file forms ns-form base-ctx test-namespaces)]]
             (do (doseq [t (:tests r) :when (= :host (:bucket t)) o (:offences t)]
                   (swap! offence-count update o (fnil inc 0)))
                 (assoc r :file file :counts (frequencies (map :bucket (:tests r))))))]
  (println (format "clojure.core publics %d, cljs.core publics %d, intersection (the language) %d, clojure-only %d"
                   (count clj-names) (count cljs-names) (count lang) (count core-only)))
  (println)
  (println (format "%-44s %5s %5s %5s %5s" "namespace" "tests" "lang" "conc" "host"))
  (doseq [{:keys [file counts]} rows]
    (let [n (reduce + (vals counts))]
      (println (format "%-44s %5d %5d %5d %5d" (.getName file) n (get counts :language 0)
                       (get counts :concurrency 0) (get counts :host 0)))))
  (let [tot (apply merge-with + (map :counts rows)) n (reduce + (vals tot))]
    (println (format "%-44s %5d %5d %5d %5d" "TOTAL" n (:language tot 0) (:concurrency tot 0) (:host tot 0))))
  (when coverage?
    ;; The intersection is a LIST OF NAMES; this script's filter runs
    ;; over the tests that exist, which is not the same thing. A name
    ;; Clojure's suite never exercises is a name the derived suite
    ;; cannot exercise either -- int-array and object-array sat in
    ;; that gap and were both broken while the suite was green.
    ;; NOTES.md "The intersection is a list of NAMES" is the finding.
    (let [text  (fn [fs] (apply str (map slurp fs)))
          derived (text (filter #(str/ends-with? (.getName %) ".clj") (.listFiles out-dir)))
          ours    (text [(io/file repo "test/clj/oracle.clj")
                         (io/file repo "test/clj/language_test.clj")])
          tok   (fn [n] (re-pattern (str "(?<![A-Za-z0-9*+!_?<>=/.'-])"
                                         (java.util.regex.Pattern/quote (str n))
                                         "(?![A-Za-z0-9*+!_?<>=/.'-])")))
          in?   (fn [hay n] (boolean (re-find (tok n) hay)))
          d     (set (filter #(in? derived %) lang))
          o     (set (filter #(in? ours %) lang))
          gap   (sort (remove (into d o) lang))]
      (println)
      (println (format "intersection names                %4d" (count lang)))
      (println (format "named in the derived suite        %4d" (count d)))
      (println (format "named in oracle/language_test     %4d" (count o)))
      (println (format "named in NEITHER                  %4d" (count gap)))
      (println)
      (println (str/join " " gap))))
  (println)
  (println "most frequent symbols that made a test HOST:")
  (doseq [[s c] (take 40 (sort-by (comp - second) @offence-count))]
    (println (format "  %4d %s" c s)))
  (when-not report?
    (.mkdirs out-dir)
    (doseq [old (.listFiles out-dir)] (.delete old))
    (doseq [{:keys [file tests helpers ns-clean]} rows
            :let [kept (filter #(#{:language :concurrency} (:bucket %)) tests)]
            :when (seq kept)]
      (let [lines (str/split-lines (slurp file))
            slice (fn [form] (let [m (meta form)] (str/join "\n" (subvec lines (dec (:row m)) (:end-row m)))))
            out (io/file out-dir (.getName file))]
        (spit out (str ";; DERIVED from " (str (.relativize (.toPath repo) (.toPath file))) " by scripts/derive-tests -- do not edit.\n"
                       ";; Kept: tests whose symbols lie in the clojure.core/cljs.core intersection (plus concurrency).\n\n"
                       (pr-str (with-meta (apply list ns-clean) nil)) "\n\n"
                       (str/join "\n\n" (map slice helpers)) "\n\n"
                       (str/join "\n\n" (for [t kept]
                                          (str ";; " (.getName file) ":" (:row (meta (:form t))) " [" (name (:bucket t)) "]\n"
                                               (slice (:form t)))))
                       "\n"))))
    (println "\nwrote" (count (.listFiles out-dir)) "files to" (str out-dir))))
