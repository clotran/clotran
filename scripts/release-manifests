#!/usr/bin/env bb
;; release-manifests: the package descriptions for a release, from its
;; artifacts' checksums.
;;
;;   scripts/release-manifests [build/dist]
;;
;; Reads VERSION and DIR/SHA256SUMS (the six artifacts, as make dist and
;; scripts/dist-linux name them) and writes
;;
;;   packaging/homebrew/clotran.rb   the formula for the jborden/clotran tap
;;                                   (macOS arm64, Linux aarch64 and x86_64)
;;   packaging/scoop/clotran.json    the manifest for the jborden/clotran bucket
;;
;; each pointing at the GitHub release v$VERSION. A sum missing from the
;; file is an error, not a formula with a hole in it.
(require '[clojure.string :as str]
         '[babashka.fs :as fs])

(def repo (str (fs/parent (fs/parent (fs/absolutize *file*)))))
(def dist-dir (or (first *command-line-args*) (str repo "/build/dist")))
(def version (str/trim (slurp (str repo "/VERSION"))))
(def base (str "https://github.com/jborden/clotran/releases/download/v" version))
(def sums (into {} (for [l (str/split-lines (slurp (str dist-dir "/SHA256SUMS")))
                         :let [[h f] (str/split (str/trim l) #"\s+\*?")] :when f]
                     [f h])))

(defn art [target ext]
  (let [f (str "clotran-" version "-" target ext)]
    (or (some->> (sums f) (vector (str base "/" f) (str "clotran-" version "-" target)))
        (throw (ex-info (str f " is not in " dist-dir "/SHA256SUMS") {})))))

(defn sha [target ext] (sums (str "clotran-" version "-" target ext)))

(let [[mac] (art "darwin-arm64" ".tar.gz")
      [la] (art "linux-aarch64" ".tar.gz")
      [lx] (art "linux-x86_64" ".tar.gz")]
  (fs/create-dirs (str repo "/packaging/homebrew"))
  (spit (str repo "/packaging/homebrew/clotran.rb")
        (str "# GENERATED by scripts/release-manifests from build/dist/SHA256SUMS. Do not edit.
class Clotran < Formula
  desc \"Clojure, hosted on Fortran\"
  homepage \"https://github.com/jborden/clotran\"
  version \"" version "\"
  license \"EPL-2.0\"

  on_macos do
    on_arm do
      url \"" mac "\"
      sha256 \"" (sha "darwin-arm64" ".tar.gz") "\"
    end
  end
  on_linux do
    on_arm do
      url \"" la "\"
      sha256 \"" (sha "linux-aarch64" ".tar.gz") "\"
    end
    on_intel do
      url \"" lx "\"
      sha256 \"" (sha "linux-x86_64" ".tar.gz") "\"
    end
  end

  def install
    # the release is relocatable as a directory: each command finds its
    # home from where it is, so it stays together under libexec and bin
    # gets wrappers, not symlinks
    libexec.install Dir[\"*\"]
    %w[clotran clotran-deps].each { |c| (bin/c).write_exec_script libexec/\"bin\"/c }
  end

  test do
    (testpath/\"t.clj\").write \"(println (reduce + (range 10)) @(future :ok))\\n\"
    assert_equal \"45 :ok\\n\", shell_output(\"#{bin}/clotran #{testpath}/t.clj < /dev/null\")
  end
end
")))

(let [[url dir'] (art "windows-x86_64" ".zip")]
  (fs/create-dirs (str repo "/packaging/scoop"))
  (spit (str repo "/packaging/scoop/clotran.json")
        (str "{
    \"version\": \"" version "\",
    \"description\": \"Clojure, hosted on Fortran\",
    \"homepage\": \"https://github.com/jborden/clotran\",
    \"license\": \"EPL-2.0\",
    \"architecture\": {
        \"64bit\": {
            \"url\": \"" url "\",
            \"hash\": \"" (sha "windows-x86_64" ".zip") "\",
            \"extract_dir\": \"" dir' "\"
        }
    },
    \"bin\": [\"bin\\\\clotran.cmd\", \"bin\\\\clotran-deps.cmd\"],
    \"checkver\": \"github\",
    \"autoupdate\": {
        \"architecture\": {
            \"64bit\": {
                \"url\": \"https://github.com/jborden/clotran/releases/download/v$version/clotran-$version-windows-x86_64.zip\",
                \"extract_dir\": \"clotran-$version-windows-x86_64\"
            }
        }
    }
}
")))

(println "wrote packaging/homebrew/clotran.rb and packaging/scoop/clotran.json for" version)
