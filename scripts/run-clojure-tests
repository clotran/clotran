#!/bin/sh
# Runs real Clojure's OWN test suite (test/clj/clojure/test_clojure/*.clj,
# vendored from clojure/clojure) against clotran, one namespace per run so
# that a hard failure in one file can't hide the others.
#
# Drives clotran with core.clj loaded -- the real interpreter. A
# namespace that reports 0 tests did not pass: its file failed to load
# partway, and the line above it says why. Prints each
# namespace's summary and a total.
#
# These are the conformance number that matters: test/f/*_test.f90 covers
# the Fortran host (the collector, native arrays, the gotchas catalog),
# which upstream cannot test, and everything about the LANGUAGE is
# checked here by Clojure's own assertions instead of ours.
set -e
cd "$(dirname "$0")/.."
total_pass=0; total_fail=0; total_err=0; total_test=0
for f in test/clj/clojure/test_clojure/*.clj; do
  ns=$(sed -n 's/^(ns \([a-zA-Z0-9._-]*\).*/\1/p' "$f" | head -1)
  [ -z "$ns" ] && continue
  # A watchdog, because a test file that sends the evaluator into an
  # infinite loop must not stall the whole run (clojure.test-clojure.for
  # does exactly that today -- see NOTES.md). No portable `timeout` on
  # macOS, hence the background-and-kill.
  printf "(require 'clojure.test)\n(load-file \"test/clj/clojure/test_helper.clj\")\n(load-file \"%s\")\n(clojure.test/run-tests '%s)\n" "$f" "$ns" > /tmp/clotran-run.clj
  ./clotran-bin src/clj/clojure/core.clj < /tmp/clotran-run.clj > /tmp/clotran-run.out 2>&1 &
  pid=$!
  waited=0
  while kill -0 $pid 2>/dev/null && [ $waited -lt ${CLOTRAN_TEST_TIMEOUT:-240} ]; do
    sleep 2; waited=$((waited + 2))
  done
  if kill -0 $pid 2>/dev/null; then
    kill -9 $pid 2>/dev/null
    printf "%-44s TIMED OUT after %ss\n" "$ns" "$waited"
    continue
  fi
  wait $pid 2>/dev/null || true
  out=$(tail -40 /tmp/clotran-run.out)
  sum=$(echo "$out" | sed -n 's/.*{:test \([0-9]*\),* :pass \([0-9]*\),* :fail \([0-9]*\),* :error \([0-9]*\).*/\1 \2 \3 \4/p' | tail -1)
  if [ -z "$sum" ]; then
    printf "%-44s CRASHED\n" "$ns"
    continue
  fi
  set -- $sum
  printf "%-44s tests=%-4s pass=%-5s fail=%-4s error=%-4s\n" "$ns" "$1" "$2" "$3" "$4"
  total_test=$((total_test + $1)); total_pass=$((total_pass + $2))
  total_fail=$((total_fail + $3)); total_err=$((total_err + $4))
done
echo "---"
printf "TOTAL  tests=%s  pass=%s  fail=%s  error=%s\n" "$total_test" "$total_pass" "$total_fail" "$total_err"
