#!/usr/bin/env bb
;; The Fortran-types oracle against the compilers (James, 2026-11-21).
;;
;;   scripts/ftypes-check [cases.edn]     default test/ftypes/cases.edn
;;
;; test/ftypes/oracle.clj says what Fortran's intrinsic types do, as
;; Clojure run on real clj. Here every case is evaluated by it, then written
;; as a Fortran program, built with gfortran AND flang, run, and the printed
;; answers compared with the oracle's: integers exactly, reals bit for bit
;; (a binary32 as a binary32). A case the oracle calls :undefined (the
;; standard leaves it to the processor) is counted, not compared. Exit 1 on
;; any difference. clotran is then checked against the oracle, not against
;; this script (PLAN: types).
(require '[clojure.string :as str]
         '[clojure.edn :as edn]
         '[babashka.fs :as fs]
         '[babashka.process :refer [shell]])

(def repo (-> *file* fs/file .getCanonicalFile .getParentFile .getParentFile))
(def cases-file (or (first *command-line-args*) (str (fs/file repo "test" "ftypes" "cases.edn"))))
(def cases (edn/read-string (slurp cases-file)))
(def work (fs/file repo "build" "ftypes-check"))
(fs/create-dirs work)

;; 1. the oracle, on real clj. It is written in clotran's class names, as every file of
;; the tree is (upstream/check-names); upstream/names.clj turns them into clj's, as
;; scripts/oracle does for its forms.
(load-file (str (fs/file repo "upstream" "names.clj")))
(def oracle-file (fs/file work "oracle_clj.clj"))
(spit oracle-file (names/to-upstream (slurp (fs/file repo "test" "ftypes" "oracle.clj"))))
(def answers
  (let [r (shell {:out :string :err :string :dir (str repo)}
                 "clj" "-Sdeps" "{:deps {org.clojure/clojure {:mvn/version \"1.12.6\"}}}"
                 "-M" "-i" (str oracle-file)
                 "-e" (str "(require 'clojure.edn) (ftypes.oracle/run-file " (pr-str cases-file) ")"))]
    (->> (str/split-lines (:out r)) (remove str/blank?) (mapv read-string))))
(assert (= (count answers) (count cases)) (str "oracle answered " (count answers) " of " (count cases)))

;; 2. a case as Fortran text
;; clotran's kind-number names to iso_fortran_env's (bits) names, which the Fortran text uses
(def iso {:int1 "int8" :int2 "int16" :int4 "int32" :int8 "int64" :real4 "real32" :real8 "real64"
          :complex4 "real32" :complex8 "real64"})
(defn complex? [k] (contains? #{:complex4 :complex8} k))
(defn fk [k] (iso k))
(defn ftext [e]
  (cond
    (map? e) (ftext (or (:undefined e) (:processor e) (:interpreted e)))
    (and (vector? e) (complex? (first e)))
    ;; a complex constant: (re, im), each part a real of the kind's part, signs inside
    (let [[k [x y]] e
          part (fn [t] (let [t (str t) t (if (re-find #"[.eE]" t) t (str t ".0"))] (str t "_" (iso k))))]
      (str "(" (part x) ", " (part y) ")"))
    (vector? e) (let [[k x] e]
                  (if (str/starts-with? (name k) "int")
                    (str (if (neg? x) (str "(" x "_" (fk k) ")") (str x "_" (fk k))))
                    (let [t (str x)
                          t (if (re-find #"[.eE]" t) t (str t ".0"))]
                      (str "id(" (if (str/starts-with? t "-") (str "(" t "_" (fk k) ")") (str t "_" (fk k))) ")"))))
    (keyword? e) (fk e)
    :else (let [[op & args] e
                a (map ftext args)]
            (case op
              (+ - * / **) (if (and (= op '-) (= 1 (count a)))
                             (str "(-" (first a) ")")
                             (str "(" (first a) " " op " " (second a) ")"))
              (str op "(" (str/join ", " a) ")")))))

(def decl {:complex4 "complex(real32)" :complex8 "complex(real64)" :int1 "integer(int8)" :int2 "integer(int16)" :int4 "integer(int32)" :int8 "integer(int64)"
           :real4 "real(real32)" :real8 "real(real64)"})
(def fmt {:real4 "ES16.8E3" :real8 "ES26.17E3" :complex4 "2(1x,ES16.8E3)" :complex8 "2(1x,ES26.17E3)"})

;; a case must answer what it says: a value, or {:undefined ..} undefined. Anything else
;; (an ill-typed or an unexpected undefined) is a failure, not a skip.
(def expected (mapv #(if (or (:undefined %) (:processor %)) :undefined :ok) cases))
(defn processor-case? [i] (let [c (nth cases i)] (and (map? c) (:processor c))))
(defn interpreted-only? [i] (let [c (nth cases i)] (and (map? c) (:interpreted c))))
(def unexpected (vec (for [[i a] (map-indexed vector answers) :when (not= (first a) (expected i))]
                       {:case (pr-str (nth cases i)) :expected (expected i) :answered a})))
(def compared (vec (keep-indexed (fn [i [tag k]] (when (and (= tag :ok) (= :ok (expected i))) [i k])) answers)))
;; the compiler names the kind of each expression itself (the result variable is declared with the
;; ORACLE's kind, which would convert a different one silently)
(def tkind-module
  (str "module tkind\n  use iso_fortran_env\n  implicit none\n  interface tk\n"
       "    module procedure tk_i1, tk_i2, tk_i4, tk_i8, tk_r4, tk_r8, tk_c4, tk_c8\n  end interface\n"
       ;; id passes a real through a procedure: a compiler cannot fold 1.0e200*1.0e200 into
       ;; "Arithmetic overflow" at compile time, so the overflow happens at run time, as IEEE has it
       "  interface id\n    module procedure id_r4, id_r8\n  end interface\ncontains\n"
       "  function id_r4(x) result(y)\n    real(real32), intent(in) :: x\n    real(real32) :: y\n    y = x\n  end function id_r4\n"
       "  function id_r8(x) result(y)\n    real(real64), intent(in) :: x\n    real(real64) :: y\n    y = x\n  end function id_r8\n"
       (str/join (for [[nm t k] [["i1" "integer(int8)" "int1"] ["i2" "integer(int16)" "int2"] ["i4" "integer(int32)" "int4"]
                                 ["i8" "integer(int64)" "int8"] ["r4" "real(real32)" "real4"] ["r8" "real(real64)" "real8"]
                                 ["c4" "complex(real32)" "complex4"] ["c8" "complex(real64)" "complex8"]]]
                   (str "  function tk_" nm "(x) result(s)\n    " t ", intent(in) :: x\n    character(len=8) :: s\n    s = '" k "'\n  end function tk_" nm "\n")))
       "end module tkind\n\n"))
(def program
  (str tkind-module "program ftypes\n  use iso_fortran_env\n  use tkind\n  implicit none\n"
       (str/join (for [[i k] compared] (str "  " (decl k) " :: r" i "\n")))
       (str/join (for [[i _] compared] (str "  r" i " = " (ftext (nth cases i)) "\n")))
       (str/join (for [[i k] compared]
                   (str "  write(*,'(A)') tk(" (ftext (nth cases i)) ")\n"
                        (if (str/starts-with? (name k) "int")
                          (str "  write(*,'(I0)') r" i "\n")
                          (str "  write(*,'(" (fmt k) ")') r" i "\n")))))
       "end program ftypes\n"))
(spit (fs/file work "ftypes.f90") program)

;; 3. each compiler
(defn parse-out [k s]
  (if (complex? k)
    (let [[re im] (str/split (str/trim s) #"\s+")]
      [(parse-out (case k :complex4 :real4 :complex8 :real8) re) (parse-out (case k :complex4 :real4 :complex8 :real8) im)])
  (if (str/starts-with? (name k) "int")
    (parse-long (str/trim s))
    (let [t (str/lower-case (str/trim s))]
      (cond (str/includes? t "nan") ##NaN
            (str/includes? t "inf") (if (str/starts-with? t "-") ##-Inf ##Inf)
            :else (case k :real8 (Double/parseDouble t) :real4 (double (Float/parseFloat t))))))))

(defn same? [k want got]
  (cond
    (complex? k) (and (= (count want) (count got) 2) (every? true? (map (fn [w g] (= (Double/doubleToRawLongBits (double w)) (Double/doubleToRawLongBits (double g)))) want got)))
    (str/starts-with? (name k) "int") (= want got)
    :else
    (or (and (Double/isNaN (double want)) (Double/isNaN (double got)))
        (= (Double/doubleToRawLongBits (double want)) (Double/doubleToRawLongBits (double got))))))

(def results
  (for [[fc flags] [["gfortran" ["-std=f2018" "-ffp-contract=off" "-O0"]] ["flang" []]]]
    (let [exe (str (fs/file work (str "ftypes-" fc)))
          c (apply shell {:out :string :err :string :continue true} fc (concat flags ["-o" exe (str (fs/file work "ftypes.f90"))]))]
      (if-not (zero? (:exit c))
        {:fc fc :compile-failed (str (:err c) (:out c))}
        (let [r (shell {:out :string :err :string :continue true} exe)
              lines (str/split-lines (:out r))]
          (if (not= (count lines) (* 2 (count compared)))
            {:fc fc :compile-failed (str "ran, but printed " (count lines) " lines for " (count compared) " cases: " (:err r))}
            {:fc fc
             :diffs (vec (for [[[i k] [kline line]] (map vector compared (partition 2 lines))
                               :let [want (nth (nth answers i) 2) got (parse-out k line)]
                               :when (or (not= (str/trim kline) (name k)) (not (same? k want got)))]
                           {:case (pr-str (nth cases i)) :oracle want :got got :kind k
                            :compiler-kind (str/trim kline)}))}))))))

;; 4. clotran: the same cases through fortran.ops (src/clj/fortran/ops.cljf). A case
;; must answer the oracle's value and kind, or, for {:undefined ..}, throw.
(defn clotran-form [e]
  (cond (vector? e) (list 'f/lit (first e) (second e))
        (keyword? e) e
        (map? e) (clotran-form (or (:undefined e) (:processor e) (:interpreted e)))
        :else (cons (symbol "f" (name (first e))) (map clotran-form (rest e)))))
(def clotran-result
  (let [prog (str "(require '[fortran.ops :as f])\n"
                  "(defn show [v] (let [k (f/kind-of v)] [:ok k (cond (#{:int1 :int2 :int4 :int8} k) (long v)
                                                            (#{:complex4 :complex8} k) [(double (f/real v)) (double (f/aimag v))]
                                                            :else (double v))]))\n"
                  (str/join (for [e cases]
                              (str "(prn (try (show " (pr-str (clotran-form e)) ") (catch clotran.host.throwable e [:threw (ex-message e)])))\n"))))
        f (fs/file work "ftypes_clotran.cljf")]
    (spit f prog)
    (let [r (shell {:out :string :err :string :continue true :dir (str work)
                    :extra-env {"CLOTRAN_PATH" (str (fs/file repo "src" "clj"))}}
                   (str (fs/file repo "clotran")) (str f))]
      (if (zero? (:exit r))
        {:answers (->> (str/split-lines (:out r)) (remove str/blank?) (mapv read-string))}
        {:failed (str (:out r) (:err r))}))))
(def clotran-diffs
  (when-let [as (:answers clotran-result)]
    (vec (for [[i a] (map-indexed vector as)
               :let [want (nth answers i) ex (expected i)]
               :when (if (= ex :ok)
                       (not (and (= :ok (first a) (first want)) (= (second a) (second want))
                                 (same? (second a) (nth want 2) (nth a 2))))
                       (not= :threw (first a)))]
           {:case (pr-str (nth cases i)) :oracle want :clotran a :expected ex}))))

;; 5. type hints in Fortran's words (test/ftypes/ftypes_hints.cljf: every function twice): the same
;; answers interpreted, and the same pure Fortran compiled. A spelling must change nothing.
(def hint-pairs
  '[[sum-c sum-f [(double-array [1.5 2.5 -3.0])] [(double-array [])]]
    [tot-c tot-f [(long-array [1 2 3 -4])] [(long-array [])]]
    [scale-c scale-f [3 1.5] [-2 0.25] [3.9 2.0]]
    [dot-c dot-f [(double-array [1.0 2.0 3.0]) (double-array [4.0 5.0 6.0])]]
    [sq-c sq-f [(double-array [1.0 2.0 3.0])]]
    ;; a hint that is honoured refuses the wrong kind of array, with the same message
    [ints-c ints-f [(int-array [1 2])] [(double-array [1.0])]]
    [flts-c flts-f [(float-array [1 2])] [(double-array [1.0])]]
    [shrt-c shrt-f [(short-array [1 2])] [(double-array [1.0])]]
    [byts-c byts-f [(byte-array [1 2])] [(double-array [1.0])]]
    [lngs-c lngs-f [(long-array [1 2])] [(int-array [1])]]
    [dbls-c dbls-f [(double-array [1 2])] [(int-array [1])]]])
(def hint-diffs
  (let [dir (str (fs/file repo "test" "ftypes"))
        prog (str "(require 'ftypes-hints)\n"
                  (str/join (for [[c f & argsets] hint-pairs, args argsets]
                              (str "(prn [" (pr-str (list 'quote (list c f))) " "
                                   (pr-str (list 'try (cons (symbol "ftypes-hints" (str c)) args) '(catch clotran.host.throwable e (ex-message e)))) " "
                                   (pr-str (list 'try (cons (symbol "ftypes-hints" (str f)) args) '(catch clotran.host.throwable e (ex-message e)))) "])\n"))))
        pf (fs/file work "ftypes_hints_run.cljf")
        _ (spit pf prog)
        run (shell {:out :string :err :string :continue true :dir (str work)
                    :extra-env {"CLOTRAN_PATH" (str (fs/file repo "src" "clj") ":" dir)}}
                   (str (fs/file repo "clotran")) (str pf))
        interp (if (zero? (:exit run))
                 (for [line (str/split-lines (:out run)) :when (str/starts-with? line "[")
                       :let [[_ a b] (read-string line)] :when (not= a b)]
                   (str "interpreted answers differ: " a " vs " b))
                 [(str "did not run: " (:out run) (:err run))])
        pure-file (fs/file work "ftypes_hints_pure.f90")
        pr (shell {:out :string :err :string :continue true :dir (str work)
                   :extra-env {"CLOTRAN_PATH" (str (fs/file repo "src" "clj"))}}
                  (str (fs/file repo "clotran")) "compile" "--pure" (str (fs/file dir "ftypes_hints.cljf")) (str pure-file))
        text (when (zero? (:exit pr)) (slurp pure-file))
        procs (fn [fname] (let [id (str/replace (name fname) "-" "_")]
                            (->> (re-seq (re-pattern (str "(?s)(?:pure )?function " id "__\\w+\\(.*?end function " id "__\\w+")) text)
                                 (map #(str/replace % id "FN")))))
        pure (if text
               (for [[c f] hint-pairs
                     :let [pc (procs c) pf' (procs f)]
                     :when (or (empty? pc) (not= pc pf'))]
                 (str "pure Fortran differs (or is not generated) for " c " and " f))
               [(str "compile --pure failed: " (:out pr) (:err pr))])]
    (vec (concat interp pure))))

;; 6. the pure tier: every case as pure Fortran functions (src/clj/clotran/purefort.cljf,
;; fortran-call), at the boundary a long or a double (a complex: its real and imaginary parts, one
;; function each); one executable per compiler, run once per case (and part). A case that answers
;; must answer the oracle's value; a case the standard leaves undefined must fail, or not lower
;; (then fortran.ops throws it, leg 4); a case that answers and does not lower is a failure.
(defn pure-form [e]
  (cond (vector? e) (let [[k x] e]
                      (case k
                        :real4 (list 'f/real4 x) :real8 (list 'f/real8 x)
                        (:complex4 :complex8) (list* (symbol "f" (name k)) x)
                        (list (symbol "f" (name k)) x)))
        (keyword? e) e
        (map? e) (pure-form (or (:undefined e) (:processor e) (:interpreted e)))
        :else (cons (symbol "f" (name (first e))) (map pure-form (rest e)))))
(defn case-cplx? [i] (and (= :ok (first (nth answers i))) (complex? (second (nth answers i)))))
(def pure-results
  (let [head "(ns ftypes-pure (:require [fortran.ops :as f]))\n"
        fns (str/join (for [[i e] (map-indexed vector cases)
                            :let [a (nth answers i)
                                  form (pure-form e)]]
                        (if (case-cplx? i)
                          (str (pr-str (list 'defn (symbol (str "c" i)) [] (list 'double (list 'f/real form)))) "\n"
                               (pr-str (list 'defn (symbol (str "d" i)) [] (list 'double (list 'f/aimag form)))) "\n")
                          (let [wrap (if (and (= :ok (first a)) (#{:real4 :real8} (second a))) 'double 'long)]
                            (str (pr-str (list 'defn (symbol (str "c" i)) [] (list wrap form))) "\n")))))
        src (fs/file work "ftypes_pure.cljf")
        env {"CLOTRAN_PATH" (str (fs/file repo "src" "clj"))}
        _ (spit src (str head fns))
        c (shell {:out :string :err :string :continue true :dir (str work) :extra-env env}
                 (str (fs/file repo "clotran")) "compile" "--pure" (str src) (str (fs/file work "ftypes_pure.f90")))
        got (set (for [l (str/split-lines (:out c)) :let [m (re-find #"^\s+pure\s+ftypes-pure/([cd])(\d+)" l)] :when m]
                   [(first (rest m)) (parse-long (nth m 2))]))
        lowered (set (for [i (range (count cases))
                           :when (and (got ["c" i]) (or (not (case-cplx? i)) (got ["d" i])))] i))
        main (str "(defn -main [^long i ^long p]\n  (cond\n"
                  (str/join (for [i (sort lowered)]
                              (if (case-cplx? i)
                                (str "    (and (= i " i ") (= p 0)) (println (c" i "))\n    (and (= i " i ") (= p 1)) (println (d" i "))\n")
                                (str "    (= i " i ") (println (c" i "))\n"))))
                  "    :else (println \"none\")))\n")
        full (fs/file work "ftypes_pure_main.cljf")
        _ (spit full (str head fns main))
        build (fn [fc]
                (let [exe (str (fs/file work (str "ftypes_pure_" fc)))
                      b (shell {:out :string :err :string :continue true :dir (str work)
                                :extra-env (assoc env "FC" fc)}
                               (str (fs/file repo "clotran")) "build" "--pure" (str full) "-o" exe)]
                  (if (zero? (:exit b))
                    {:fc fc :exe exe}
                    {:fc fc :failed (str (:out b) (:err b))})))]
    {:lowered lowered
     :runs (vec (for [b [(build "gfortran") (build "flang")]]
                  (if (:failed b) b
                    (assoc b :out (into {} (for [i (sort lowered)
                                                 :let [run (fn [p] (let [r (shell {:out :string :err :string :continue true} (:exe b) (str i) (str p))]
                                                                     {:exit (:exit r) :out (str/trim (:out r))}))]]
                                             [i (if (case-cplx? i) [(run 0) (run 1)] (run 0))]))))))}))
(defn parse-pure [k out]
  (try (if (str/starts-with? (name k) "int")
         (parse-long out)
         (let [t (str/lower-case out)]
           (cond (str/includes? t "nan") ##NaN
                 (str/includes? t "inf") (if (str/starts-with? t "-") ##-Inf ##Inf)
                 :else (Double/parseDouble out))))
       (catch Exception _ ::bad)))
(def pure-diffs
  (vec (concat
        (for [i (range (count cases)) :when (and (= :ok (expected i)) (not (interpreted-only? i)) (not ((:lowered pure-results) i)))]
          (str "case " (pr-str (nth cases i)) " answers (" (nth answers i) ") but is not lowered to pure Fortran"))
        (for [r (:runs pure-results)
              d (if (:failed r) [(str (:fc r) " did not build: " (subs (:failed r) 0 (min 400 (count (:failed r)))))]
                  (for [[i res] (:out r)
                        :when (not (processor-case? i))
                        :let [want (nth answers i) cplx (case-cplx? i)
                              rs (if cplx res [res])
                              ok? (every? #(zero? (:exit %)) rs)]
                        :when (if (= :ok (expected i))
                                (and (= :ok (first want)) (not (and ok?
                                          (let [k (second want)
                                                pk (case k :complex4 :real4 :complex8 :real8 k)
                                                got (mapv #(parse-pure pk (:out %)) rs)]
                                            (and (not-any? #{::bad} got)
                                                 (same? k (nth want 2) (if cplx got (first got))))))))
                                (every? #(zero? (:exit %)) rs))]
                    (str (:fc r) " " (pr-str (nth cases i)) ": oracle " (pr-str want) ", pure printed " (pr-str (mapv :out rs)) " (exit " (mapv :exit rs) ")")))]
          d))))

(let [n (count cases)
      und (remove #(= :ok (first %)) answers)
      bad (+ (count unexpected) (if (:failed clotran-result) 1 (count clotran-diffs)) (count hint-diffs) (count pure-diffs) (reduce + (for [r results] (if (:compile-failed r) 1 (count (:diffs r))))))]
  (println (str "  hints in Fortran's words: " (count hint-diffs) " differ from Clojure's spelling (" (count hint-pairs) " pairs, interpreted and pure Fortran)"))
  (doseq [d hint-diffs] (println (str "  DIFF hints: " d)))
  (println (str "  pure Fortran: " (count pure-diffs) " differ from the oracle (" (count (:lowered pure-results)) " cases lowered, gfortran and flang)"))
  (doseq [d pure-diffs] (println (str "  DIFF pure " d)))
  (cond (:failed clotran-result) (println (str "  clotran: DID NOT RUN\n" (:failed clotran-result)))
        :else (println (str "  clotran: " (count clotran-diffs) " differ from the oracle (" (count (:answers clotran-result)) " cases)")))
  (doseq [d clotran-diffs] (println (str "  DIFF clotran " (:case d) ": oracle " (:oracle d) ", clotran " (:clotran d))))
  (doseq [u unexpected] (println (str "  UNEXPECTED " (:case u) ": expected " (:expected u) ", the oracle answered " (:answered u))))
  (println (str "ftypes-check: " n " cases, " (count compared) " compared with the compilers, "
                (count und) " not (the standard leaves them to the processor, or ill-typed): "
                (frequencies (map #(if (= :ok (first %)) :ok (second %)) und))))
  (doseq [r results]
    (cond (:compile-failed r) (println (str "  " (:fc r) ": DID NOT BUILD\n" (:compile-failed r)))
          :else (println (str "  " (:fc r) ": " (count (:diffs r)) " differ"))))
  (doseq [r results d (:diffs r)] (println (str "  DIFF " (:fc r) " " (:case d) ": oracle " (:kind d) " " (:oracle d) ", compiler " (:compiler-kind d) " " (:got d))))
  (System/exit (if (zero? bad) 0 1)))
