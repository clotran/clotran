#!/usr/bin/env bb
;; Which builtins may be handed a REUSED argument vector: those whose case in
;; call_builtin (Eval.f90) touches its argument vector only to read an element
;; (gcv_nth), count it, root allocations with it ([...] lists), check it
;; (numbers_ok, divisor_first) or copy its tail (rest_args). Anything else -- the vector
;; passed on, returned, stored -- might keep it, and keeps allocating.
;;
;; usage: scripts/argsafe          writes src/f/argsafe.inc
;;        scripts/argsafe --check  fails if src/f/argsafe.inc is out of date (make test)
;;        scripts/argsafe --why    the unsafe ones and the first line that makes them so
(require '[clojure.string :as str])

(def src (slurp "src/f/Eval.f90"))
(def why? (some #{"--why"} *command-line-args*))
(def lines (vec (str/split-lines src)))
(def start (first (keep-indexed (fn [i l] (when (re-find #"^  function call_builtin\(id, args\)" l) i)) lines)))
(def end (first (keep-indexed (fn [i l] (when (and (> i start) (re-find #"^  end function call_builtin" l)) i)) lines)))
(def body (subvec lines start end))

(def arg-re #"\bargs\b|vs_get\(vst, base \+ 1\)")

(defn code [l] (str/replace l #"!.*$" ""))

(defn mask-roots
  "Blank out bracketed [...] root lists, where naming the vector only
  roots it for an allocation."
  [s]
  (str/replace s #"\[[^\[\]]*\]" "[]"))

(defn allowed-removed [s]
  (-> s
      mask-roots
      (str/replace #"gcv_nth\((args|vs_get\(vst, base \+ 1\)),\s*" "gcv_nth(ARG, ")
      (str/replace #"gcv_count\((args|vs_get\(vst, base \+ 1\))\)" "COUNT")
      (str/replace #"numbers_ok\((args|vs_get\(vst, base \+ 1\))," "numbers_ok(ARG,")
      (str/replace #"divisor_first\((args|vs_get\(vst, base \+ 1\))," "divisor_first(ARG,")
      (str/replace #"rest_args\((args|vs_get\(vst, base \+ 1\))," "rest_args(ARG,")))

;; blocks: top-level `case (...)` lines of the procedure's own select
(def blocks
  (loop [i 0 cur nil acc []]
    (if (>= i (count body))
      (cond-> acc cur (conj cur))
      (let [l (body i)]
        (if-let [[_ ids] (re-find #"^    case \(([^)]*)\)" l)]
          (recur (inc i) {:ids (map str/trim (str/split ids #",")) :lines [] :at (+ start i 1)}
                 (cond-> acc cur (conj cur)))
          (recur (inc i) (if cur (update cur :lines conj l) cur) acc))))))

(def verdicts
  (for [b blocks]
    (let [bad (first (filter #(re-find arg-re (allowed-removed (code %))) (:lines b)))]
      (assoc b :bad bad))))

(def safe
  (sort (distinct (for [v verdicts :when (nil? (:bad v)) id (:ids v) :when (re-matches #"B_[A-Z0-9_]+" id)] id))))

(def text
  (str "! GENERATED by scripts/argsafe from call_builtin (Eval.f90). Do not edit;\n"
       "! rerun it. The builtins that may be handed a REUSED argument vector:\n"
       "! each touches its arguments only by element (PLAN.md, the calling\n"
       "! convention). `make test` checks this file is current.\n"
       "  logical function args_reusable(id)\n"
       "    integer, intent(in) :: id\n"
       "    select case (id)\n"
       (apply str (for [chunk (partition-all 6 safe)]
                    (str "    case (" (str/join ", " chunk) ")\n       args_reusable = .true.\n")))
       "    case default\n       args_reusable = .false.\n"
       "    end select\n"
       "  end function args_reusable\n"))

(cond
  why? (doseq [v verdicts :when (:bad v) id (:ids v)] (println id "--" (str/trim (:bad v))))
  (some #{"--check"} *command-line-args*)
  (if (= text (slurp "src/f/argsafe.inc"))
    (println "argsafe.inc is current:" (count safe) "builtins may reuse an argument vector")
    (do (println "src/f/argsafe.inc is out of date: run scripts/argsafe") (System/exit 1)))
  :else (do (spit "src/f/argsafe.inc" text) (println "wrote src/f/argsafe.inc:" (count safe) "builtins")))
