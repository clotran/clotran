#!/usr/bin/env bb
;; The differential fuzzer (PLAN 26.9). Random closed programs -- let,
;; loop/recur, closures, lazy-seq, try/throw, the seq functions -- built
;; from a typed grammar, run through clj (the oracle) and through
;; clotran's three ways of running code: the flat bytecode, the tree
;; evaluator (CLOTRAN_FLAT=0) and compiled (each case a defn in a
;; namespace built by `clotran compile`). Any value that differs from
;; clj's is a bug; --shrink cuts a failing case down to a small one.
;;
;; spec states what a case is (::case) and test.check -- the generator
;; layer spec generates through -- builds them; a generated case that
;; does not conform is a bug in this script, and it says so.
;;
;;   scripts/fuzz                      200 cases, seed 1, every mode
;;   scripts/fuzz -n 500 -s 7          500 cases, seed 7
;;   scripts/fuzz -m flat,tree         only those modes
;;   scripts/fuzz --shrink             shrink each failure (slow: a run per try)
;;   --shrink-budget 60                shrink, all failures together in at most 60 s
;;                                     of wall time (the gate's: a red run shows a
;;                                     small case, and its seed reproduces the original)
;;   --control-shrink                  the shrinker's negative control: flat mode's answers
;;                                     read every 7 as 8, a planted bug; the run must find
;;                                     it and shrink each case to one no larger that still
;;                                     fails, at least one strictly smaller, and exits 0
;;                                     only then
;;   scripts/fuzz --fns 20             20 calls of each function spec'd in
;;                                     scripts/fuzz_specs.clj, from its :args spec;
;;                                     clj's answer checked against its :ret
;;   scripts/fuzz -f cases.edn         these cases (a vector of forms) instead:
;;                                     what the fuzzer found, kept (make test)
;;   scripts/fuzz -r clojure.spec.alpha  that namespace required before the cases
;;                                     are analysed (scripts/fuzz-spec), repeatable
;;   -m torture                        a fourth mode: flat, core loaded from
;;                                     source, the collector run every 97
;;                                     allocations (as check-oracle-gc);
;;                                     torture-N every N allocations instead
;;   -m noimage                        flat with core loaded from source, not
;;                                     the heap image: what the image holds
;;                                     must be what loading makes
;;   --fixture defs.clj                these definitions too, after the fixture's:
;;                                     in user, and in the compiled namespace,
;;                                     where they are compiled (scripts/fuzz-fn)
;;
;; Exit 1 on any difference.
(require '[clojure.spec.alpha :as s]
         '[clojure.test.check.generators :as g]
         '[clojure.test.check.rose-tree :as rose]
         '[clojure.test.check.random :as random]
         '[clojure.string :as str]
         '[clojure.walk :as walk]
         '[babashka.fs :as fs]
         '[babashka.process :as p])

(def repo (str (fs/parent (fs/parent (fs/absolutize *file*)))))
(load-file (str repo "/upstream/names.clj"))
;; Clojure's own specs for its macros, as vendored: the shapes of let,
;; fn, if-let and when-let the grammar below follows, and every form it
;; emits is checked against
(load-file (str repo "/src/clj/clojure/core/specs/alpha.clj"))

;;; ---- options --------------------------------------------------------

(def opts
  (loop [a *command-line-args* o {:n 200 :seed 1 :modes ["flat" "tree" "compiled"] :shrink false :timeout 600 :probe-timeout 120}]
    (case (first a)
      nil o
      "-n" (recur (drop 2 a) (assoc o :n (parse-long (second a))))
      "-s" (recur (drop 2 a) (assoc o :seed (parse-long (second a))))
      "-m" (recur (drop 2 a) (assoc o :modes (vec (remove str/blank? (str/split (second a) #",")))))
      "--shrink" (recur (rest a) (assoc o :shrink true))
      "--control-shrink" (recur (rest a) (assoc o :control-shrink true :shrink true :shrink-budget 120 :modes ["flat"]))
      "--shrink-budget" (recur (drop 2 a) (assoc o :shrink true :shrink-budget (parse-long (second a))))
      "-f" (recur (drop 2 a) (assoc o :file (second a)))
      "--timeout" (recur (drop 2 a) (assoc o :timeout (parse-long (second a))))
      "--keep" (recur (rest a) (assoc o :keep true))
      "--probe-timeout" (recur (drop 2 a) (assoc o :probe-timeout (parse-long (second a))))
      "-r" (recur (drop 2 a) (update o :requires (fnil conj []) (second a)))
      "--fns" (recur (drop 2 a) (assoc o :fns (parse-long (second a))))
      "--fixture" (recur (drop 2 a) (assoc o :fixture (second a)))
      (do (println "unknown option" (first a)) (System/exit 2)))))

;;; ---- the grammar ----------------------------------------------------
;;
;; Typed, so most cases compute something rather than throw: an :int
;; expression, a :seq of ints (always finite once evaluated), a :bool,
;; a :fn from int to int. env holds the locals in scope by type. Every
;; infinite seq is under a take, every loop bound is a small constant.

(def small (g/choose -9 20))
(def pos-small (g/choose 1 7))

(defn fresh [env] (symbol (str "x" (:n env 0))))
(defn bind [env t sym] (-> env (update t (fnil conj []) sym) (update :n (fnil inc 0))))

(declare g-int g-seq g-bool g-fn g-map g-str)

;; a generator built when it is drawn from, not when its parent is: the
;; grammar's branches each hold a deeper generator, and built eagerly
;; they are ~20^depth objects before one case is drawn
(defn lazy [thunk] (g/bind (g/return nil) (fn [_] (thunk))))

(defn leaf [env t base]
  (if-let [ls (seq (get env t))]
    (g/frequency [[3 base] [2 (g/elements ls)]])
    base))

(defn g-let [env d body-gen]
  ;; (let [x <int or seq>] body), body able to read x
  (g/bind (g/elements [:int :seq])
          (fn [bt]
            (let [x (fresh env) env2 (bind env bt x)]
              (g/let [v (lazy #(if (= bt :int) (g-int env (dec d)) (g-seq env (dec d))))
                      b (lazy #(body-gen env2 (dec d)))]
                (list 'let [x v] b))))))

(defn g-int [env d]
  (if (<= d 0)
    (leaf env :int small)
    (let [i #(lazy (fn [] (g-int env (dec d)))) sq #(lazy (fn [] (g-seq env (dec d))))
          b #(lazy (fn [] (g-bool env (dec d)))) f #(lazy (fn [] (g-fn env (dec d))))]
      (g/frequency
       [[3 (leaf env :int small)]
        [3 (g/let [op (g/elements '[+ - max min]) x (i) y (i)] (list op x y))]
        [1 (g/let [x (i) y (i)] (list '* x y))]
        [2 (g/let [op (g/elements '[inc dec]) x (i)] (list op x))]
        [1 (g/let [op (g/elements '[quot rem mod]) x (i) y pos-small] (list op x y))]
        [2 (g/let [s (sq)] (list 'count s))]
        [2 (g/let [s (sq) k small] (list 'or (list 'first s) k))]
        [2 (g/let [s (sq) k small] (list 'reduce '+ k s))]
        [1 (g/let [s (sq)] (list 'apply '+ s))]
        [1 (g/let [s (sq) k (g/choose 0 6)] (list 'nth s k -1))]
        [2 (g/let [c (b) x (i) y (i)] (list 'if c x y))]
        [2 (g-let env d g-int)]
        [2 (g/let [fn (f) x (i)] (list fn x))]
        [1 (g/let [s (sq) fn (f)] (list 'reduce (list 'fn '[a b] (list '+ 'a (list fn 'b))) 0 s))]
        [1 (let [i0 (symbol (str "i" (:n env 0))) a0 (symbol (str "acc" (:n env 0)))
                 env2 (-> env (bind :int i0) (bind :int a0))]
             (g/let [n pos-small x (i) step (lazy #(g-int env2 (dec d)))]
               (list 'loop [i0 0 a0 x] (list 'if (list '< i0 n) (list 'recur (list 'inc i0) step) a0))))]
        [1 (g/let [x (i) y (i)]
             (list 'try (list 'if (list 'even? x) (list 'throw (list 'ex-info "fz" {:v x})) x)
                   (list 'catch 'clotran.host.exception_info 'e (list '+ y (list ':v (list 'ex-data 'e))))))]
        [1 (g/let [x (i) y (i)] (list 'try (list 'quot x 0) (list 'catch 'clotran.host.arithmetic_exception 'e y)))]
        ;; ones that may throw: both sides throwing is agreement, one
        ;; throwing is a difference
        [1 (g/let [s (sq) k (g/choose 0 6)] (list 'nth s k))]
        [1 (g/let [x (i)] (list '* x 4611686018427387904))]
        [1 (g/let [x (i) c (b)] (list '+ x (list 'when c 1)))]
        [1 (g/let [x (i)] (list 'first x))]
        ;; ::seq-binding-form: forms, & rest, :as
        [2 (g/let [s (sq) k small]
             (list 'let ['[a b & r :as all] s] (list '+ (list 'or 'a k) '(or b 0) '(count r) '(count all))))]
        ;; ::map-binding-form: :keys with :or
        [1 (g/let [x (i) y (i) m (g/elements [:pq :p :none])]
             (list 'let [{:keys '[p q] :or {'p y}} (case m :pq {:p x :q y} :p {:p x} :none {})]
                   '(+ p (or q 0))))]
        ;; ::param-list with var-params
        [1 (g/let [x (i) y (i) z (i)]
             (list (list 'fn '[u & vs] '(+ u (count vs) (apply + vs))) x y z))]
        ;; fn :arity-n
        [1 (g/let [x (i) y (i) two g/boolean]
             (concat [(list 'fn '([u] (inc u)) '([u v] (- u v)))] (if two [x y] [x])))]
        ;; if-let, when-let
        [1 (g/let [s (sq) k small] (list 'if-let ['[a] (list 'seq s)] 'a k))]
        [1 (g/let [s (sq) k small] (list 'or (list 'when-let ['y (list 'first s)] '(* y 2)) k))]
        ;; a named fn calling itself, and letfn
        [1 (g/let [x (i)] (list (list 'fn 'self '[n] '(if (pos? n) (+ n (self (dec n))) 0)) (list 'mod x 8)))]
        [1 (g/let [x (i)] (list 'letfn '[(ev? [n] (if (zero? n) true (od? (dec n)))) (od? [n] (if (zero? n) false (ev? (dec n))))]
                                (list 'if (list 'ev? (list 'mod x 9)) 1 0)))]
        ;; maps
        [2 (g/let [m (lazy #(g-map env (dec d))) k (g/elements [:a :b :c :z]) x (i)] (list 'get m k x))]
        [1 (g/let [m (lazy #(g-map env (dec d)))] (list 'count m))]
        [1 (g/let [m (lazy #(g-map env (dec d)))] (list 'reduce '+ 0 (list 'vals m)))]
        [1 (g/let [m (lazy #(g-map env (dec d))) k (g/elements [:a :b :c])] (list k m 0))]
        ;; strings
        [1 (g/let [st (lazy #(g-str env (dec d)))] (list 'count st))]
        ;; transducers and reduced
        [1 (g/let [s (sq) fn (f)] (list 'transduce (list 'map fn) '+ 0 s))]
        [1 (g/let [s (sq) p (g/elements '[even? odd? pos?])] (list 'transduce (list 'comp (list 'filter p) '(map inc)) '+ s))]
        [1 (g/let [s (sq) k pos-small] (list 'reduce (list 'fn '[a b] (list 'if (list '> 'a k) (list 'reduced 'a) '(+ a b))) 0 s))]
        ;; case, cond, atoms
        [1 (g/let [x (i) y (i) z (i)] (list 'case (list 'mod x 3) 0 y 1 z (list '- y z)))]
        [1 (g/let [x (i) y (i) z (i)] (list 'cond (list '< x 0) y (list '> x 10) z :else (list '+ y z)))]
        [1 (g/let [s (sq)] (list 'let '[at (atom 0)] (list 'doseq ['v s] '(swap! at + v)) '@at))]
        [1 (g/let [s (sq)] (list 'let '[vt (volatile! 1)] (list 'run! '(fn [v] (vswap! vt * (if (zero? v) 1 (min 3 (max -3 v))))) s) '@vt))]
        ;; the fixture: protocol dispatch on a type, a record, a long, nil;
        ;; record fields and assoc; multimethods; binding
        [2 (g/let [x (i)] (list 'fz-m (list '->FzT x)))]
        [1 (g/let [x (i) y (i)] (list 'fz-m2 (list '->FzT x) y))]
        [2 (g/let [x (i) y (i)] (list 'fz-m (list '->FzR x y)))]
        [1 (g/let [x (i) y (i) z (i)] (list 'fz-m2 (list 'map->FzR {:a x :b y}) z))]
        [1 (g/let [x (i)] (list 'fz-m (list 'long x)))]
        [1 (g/let [x (i)] (list 'fz-m2 nil x))]
        [1 (g/let [x (i) y (i)] (list ':a (list '->FzR x y)))]
        [1 (g/let [x (i) y (i) z (i)] (list 'get (list 'assoc (list '->FzR x y) :c z) :c 0))]
        [1 (g/let [x (i) y (i) z (i)] (list ':a (list 'assoc (list '->FzR x y) :a z)))]
        [1 (g/let [x (i) y (i)] (list 'count (list 'dissoc (list '->FzR x y) :a)))]
        [1 (g/let [x (i) y (i)] (list 'reduce '+ (list 'vals (list '->FzR x y))))]
        [1 (g/let [x (i)] (list 'fz-mm (list 'abs (list 'mod x 50))))]
        [1 (g/let [x (i) y (i) sh (g/elements [:sq :rect :tri])] (list 'fz-area {:shape sh :s x :w x :h y}))]
        [1 (g/let [x (i) y (i)] (list 'binding ['*fz-d* x] (list '+ '(fz-read-d) y)))]
        [1 (g/let [x (i)] (list '+ '(fz-read-d) x))]
        [1 (g/let [x (i) y (i)] (list 'binding ['*fz-d* x] (list 'binding ['*fz-d* y] '(fz-read-d))))]
        ;; higher-order functions, applied
        [1 (g/let [fa (f) fb (f) x (i)] (list (list 'comp fa fb) x))]
        [1 (g/let [k small x (i)] (list (list 'partial '+ k) x))]
        [1 (g/let [fa (f) x (i)] (list 'apply 'max (list (list 'juxt fa 'inc 'dec) x)))]
        [1 (g/let [x (i) y (i)] (list (list 'fnil '+ 0) (list 'when (list 'even? x) x) y))]
        [1 (g/let [x (i) y (i)] (list 'apply '+ x [y 3]))]
        [1 (g/let [x (i)] (list 'if (list (list 'every-pred 'even? 'pos?) x) 1 0))]
        [1 (g/let [x (i)] (list 'if (list (list 'some-fn 'neg? 'zero?) x) 1 0))]
        [1 (g/let [x (i)] (list 'if (list (list 'complement 'even?) x) 1 0))]
        ;; DESTRUCTURING beyond the basics, as ::binding-form allows:
        ;; nested sequential forms, map forms with :keys :strs :syms,
        ;; namespaced keys, :or and :as, and the same in fn parameters
        [1 (g/let [x (i) y (i) s (sq)]
             (list 'let [['p ['q 'r] '& 'more :as 'all] (list 'vector x (list 'vector y x) s)]
                   '(+ p (or q 0) (or r 0) (count more) (count all))))]
        [1 (g/let [x (i) y (i) z (i)]
             (list 'let [{:keys '[a b] {:keys '[c]} :n :or {'a 7 'b 8} :as 'm} {:a x :n {:c y} :z z}]
                   '(+ a b (or c 0) (count m))))]
        [1 (g/let [x (i) y (i)]
             (list 'let [{:strs '[a b] :or {'b 1}} {"a" x "b" y}] '(+ a b)))]
        [1 (g/let [x (i) y (i)]
             (list 'let [{:syms '[a b]} {'(quote a) x '(quote b) y}] '(- a b)))]
        [1 (g/let [x (i) y (i)]
             (list 'let [{:fz/keys '[a b] :or {'b 2}} {:fz/a x :fz/b y}] '(* a b)))]
        [1 (g/let [x (i) y (i) s (sq)]
             (list (list 'fn '[[u v] {:keys [w] :or {w 3}} & more] '(+ (or u 0) (or v 0) w (count more)))
                   (list 'vector x y) {:w y} s x))]
        [1 (g/let [x (i) s (sq)]
             (list 'reduce (list 'fn '[acc [k v]] '(+ acc (* k v))) 0 (list 'map-indexed 'vector (list 'take 5 (list 'concat s (list 'list x))))))]
        [1 (g/let [s (sq)] (list 'count (list 'for [['i 'v] (list 'map-indexed 'vector s) :let '[w (* i v)] :when '(even? w)] 'w)))]
        ;; RECURSION THAT IS NOT A LOOP: about 2000 frames deep
        [1 (g/let [x (i)] (list (list 'fn 'f '[n] '(if (zero? n) 0 (inc (f (dec n))))) (list '+ 1500 (list 'mod x 500))))]
        [1 (g/let [x (i)] (list 'letfn '[(f [n] (if (pos? n) (g (dec n)) 0)) (g [n] (if (pos? n) (+ 1 (f (dec n))) 1))] (list 'f (list '+ 1000 (list 'mod x 900)))))]
        ;; try / catch / finally, nested, with a side effect in finally
        [1 (g/let [x (i) y (i)]
             (list 'let '[at (atom 0)]
                   (list '+ (list 'try (list 'try (list 'if (list 'odd? x) (list 'throw (list 'ex-info "in" {:v y})) x)
                                             (list 'finally '(swap! at inc)))
                                  (list 'catch 'clotran.host.exception_info 'e (list '+ 100 (list ':v (list 'ex-data 'e)))))
                         '@at)))]
        [1 (g/let [x (i)]
             (list 'try (list 'nth [] x) (list 'catch 'clotran.host.index_out_of_bounds_exception 'e -1) (list 'catch 'clotran.host.exception 'e -2)))]
        ;; interop on strings, as Clojure writes it
        [1 (g/let [st (lazy #(g-str env (dec d)))] (list '.length st))]
        [1 (g/let [st (lazy #(g-str env (dec d)))] (list '.indexOf st "a"))]
        ;; a long, so clj picks the long overload when it compiles; given a
        ;; boxed long its reflection calls abs(int) and truncates (DEVIATIONS 77)
        [1 (g/let [x (i)] (list 'clotran.host.math/abs (list 'long x)))]]))))

(defn g-seq [env d]
  (if (<= d 0)
    (leaf env :seq (g/one-of [(g/let [n (g/choose 0 8)] (list 'range n))
                              (g/let [xs (g/vector small 0 5)] xs)
                              (g/let [xs (g/vector small 0 4)] (cons 'list xs))]))
    (let [i #(lazy (fn [] (g-int env (dec d)))) sq #(lazy (fn [] (g-seq env (dec d))))
          f #(lazy (fn [] (g-fn env (dec d)))) k (g/choose 0 6)]
      (g/frequency
       [[3 (g-seq env 0)]
        [2 (g/let [n k s (sq)] (list 'take n s))]
        [1 (g/let [n k x (i)] (list 'take n (list 'iterate 'inc x)))]
        [1 (g/let [n k] (list 'take n '(range)))]
        [1 (g/let [n k x (i)] (list 'take n (list 'repeat x)))]
        [2 (g/let [n k s (sq)] (list 'drop n s))]
        [3 (g/let [fn (f) s (sq)] (list 'map fn s))]
        [1 (g/let [s (sq) t (sq)] (list 'map '+ s t))]
        [2 (g/let [p (g/elements '[even? odd? pos? neg? zero?]) s (sq)] (list 'filter p s))]
        [1 (g/let [p (g/elements '[even? odd? pos?]) s (sq)] (list 'remove p s))]
        [2 (g/let [s (sq) t (sq)] (list 'concat s t))]
        [2 (g/let [x (i) s (sq)] (list 'cons x s))]
        [1 (g/let [s (sq)] (list 'rest s))]
        [1 (g/let [x (i) s (sq)] (list 'lazy-seq (list 'cons x s)))]
        [1 (g/let [s (sq)] (list 'reverse s))]
        [1 (g/let [s (sq)] (list 'sort s))]
        [1 (g/let [s (sq)] (list 'distinct s))]
        [1 (g/let [s (sq)] (list 'vec s))]
        [1 (g/let [s (sq) t (sq)] (list 'interleave s t))]
        [1 (g/let [s (sq)] (list 'mapcat (list 'fn '[y] '[y y]) s))]
        [1 (g/let [p (g/elements '[pos? even? odd?]) s (sq)] (list 'take-while p s))]
        [1 (g/let [s (sq)] (list 'for ['y s :when '(odd? y)] '(* y 2)))]
        [1 (g/let [s (sq) x (i)] (list 'conj (list 'vec s) x))]
        [1 (g/let [s (sq)] (list 'map-indexed '+ s))]
        [1 (g/let [s (sq)] (list 'reductions '+ s))]
        [1 (g/let [s (sq)] (list 'into '() s))]
        [2 (g-let env d g-seq)]
        [1 (g/let [s (sq) fn (f)] (list 'into [] (list 'map fn) s))]
        [1 (g/let [s (sq) p (g/elements '[even? odd?])] (list 'sequence (list 'comp (list 'remove p) '(map dec)) s))]
        [1 (g/let [s (sq) n pos-small] (list 'map (list 'fn '[p] '(reduce + p)) (list 'partition n s)))]
        [1 (g/let [s (sq) n pos-small] (list 'map 'count (list 'partition-all n s)))]
        [1 (g/let [s (sq)] (list 'sort-by '- s))]
        [1 (g/let [m (lazy #(g-map env (dec d)))] (list 'sort (list 'vals m)))]
        [1 (g/let [s (sq)] (list 'sort (list 'map 'count (list 'vals (list 'group-by 'even? s)))))]
        [1 (g/let [s (sq)] (list 'map 'second (list 'sort (list 'frequencies s))))]
        [1 (g/let [s (sq) n k] (list 'take n (list 'cycle (list 'cons 1 s))))]
        [1 (g/let [s (sq) n k] (list 'take n (list 'distinct (list 'concat s s))))]
        [1 (g/let [s (sq)] (list 'keep (list 'fn '[v] '(when (odd? v) (* v v))) s))]
        [1 (g/let [s (sq)] (list 'map-indexed (list 'fn '[i v] '(- v i)) s))]
        ;; LAZY EDGES: lazy-cat, empty lazy seqs, cycle of nothing, iterate
        ;; under take-while, repeatedly, nested lazy maps, rest of rest
        [1 (g/let [s (sq) t (sq)] (list 'lazy-cat s t))]
        [1 (g/let [s (sq)] (list 'concat (list 'lazy-seq nil) s (list 'lazy-seq (list 'seq []))))]
        [1 (g/let [n k] (list 'take n (list 'cycle [])))]
        [1 (g/let [x (i)] (list 'take-while '(fn [v] (< v 30)) (list 'iterate '(fn [v] (+ v 3)) x)))]
        [1 (g/let [n k x (i)] (list 'repeatedly n (list 'constantly x)))]
        [1 (g/let [s (sq)] (list 'map 'inc (list 'map 'dec (list 'map 'inc s))))]
        [1 (g/let [s (sq)] (list 'rest (list 'rest (list 'rest s))))]
        [1 (g/let [s (sq)] (list 'take 3 (list 'drop 1 (list 'cycle (list 'cons 0 s)))))]
        [1 (g/let [s (sq)] (list 'seq (list 'doall (list 'filter 'odd? s))))]
        [1 (g/let [s (sq)] (list 'sequence (list 'map-indexed 'vector s)))]]))))

(defn g-bool [env d]
  (let [i #(lazy (fn [] (g-int env (max 0 (dec d))))) sq #(lazy (fn [] (g-seq env (max 0 (dec d)))))
        base [[3 (g/let [op (g/elements '[< > <= = not=]) x (i) y (i)] (list op x y))]
              [2 (g/let [p (g/elements '[even? odd? pos? zero?]) x (i)] (list p x))]
              [1 (g/let [s (sq)] (list 'empty? s))]
              [1 (g/let [s (sq)] (list 'boolean (list 'some 'even? s)))]
              [1 (g/let [x (i)] (list 'satisfies? 'FzP (list 'long x)))]
              [1 (g/let [x (i) y (i)] (list 'satisfies? 'FzP (list '->FzR x y)))]
              [1 (g/let [x (i) y (i)] (list '= (list '->FzR x y) (list '->FzR x y)))]
              [1 (g/let [x (i) y (i)] (list '= (list '->FzR x y) {:a x :b y}))]
              [1 (g/let [x (i) y (i)] (list 'record? (list '->FzR x y)))]
              [1 (g/let [x (i)] (list 'map? (list '->FzT x)))]]]
    ;; generators are built eagerly: and/or only while depth is left
    (g/frequency
     (if (<= d 0)
       base
       (into base [[1 (g/let [x (lazy #(g-bool env (dec d))) y (lazy #(g-bool env (dec d)))] (list 'and x y))]
                   [1 (g/let [x (lazy #(g-bool env (dec d))) y (lazy #(g-bool env (dec d)))] (list 'or x y))]])))))

(defn g-fn [env d]
  (let [x (fresh env) env2 (bind env :int x)]
    (g/frequency
     [[2 (g/elements '[inc dec -])]
      [3 (g/let [b (lazy #(g-int env2 (max 0 (dec d))))] (list 'fn [x] b))]
      [1 (g/let [k small] (list 'partial '+ k))]
      [1 (g/return '(comp inc inc))]
      [1 (g/let [k (g/choose 1 3)] (list 'fn [x] (list '* x k)))]])))

;; a map of keyword to int
(defn g-map [env d]
  (let [i #(lazy (fn [] (g-int env (max 0 (dec d))))) sq #(lazy (fn [] (g-seq env (max 0 (dec d)))))
        kw (g/elements [:a :b :c :d])
        base [[2 (g/let [ks (g/vector kw 0 4) vs (g/vector small 4)] (zipmap ks vs))]
              [1 (g/let [s (sq)] (list 'zipmap [:a :b :c] s))]]]
    (g/frequency
     (if (<= d 0)
       base
       (into base
             [[2 (g/let [m (lazy #(g-map env (dec d))) k kw x (i)] (list 'assoc m k x))]
              [2 (g/let [m (lazy #(g-map env (dec d))) k kw] (list 'update m k '(fnil inc 0)))]
              [1 (g/let [m (lazy #(g-map env (dec d))) n (lazy #(g-map env (dec d)))] (list 'merge m n))]
              [1 (g/let [m (lazy #(g-map env (dec d))) n (lazy #(g-map env (dec d)))] (list 'merge-with '+ m n))]
              [1 (g/let [m (lazy #(g-map env (dec d))) k kw] (list 'dissoc m k))]
              [1 (g/let [m (lazy #(g-map env (dec d)))] (list 'select-keys m [:a :c]))]
              [1 (g/let [m (lazy #(g-map env (dec d)))] (list 'update-vals m 'inc))]
              [1 (g/let [m (lazy #(g-map env (dec d)))] (list 'into {} (list 'filter '(fn [[k v]] (even? v)) m)))]
              [1 (g/let [s (sq)] (list 'reduce (list 'fn '[m v] '(update m (if (even? v) :a :b) (fnil + 0) v)) {} s))]])))))

;; a string
(defn g-str [env d]
  (let [i #(lazy (fn [] (g-int env (max 0 (dec d))))) sq #(lazy (fn [] (g-seq env (max 0 (dec d)))))]
    (g/frequency
     [[2 (g/let [x (i) y (i)] (list 'str x "-" y))]
      [1 (g/let [s (sq)] (list 'apply 'str s))]
      [1 (g/let [s (sq)] (list 'pr-str (list 'vec s)))]
      [1 (g/let [x (i) n (g/choose 0 2)] (list 'subs (list 'str "abcdef" x) n))]
      [1 (g/let [m (lazy #(g-map env (dec d)))] (list 'pr-str (list 'into (sorted-map) m)))]])))

(s/def ::case (s/or :number number? :vector vector? :map map? :form (s/and seq? seq)))

;; Every let, loop, fn, if-let and when-let in a form, checked against the
;; :args spec Clojure gives it (loop's bindings are let's): what does
;; not conform, as [head form]
(def macro-args
  (into {} (for [m '[let fn if-let when-let]] [m (:args (s/get-spec (symbol "clojure.core" (str m))))])))
(defn nonconforming [form]
  (for [x (tree-seq coll? seq form)
        :when (and (seq? x) (symbol? (first x)))
        :let [h (first x) sp (get macro-args (if (= 'loop h) 'let h))]
        :when (and sp (not (s/valid? sp (rest x))))]
    [h x]))
(def g-case (g/sized (fn [size] (let [d (min 5 (+ 1 (quot size 20)))]
                                   (g/frequency [[3 (g-int {} d)] [2 (g-seq {} d)] [1 (g-map {} d)] [1 (g-str {} d)]])))))

;; One rose tree per case, from the seed: the case is its root, its
;; shrinks are its children (--shrink walks them).
(defn generate-roses [n seed]
  (loop [r (random/make-random seed) i 0 acc []]
    (if (= i n)
      acc
      (let [[r1 r2] (random/split r)
            tree (g/call-gen g-case r1 (mod (* 7 i) 100))]
        (recur r2 (inc i) (conj acc tree))))))

;;; ---- calls from the function specs (--fns) --------------------------

(load-file (str repo "/scripts/fuzz_specs.clj"))

(defn arg-form
  "A generated argument as the program writes it: a FnRef's form, any
  other value quoted."
  [v]
  (if (fuzz-specs/fnref? v) (.-form v) (list 'quote v)))

(def spec-bugs (atom #{}))

(defn fn-roses
  "k rose trees of calls to each spec'd function: [fn-symbol tree], the
  tree's root a form."
  [k seed]
  (loop [r (random/make-random seed) fs fuzz-specs/fuzz-fns i 0 acc []]
    (if-let [fsym (first fs)]
      (if (= i k)
        (recur r (rest fs) 0 acc)
        (let [[r1 r2] (random/split r)
              args-spec (:args (s/get-spec fsym))
              args-gen (s/gen args-spec)
              t0 (g/call-gen args-gen r1 (mod (* 13 i) 30))
              ;; THE SPECS' OWN CHECK: what an :args generator makes must
              ;; conform to that :args -- a with-gen that strays is a bug
              ;; in fuzz_specs.clj, not in clotran
              _ (when-not (s/valid? args-spec (vec (rose/root t0)))
                  (swap! spec-bugs conj fsym)
                  (println "SPEC-GEN:" fsym "generated" (pr-str (rose/root t0)) "which its :args refuses"))
              tree (rose/fmap (fn [args] (cons (if (= "clojure.core" (namespace fsym)) (symbol (name fsym)) fsym) (map arg-form args)))
                              t0)]
          (recur r2 fs (inc i) (conj acc [fsym tree]))))
      acc)))

(defn ret-check
  "Each call whose clj answer does not conform to its function's :ret:
  the spec is wrong, or clj is not what its docstring says."
  [fsyms want]
  (for [[i fsym] (map-indexed vector fsyms)
        :let [w (get want i) rs (:ret (s/get-spec fsym))]
        :when (and rs w (not (str/starts-with? (str w) "!error")))
        :let [v (try (read-string w) (catch Exception _ ::unread))]
        :when (and (not= v ::unread) (not (s/valid? rs v)))]
    [fsym i w]))

;;; ---- running ------------------------------------------------------

;; THE FIXTURE: what a case may use beyond clojure.core -- a protocol, a
;; deftype and a defrecord implementing it, the protocol extended to longs
;; and nil, two multimethods (one on a function, one on a keyword, with a
;; :default), a dynamic var -- defined the same on every side: in user for
;; clj and the interpreted modes, in the compiled namespace for compiled;
;; --fixture's definitions follow it
(def fixture (str "
(defprotocol FzP (fz-m [x]) (fz-m2 [x y]))
(deftype FzT [a] FzP (fz-m [_] (* a 2)) (fz-m2 [_ y] (+ a y)))
(defrecord FzR [a b] FzP (fz-m [_] (+ a b)) (fz-m2 [_ y] (* a y)))
(extend-protocol FzP clotran.host.int8 (fz-m [x] (- x)) (fz-m2 [x y] (- x y)) nil (fz-m [_] 0) (fz-m2 [_ y] y))
(defmulti fz-mm (fn [x] (if (even? x) :even :odd)))
(defmethod fz-mm :even [x] (quot x 2))
(defmethod fz-mm :odd [x] (inc (* 3 x)))
(defmulti fz-area :shape)
(defmethod fz-area :sq [{:keys [s]}] (* s s))
(defmethod fz-area :rect [{:keys [w h] :or {h 1}}] (* w h))
(defmethod fz-area :default [_] -1)
(def ^:dynamic *fz-d* 10)
(defn fz-read-d [] *fz-d*)
" (some-> (:fixture opts) slurp)))

(def prelude "
(defn fz-canon [x]
  (cond (map? x) (str \"{\" (clojure.string/join \", \" (sort (map (fn [e] (str (fz-canon (key e)) \" \" (fz-canon (val e)))) x))) \"}\")
        (set? x) (str \"#{\" (clojure.string/join \" \" (sort (map fz-canon x))) \"}\")
        (vector? x) (str \"[\" (clojure.string/join \" \" (map fz-canon x)) \"]\")
        (sequential? x) (str \"(\" (clojure.string/join \" \" (map fz-canon x)) \")\")
        :else (pr-str x)))
;; an error as its class and message, compared as a value is: the
;; message without what follows two spaces and \"at \" (clotran adds where)
(defn fz-err [t]
  (let [m (str (.getMessage t))
        i (.indexOf m \"  at \")]
    (str \"!error \" (.getName (class t)) \": \" (if (neg? i) m (subs m 0 i)))))
(defn fz-out [i f] (println (str \"FZ \" i \" \" (try (fz-canon (f)) (catch clotran.host.throwable t (fz-err t))))))
")

(def requires (str/join " " (map #(str "'" %) (into ["clojure.string" "clojure.set" "clojure.walk"] (:requires opts)))))

;; A case printed with the metadata it was written with -- a field's
;; ^:volatile-mutable, a ^long hint -- which plain pr-str drops: every
;; mutable-field case of fuzz-deftype reached clj with its fields
;; immutable and was refused by both sides. The reader's own positions
;; are left out.
(defn pr-case [f]
  (binding [*print-meta* true]
    ;; a form's parts with metadata are symbols and collections, all of
    ;; which take with-meta
    (pr-str (walk/postwalk (fn [x] (if-let [m (meta x)]
                                     (with-meta x (not-empty (dissoc m :line :column :end-line :end-column)))
                                     x))
                           f))))

(defn case-script [forms]
  (str "(in-ns 'user)\n(require " requires ")\n" prelude fixture
       (apply str (map-indexed (fn [i f] (str "(fz-out " i " (fn [] " (pr-case f) "))\n")) forms))
       "(shutdown-agents)\n"))

(defn outputs [text]
  (into {} (for [l (str/split-lines (or text ""))
                 :let [[_ i v] (re-find #"^FZ (\d+) (.*)$" l)] :when i]
             [(parse-long i) v])))

(def work (str (fs/create-temp-dir {:prefix "fuzz-"})))

;; Every process has a DEADLINE (--timeout, seconds): a run that
;; hangs -- ICU looping on a regex, gfortran on a huge file -- is killed
;; with everything it started and counted as a finding, not waited on
;; for an hour.
(def timeouts (atom []))
(def last-run (atom nil))   ; the last process's {:exit :err}

(def ^:dynamic *deadline* nil)

(defn sh [env & cmd]
  (let [proc (apply p/process {:dir repo :in "" :out :string :err :string :extra-env env} cmd)
        secs (or *deadline* (:timeout opts))
        r (deref proc (* 1000 secs) ::timeout)]
    (if (= r ::timeout)
      (do (p/destroy-tree proc)
          (swap! timeouts conj (str/join " " (take 3 cmd)))
          (println "TIMEOUT after" secs "s:" (str/join " " (map #(if (> (count %) 80) (str (subs % 0 77) "...") %) cmd)))
          (reset! last-run {:exit :timeout :err ""})
          {:out "" :err "" :exit -1})
      (do (reset! last-run {:exit (:exit r) :err (:err r)}) r))))

(defn run-clj [forms]
  (let [f (str work "/cases.clj")]
    (spit f (names/to-upstream (case-script forms)))
    (let [r (sh {} "clj" "-Sdeps" (slurp (str repo "/deps.edn")) "-M" f)
          out (update-vals (outputs (:out r)) names/from-clj)]
      ;; a case clj does not answer is not compared: say why it stopped
      (when (< (count out) (count forms))
        (println "clj stopped after" (count out) "of" (count forms) "cases:")
        (println (str/join "\n" (take 6 (str/split-lines (str (:err r)))))))
      out)))

(defn run-clotran [mode forms]
  (let [core (str repo "/src/clj/clojure/core.clj") bin (str repo "/clotran-bin")]
    (case mode
      "flat" (let [f (str work "/cases.cljf")] (spit f (case-script forms))
               (cond->> (outputs (:out (sh {} bin core f)))
                 ;; --control-shrink's planted bug
                 (:control-shrink opts) (into {} (map (fn [[k v]] [k (str/replace v "7" "8")])))))
      "tree" (let [f (str work "/cases.cljf")] (spit f (case-script forms))
               (outputs (:out (sh {"CLOTRAN_FLAT" "0"} bin core f))))
      "vm" (let [f (str work "/cases.cljf")] (spit f (case-script forms))
             (outputs (:out (sh {"CLOTRAN_VM" "1" "CLOTRAN_IMAGE" "0"} bin core f))))
      ;; the VM and the JIT load core from source (no image), so core's fns
      ;; are compiled by the VM too, not the flat code the image holds
      ;; the VM's code translated to native code (src/f/vmjit.inc)
      "jit" (let [f (str work "/cases.cljf")] (spit f (case-script forms))
              (outputs (:out (sh {"CLOTRAN_VM" "1" "CLOTRAN_JIT" "1" "CLOTRAN_IMAGE" "0"} bin core f))))
      ;; its negative control: a jmpf block that branches on the opposite
      ;; test (CLOTRAN_JIT_BREAK), which this mode must catch
      "jit-control" (let [f (str work "/cases.cljf")] (spit f (case-script forms))
                      (outputs (:out (sh {"CLOTRAN_VM" "1" "CLOTRAN_JIT" "1" "CLOTRAN_JIT_BREAK" "1"} bin core f))))
      ;; the compiled prims' control: an integer sum one off
      ;; (CLOTRAN_JIT_BREAK=2, model/vmj2.lisp's prim-fast-ok broken)
      "jit-control-prim" (let [f (str work "/cases.cljf")] (spit f (case-script forms))
                           (outputs (:out (sh {"CLOTRAN_VM" "1" "CLOTRAN_JIT" "1" "CLOTRAN_JIT_BREAK" "2"} bin core f))))
      ;; native recur's control: of two values or more, the last not copied (CLOTRAN_JIT_BREAK=3)
      "jit-control-recur" (let [f (str work "/cases.cljf")] (spit f (case-script forms))
                            (outputs (:out (sh {"CLOTRAN_VM" "1" "CLOTRAN_JIT" "1" "CLOTRAN_JIT_BREAK" "3"} bin core f))))
      "noimage" (let [f (str work "/cases.cljf")] (spit f (case-script forms))
                  (outputs (:out (sh {"CLOTRAN_IMAGE" "0"} bin core f))))
      "compiled"
      ;; each case a fn of a namespace, compiled; a fn the generator
      ;; declines stays interpreted, and the run says how many compiled
      (let [nsf (str work "/fz/cases.cljf") lib (str work "/fz.dylib") drv (str work "/drive.cljf")]
        (fs/create-dirs (str work "/fz"))
        (spit nsf (str "(ns fz.cases (:require [clojure.string] [clojure.set] [clojure.walk]"
                       (apply str (map #(str " [" % "]") (:requires opts))) "))\n" fixture
                       (apply str (map-indexed (fn [i f] (str "(defn c" i " [] " (pr-case f) ")\n")) forms))))
        (let [c (sh {"CLOTRAN_CACHE" (str work "/cache")} (str repo "/clotran") "compile" nsf lib)]
          (when-not (fs/exists? lib)
            (println "compiled mode: no library:")
            (println (str/join "\n" (take-last 25 (str/split-lines (str (:out c) (:err c))))))))
        (spit drv (str "(in-ns 'user)\n(require " requires ")\n" prelude
                       "(load-file " (pr-str nsf) ")\n(require 'clotran.loader)\n"
                       "(clotran.loader/install " (pr-str lib) " " (pr-str nsf) ")\n"
                       "(println \"FZCOMPILED\" (count (filter #(clojure.string/starts-with? (str (deref %)) \"#<compiled\") (vals (ns-interns 'fz.cases)))))\n"
                       (apply str (for [i (range (count forms))] (str "(fz-out " i " fz.cases/c" i ")\n")))))
        (let [r (sh {"CLOTRAN_IMAGE" "0"} bin core drv)]
          (when-let [[_ k] (re-find #"FZCOMPILED (\d+)" (:out r))]
            (println (str "compiled mode: " k " of " (count forms) " cases compiled")))
          (outputs (:out r))))
      ;; torture, or torture-N: the collector every N allocations
      (if (str/starts-with? mode "torture")
        (let [f (str work "/cases.cljf")
              every (or (second (re-find #"^torture-(\d+)$" mode)) "97")]
          (spit f (case-script forms))
          (outputs (:out (sh {"CLOTRAN_GC_EVERY" every "CLOTRAN_IMAGE" "0"} bin core f))))
        (throw (ex-info (str "no mode " mode) {}))))))


(defn- dbl [s] (when (and s (re-matches #"-?\d+\.\d+(E-?\d+)?" s)) (parse-double s)))

;; An error's message, less what only clj's host says: the module and
;; loader a ClassCastException names, and the word "class" before each
;; name in it, the method call a NullPointerException
;; describes, and "/ by zero", which is what its host's integer division
;; says where the boxed path says "Divide by zero" -- which one clj answers
;; depends on whether its compiler saw primitive longs
(defn error-text [s]
  (if-not (and (string? s) (str/starts-with? s "!error"))
    s
    (-> s
        (str/replace #" \([^()]*\bmodule\b[^()]*\)$" "")
        (str/replace #"\bclass (\S+) cannot be cast to class (\S+)" "$1 cannot be cast to $2")
        ;; the fn an arity error names, by its own name: clj's path has its
        ;; class counters (fn--134, eval2108; DEVIATIONS 34), and a case's
        ;; enclosing fn is the harness's (a defn in compiled mode); the
        ;; path itself is the oracle's to check
        (str/replace #"passed to: \S*/(\S+)$" (fn [[_ w]] (str "passed to: " (str/replace w #"--\d+$" ""))))
        (str/replace #"^(!error \S*null_pointer_exception):.*$" "$1:")
        (str/replace "/ by zero" "Divide by zero")
        ;; count, compare and hash answer clj's Integer, clotran's one
        ;; integer (DEVIATIONS 71), and a message names the class
        (str/replace "clotran.host.int4" "clotran.host.int8"))))

(defn differs
  "Whether clotran's answer is not clj's. One allowance, DEVIATIONS 70: a
  ratio becomes a double by Fortran's IEEE quotient, clj's by a 16-digit
  decimal first, so with a ratio in the form two doubles a unit in the
  last place apart agree. And DEVIATIONS 72: a ratio, or a boxed long,
  less the smallest long is exact here, where clj's host overflows
  negating it -- so with the smallest long in the form, clj's long
  overflow and a number here agree. Errors
  compare by class and message (error-text)."
  ([want got] (differs want got nil))
  ([want got form]
   (and (some? want) (not= (error-text want) (error-text got))
        (not (and form (str/includes? (pr-str form) "/")
                  (when-let [a (dbl want)] (when-let [b (dbl got)] (<= (abs (- a b)) (Math/ulp (double a)))))))
        (not (and form (str/includes? (pr-str form) "-9223372036854775808")
                  (str/ends-with? (str want) "arithmetic_exception: long overflow")
                  (re-find #"^\[?-?\d+(/\d+)?" (str got))))
        ;; ...and a BigInt less it: clj's wrapped negation answers the
        ;; BigInt PLUS the smallest long, 2^64 from the exact difference
        (not (and form (str/includes? (pr-str form) "-9223372036854775808")
                  (let [lead #(some-> (re-find #"^\[?(-?\d+)N?[ \]]" (str %)) second bigint)
                        a (lead want) b (lead got)]
                    (and a b (= (abs (- a b)) 18446744073709551616N))))))))

;;; ---- shrinking ------------------------------------------------------

(defn fails? [mode form]
  (let [w (get (run-clj [form]) 0) g (get (run-clotran mode [form]) 0)]
    (and (some? w) (differs w g))))

(def shrunk (atom []))   ; --control-shrink's record of what shrinking did

(def shrink-until
  "when --shrink-budget's wall time runs out, for every failure together"
  (delay (some->> (:shrink-budget opts) (* 1000) (+ (System/currentTimeMillis)))))

(defn shrink
  "[smallest form found, whether the budget cut it short]"
  [mode tree]
  ;; greedy: the first child that still fails, until none does
  (loop [t tree tries 0]
    (let [out? (some-> @shrink-until (< (System/currentTimeMillis)))
          kid (when (and (< tries 60) (not out?))
                (some #(when (fails? mode (rose/root %)) %) (take 8 (rose/children t))))]
      (if kid (recur kid (inc tries)) [(rose/root t) (boolean out?)]))))

;;; ---- main -----------------------------------------------------------

;; A run over cases i.. -- (run forms) -> {position answer} -- that
;; also says which cases never ANSWER: every case prints a line, even a
;; throw, so a case without one means the process hung (the deadline) or
;; died (a crash: ERROR STOP, a signal), and every case after it lost its
;; answer too. Then the batch is halved and each half run again, under
;; the shorter probe deadline, until each such case stands alone, and is
;; named a :hang or a :crash. Answers come back by the cases' own indices.
(defn run-finding-hangs [run forms idxs]
  (let [out (binding [*deadline* (if (< (count idxs) (count forms)) (:probe-timeout opts) *deadline*)]
              (run (mapv forms idxs)))
        how @last-run
        by-idx (into {} (map (fn [[j v]] [(nth idxs j) v]) out))]
    (cond (every? #(contains? by-idx %) idxs) {:out by-idx :hangs []}
          (= 1 (count idxs)) {:out {} :hangs [[(first idxs) (if (= :timeout (:exit how)) :timeout :crash)
                                                  (let [ls (some->> (:err how) str/split-lines (remove str/blank?))] (or (first (filter #(re-find #"(?i)error" %) ls)) (last ls)))]]}
          :else (let [[a b] (split-at (quot (count idxs) 2) idxs)
                      ra (run-finding-hangs run forms (vec a))
                      rb (run-finding-hangs run forms (vec b))
                      found (into (:hangs ra) (:hangs rb))]
                  ;; the batch failed and neither half does: the failure needs
                  ;; them together -- a deadlock between threads one case
                  ;; started and another's, say. A finding, not a pass: the
                  ;; one this search once hid ran every threads batch into
                  ;; its deadline, and fuzz-threads passed
                  {:out (merge (:out ra) (:out rb))
                   :hangs (if (seq found)
                            found
                            [[(first idxs) (if (= :timeout (:exit how)) :batch-timeout :batch-crash)
                              (str "cases " (first idxs) ".." (last idxs) " fail together and finish apart")]])}))))

(def hangs (atom []))

(let [{:keys [n seed modes]} opts
      fixed (some-> (:file opts) slurp read-string vec)   ; the reader, not edn: a case may hold #"regex"
      fn-pairs (when (:fns opts) (fn-roses (:fns opts) seed))
      fsyms (mapv first fn-pairs)
      n (cond fixed (count fixed) fn-pairs (count fn-pairs) :else n)
      roses (cond fixed nil fn-pairs (mapv second fn-pairs) :else (generate-roses n seed))
      forms (or fixed (mapv rose/root roses))
      _ (doseq [f forms]
          (when-not (s/valid? ::case f) (println "fuzz: a generated case does not conform:" (pr-str f)))
          (doseq [[h x] (nonconforming f)] (println "fuzz: a generated" h "does not conform to its spec:" (pr-str x))))
      ;; -m "": no mode, the cases only (scripts/fuzz-net takes them)
      _ (when (empty? modes) (System/exit 0))
      want (let [{:keys [out] h :hangs} (run-finding-hangs run-clj forms (vec (range (count forms))))]
             (doseq [[i k] h] (println "clj" (name k) "on case" i "(not compared):" (pr-str (nth forms i))))
             out)
      _ (when (< (count want) n) (println "clj answered" (count want) "of" n "cases"))
      ;; what was tested: a case both sides throw on agrees, and says little
      _ (println (format "%d cases, %.0f forms a case on average; clj threw on %d"
                         n (double (/ (reduce + (map #(count (tree-seq coll? seq %)) forms)) (max n 1)))
                         (count (filter #(str/starts-with? (str %) "!error") (vals want)))))
      _ (when fn-pairs
          (println (count fuzz-specs/fuzz-fns) "functions spec'd")
          ;; every spec'd function says what it returns, or its answers go unchecked
          (doseq [fsym fuzz-specs/fuzz-fns :when (nil? (:ret (s/get-spec fsym)))]
            (swap! spec-bugs conj fsym)
            (println "SPEC:" fsym "has no :ret"))
          (doseq [[fsym i w] (ret-check fsyms want)]
            (println "SPEC:" fsym "answered" w "in clj, which its :ret refuses --" (pr-str (nth forms i))))
          ;; an :args spec clj throws on often is too loose: it tests errors, not answers
          (doseq [[fsym k] (frequencies (keep (fn [i] (when (str/starts-with? (str (get want i)) "!error") (nth fsyms i))) (range n)))
                  :when (> k (quot (:fns opts) 2))]
            (println "LOOSE:" fsym "threw in clj on" k "of" (:fns opts) "calls")))
      bad (atom [])]
  (doseq [m modes]
    (let [{got :out h :hangs} (run-finding-hangs (partial run-clotran m) forms (vec (range n)))
          _ (doseq [[i k err] h :when (contains? want i)]
              (swap! hangs conj [m i k])
              (println (str/upper-case (name k)) m "case" i
                       (case k
                         :timeout (str "(no answer in " (:probe-timeout opts) " s)")
                         :crash "(the process died)"
                         (:batch-timeout :batch-crash) "(only with the cases run beside it)")
                       "-- clj answers" (get want i) ":" (pr-str (nth forms i)))
              (when (seq err) (println "   " err)))
          hung (set (map first h))
          diffs (filter #(and (not (hung %)) (differs (get want %) (get got %) (nth forms %))) (range n))]
      (println (format "%-9s %d cases, %d differ from clj" m n (count diffs)))
      (doseq [i diffs] (swap! bad conj [m i (get got i)]))))
  (doseq [[m i batch] (take 40 @bad)]
    (let [f (nth forms i)]
      (println "---" m "case" i)
      (when-not (:file opts)
        (println (str "  seed:    " seed " -- scripts/fuzz " (if (:fns opts) (str "--fns " (:fns opts)) (str "-n " n)) " -s " seed " -m " m " reproduces it")))
      (println "  form:   " (pr-str f))
      (println "  clj:    " (get want i))
      ;; the answer the run gave, beside the case's alone: a case that
      ;; passes alone fails because of its neighbours, and showing only
      ;; the alone answer hid that
      (println "  clotran:" batch)
      (let [alone (get (run-clotran m [f]) 0)]
        (when (not= alone batch) (println "  alone:  " alone)))
      (when (and (:shrink opts) roses)
        (let [[small cut] (shrink m (nth roses i))]
          (swap! shrunk conj {:small small :orig f :still (fails? m small)})
          (println (str "  shrunk: " (pr-str small) (when cut "   (the shrink budget ran out first)")))
          (println "    clj:    " (get (run-clj [small]) 0))
          (println "    clotran:" (get (run-clotran m [small]) 0))))))
  (if (:keep opts) (println "kept:" work) (fs/delete-tree work))
  (when (seq @hangs) (println "TIMEOUTS AND CRASHES:" (count @hangs) "-- cases clj answers and clotran does not, in time or at all"))
  (when (seq @spec-bugs) (println "SPEC BUGS:" (count @spec-bugs) "functions' specs are wrong"))
  (when (:control-shrink opts)
    (let [ok (and (seq @shrunk)
                  (some #(< (count (pr-str (:small %))) (count (pr-str (:orig %)))) @shrunk)
                  (every? #(and (:still %) (<= (count (pr-str (:small %))) (count (pr-str (:orig %))))) @shrunk))]
      (println (format "CONTROL: %d planted failures shrunk, %d smaller than found, all still failing: %s"
                       (count @shrunk) (count (filter #(< (count (pr-str (:small %))) (count (pr-str (:orig %)))) @shrunk))
                       (if ok "yes" "NO")))
      (System/exit (if ok 0 1))))
  (System/exit (if (or (seq @bad) (seq @hangs) (seq @spec-bugs)) 1 0)))
