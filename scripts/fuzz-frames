#!/usr/bin/env bb
;; fuzz-frames: stack frames and traces, generated (PLAN step 28: the VM
;; changes frames, so what they show is pinned first).
;;
;;   scripts/fuzz-frames [-n N] [-s SEED] [--modes flat,tree,compiled] [--show K]
;;                       [--leaves throw|break]   every case ending so
;;
;; Each case is a chain of functions f0 -> f1 -> ... -> fk, each with
;; known arguments and locals, linked by a random CALL SHAPE -- a direct
;; call, a let-bound closure, a named fn, apply, a loop's exit, a
;; try/finally, a mapv or reduce callback -- ending in a THROW or a BREAK.
;;
;;   a throw   the chain of user frames in (.getStackTrace e), against
;;             clj's own, both normalised: clj's munged names demunged
;;             (fzf$f1$g__12 -> fzf/f1/g), invoke/invokeStatic pairs and
;;             eval frames dropped
;;   a break   (clotran-break)'s frames, against what the generator built:
;;             each pending call's function, innermost first, and each
;;             frame's locals by name and value
;;
;; and in both, each frame's LINE against the generator's: a function is
;; four lines, and every frame of it is at its third, where its pending
;; call is written. Each case runs twice, the second time from a copy
;; of the file moved down by `shift` lines -- load-file'd again, or
;; compiled and installed again -- and the lines must move with it: a
;; position left over from the first load is a debugger pointing at the
;; wrong line.
;;
;; And every clotran mode against the others. A disagreement is counted
;; by KIND -- a frame missing, a name, a local missing, a local read nil
;; where it held a value (cleared), a value, a mode -- and the first few
;; of each are shown.
(require '[clojure.string :as str]
         '[babashka.fs :as fs]
         '[babashka.process :as p])

(def opts (loop [as *command-line-args* o {:n 100 :seed 1 :modes ["flat" "tree" "compiled"] :show 3}]
            (if (empty? as) o
                (case (first as)
                  "-n" (recur (drop 2 as) (assoc o :n (parse-long (second as))))
                  "-s" (recur (drop 2 as) (assoc o :seed (parse-long (second as))))
                  "--modes" (recur (drop 2 as) (assoc o :modes (str/split (second as) #",")))
                  "--show" (recur (drop 2 as) (assoc o :show (parse-long (second as))))
                  "--leaves" (recur (drop 2 as) (assoc o :leaf (keyword (second as))))
                  (do (println "usage: scripts/fuzz-frames [-n N] [-s SEED] [--modes a,b] [--show K] [--leaves throw|break]") (System/exit 2))))))

(def repo (str (fs/canonicalize ".")))
(def work (str (fs/create-temp-dir {:prefix "fzframes"})))

;; splitmix64, seeded
(def state (atom (long (:seed opts))))
(defn rnd []
  (let [z (swap! state #(unchecked-add % -7046029254386353131))
        z (unchecked-multiply (bit-xor z (unsigned-bit-shift-right z 30)) -4658895280553007687)
        z (unchecked-multiply (bit-xor z (unsigned-bit-shift-right z 27)) -7723592293110705685)]
    (bit-xor z (unsigned-bit-shift-right z 31))))
(defn pick [xs] (nth xs (mod (rnd) (count xs))))
(defn rint [lo hi] (+ lo (mod (rnd) (- hi lo))))

;; ---- the generator ---------------------------------------------------
;;
;; Function i of case c is fzf/c<c>f<i>, takes the one argument a with a
;; known value, binds locals l0.. from it, and calls the next by a shape.
;; Each shape says the frames it adds above the callee's, and their names
;; as clj names them (the oracle for the names clotran should give).

(def shapes [:direct :closure :named :apply :loop :try :mapv :reduce])

(defn fname [c i] (str "c" c "f" i))

(defn gen-case [c]
  (let [k (rint 2 6)
        ;; drawn either way, so a seed builds the same chains with --leaves
        leaf (let [l (pick [:throw :break])] (or (:leaf opts) l))
        fns (vec (for [i (range k)]
                   (let [a (rint 1 100)
                         nl (rint 0 3)
                         locals (vec (for [j (range nl)] [(str "l" j) (+ a j 1)]))]
                     {:i i :arg a :locals locals :shape (when (< i (dec k)) (pick shapes))})))
        ;; the next function's argument is this one's argument plus 1000
        fns (vec (map-indexed (fn [i f] (assoc f :arg (+ 1000 i (:arg (first fns))))) fns))]
    {:c c :k k :leaf leaf :fns fns}))

(defn call-of [c {:keys [i shape]} next-arg]
  (let [callee (fname c (inc i))]
    (case shape
      :direct (str "(" callee " " next-arg ")")
      :closure (str "(let [g (fn [p] (" callee " p))] (g " next-arg "))")
      :named (str "((fn hop [p] (" callee " p)) " next-arg ")")
      :apply (str "(apply " callee " [" next-arg "])")
      :loop (str "(loop [j 0] (if (< j 2) (recur (inc j)) (" callee " " next-arg ")))")
      :try (str "(try (" callee " " next-arg ") (finally nil))")
      :mapv (str "(first (mapv (fn [p] (" callee " p)) [" next-arg "]))")
      :reduce (str "(reduce (fn [_ p] (" callee " p)) nil [" next-arg "])"))))

;; the frames a shape adds above its callee, as clj names them
(defn shape-frames [c {:keys [i shape]}]
  (let [me (str "fzf/" (fname c i))]
    (case shape
      :closure [(str me "/g")]
      :named [(str me "/hop")]
      (:mapv :reduce) [(str me "/fn")]
      [])))

(defn fn-src [c {:keys [i locals] :as f} leaf fns]
  (let [body (if (= i (dec (count fns)))
               (if (= leaf :throw) "(throw (ex-info \"fz\" {}))" "(clotran-break)")
               (call-of c f (:arg (nth fns (inc i)))))
        ;; every local is read after the call or break, so none is dead
        ;; there: what a frame shows is what the program still holds
        uses (str/join " " (concat ["a"] (map first locals)))]
    [(str "(defn " (fname c i) " [a]")
     (str "  (let [" (str/join " " (mapcat (fn [[n v]] [n (str "(+ a " (- v (:arg f)) ")")]) locals)) "]")
     (str "    (let [r " body "]")
     (str "      (vector r " uses "))))")]))

(defn case-lines [{:keys [c fns leaf]}]
  (map (fn [f] [[c (:i f)] (fn-src c f leaf fns)]) (reverse fns)))

;; what a break must show, innermost first: per function, its frame and
;; the frames its call shape adds below it
(declare call-line)

(defn expected-break [{:keys [c fns]}]
  (vec (reverse
        (mapcat (fn [f]
                  (let [line (call-line [c (:i f)])
                        me {:fn (str "fzf/" (fname c (:i f))) :line line
                            :env (into {"a" (:arg f)} (:locals f))}]
                    (cons me (map (fn [n] {:fn n :line line}) (shape-frames c f)))))
                fns))))

;; ---- running -----------------------------------------------------------

(def cases (vec (for [c (range (:n opts))] (gen-case c))))

(def prelude
  ["(ns fzf)"
   "(defn fz-chain [t] (mapv (fn [e] [(.getClassName e) (.getLineNumber e)]) (.getStackTrace t)))"])

;; the source, a line at a time, and each function's call line
(def src-lines (into prelude (mapcat (comp (partial mapcat second) case-lines) cases)))
(def call-line
  (loop [ls (mapcat case-lines cases) at (inc (count prelude)) m {}]
    (if-let [[k fl] (first ls)]
      (recur (rest ls) (+ at (count fl)) (assoc m k (+ at 2)))
      m)))
(def shift 7)
(def src (str (str/join "\n" src-lines) "\n"))
(def src-shifted (str (str/join (repeat shift ";\n")) src))

(defn drive [catch-class phase]
  (str/join "\n"
            (for [{:keys [c leaf]} cases]
              (if (= leaf :throw)
                (str "(println \"FZF\" " phase " " c " (pr-str (try (" (fname c 0) " " (:arg (first (:fns (cases c)))) ") nil (catch " catch-class " t (fz-chain t)))))")
                (str "(println \"FZF\" " phase " " c " (pr-str (let [b (" (fname c 0) " " (:arg (first (:fns (cases c)))) ")"
                     " b (some #(when (and (map? %) (contains? % :frames)) %) (tree-seq vector? seq b))] (mapv (fn [f] {:fn (:fn f) :line (:line f) :env (into {} (map (fn [[k v]] [(str k) (if (or (nil? v) (number? v)) v :other)]) (:env f)))}) (:frames b)))))")))))

(defn outputs [out]
  (into {} (for [[_ p c v] (re-seq #"FZF (\d+) (\d+) (.*)" out)] [[(parse-long p) (parse-long c)] (read-string v)])))

(defn sh [env & args] (apply p/shell {:out :string :err :string :in "" :continue true :extra-env env} args))


(defn run-clj []
  (let [f (str work "/clj.clj")]
    ;; clj has no break: a stub, the break cases' answers unread
    (spit f (str (str/replace src "(ns fzf)" "(ns fzf)\n(defn clotran-break [] nil)") (drive "Throwable" 0) "\n"))
    (outputs (:out (sh {} "clj" "-M" f)))))

(defn run-clotran [mode]
  (let [core (str repo "/src/clj/clojure/core.clj") bin (str repo "/clotran-bin")]
    (case mode
      ("flat" "tree")
      (let [f0 (str work "/" mode "-0.cljf") f1 (str work "/" mode "-1.cljf") drv (str work "/" mode "-drive.cljf")]
        (spit f0 src)
        (spit f1 src-shifted)
        (spit drv (str (str/join "\n" (for [[p fl] [[0 f0] [1 f1]]]
                                         (str "(load-file " (pr-str fl) ")\n(in-ns 'fzf)\n" (drive "clotran.host.throwable" p))))
                       "\n"))
        (outputs (:out (sh (if (= mode "tree") {"CLOTRAN_FLAT" "0"} {}) bin core drv))))
      "compiled"
      (let [drv (str work "/drive.cljf")
            ;; the shifted copy is compiled again, through the same cache
            parts (for [[p s] [[0 src] [1 src-shifted]]
                        :let [d (str work "/c" p) nsf (str d "/fzf.cljf") lib (str d "/fzf.dylib")]]
                    (do (fs/create-dirs d)
                        (spit nsf s)
                        (sh {"CLOTRAN_CACHE" (str work "/cache")} (str repo "/clotran") "compile" nsf lib)
                        (str "(in-ns 'user)\n(load-file " (pr-str nsf) ")\n(require 'clotran.loader)\n"
                             (when (fs/exists? lib) (str "(clotran.loader/install " (pr-str lib) " " (pr-str nsf) ")\n"))
                             "(in-ns 'fzf)\n" (drive "clotran.host.throwable" p))))]
        (spit drv (str (str/join "\n" parts) "\n"))
        (outputs (:out (sh {"CLOTRAN_IMAGE" "0"} bin core drv)))))))

;; ---- comparing -----------------------------------------------------------

;; clj's class names as fzf/fn/inner: munged dashes back, the counters off
(defn demunge [s] (-> s (str/replace "_" "-") (str/replace #"--\d+" "") (str/replace "$" "/")))

(defn user-chain [elems clj?]
  (->> elems
       (filter #(str/starts-with? (first %) (if clj? "fzf$" "fzf/")))
       (map (fn [[n l]] [(if clj? (demunge n) n) l]))
       (remove #(re-find #"/eval\d*" (first %)))
       (partition-by first) (map first) vec))

;; the line every frame of fzf/cCfI... should show, in phase p
(defn want-line [p n]
  (when-let [[_ c i] (re-find #"^fzf/c(\d+)f(\d+)" n)]
    (+ (* p shift) (call-line [(parse-long c) (parse-long i)]))))

(defn line-diffs [p frames]
  (for [{:keys [fn line]} frames
        :let [w (want-line p fn)]
        :when (and w (not= w line))]
    [:line (str "phase " p " " fn " at line " line " not " w)]))

;; the frames clj's compiler adds: a loop or try in expression position
;; runs as ((fn* [] form)), a call the program did not write
;; (DEVIATIONS 73)
(defn hoisted [{:keys [c fns]}]
  (set (for [f fns :when (#{:loop :try} (:shape f))] (str "fzf/" (fname c (:i f)) "/fn"))))

(defn shifted [p want] (mapv #(update % :line + (* p shift)) want))

;; the program's own frames: its namespace's, and anonymous ones (a
;; closure named "fn" is the program's, not core's); clojure.core's own
;; -- apply, mapv's walk -- are not the program's to check
(defn own-frames [got]
  (filterv #(let [n (str (:fn %))] (or (str/starts-with? n "fzf/") (= n "fn"))) got))

(defn break-diffs [p want0 got0]
  (let [got (own-frames got0) want (shifted p want0)]
  (concat
   (line-diffs p got)
   (when (not= (map :fn want) (map :fn got))
     [[:frames (str "want " (pr-str (map :fn want)) " got " (pr-str (map :fn got)))]])
   (for [[w g] (map vector want got)
         :when (= (:fn w) (:fn g))
         [k v] (:env w)
         :let [gv (get (:env g) k ::absent)]
         :when (not= gv v)]
     (cond (= gv ::absent) [:local-missing (str (:fn w) " " k)]
           (nil? gv) [:local-cleared (str (:fn w) " " k " read nil, held " v)]
           :else [:local-value (str (:fn w) " " k " " gv " not " v)])))))

(let [modes (:modes opts)
      clj (run-clj)
      got (into {} (for [m modes] [m (run-clotran m)]))
      problems
      (for [{:keys [c leaf] :as cs} cases
            m modes
            p [0 1]
            :let [g (get-in got [m [p c]])]
            d (cond
                (nil? g) [[:no-answer (str m " phase " p)]]
                (= leaf :throw)
                (let [w (remove (hoisted cs) (map first (user-chain (get clj [0 c]) true)))
                      h (user-chain g false)]
                  (concat
                   (when (not= w (map first h)) [[:trace (str "clj " (pr-str w) " clotran " (pr-str (map first h)))]])
                   (line-diffs p (map (fn [[n l]] {:fn n :line l}) h))))
                :else (break-diffs p (expected-break cs) g))]
        (assoc (zipmap [:kind :detail] d) :case c :mode m))
      mode-diffs (for [{:keys [c]} cases
                       :let [vs (distinct (map #(get-in got [% [0 c]]) modes))]
                       :when (> (count vs) 1)]
                   c)]
  (println (str "fuzz-frames: " (count cases) " cases ("
                (count (filter #(= :throw (:leaf %)) cases)) " throw, "
                (count (filter #(= :break (:leaf %)) cases)) " break) x " (count modes) " modes"))
  (doseq [[kind ps] (sort-by key (group-by :kind problems))]
    (println (format "  %-14s %4d" (name kind) (count ps)))
    (doseq [p (take (:show opts) ps)]
      (println (str "      case " (:case p) " " (:mode p) ": " (:detail p)))))
  (println (str "  modes disagree on " (count mode-diffs) " cases"))
  (doseq [c (take (:show opts) mode-diffs)] (println (str "      case " c)))
  (System/exit (if (and (empty? problems) (empty? mode-diffs)) 0 1)))
