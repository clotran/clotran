#!/usr/bin/env bb
;; fuzz-vm-gen: the GENERATED Fortran VM (src/f/gen/vm_gen.f90, written
;; by scripts/acl2-fortran from model/vmg.lisp) against the ACL2 it was
;; generated from, step for step (PLAN step 30).
;;
;;   scripts/fuzz-vm-gen [-n COUNT] [-s SEED] [-x] [--fc gfortran|flang]
;;
;; fuzz-vmx2's programs (closures, loops, variadic calls, throws, the
;; runtime's primitives) are compiled and encoded by ACL2, which prints
;; each program's arrays and vmi's trace: the machine after every step.
;; test/vm/vm_check runs the same arrays on the generated code and prints
;; its trace. The two must agree line for line, token for token -- the
;; registers, every live stack slot's value, every live control record.
;; This checks the translator and the compiler together: the proof is
;; about the ACL2; this is what says the Fortran is it.
;;
;; -x is the NEGATIVE CONTROL: the generated unwind, with no handler to
;; land at, leaves two slots where ACL2 leaves one, and the traces must part.
(require '[babashka.process :as p] '[clojure.string :as str] '[clojure.edn :as edn] '[babashka.fs :as fs])

(def broken (some #{"-x"} *command-line-args*))
(def args (apply hash-map (remove #{"-x"} *command-line-args*)))
(def n (parse-long (get args "-n" "100")))
(def seed (parse-long (get args "-s" (str (mod (System/nanoTime) 2147483647)))))
(def fc (get args "--fc" "gfortran"))
(def work (str (fs/create-temp-dir {:prefix "fuzz-vm-gen"})))

;; the programs: fuzz-vmx2's generator
(p/shell {:out :string} "scripts/fuzz-vmx2" "-n" (str n) "-s" (str seed) "--emit" (str work "/progs.edn"))
(def exprs (edn/read-string (slurp (str work "/progs.edn"))))

(defn lisp [x]
  (cond (seq? x) (str "(" (str/join " " (map lisp x)) ")")
        (keyword? x) (str ":" (name x))
        (true? x) "t"
        (nil? x) "nil"
        :else (str x)))

;; ---- ACL2: each program's arrays and vmi's trace ----------------------------------

(def driver
  (str "(include-book \"vmi\")\n"
       "(set-print-case :downcase state)\n"
       "(set-fmt-hard-right-margin 100000 state)\n(set-fmt-soft-right-margin 100000 state)\n"
       "(defun strip-to-clauses (ds) (if (atom ds) nil (cons (list (caar ds) (list (cadar ds) (caddar ds))) (strip-to-clauses (cdr ds)))))\n"
       "(defconst *xall-defs* (append (strip-to-clauses *x-defs*) *x2-defs*))\n"
       "(defconst *xall-names* (strip-cars *xall-defs*))\n"
       "(defconst *xalli-defs* (ren-defs *xall-defs* *xall-names* 0))\n"
       "(defun pr-ints (f i n vmi) (declare (xargs :stobjs vmi :mode :program))\n"
       "  (if (>= i n) nil (prog2$ (cw \"~x0~%\" (case f (:code (v-codei i vmi)))) (pr-ints f (1+ i) n vmi))))\n"
       "(defun pr-pool (i n vmi) (declare (xargs :stobjs vmi :mode :program))\n"
       "  (if (>= i n) nil\n"
       "    (let ((v (v-pooli i vmi)))\n"
       "      (prog2$ (cond ((integerp v) (cw \"I ~x0~%\" v)) ((eq v t) (cw \"T~%\")) ((null v) (cw \"N~%\"))\n"
       "                    ((keywordp v) (cw \"K ~s0~%\" (string-downcase (symbol-name v)))) (t (cw \"UNPRINTABLE~%\")))\n"
       "              (pr-pool (1+ i) n vmi)))))\n"
       "(defun pr-fns (i n vmi) (declare (xargs :stobjs vmi :mode :program))\n"
       "  (if (>= i n) nil (prog2$ (cw \"~x0 ~x1~%\" (v-fnfirsti i vmi) (v-fncounti i vmi)) (pr-fns (1+ i) n vmi))))\n"
       "(defun pr-cls (i n vmi) (declare (xargs :stobjs vmi :mode :program))\n"
       "  (if (>= i n) nil (prog2$ (cw \"~x0 ~x1 ~x2~%\" (v-clni i vmi) (v-clenti i vmi) (v-clresti i vmi)) (pr-cls (1+ i) n vmi))))\n"
       "(defun pr-stk (j n vmi) (declare (xargs :stobjs vmi :mode :program))\n"
       "  (if (>= j n) nil (prog2$ (cw \" ~x0\" (v-stki j vmi)) (pr-stk (1+ j) n vmi))))\n"
       "(defun pr-ctl (j n vmi) (declare (xargs :stobjs vmi :mode :program))\n"
       "  (if (>= j n) nil (prog2$ (cw \" ~x0 ~x1 ~x2 ~x3 ~x4\" (v-ckindi j vmi) (v-cai j vmi) (v-cbi j vmi) (v-cci j vmi) (v-cprevi j vmi))\n"
       "                          (pr-ctl (1+ j) n vmi))))\n"
       "(defun show (vmi) (declare (xargs :stobjs vmi :mode :program))\n"
       "  (prog2$ (cw \"~x0 ~x1 ~x2 ~x3 ~x4 ~x5 |\" (v-pc vmi) (v-fb vmi) (v-sp vmi) (v-status vmi) (v-ctop vmi) (v-hidx vmi))\n"
       "    (prog2$ (pr-stk 0 (min (v-sp vmi) (v-stk-length vmi)) vmi)\n"
       "      (prog2$ (cw \" |\") (prog2$ (pr-ctl 0 (v-ctop vmi) vmi) (cw \"~%\"))))))\n"
       "(defun trace-run (k vmi) (declare (xargs :stobjs vmi :mode :program))\n"
       "  (if (zp k) vmi\n"
       "    (let* ((last (and (equal (vmi-w (v-pc vmi) 0 vmi) 11) (zp (v-ctop vmi)) (equal (v-status vmi) 0)))\n"
       "           (vmi (vmi-step vmi)))\n"
       "      (prog2$ (show vmi)\n"
       "        (if (or (not (equal (v-status vmi) 0)) last) vmi (trace-run (1- k) vmi))))))\n"
       "(defun one (e i vmi) (declare (xargs :stobjs vmi :mode :program))\n"
       "  (let* ((e (ren-e e *xall-names*)) (prog (vcs2-program e *xalli-defs*)))\n"
       "    (if (not (enc-ok prog)) (prog2$ (cw \"~%NOT-ENCODABLE ~x0~%\" i) vmi)\n"
       "      (let ((vmi (vmi-load-prog prog 1024 256 vmi)))\n"
       "        (prog2$ (cw \"~%BEGIN-PROG ~x0~%~x1 ~x2 ~x3 ~x4 ~x5 ~x6~%\" i (v-code-length vmi) (v-pool-length vmi)\n"
       "                    (v-fnfirst-length vmi) (v-cln-length vmi) (v-stk-length vmi) (v-ckind-length vmi))\n"
       "          (prog2$ (pr-ints :code 0 (v-code-length vmi) vmi)\n"
       "            (prog2$ (pr-pool 0 (v-pool-length vmi) vmi)\n"
       "              (prog2$ (pr-fns 0 (v-fnfirst-length vmi) vmi)\n"
       "                (prog2$ (pr-cls 0 (v-cln-length vmi) vmi)\n"
       "                  (prog2$ (cw \"END-PROG~%BEGIN-TRACE ~x0~%\" i)\n"
       "                    (prog2$ (show vmi)\n"
       "                      (let ((vmi (trace-run 400000 vmi)))\n"
       "                        (prog2$ (cw \"END-TRACE~%\") vmi)))))))))))))\n"
       "(defun all (es i vmi) (declare (xargs :stobjs vmi :mode :program))\n"
       "  (if (atom es) vmi (let ((vmi (one (car es) i vmi))) (all (cdr es) (1+ i) vmi))))\n"
       "(set-guard-checking :none)\n"
       "(all '(" (str/join "\n" (map lisp exprs)) ") 0 vmi)\n"
       "(good-bye)\n"))

(def acl2 (str (System/getProperty "user.home") "/jborden/acl2/saved_acl2"))
(def out (:out (p/shell {:dir "model" :in driver :out :string :err :string} acl2)))

(def progs (into {} (for [[_ i body] (re-seq #"(?s)\nBEGIN-PROG (\d+)\n(.*?)END-PROG" out)] [(parse-long i) body])))
(def traces (into {} (for [[_ i body] (re-seq #"(?s)BEGIN-TRACE (\d+)\n(.*?)END-TRACE" out)] [(parse-long i) body])))
(def not-encodable (count (re-seq #"NOT-ENCODABLE" out)))

(when (not= n (+ not-encodable (count traces)))
  (println "fuzz-vm-gen: ACL2 did not report every program; the tail of its output:")
  (println (subs out (max 0 (- (count out) 3000))))
  (System/exit 1))

;; ---- the generated Fortran ------------------------------------------------------------

(def gen-src (str work "/vm_gen.f90"))
(spit gen-src
      (cond-> (slurp "src/f/gen/vm_gen.f90")
        ;; the negative control: an uncaught throw's stack two slots, not one
        broken ((fn [s] (let [a (str/index-of s "subroutine vmg_unwind")
                              b (str/index-of s "st%sp = 1_int64" a)]
                          (when-not b (println "fuzz-vm-gen: the control's slip has no place") (System/exit 1))
                          (str (subs s 0 b) "st%sp = 2_int64" (subs s (+ b (count "st%sp = 1_int64")))))))))
(def exe (str work "/vm_check"))
(let [r (p/shell {:continue true :out :string :err :string :dir work}
                 fc "-O1" "-o" exe (str (fs/absolutize "test/vm/vm_runtime.f90")) gen-src (str (fs/absolutize "test/vm/vm_check.f90")))]
  (when-not (zero? (:exit r))
    (println "fuzz-vm-gen: the generated Fortran did not compile:")
    (println (:err r) (:out r))
    (System/exit 1)))

(defn tokens [s] (vec (remove str/blank? (str/split s #"\s+"))))

(def results
  (vec (for [i (sort (keys traces))]
         (let [f (str work "/prog" i ".txt")
               _ (spit f (progs i))
               r (p/shell {:continue true :out :string :err :string} exe f)
               want (mapv tokens (remove str/blank? (str/split-lines (traces i))))
               got (mapv tokens (remove str/blank? (str/split-lines (:out r))))
               k (first (for [j (range (max (count want) (count got))) :when (not= (get want j) (get got j))] j))]
           {:i i :ok (and (zero? (:exit r)) (nil? k)) :steps (count want) :line k
            :want (when k (str/join " " (get want k))) :got (when k (str/join " " (get got k))) :err (:err r)}))))

(def bad (filter (complement :ok) results))
(println (str "fuzz-vm-gen: " n " programs, seed " seed ", " fc "; " (count results) " run, "
              (reduce + (map :steps results)) " steps compared" (when (pos? not-encodable) (str ", " not-encodable " not encodable"))))
(println (format "the generated Fortran against ACL2's vmi, step for step: %d disagree" (count bad)))
(doseq [b (take 3 bad)]
  (println (str "    program " (:i b) ", step " (:line b) ": " (lisp (exprs (:i b)))))
  (println (str "      acl2:    " (:want b)))
  (println (str "      fortran: " (:got b)))
  (when-not (str/blank? (:err b)) (println (str "      " (first (str/split-lines (:err b)))))))
(if broken
  (do (println (if (seq bad) "negative control: the broken generated unwind was caught" "NEGATIVE CONTROL FAILED: a broken generated unwind went unseen"))
      (System/exit (if (seq bad) 0 1)))
  (System/exit (if (or (seq bad) (pos? not-encodable)) 1 0)))
