#!/usr/bin/env bb
;; fuzz-fn: generated FUNCTIONS, typed, called with arguments (PLAN step 29).
;;
;;   scripts/fuzz-fn [-n N] [-k K] [-s SEED] [-m modes] [-o cases.edn]
;;
;; scripts/fuzz's cases are closed forms; a closed form gives the compiler
;; constants to fold and no parameter to type. Here N defns are generated
;; -- one to three parameters hinted ^long, ^double or not at all, a
;; return hint matching the body, bodies of long and double arithmetic,
;; bit operations, comparisons, primitive locals from let and loop/recur,
;; and calls of the fns generated before -- and handed to scripts/fuzz as
;; a --fixture, so they are definitions of the compiled namespace and
;; compiled there. The cases call each fn K times with generated
;; arguments: directly, so a primitive call is made where the compiler
;; can; through apply, the boxed path; and through apply with a double
;; where a long is wanted, so the cast or refusal is compared. Values,
;; and errors by class and message, against clj.
;;
;; Typed so that clj compiles every fn: a loop's recur arguments are cast
;; to the local's primitive ((long e), (double e)), a let local is never
;; hinted (clj refuses a hint on a primitive initializer), and a body's
;; type is what its return hint says.
(require '[clojure.test.check.generators :as g]
         '[clojure.string :as str]
         '[babashka.fs :as fs]
         '[babashka.process :as p])

(def opts (loop [as *command-line-args* o {:n 30 :k 4 :seed 1 :modes "flat,tree,compiled"}]
            (if (empty? as) o
                (case (first as)
                  "-n" (recur (drop 2 as) (assoc o :n (parse-long (second as))))
                  "-k" (recur (drop 2 as) (assoc o :k (parse-long (second as))))
                  "-s" (recur (drop 2 as) (assoc o :seed (parse-long (second as))))
                  "-m" (recur (drop 2 as) (assoc o :modes (second as)))
                  "-o" (recur (drop 2 as) (assoc o :out (second as)))
                  (do (println "usage: scripts/fuzz-fn [-n N] [-k K] [-s SEED] [-m modes] [-o cases.edn]")
                      (System/exit 2))))))

;; ---- typed expressions ----------------------------------------------------
;;
;; env: {:L [syms usable as a long] :D [syms that are doubles]}; an
;; unhinted parameter is passed a long and used as one. fns: the
;; signatures generated so far, callable from later bodies.

(def counter (atom 0))
(defn fresh [p] (symbol (str p (swap! counter inc))))

(def g-long-lit (g/frequency [[8 (g/choose -9 20)] [1 (g/elements [0 1 -1 Long/MAX_VALUE Long/MIN_VALUE 4294967296])]]))
(def g-dbl-lit (g/frequency [[8 (g/fmap #(/ % 4.0) (g/choose -40 40))] [1 (g/elements [0.0 -0.0 1.0E300 1.0E-300 0.1])]]))
(def g-nz (g/elements [1 2 3 7 -1 -4]))

(declare g-expr)

(defn g-call [env fns ty depth]
  ;; a call of an earlier fn whose result is ty
  (let [cands (filter #(= ty (:ret %)) fns)]
    (when (seq cands)
      (g/let [f (g/elements cands)
              args (apply g/tuple (for [pt (:params f)] (g-expr env fns (if (= pt :D) :D :L) (dec depth))))]
        (g/return (cons (:name f) args))))))

(defn g-bool [env fns depth]
  (let [l (g-expr env fns :L (dec depth)) d (g-expr env fns :D (dec depth))]
    (g/one-of [(g/fmap (fn [[op a b]] (list op a b)) (g/tuple (g/elements '[< > <= >= ==]) l l))
               (g/fmap (fn [[op a b]] (list op a b)) (g/tuple (g/elements '[< > ==]) d d))
               (g/fmap (fn [[op a]] (list op a)) (g/tuple (g/elements '[zero? pos? neg? even? odd?]) l))
               (g/fmap (fn [[op a]] (list op a)) (g/tuple (g/elements '[zero? pos? neg?]) d))])))

(defn g-loop [env fns ty depth]
  ;; (loop [i 0 acc init] (if (< i K) (recur (inc i) (cast body)) acc))
  (let [i (fresh "i") acc (fresh "acc")
        env' (-> env (update :L conj i) (update ty conj acc))
        cast (if (= ty :D) 'double 'long)]
    (g/let [init (g-expr env fns ty (dec depth))
            k (g/choose 0 6)
            body (g-expr env' fns ty (dec depth))]
      (g/return (list 'loop [i 0 acc init]
                      (list 'if (list '< i k) (list 'recur (list 'inc i) (list cast body)) acc))))))

(defn g-let [env fns ty depth]
  (g/let [lt (g/elements [:L :D])
          init (g-expr env fns lt (dec depth))]
    (let [x (fresh "x")
          ;; a primitive local: the initializer's own type, cast to it
          init (list (if (= lt :D) 'double 'long) init)]
      (g/fmap (fn [body] (list 'let [x init] body))
              (g-expr (update env lt conj x) fns ty (dec depth))))))

(defn g-expr [env fns ty depth]
  (let [leaf (if (= ty :D)
               (g/one-of (cond-> [g-dbl-lit] (seq (:D env)) (conj (g/elements (:D env)))))
               (g/one-of (cond-> [g-long-lit] (seq (:L env)) (conj (g/elements (:L env))))))]
    (if (<= depth 0)
      leaf
      (let [sub (fn [t] (g-expr env fns t (dec depth)))
            l (sub :L) d (sub :D)
            two (fn [ops a b] (g/fmap (fn [[op x y]] (list op x y)) (g/tuple (g/elements ops) a b)))
            call (g-call env fns ty depth)]
        (g/frequency
         (cond-> [[2 leaf]
                  [1 (g/fmap (fn [[b x y]] (list 'if b x y)) (g/tuple (g-bool env fns depth) (sub ty) (sub ty)))]
                  [1 (g-let env fns ty depth)]
                  [1 (g-loop env fns ty depth)]]
           (= ty :L) (into [[3 (two '[+ - * max min unchecked-add unchecked-subtract unchecked-multiply] l l)]
                            [1 (g/fmap (fn [[op x]] (list op x)) (g/tuple (g/elements '[inc dec unchecked-inc unchecked-negate abs]) l))]
                            [2 (two '[quot rem mod] l g-nz)]
                            [2 (two '[bit-and bit-or bit-xor] l l)]
                            [1 (two '[bit-shift-left bit-shift-right unsigned-bit-shift-right] l (g/choose 0 5))]
                            [1 (g/fmap #(list 'long %) d)]])
           ;; no min or max of two doubles: a signed-zero tie is DEVIATIONS 76,
           ;; and what DEVIATIONS records is not generated (as in fuzz-num)
           (= ty :D) (into [[3 (two '[+ - *] d d)]
                            [2 (two '[+ - *] l d)]
                            [1 (two '[/] d (g/elements [2.0 -0.5 4.0 3.0]))]
                            [1 (g/fmap #(list 'double %) l)]])
           call (conj [2 call])))))))

;; ---- functions --------------------------------------------------------------

(def g-sig
  (g/let [params (g/vector (g/elements [:L :D :O]) 1 3)
          ret (g/elements [:L :D])
          hint-ret g/boolean]
    (g/return {:params params :ret ret :hint-ret hint-ret})))

(defn g-defn [i fns]
  (g/let [sig g-sig]
    (let [syms (vec (for [_ (:params sig)] (fresh "p")))
          env {:L (vec (keep (fn [[s t]] (when (#{:L :O} t) s)) (map vector syms (:params sig))))
               :D (vec (keep (fn [[s t]] (when (= :D t) s)) (map vector syms (:params sig))))}
          name (symbol (str "fzf" i))
          arglist (vec (for [[s t] (map vector syms (:params sig))]
                         (case t :L (with-meta s {:tag 'long}) :D (with-meta s {:tag 'double}) s)))
          arglist (if (:hint-ret sig) (with-meta arglist {:tag (if (= :D (:ret sig)) 'double 'long)}) arglist)]
      (g/fmap (fn [body] (assoc sig :name name :form (list 'defn name arglist body)))
              (g-expr env fns (:ret sig) 4)))))

(defn print-hinted [form]
  ;; pr-str with type hints: *print-meta* prints ^{:tag long} on the
  ;; symbols and the arglist
  (binding [*print-meta* true] (pr-str form)))

(defn g-arg [t]
  (case t :D g-dbl-lit g-long-lit))

(defn g-calls [{:keys [name params]} k]
  (g/vector
   (g/let [args (apply g/tuple (map g-arg params))
           how (g/frequency [[5 (g/return :direct)] [2 (g/return :apply)] [1 (g/return :apply-wrong)]])]
     (g/return
      (case how
        :direct (cons name args)
        :apply (list 'apply name (vec args))
        ;; a double where the first long (or untyped) parameter is
        :apply-wrong (list 'apply name (vec (map-indexed (fn [j a] (if (and (= j (.indexOf params (first (remove #{:D} params)))) (not= :D (nth params j))) 2.5 a)) args))))))
   k))

(let [{:keys [n k seed]} opts
      fns (reduce (fn [fns i] (conj fns (g/generate (g-defn i fns) 8 (+ seed i)))) [] (range n))
      cases (vec (mapcat (fn [f i] (g/generate (g-calls f k) 8 (+ seed 7919 i))) fns (range)))
      work (str (fs/create-temp-dir {:prefix "fuzz-fn"}))
      fixture (str work "/fns.clj")
      out (or (:out opts) (str work "/cases.edn"))]
  (spit fixture (str/join "\n" (map (comp print-hinted :form) fns)))
  (spit out (str "[" (str/join "\n" (map pr-str cases)) "]"))
  (println (str "fuzz-fn: " n " fns, " (count cases) " calls -> " out " (fns: " fixture ")"))
  (if (str/blank? (:modes opts))
    (System/exit 0)
    (let [r (p/shell {:continue true} (str (fs/parent *file*) "/fuzz") "-f" out "--fixture" fixture "-m" (:modes opts))]
      (System/exit (:exit r)))))
