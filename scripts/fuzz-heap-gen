#!/usr/bin/env bb
;; fuzz-heap-gen: the GENERATED collector (src/f/gen/heap_gen.inc, written by
;; scripts/acl2-fortran -b heapg from model/heapg.lisp and heapsw.lisp) --
;; its marking and its sweep -- against the ACL2 it was generated from (PLAN
;; step 33, stages 1a and 1b).
;;
;;   scripts/fuzz-heap-gen [-n COUNT] [-s SEED] [-x] [--fc gfortran|flang]
;;
;; Random heaps: objects of five slots, vector runs in an arena, texts;
;; slots and arena words holding references of every kind -- in range and
;; out of it, to objects already marked (as a young collection finds the
;; old ones) -- and immediates; a few roots; a mark stack sometimes too
;; small to finish; free flags, free lists, size classes and arena words of
;; their own. ACL2 pushes the roots with hpg-push, drains with hpg-drain and
;; sweeps every pool (hpg-sweep-objs, -vecs, -strs); test/heap/heap_check
;; does the same with the generated code. The marks, the counts, the
;; stack's top and the overflow flag, and everything the sweep wrote --
;; free flags, kinds, free lists and their heads, runs' places and lengths,
;; arena words, class heads, the finalizers and releases asked for -- must
;; agree, case for case.
;;
;; Before marking, the SEQ OPERATIONS (model/heapsq.lisp): first, next, rest
;; and seq -- and an id that is none of them -- of nil, immediates and
;; references in range and out of it, on objects mostly lists and lazy cells
;; in every state; ACL2's hpg-seq-op and the generated one must answer the
;; same place.
;;
;; -x is the NEGATIVE CONTROL: the generated side reads every object's last
;; slot as no reference and a delegating lazy cell as pending, and the marks
;; and the seq answers must both part.
(require '[babashka.process :as p] '[clojure.string :as str] '[clojure.edn :as edn] '[babashka.fs :as fs])

(def broken (some #{"-x"} *command-line-args*))
(def args (apply hash-map (remove #{"-x"} *command-line-args*)))
(def n (parse-long (get args "-n" "200")))
(def seed (parse-long (get args "-s" (str (mod (System/nanoTime) 2147483647)))))
(def fc (get args "--fc" "gfortran"))
(def work (str (fs/create-temp-dir {:prefix "fuzz-heap-gen"})))

;; the house LCG: every case reproduces from its seed
(def rng (atom seed))
(defn rnd [k]
  (let [x (swap! rng #(unchecked-add (unchecked-multiply % 6364136223846793005) 1442695040888963407))]
    (mod (bit-shift-right x 33) (max k 1))))
(defn pick [xs] (nth xs (rnd (count xs))))

(defn gen-ref [no nv ns]
  (let [t (pick [0 2 3 8 8 8 9 9 5 6 7 11 12 13 15 1])]
    [t (case t
         8 (rnd (+ no 2))
         9 (rnd (+ nv 2))
         (5 6 7 11 12 13 15) (rnd (+ ns 2))
         (rnd 50))]))

(defn gen-case []
  (let [no (+ 1 (rnd 25)) nv (+ 1 (rnd 8)) na (+ 1 (rnd 40)) ns (+ 1 (rnd 8))
        slots (vec (repeatedly (* 5 no) #(gen-ref no nv ns)))
        ;; object 0 and run 0 are no object: their marks start clear
        omark (vec (cons 0 (repeatedly (dec no) #(if (zero? (rnd 6)) 1 0))))
        vmark (vec (cons 0 (repeatedly (dec nv) #(if (zero? (rnd 6)) 1 0))))
        voff (vec (repeatedly nv #(if (zero? (rnd 10)) (- (rnd 5)) (rnd (+ na 3)))))
        vlen (vec (repeatedly nv #(if (zero? (rnd 12)) (- (rnd 3)) (rnd 7))))
        arena (vec (repeatedly na #(gen-ref no nv ns)))
        smark (vec (repeatedly ns #(rnd 2)))
        small (zero? (rnd 6))
        ;; a stack too small: several objects pushed at once, to overflow it
        roots (if small
                (vec (repeatedly (+ 3 (rnd 4)) #(vector 8 (+ 1 (rnd (max 1 (dec no)))))))
                (vec (repeatedly (+ 1 (rnd 6)) #(gen-ref no nv ns))))
        cap (if small (+ 1 (rnd 3)) (+ no nv 2))
        flags (fn [k] (vec (repeatedly k #(if (zero? (rnd 5)) 1 0))))]
    {:no no :nv nv :na na :ns ns :cap cap
     :otag (mapv first slots) :oref (mapv second slots) :omark omark
     :voff voff :vlen vlen :vmark vmark :atag (mapv first arena) :aref (mapv second arena)
     :smark smark :roots roots
     :okind (vec (repeatedly no #(pick [1 6 6 (rnd 20)])))
     :oi1 (vec (repeatedly no #(pick [0 1 1 2 3 4 (rnd 9) (- (rnd 3))])))
     :seqq (vec (repeatedly (+ 1 (rnd 12))
                            #(let [[t r] (if (zero? (rnd 6)) [0 0] (gen-ref no nv ns))]
                               [(pick [9 10 27 39 9 39 27 (rnd 50)]) t r]))) :ofree (flags no) :onext (vec (repeatedly no #(rnd no)))
     :vfree (flags nv) :vnext (vec (repeatedly nv #(rnd nv))) :sfree (flags ns) :snext (vec (repeatedly ns #(rnd ns)))
     :aival (vec (repeatedly na #(rnd 100))) :chead (vec (repeatedly 31 #(rnd na)))
     :heads [(rnd no) (rnd nv) (rnd ns)]
     ;; each pool's used end and its size, both inside the arrays
     :used (vec (mapcat (fn [k] (let [u (rnd k)] [u (+ u (rnd (- k u)))])) [no nv ns]))
     ;; the arena's used end and size (the size below its arrays' length),
     ;; and run takes: a vector's length and whether batching
     :arena (let [cap (rnd na) u (rnd (inc cap))] [u cap])
     :rtakes (vec (repeatedly (+ 1 (rnd 8)) #(vector (if (zero? (rnd 8)) (rnd 40) (rnd 9)) (rnd 2))))}))

(def cases (vec (repeatedly n gen-case)))

;; what is compared, in this order, on both sides
(def arrays-in [:okind :ofree :onext :vfree :vnext :sfree :snext :aival :chead])
(def out-names ["omark" "vmark" "smark" "regs" "okind" "ofree" "onext" "ofin" "voff" "vlen" "vfree" "vnext"
                "atag" "aref" "aival" "chead" "sfree" "snext" "srel" "sweep"
                "takes" "pops" "ob" "alloc" "ofree2" "omark2"
                "vtakes" "vpops" "vb" "valloc" "vfree2" "vmark2"
                "stakes" "spops" "sb" "salloc" "sfree2" "smark2"
                "runs" "arena" "chead2" "nrb" "rb" "seq"])

;; ---- ACL2 -------------------------------------------------------------------------

(defn l [xs] (str "'(" (str/join " " xs) ")"))

;; field name -> (reader writer resizer) in hpg
(def acl2-arrays
  (array-map "otag" 0 "oref" 1 "omark" 2 "voff" 3 "vlen" 4 "vmark" 5 "atag" 6 "aref" 7 "smark" 8
             "okind" 9 "ofree" 10 "onext" 11 "vfree" 12 "vnext" 13 "sfree" 14 "snext" 15 "aival" 16 "chead" 17
             "ofin" 18 "srel" 19 "ob" 20 "vb" 21 "sb" 22 "rb" 23 "nrb" 24 "oi1" 25))

(def driver
  (str "(include-book \"heapsq\")\n"
       "(set-print-case :downcase state)\n"
       "(set-fmt-hard-right-margin 100000 state)\n(set-fmt-soft-right-margin 100000 state)\n"
       "(defun ld-arr (f i xs hpg) (declare (xargs :stobjs hpg :mode :program))\n"
       "  (if (endp xs) hpg\n"
       "    (let ((hpg (case f "
       (str/join " " (for [[nm k] acl2-arrays] (str "(" k " (update-h-" nm "i i (car xs) hpg))")))
       " (t hpg))))\n"
       "      (ld-arr f (1+ i) (cdr xs) hpg))))\n"
       "(defun rs-arr (f m hpg) (declare (xargs :stobjs hpg :mode :program))\n"
       "  (case f "
       (str/join " " (for [[nm k] acl2-arrays] (str "(" k " (resize-h-" nm " m hpg))")))
       " (t hpg)))\n"
       "(defun get-arr (f i m hpg) (declare (xargs :stobjs hpg :mode :program))\n"
       "  (if (>= i m) nil (cons (case f "
       (str/join " " (for [[nm k] acl2-arrays] (str "(" k " (h-" nm "i i hpg))")))
       " (t 0)) (get-arr f (1+ i) m hpg))))\n"
       "(defun put (f xs hpg) (declare (xargs :stobjs hpg :mode :program))\n"
       "  (let ((hpg (rs-arr f (len xs) hpg))) (ld-arr f 0 xs hpg)))\n"
       "(defun get-all (f hpg) (declare (xargs :stobjs hpg :mode :program))\n"
       "  (get-arr f 0 (case f "
       (str/join " " (for [[nm k] acl2-arrays] (str "(" k " (h-" nm "-length hpg))")))
       " (t 0)) hpg))\n"
       "(defun push-roots (rs hpg) (declare (xargs :stobjs hpg :mode :program))\n"
       "  (if (endp rs) hpg (let ((hpg (hpg-push (caar rs) (cadar rs) hpg))) (push-roots (cdr rs) hpg))))\n"
       "(defun takes-obj (k acc hpg) (declare (xargs :stobjs hpg :mode :program))\n  (if (zp k) (mv (reverse acc) hpg)\n    (mv-let (i hpg) (hpg-obj-take hpg)\n      (let ((hpg (if (and (< 0 i) (< i (h-ofree-length hpg))) (hpg-obj-use i hpg) hpg))) (takes-obj (1- k) (cons i acc) hpg)))))\n(defun pops-obj (k acc hpg) (declare (xargs :stobjs hpg :mode :program))\n  (if (zp k) (mv (reverse acc) hpg) (mv-let (i hpg) (hpg-obj-pop hpg) (pops-obj (1- k) (cons i acc) hpg))))\n(defun alloc-init (us hpg) (declare (xargs :stobjs hpg :mode :program))\n  (let* ((hpg (update-h-oused (nth 0 us) hpg)) (hpg (update-h-ocap (nth 1 us) hpg))\n         (hpg (update-h-vused (nth 2 us) hpg)) (hpg (update-h-vcap (nth 3 us) hpg))\n         (hpg (update-h-sused (nth 4 us) hpg)) (hpg (update-h-scap (nth 5 us) hpg))\n         (hpg (put 20 (make-list 8 :initial-element 0) hpg)) (hpg (put 21 (make-list 8 :initial-element 0) hpg))\n         (hpg (put 22 (make-list 8 :initial-element 0) hpg))\n         (hpg (update-h-nob 0 hpg)) (hpg (update-h-nvb 0 hpg)))\n    (update-h-nsb 0 hpg)))\n(defun run-takes (ts acc hpg) (declare (xargs :stobjs hpg :mode :program))\n  (if (endp ts) (mv (reverse acc) hpg)\n    (mv-let (off hpg) (hpg-run-take (caar ts) (cadar ts) hpg) (run-takes (cdr ts) (cons off acc) hpg))))\n(defun alloc-runs (ar ts hpg) (declare (xargs :stobjs hpg :mode :program))\n  (let* ((hpg (update-h-aused (nth 0 ar) hpg)) (hpg (update-h-acap (nth 1 ar) hpg))\n         (hpg (update-h-areu 0 hpg)) (hpg (update-h-afre 0 hpg)) (hpg (update-h-asince 0 hpg))\n         (hpg (put 23 (make-list 513 :initial-element 0) hpg)) (hpg (put 24 (make-list 9 :initial-element 0) hpg)))\n    (mv-let (offs hpg) (run-takes ts nil hpg)\n      (mv (list offs (list (h-aused hpg) (h-areu hpg) (h-afre hpg) (h-asince hpg)) (get-all 17 hpg) (get-all 24 hpg) (get-all 23 hpg)) hpg))))\n(defun alloc-obj (hpg) (declare (xargs :stobjs hpg :mode :program))\n  (progn$\n    (mv-let (tk hpg) (takes-obj 3 nil hpg)\n      (let ((hpg (hpg-obj-fill 6 hpg)))\n        (mv-let (pp hpg) (pops-obj 4 nil hpg)\n          (mv (list tk pp (get-all 20 hpg) (list (h-nob hpg) (h-oused hpg) (h-ohead hpg) (h-ocap hpg))\n                    (get-all 10 hpg) (get-all 2 hpg))\n              hpg))))))\n(defun takes-vec (k acc hpg) (declare (xargs :stobjs hpg :mode :program))\n  (if (zp k) (mv (reverse acc) hpg)\n    (mv-let (i hpg) (hpg-vec-take hpg)\n      (let ((hpg (if (and (< 0 i) (< i (h-vfree-length hpg))) (hpg-vec-use i hpg) hpg))) (takes-vec (1- k) (cons i acc) hpg)))))\n(defun pops-vec (k acc hpg) (declare (xargs :stobjs hpg :mode :program))\n  (if (zp k) (mv (reverse acc) hpg) (mv-let (i hpg) (hpg-vec-pop hpg) (pops-vec (1- k) (cons i acc) hpg))))\n(defun alloc-vec (hpg) (declare (xargs :stobjs hpg :mode :program))\n  (progn$\n    (mv-let (tk hpg) (takes-vec 3 nil hpg)\n      (let ((hpg (hpg-vec-fill 6 hpg)))\n        (mv-let (pp hpg) (pops-vec 4 nil hpg)\n          (mv (list tk pp (get-all 21 hpg) (list (h-nvb hpg) (h-vused hpg) (h-vhead hpg) (h-vcap hpg))\n                    (get-all 12 hpg) (get-all 5 hpg))\n              hpg))))))\n(defun takes-str (k acc hpg) (declare (xargs :stobjs hpg :mode :program))\n  (if (zp k) (mv (reverse acc) hpg)\n    (mv-let (i hpg) (hpg-str-take hpg)\n      (let ((hpg (if (and (< 0 i) (< i (h-sfree-length hpg))) (hpg-str-use i hpg) hpg))) (takes-str (1- k) (cons i acc) hpg)))))\n(defun pops-str (k acc hpg) (declare (xargs :stobjs hpg :mode :program))\n  (if (zp k) (mv (reverse acc) hpg) (mv-let (i hpg) (hpg-str-pop hpg) (pops-str (1- k) (cons i acc) hpg))))\n(defun alloc-str (hpg) (declare (xargs :stobjs hpg :mode :program))\n  (progn$\n    (mv-let (tk hpg) (takes-str 3 nil hpg)\n      (let ((hpg (hpg-str-fill 6 hpg)))\n        (mv-let (pp hpg) (pops-str 4 nil hpg)\n          (mv (list tk pp (get-all 22 hpg) (list (h-nsb hpg) (h-sused hpg) (h-shead hpg) (h-scap hpg))\n                    (get-all 14 hpg) (get-all 8 hpg))\n              hpg))))))\n"
       "(defun seq-ops (qs hpg) (declare (xargs :stobjs hpg :mode :program))
  (if (endp qs) nil (cons (hpg-seq-op (caar qs) (cadar qs) (caddar qs) hpg) (seq-ops (cdr qs) hpg))))
(defun run-case (k arrs cap hd us ar ts roots oi qs hpg) (declare (xargs :stobjs hpg :mode :program))\n"
       "  (let* ((hpg (put 0 (nth 0 arrs) hpg)) (hpg (put 1 (nth 1 arrs) hpg)) (hpg (put 2 (nth 2 arrs) hpg))\n"
       "         (hpg (put 3 (nth 3 arrs) hpg)) (hpg (put 4 (nth 4 arrs) hpg)) (hpg (put 5 (nth 5 arrs) hpg))\n"
       "         (hpg (put 6 (nth 6 arrs) hpg)) (hpg (put 7 (nth 7 arrs) hpg)) (hpg (put 8 (nth 8 arrs) hpg))\n"
       "         (hpg (put 9 (nth 9 arrs) hpg)) (hpg (put 10 (nth 10 arrs) hpg)) (hpg (put 11 (nth 11 arrs) hpg))\n"
       "         (hpg (put 12 (nth 12 arrs) hpg)) (hpg (put 13 (nth 13 arrs) hpg)) (hpg (put 14 (nth 14 arrs) hpg))\n"
       "         (hpg (put 15 (nth 15 arrs) hpg)) (hpg (put 16 (nth 16 arrs) hpg)) (hpg (put 17 (nth 17 arrs) hpg))\n"
       "         (hpg (put 18 (make-list (len (nth 2 arrs)) :initial-element 0) hpg))\n"
       "         (hpg (put 19 (make-list (len (nth 8 arrs)) :initial-element 0) hpg))\n"
       "         (hpg (put 25 oi hpg)) (sq (seq-ops qs hpg))\n"
       "         (hpg (resize-h-mtag cap hpg)) (hpg (resize-h-mref cap hpg))\n"
       "         (hpg (update-h-msp 0 hpg)) (hpg (update-h-err 0 hpg)) (hpg (update-h-nobj 0 hpg))\n"
       "         (hpg (update-h-nvec 0 hpg)) (hpg (update-h-nstr 0 hpg)) (hpg (update-h-alive 0 hpg))\n"
       "         (hpg (update-h-ohead (nth 0 hd) hpg)) (hpg (update-h-vhead (nth 1 hd) hpg)) (hpg (update-h-shead (nth 2 hd) hpg))\n"
       "         (hpg (update-h-nswo 0 hpg)) (hpg (update-h-nswv 0 hpg)) (hpg (update-h-nsws 0 hpg)) (hpg (update-h-afree 0 hpg))\n"
       "         (hpg (push-roots roots hpg)) (hpg (hpg-drain 1000000 hpg))\n"
       "         (hpg (hpg-sweep-objs 1 (- (len (nth 2 arrs)) 1) hpg)) (hpg (hpg-sweep-vecs 1 (- (len (nth 5 arrs)) 1) hpg))\n"
       "         (hpg (hpg-sweep-strs 1 (- (len (nth 8 arrs)) 1) hpg))\n"
       "         (mk (list (get-all 2 hpg) (get-all 5 hpg) (get-all 8 hpg)\n"
       "                   (list (h-err hpg) (h-msp hpg) (h-nobj hpg) (h-nvec hpg) (h-nstr hpg) (h-alive hpg))\n"
       "                   (get-all 9 hpg) (get-all 10 hpg) (get-all 11 hpg) (get-all 18 hpg) (get-all 3 hpg) (get-all 4 hpg) (get-all 12 hpg) (get-all 13 hpg)\n"
       "                   (get-all 6 hpg) (get-all 7 hpg) (get-all 16 hpg) (get-all 17 hpg) (get-all 14 hpg) (get-all 15 hpg) (get-all 19 hpg)\n"
       "                   (list (h-ohead hpg) (h-vhead hpg) (h-shead hpg) (h-nswo hpg) (h-nswv hpg) (h-nsws hpg) (h-afree hpg))))\n"
       "         )\n"
       ;; allocation in each pool: three takes, each used; a fill; four pops
       "    (let ((hpg (alloc-init us hpg)))\n"
       "    (mv-let (ro hpg) (alloc-obj hpg)\n"
       "      (mv-let (rv hpg) (alloc-vec hpg)\n"
       "        (mv-let (rs hpg) (alloc-str hpg)\n"
       "          (mv-let (rr hpg) (alloc-runs ar ts hpg)\n"
       "            (prog2$ (cw \"CASE ~x0 ~x1~%\" k (append mk ro rv rs rr (list sq))) hpg))))))))\n"
       (str/join (map-indexed (fn [k c]
                                (str "(run-case " k " (list "
                                     (str/join " " (map #(l (% c)) [:otag :oref :omark :voff :vlen :vmark :atag :aref :smark
                                                                    :okind :ofree :onext :vfree :vnext :sfree :snext :aival :chead]))
                                     ") " (:cap c) " " (l (:heads c)) " " (l (:used c)) " " (l (:arena c))
                                     " '(" (str/join " " (map (fn [[a b]] (str "(" a " " b ")")) (:rtakes c))) ")"
                                     " '(" (str/join " " (map (fn [[t r]] (str "(" t " " r ")")) (:roots c))) ")"
                                     " " (l (:oi1 c))
                                     " '(" (str/join " " (map (fn [[o t r]] (str "(" o " " t " " r ")")) (:seqq c))) ") hpg)\n"))
                              cases))
       "(good-bye)\n"))

(def acl2 (str (System/getProperty "user.home") "/jborden/acl2/saved_acl2"))
(def out (:out (p/shell {:dir "model" :in driver :out :string :err :string} acl2)))
(def expected
  (into {} (for [[_ k body] (re-seq #"CASE (\d+) (\(.*\))" out)]
             [(parse-long k) (edn/read-string body)])))
(when (not= (count expected) n)
  (println (str "fuzz-heap-gen: ACL2 answered " (count expected) " of " n " cases; its output ends:"))
  (println (subs out (max 0 (- (count out) 2000))))
  (System/exit 1))

;; ---- the generated code ---------------------------------------------------------------

(p/shell {:out :string :err :string} "scripts/acl2-fortran" "-b" "heapg" "-o" (str work "/heap_gen.inc"))
(fs/copy "test/heap/heap_check.f90" (str work "/heap_check.f90"))
(def exe (str work "/heap_check"))
(let [r (p/shell {:continue true :out :string :err :string :dir work} fc "-O2" "-o" exe "heap_check.f90")]
  (when-not (zero? (:exit r)) (println (:err r) (:out r)) (System/exit 1)))

(defn case-file [k c]
  (let [f (str work "/case" k ".txt")
        nums (fn [xs] (str/join " " xs))]
    (spit f (str (:no c) " " (:nv c) " " (:na c) " " (:ns c) " " (:cap c) "\n"
                 (str/join "\n" (map #(nums (% c)) [:otag :oref :omark :voff :vlen :vmark :atag :aref :smark])) "\n"
                 (str/join "\n" (map #(nums (% c)) arrays-in)) "\n"
                 (nums (:heads c)) "\n" (nums (:used c)) "\n" (nums (:arena c)) "\n"
                 (count (:rtakes c)) "\n" (str/join "\n" (map (fn [[a b]] (str a " " b)) (:rtakes c))) "\n"
                 (nums (:oi1 c)) "\n" (count (:seqq c)) "\n" (str/join "\n" (map #(nums %) (:seqq c))) "\n"
                 (count (:roots c)) "\n" (str/join "\n" (map (fn [[t r]] (str t " " r)) (:roots c))) "\n"))
    f))

(defn parse-out [s]
  (let [m (into {} (for [ln (str/split-lines s) :let [[k & vs] (str/split (str/trim ln) #"\s+")]]
                     [k (mapv parse-long vs)]))]
    (map (comp seq m) out-names)))

(def results
  (vec (for [[k c] (map-indexed vector cases)]
         (let [r (apply p/shell {:continue true :out :string :err :string} exe (case-file k c) (when broken ["broken"]))
               got (parse-out (:out r))
               want (map seq (expected k))]
           {:k k :ok (= got want) :got got :want want :overflow (= 1 (first (nth (expected k) 3)))}))))

(def bad (remove :ok results))
(def seq-bad (remove (fn [r] (= (last (:got r)) (last (:want r)))) results))
(println (str n " heaps, seed " seed (when broken " (negative control: an object's last slot unread)")
              "; " (count (filter :overflow results)) " overflowed their stack"))
(println (str "generated marking, sweep, allocation and seq operations against ACL2's: " (count bad) " differ"))
(println (str "  of them in the seq operations' answers: " (count seq-bad)))
(doseq [b (take 2 bad)]
  (println "  case" (:k b))
  (doseq [[nm w g] (map vector out-names (:want b) (:got b)) :when (not= w g)]
    (println "    " nm "ACL2" (pr-str w) "generated" (pr-str g))))
(System/exit (if (if broken (or (empty? bad) (empty? seq-bad)) (seq bad)) 1 0))
