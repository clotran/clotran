#!/usr/bin/env bb
;; fuzz-amg-gen: the GENERATED array map reads (src/f/gen/arraymap_gen.inc,
;; written by scripts/acl2-fortran -b arraymapg from model/arraymapg.lisp)
;; against the ACL2 they were generated from.
;;
;;   scripts/fuzz-amg-gen [-n COUNT] [-s SEED] [-x] [--fc gfortran|flang]
;;
;; Random heaps: objects of five words, some of them maps (kind 3) whose
;; first two slots name runs of the arena -- some not runs, some shorter
;; than the count, some past the arena -- and the arena's words drawn from
;; a few, so keys repeat and lookups find them. Each query asks index_of,
;; get, key_at and val_at of a value (a map most often) with a key (one of
;; the arena's words most often). gc_equal is the words' equality on both
;; sides (ACL2: defattach). ACL2 answers with the model's functions,
;; test/amg/amg_check with the generated ones; every answer must agree.
;;
;; -x is the NEGATIVE CONTROL: the generated side reads a map's count one
;; more, and the answers must part.
(require '[babashka.process :as p] '[clojure.string :as str] '[clojure.edn :as edn] '[babashka.fs :as fs])

(def broken (some #{"-x"} *command-line-args*))
(def args (apply hash-map (remove #{"-x"} *command-line-args*)))
(def n (parse-long (get args "-n" "200")))
(def seed (parse-long (get args "-s" (str (mod (System/nanoTime) 2147483647)))))
(def fc (get args "--fc" "gfortran"))
(def work (str (fs/create-temp-dir {:prefix "fuzz-amg-gen"})))

;; the house LCG: every case reproduces from its seed
(def rng (atom seed))
(defn rnd [k]
  (let [x (swap! rng #(unchecked-add (unchecked-multiply % 6364136223846793005) 1442695040888963407))]
    (mod (bit-shift-right x 33) (max k 1))))
(defn pick [xs] (nth xs (rnd (count xs))))

(defn gen-word [] [(pick [0 2 2 2 7 7 5 8]) (rnd 3) (pick [0 1 2 3 (rnd 5) -1])])

(defn gen-case []
  (let [no (+ 2 (rnd 10)) nv (+ 2 (rnd 6)) na (+ 8 (rnd 40))
        okind (vec (for [o (range no)] (if (zero? o) 0 (pick [3 3 3 3 1 2 (rnd 9)]))))
        oi1 (vec (for [_ (range no)] (pick [1 2 3 4 5 6 2 3 4 0 (rnd 9) -1])))
        voff (vec (repeatedly nv #(pick [(+ 1 (rnd (- na 7))) (+ 1 (rnd (- na 7))) (+ 1 (rnd (- na 7))) (+ 1 (rnd (- na 7))) (+ 1 (rnd 4)) 0 -1 (+ na (rnd 3)) (- na 2)])))
        vlen (vec (repeatedly nv #(pick [1 2 3 4 5 6 3 4 0 (rnd 8)])))
        slots (vec (for [o (range no) k (range 5)]
                     (cond (and (< k 2) (= 3 (nth okind o)) (pos? (rnd 6))) [9 (pick [(rnd nv) (rnd nv) (rnd nv) nv -1])]
                           :else (let [[t r] (gen-word)] [t r]))))
        arena (vec (repeatedly na gen-word))
        mapo (or (seq (keep-indexed (fn [o k] (when (= k 3) o)) okind)) [1])
        qs (vec (repeatedly (+ 4 (rnd 10))
                            #(let [[tg rf] (pick [[8 (pick mapo)] [8 (pick mapo)] [8 (pick mapo)] [8 (+ 1 (rnd (dec no)))]
                                                  [8 0] [8 no] [0 0] [9 (rnd nv)]])
                                   [st sr] (if (and (= tg 8) (< rf no)) (nth slots (* 5 rf)) [0 0])
                                   v (if (and (= st 9) (< -1 sr nv)) sr (rnd nv)) o (nth voff v)
                                   ;; a key of some run, most often: lookups that find
                                   [kt kr kv] (cond (and (pos? (rnd 3)) (< 0 o) (< (+ o (nth vlen v)) na) (pos? (nth vlen v)))
                                                    (nth arena (+ o (rnd (nth vlen v))))
                                                    (pos? (rnd 2)) (pick arena) :else (gen-word))]
                               [tg rf kt kr kv (pick [0 1 2 3 4 (rnd 9) -1])])))]
    {:no no :nv nv :na na :slots slots :okind okind :oi1 oi1 :voff voff :vlen vlen :arena arena :qs qs}))

(def cases (vec (repeatedly n gen-case)))

;; ---- ACL2 -------------------------------------------------------------------------

(defn l [xs] (str "'(" (str/join " " xs) ")"))

(def hfields [["otag" 0] ["oref" 1] ["okind" 2] ["oi1" 3] ["voff" 4] ["vlen" 5] ["atag" 6] ["aref" 7] ["aival" 8]])
(def driver
  (str "(include-book \"arraymapg\")\n"
       "(defun amg-keq-words (kt kr kv wt wr wv) (declare (xargs :guard t)) (and (equal kt wt) (equal kr wr) (equal kv wv)))\n"
       "(defattach amg-keq amg-keq-words)\n"
       "(set-print-case :downcase state)\n"
       "(set-fmt-hard-right-margin 100000 state)\n(set-fmt-soft-right-margin 100000 state)\n"
       "(defun ld-h (f i xs hpg) (declare (xargs :stobjs hpg :mode :program))\n"
       "  (if (endp xs) hpg (let ((hpg (case f "
       (str/join " " (for [[nm k] hfields] (str "(" k " (update-h-" nm "i i (car xs) hpg))")))
       " (t hpg)))) (ld-h f (1+ i) (cdr xs) hpg))))\n"
       "(defun put-h (f xs hpg) (declare (xargs :stobjs hpg :mode :program))\n"
       "  (let ((hpg (case f "
       (str/join " " (for [[nm k] hfields] (str "(" k " (resize-h-" nm " (len xs) hpg))")))
       " (t hpg)))) (ld-h f 0 xs hpg)))\n"
       "(defun ask (q hpg) (declare (xargs :stobjs hpg :mode :program))\n"
       "  (let ((tg (nth 0 q)) (rf (nth 1 q)) (kt (nth 2 q)) (kr (nth 3 q)) (kv (nth 4 q)) (i (nth 5 q)))\n"
       "    (list (amg-index tg rf kt kr kv hpg) (amg-get tg rf kt kr kv hpg) (amg-at tg rf 0 i hpg) (amg-at tg rf 1 i hpg))))\n"
       "(defun asks (qs hpg) (declare (xargs :stobjs hpg :mode :program))\n"
       "  (if (endp qs) nil (cons (ask (car qs) hpg) (asks (cdr qs) hpg))))\n"
       "(defun put-all (k hs hpg) (declare (xargs :stobjs hpg :mode :program))\n"
       "  (if (endp hs) hpg (let ((hpg (put-h k (car hs) hpg))) (put-all (1+ k) (cdr hs) hpg))))\n"
       "(defun run-case (k hs qs hpg) (declare (xargs :stobjs hpg :mode :program))\n"
       "  (let ((hpg (put-all 0 hs hpg))) (prog2$ (cw \"CASE ~x0 ~x1~%\" k (asks qs hpg)) hpg)))\n"
       (str/join (map-indexed
                  (fn [k c]
                    (let [s (:slots c) a (:arena c)]
                      (str "(run-case " k " (list "
                           (str/join " " (map l [(map first s) (map second s) (:okind c) (:oi1 c) (:voff c) (:vlen c)
                                                 (map first a) (map second a) (map #(nth % 2) a)]))
                           ") '(" (str/join " " (map #(str "(" (str/join " " %) ")") (:qs c))) ") hpg)\n")))
                  cases))
       "(good-bye)\n"))

(def acl2 (or (System/getenv "ACL2") (str (fs/parent (fs/parent (fs/parent (fs/canonicalize *file*)))) "/acl2/saved_acl2")))
(def out (:out (p/shell {:dir "model" :in driver :out :string :err :string} acl2)))
(def expected
  (into {} (for [[_ k body] (re-seq #"CASE (\d+) (\(.*\))" out)] [(parse-long k) (edn/read-string body)])))
(when (not= (count expected) n)
  (println (str "fuzz-amg-gen: ACL2 answered " (count expected) " of " n " cases; its output ends:"))
  (println (subs out (max 0 (- (count out) 2000))))
  (System/exit 1))

;; ---- the generated code ---------------------------------------------------------------

(p/shell {:out :string :err :string} "scripts/acl2-fortran" "-b" "arraymapg" "-o" (str work "/arraymap_gen.inc"))
(fs/copy "test/amg/amg_check.f90" (str work "/amg_check.f90"))
(def exe (str work "/amg_check"))
(let [r (p/shell {:continue true :out :string :err :string :dir work} fc "-O2" "-o" exe "amg_check.f90")]
  (when-not (zero? (:exit r)) (println (:err r) (:out r)) (System/exit 1)))

(defn nums [xs] (str/join " " xs))
(defn case-file [k c]
  (let [f (str work "/case" k ".txt") s (:slots c) a (:arena c)]
    (spit f (str (:no c) " " (:nv c) " " (:na c) "\n"
                 (str/join "\n" (map nums [(map first s) (map second s) (:okind c) (:oi1 c) (:voff c) (:vlen c)
                                           (map first a) (map second a) (map #(nth % 2) a)]))
                 "\n" (count (:qs c)) "\n" (str/join "\n" (map nums (:qs c))) "\n"))
    f))

(def kinds ["index" "get" "key-at" "val-at"])

(def results
  (vec (for [[k c] (map-indexed vector cases)]
         (let [r (apply p/shell {:continue true :out :string :err :string} exe (case-file k c) (when broken ["broken"]))
               got (mapv (fn [ln] (mapv parse-long (str/split (str/trim ln) #"\s+"))) (remove str/blank? (str/split-lines (:out r))))
               want (mapv vec (expected k))]
           {:k k :got got :want want :ok (= got want)}))))

(def by-kind
  (frequencies (for [{:keys [got want]} results [g w] (map vector got want) [nm a b] (map vector kinds w g) :when (not= a b)] nm)))
(def bad (remove :ok results))
(def asked (mapcat :want results))
(println (str n " heaps, seed " seed (when broken " (negative control: a map's count one more)")))
(println (str "  asked " (count asked) " lookups, " (count (filter #(pos? (first %)) asked)) " of them found, "
              (count (filter #(neg? (nth % 2)) asked)) " key_at in a run"))
(println (str "generated array map reads against ACL2's: " (count bad) " cases differ"))
(doseq [[nm c] (sort by-kind)] (println (str "  " nm ": " c)))
(doseq [b (take 2 bad)]
  (println "  case" (:k b))
  (doseq [[w g] (map vector (:want b) (:got b)) :when (not= w g)] (println "    ACL2" (pr-str w) "generated" (pr-str g))))
(System/exit (if (if broken (empty? bad) (seq bad)) 1 0))
