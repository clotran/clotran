#!/usr/bin/env bb
;; fuzz-gc: the collector and the heap image, under every generator
;; (PLAN step 29).
;;
;;   scripts/fuzz-gc [-n N] [-s SEED]
;;
;; The generated programs (scripts/fuzz), collections (fuzz-coll), values
;; printed and read back (fuzz-print), numbers (fuzz-num), spec forms
;; (fuzz-spec) and threads (fuzz-threads, every 17 and 1009 only) run with the collector forced every 3, 17 and 1009
;; allocations -- a rooting bug shows only when a collection lands
;; between two allocations, and where it lands depends on the interval --
;; and with core loaded from source instead of the heap image (noimage):
;; what the image holds must be what loading makes. Every answer is
;; compared with clj's, so a collection that frees something live, or an
;; image that lost something, shows as a wrong value, a crash or a hang.
(require '[babashka.fs :as fs]
         '[babashka.process :as p])

(def opts (loop [as *command-line-args* o {:n 60 :seed 1}]
            (if (empty? as) o
                (case (first as)
                  "-n" (recur (drop 2 as) (assoc o :n (parse-long (second as))))
                  "-s" (recur (drop 2 as) (assoc o :seed (parse-long (second as))))
                  (do (println "usage: scripts/fuzz-gc [-n N] [-s SEED]") (System/exit 2))))))

(def modes "torture-3,torture-17,torture-1009,noimage")
(def scripts (str (fs/parent *file*)))

(let [{:keys [n seed]} opts
      out (str (fs/create-temp-dir {:prefix "fuzz-gc"}))
      runs [[(str scripts "/fuzz") "-n" (str n) "-s" (str seed) "-m" modes]
            [(str scripts "/fuzz-coll") "-n" (str n) "-s" (str seed) "-m" modes "-o" (str out "/coll.edn")]
            [(str scripts "/fuzz-print") "-n" (str n) "-s" (str seed) "-m" modes "-o" (str out "/print.edn")]
            [(str scripts "/fuzz-num") "-n" (str n) "-s" (str seed) "-m" modes "-o" (str out "/num.edn")]
            ;; threads under the collector: a mutator blocked on a lock while
            ;; another collects (torture-3 is too slow for futures)
            [(str scripts "/fuzz-threads") "-n" (str (max 4 (quot n 2))) "-s" (str seed) "-m" "torture-17,torture-1009" "-o" (str out "/threads.edn")]
            [(str scripts "/fuzz-spec") "-n" (str (max 4 (quot n 6))) "-k" "2" "-s" (str seed) "-m" modes "-o" (str out "/spec.edn")]]
      results (doall (for [cmd runs]
                       (do (println "===" (fs/file-name (first cmd)))
                           (:exit (apply p/shell {:continue true} "bb" cmd)))))]
  (fs/delete-tree out)
  (println "fuzz-gc:" (count (remove zero? results)) "of" (count runs) "generators found something")
  (System/exit (if (every? zero? results) 0 1)))
