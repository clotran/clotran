#!/usr/bin/env bb
;; dist-check: a release tarball run where nothing else is installed.
;;
;;   scripts/dist-check build/dist/clotran-...tar.gz IMAGE...
;;
;; In each image (debian:10, alpine:3.20, ...) the tarball is unpacked
;; and asked four things: a program run as a file, a future, a Unicode
;; regex, and a project whose deps.edn names a :local/root library --
;; which runs clotran-deps. Each answer is checked; exit 1 on any miss.
(require '[babashka.fs :as fs]
         '[babashka.process :as p]
         '[clojure.string :as str])

(def tarball (str (fs/absolutize (first *command-line-args*))))
(def images (rest *command-line-args*))
(def outdir (str (fs/parent tarball)))
(def top (str/replace (fs/file-name tarball) #"\.tar\.gz$" ""))
;; the images run as the tarball's machine, emulated where it is not this one
(def platform (cond (str/includes? top "x86_64") "linux/amd64" (str/includes? top "aarch64") "linux/arm64"))

(def script
  (str "set -e; cd /tmp && tar xzf /d/" (fs/file-name tarball) " && c=/tmp/" top "/bin/clotran\n"
       "printf '(println (+ 1 2))\\n(prn 3.5 (/ 1.0 3) 1e300 (Math/sqrt 2))\\n(println @(future (reduce + (range 1000))))\\n(println (re-seq #\"\\\\p{L}+\" \"h\\303\\251llo w\\303\\266rld\"))\\n(shutdown-agents)\\n' > /tmp/p.cljf\n"
       "$c /tmp/p.cljf\n"
       "mkdir -p /tmp/lib/src/lib /tmp/app/src/app\n"
       "printf '(ns lib.core)\\n(defn twice [x] (* 2 x))\\n' > /tmp/lib/src/lib/core.cljf\n"
       "printf '{:paths [\"src\"]}\\n' > /tmp/lib/deps.edn\n"
       "printf '(ns app.main (:require [lib.core :as l]))\\n(defn -main [] (println (l/twice 21)))\\n' > /tmp/app/src/app/main.cljf\n"
       "printf '{:paths [\"src\"] :deps {local/lib {:local/root \"/tmp/lib\"}}}\\n' > /tmp/app/deps.edn\n"
       "cd /tmp/app && $c -m app.main\n"))

;; a double printed, and read back: rc.3's Linux build crashed on the first
;; (its gcc 8 Fortran runtime could not read the formats gfortran 14 writes)
(def want ["3" "3.5 0.3333333333333333 1.0E300 1.4142135623730951" "499500" "(héllo wörld)" "42"])

(def bad
  (doall
   (for [img images]
     (let [r (p/shell {:out :string :err :string :continue true}
                      "docker" "run" "--rm" "--platform" platform "-v" (str outdir ":/d") img "sh" "-c" script)
           got (vec (remove #(re-find #"^note:" %) (str/split-lines (:out r))))]
       (if (and (zero? (:exit r)) (= want got))
         (do (println "pass" img) nil)
         (do (println "FAIL" img "exit" (:exit r))
             (println "  want:" want)
             (println "  got: " got)
             (println (str/join "\n" (take-last 10 (str/split-lines (:err r)))))
             img))))))

(println (format "dist-check: %d of %d images pass" (- (count images) (count (remove nil? bad))) (count images)))
(System/exit (if (some some? bad) 1 0))
