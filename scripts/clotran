#!/bin/sh
# The user-facing entry point, wrapping the real interpreter
# (clotran-gc) exactly the way real Clojure's own clj wraps clojure:
# rlwrap when it's installed (command-line editing/history), otherwise
# a plain invocation with a note about what's missing. Same rlwrap
# flags clj itself uses -- -m (multi-line), -r (remember words typed
# for completion), -q/-b tuned for Lisp syntax rather than shell
# syntax -- not reinvented here.
#
# core.clj is loaded on every start; there is no image yet, so this
# costs a second or two before the prompt.
dir=$(cd "$(dirname "$0")" && pwd)
core="$dir/src/clj/clojure/core.clj"
[ -f "$core" ] || core="$dir/../src/clj/clojure/core.clj"

if type rlwrap >/dev/null 2>&1; then
  exec rlwrap -m -r -q '"' -b "(){}[],^%#@\";:'" "$dir/clotran-gc" "$core" "$@"
else
  echo "Please install rlwrap for command editing or use clotran-gc instead." >&2
  exec "$dir/clotran-gc" "$core" "$@"
fi
