#!/bin/sh
# The user-facing entry point, wrapping the interpreter (./clotran, built
# by make at the repo root) exactly the way real Clojure's own clj wraps
# clojure: rlwrap when it's installed (command-line editing/history),
# otherwise a plain invocation with a note about what's missing. Same
# rlwrap flags clj itself uses -- -m (multi-line), -r (remember words
# typed for completion), -q/-b tuned for Lisp syntax rather than shell
# syntax -- not reinvented here.
#
# core.clj is loaded on every start; there is no image yet, so this
# costs a few seconds before the prompt.
root=$(cd "$(dirname "$0")/.." && pwd)
bin="$root/clotran"
core="$root/src/clj/clojure/core.clj"
[ -x "$bin" ] || { echo "build first: make" >&2; exit 1; }

if type rlwrap >/dev/null 2>&1; then
  exec rlwrap -m -r -q '"' -b "(){}[],^%#@\";:'" "$bin" "$core" "$@"
else
  echo "Please install rlwrap for command editing, or run ./clotran $core directly." >&2
  exec "$bin" "$core" "$@"
fi
