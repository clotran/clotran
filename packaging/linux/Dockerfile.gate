# The Linux gate (scripts/gate-linux): make crosscheck under gfortran and
# flang on Debian 13, with the oracle's own tools at the versions the
# macOS gate runs -- clj on JDK 26.0.2.1 (a host exception's message is the
# JDK's, and the oracle compares messages) and babashka 1.3.185 -- and a
# UTF-8 locale, without which clj's runtime writes ? for every non-ASCII
# character and the oracle sees sixteen false differences. flang is
# 23.1.1, the macOS gate's, from LLVM's release by sha256: Debian's
# flang-19 initializes every gc_value local through its runtime, which
# made clotran 5x slower than under 23 and lost compiler-check's race on
# x86_64. The Clojure CLI is the macOS gate's too, 1.12.0.1479.
FROM debian:trixie
ARG ARCH=aarch64
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 PATH=/opt/jdk/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential gfortran xz-utils python3 make ca-certificates curl git file \
      rlwrap bash netcat-openbsd unzip rsync patchelf && rm -rf /var/lib/apt/lists/*
RUN case ${ARCH} in \
      aarch64) L=ARM64 SUM=3fbaaa6a1f147557a4095b9911f8dc2d4c745a11863982f76ee20e248c190a80 ;; \
      x86_64) L=X64 SUM=832aeb58d105de1cabc7b982dd2c65de0610f7377df48ae8fc2dd8e97420a15c ;; \
    esac \
 && curl -sfL -o /tmp/llvm.tar.xz https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.1/LLVM-23.1.1-Linux-$L.tar.xz \
 && echo "$SUM  /tmp/llvm.tar.xz" | sha256sum -c - \
 && mkdir -p /opt/llvm && tar xJf /tmp/llvm.tar.xz -C /opt/llvm --strip-components=1 --wildcards \
      '*/bin/flang*' '*/lib/clang' '*/lib/*flang*' '*/include/flang' \
 && rm /tmp/llvm.tar.xz && ln -s /opt/llvm/bin/flang /usr/local/bin/flang && flang --version
RUN mkdir -p /opt/jdk && curl -sL "https://api.adoptium.net/v3/binary/version/jdk-26.0.2.1%2B1/linux/${ARCH}/jdk/hotspot/normal/eclipse" \
      | tar xz -C /opt/jdk --strip-components=1
RUN curl -sL https://github.com/clojure/brew-install/releases/download/1.12.0.1479/linux-install.sh -o /tmp/ci.sh && bash /tmp/ci.sh && rm /tmp/ci.sh
RUN curl -sL https://raw.githubusercontent.com/babashka/babashka/master/install -o /tmp/bbi \
 && bash /tmp/bbi --version 1.3.185 && rm /tmp/bbi
WORKDIR /src
