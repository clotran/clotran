# The Linux gate (scripts/gate-linux): make crosscheck under gfortran and
# flang on Debian 13, with the oracle's own tools at the versions the
# macOS gate runs -- clj on JDK 26.0.2.1 (a host exception's message is the
# JDK's, and the oracle compares messages) and babashka 1.3.185 -- and a
# UTF-8 locale, without which clj's runtime writes ? for every non-ASCII
# character and the oracle sees sixteen false differences.
FROM debian:trixie
ARG ARCH=aarch64
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 PATH=/opt/jdk/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential gfortran flang-19 python3 make ca-certificates curl git file \
      rlwrap bash netcat-openbsd unzip rsync patchelf && rm -rf /var/lib/apt/lists/*
RUN ln -s /usr/bin/flang-new-19 /usr/local/bin/flang 2>/dev/null || ln -s /usr/lib/llvm-19/bin/flang-new /usr/local/bin/flang
RUN mkdir -p /opt/jdk && curl -sL "https://api.adoptium.net/v3/binary/version/jdk-26.0.2.1%2B1/linux/${ARCH}/jdk/hotspot/normal/eclipse" \
      | tar xz -C /opt/jdk --strip-components=1
RUN curl -sL https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh -o /tmp/ci.sh && bash /tmp/ci.sh && rm /tmp/ci.sh
RUN curl -sL https://raw.githubusercontent.com/babashka/babashka/master/install -o /tmp/bbi \
 && bash /tmp/bbi --version 1.3.185 && rm /tmp/bbi
WORKDIR /src
